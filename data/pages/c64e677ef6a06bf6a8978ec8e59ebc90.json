  "url": "http://ar.wikibooks.org/wiki/%D9%88%D9%8A%D9%83%D9%8A_%D9%83%D8%AA%D8%A8:%D8%A8%D9%88%D8%A7%D8%A8%D8%A9_%D8%A7%D9%84%D9%85%D8%AC%D8%AA%D9%85%D8%B9",
  "title": "\u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u064a\u0639\u062f \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0645\u0643\u062a\u0628\u0629 \u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0648\u0645\u062c\u062a\u0645\u0639 \u0641\u064a \u0646\u0641\u0633 \u0627\u0644\u0648\u0642\u062a.\n\u0625\u0630 \u062a\u0633\u062a\u0637\u064a\u0639 \u062a\u0639\u062f\u064a\u0644 \u0623\u064a \u0635\u0641\u062d\u0629\u060c \u0648\u062d\u062a\u0649 \u0627\u0646\u062a . \u0644\u062a\u062c\u0631\u0628\u0629 \u0630\u0644\u0643 \u062a\u0648\u062c\u0647 \u0644\u0633\u0627\u062d\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u0628 . \u0628\u0639\u062f\u0647\u0627 \u0645\u0646 \u0627\u0644\u0645\u0645\u0643\u0646 \u0623\u0646 \u062a\u0642\u0648\u0645 \u0628\u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u062c\u062f\u064a\u062f \u0644\u062a\u062a\u0645\u062a\u0639 \u0628\u0627\u0644\u0645\u0632\u0627\u064a\u0627 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u062a\u064a \u062a\u062d\u0635\u0644 \u0639\u0644\u064a\u0647\u0627 \u0639\u0646\u062f \u0627\u0644\u0625\u0634\u062a\u0631\u0627\u0643. \u062a\u0647\u062f\u0641 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0625\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0628\u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0639\u0644\u0649 \u0623\u0633\u0626\u0644\u062a\u0643 \u060c \u0648\u0645\u0633\u0627\u0639\u062f\u062a\u0643 \u0639\u0644\u0649 \u0645\u0639\u0631\u0641\u0629 \u0648\u0641\u0647\u0645 \u0633\u064a\u0627\u0633\u0627\u062a \u0627\u0644\u0645\u0648\u0633\u0648\u0639\u0629\u060c \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639 \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u064a\u0646 \u0627\u0644\u0622\u062e\u0631\u064a\u0646. \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0648\u064a\u0643\u064a_\u0643\u062a\u0628:\u0628\u0648\u0627\u0628\u0629_\u0627\u0644\u0645\u062c\u062a\u0645\u0639&oldid=223535 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0628\u062d\u062b \u0628\u062d\u062b \u0648\u064a\u0643\u064a \u0643\u062a\u0628 : \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 31 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

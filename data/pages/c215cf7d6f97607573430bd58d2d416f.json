{
  "url": "https://ary.wikipedia.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D9%84%D8%B9%D9%88%D8%A7%D9%85",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0644\u0639\u0648\u0627\u0645 - \u0648\u064a\u0643\u064a\u067e\u064a\u062f\u064a\u0627",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0644\u0639\u0648\u0627\u0645 - \u0648\u064a\u0643\u064a\u067e\u064a\u062f\u064a\u0627 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0639\u0627\u0648\u0646\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a\u067e\u064a\u062f\u064a\u0627 \u0644\u0645\u0642\u0627\u0644\u0629 \u0631\u0651\u0626\u064a\u0633\u064a\u0629 \u062f\u064a\u0627\u0644 \u0647\u0627\u062f \u062a\u0651\u0635\u0646\u064a\u0641 \u0647\u064a\u0651 \u0639\u0627\u0645 \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 \u0639\u0646\u062f\u0627 \u062a\u0635\u0627\u0648\u0631 \u0648 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0644\u0649 \u0644\u0639\u0648\u0627\u0645 . \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u0647\u0627\u062f \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0641\u064a\u0647 10 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629\u060c \u0645\u0646 \u0623\u0635\u0644 10 \u0641\u0627\u0644\u0645\u062c\u0645\u0648\u0639. \u0623 \u0623\u062d\u062f\u0627\u062a \u0643\u0627\u064a\u0637\u0631\u0627\u0648 \u0643\u0644 \u0639\u0627\u0645 (1 \u062a\u060c  2 \u0635) \u062a \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0644\u0639\u0627\u0645 (25 \u062a) \u0639 \u0639\u0648\u0627\u0645 \u062f \u062a\u0642\u0648\u064a\u0645 \u0644\u0645\u064a\u0644\u0627\u062f\u064a (1,288 \u062a\u060c  2,892 \u0635) \u0639\u0648\u0627\u0645 \u062f \u0644\u0642\u0631\u0646 20 (102 \u062a) \u0639\u0648\u0627\u0645 \u062f \u0644\u0642\u0631\u0646 21 (32 \u062a) \u0639\u0648\u0627\u0645 \u062f \u0644\u0642\u0631\u0646 4 (96 \u062a) \u0639\u0648\u0627\u0645 \u062f \u0644\u0642\u0631\u0646 5 (95 \u062a) \u0644 \u0644\u0639\u0648\u0627\u0645 \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0644\u0628\u0644\u0627\u062f (115 \u062a) \u0644\u0639\u0648\u0627\u0645 \u0639\u0644\u0649 \u062d\u0633\u0627\u0628 \u0644\u0642\u0627\u0631\u0629 (9 \u062a) \u0646 \u0646\u0647\u0627\u0631\u0627\u062a \u062f \u0644\u0639\u0627\u0645 (2 \u062a\u060c  366 \u0635) \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0644\u064a \u0643\u0627\u064a\u0646\u064a\u0646 \u0641\u062a\u0635\u0646\u064a\u0641 \"\u0644\u0639\u0648\u0627\u0645\" \u0647\u0627\u062f 2 \u0635\u0641\u062d\u0627\u062a \u0643\u0627\u064a\u0646\u064a\u0646 \u0641 \u0647\u0627\u062f \u062a\u0635\u0646\u064a\u0641\u060c \u0645\u0646 \u0623\u0635\u0644 2 \u0641 \u0644\u0645\u062c\u0645\u0648\u0639. \u0639 \u0639\u0627\u0645 \u0644 \u0644\u064a\u0633\u062a\u0629 \u062f \u0644\u0639\u0648\u0627\u0645 \u0645\u0631\u062c\u0651\u0639\u0629 \u0645\u0646 \" https://ary.wikipedia.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0644\u0639\u0648\u0627\u0645&oldid=335023 \" \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0639\u0628\u0631\u0627\u062a \u062f \u0627\u0644\u0632\u0645\u0627\u0646 \u062a\u0642\u0648\u064a\u0645 \u0643\u0631\u0648\u0646\u0648\u0644\u0648\u062c\u064a\u0627 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0623\u062e\u0637\u0627\u0621 \u0641\u064a \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0646\u0635\u064a \u0642\u0644\u0651\u0628 \u0642\u0644\u0651\u0628 \u062a\u0635\u0646\u064a\u0641 : \u0644\u0639\u0648\u0627\u0645 197 \u0644\u0648\u063a\u0627\u062a \u0632\u064a\u062f \u0634\u064a \u0645\u0648\u0636\u0648\u0639",

{
  "url": "http://ar.wikiversity.org/wiki/%D9%86%D9%82%D8%A7%D8%B4_%D8%A7%D9%84%D9%85%D8%B3%D8%AA%D8%AE%D8%AF%D9%85:Bsthalk",
  "title": "\u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:Bsthalk - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:Bsthalk - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u0623\u062d\u062f\u062b \u062a\u0639\u0644\u064a\u0642: \u0642\u0628\u0644 9 \u0623\u0634\u0647\u0631 \u0645\u0646 Bsthalk \u0641\u064a \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u062a\u0646\u0628\u064a\u0647 \u062a\u0646\u0628\u064a\u0647 [ \u0639\u062f\u0644 ] \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0623\u062e\u064a\u0631: \u0642\u0628\u0644 9 \u0623\u0634\u0647\u0631 \u062a\u0639\u0644\u064a\u0642\u0627\u0646 \u0634\u062e\u0635\u0627\u0646 \u0641\u064a \u0627\u0644\u0646\u0642\u0627\u0634 \u0645\u0631\u062d\u0628\u064b\u0627 Bsthalk\u060c \u064a\u064f\u0631\u062c\u0649 \u0627\u0644\u0627\u0646\u062a\u0628\u0627\u0647 \u0644\u0644\u0648\u0635\u0644\u0627\u062a \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0648\u0637\u0631\u064a\u0642\u0629 \u0637\u0631\u062d\u0647\u0627 \u0627\u0644\u0645\u0633\u062a\u0639\u0645\u0644\u0629\u060c \u0625\u0646 \u0643\u0627\u0646\u062a \u0628\u0646\u064a\u0651\u0629 \u063a\u064a\u0631 \u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u0648\u062a\u0647\u062f\u0641 \u0644\u063a\u0631\u0636 \u0627\u0644\u062a\u0631\u0648\u064a\u062c \u0648\u0627\u0644\u062f\u0639\u0627\u064a\u0629 \u0641\u0625\u0646\u0647\u0627 \u0633\u062a\u0639\u062a\u0628\u0631 \u0645\u062e\u0627\u0644\u0641\u0629 \u0648\u0633\u064a\u062c\u0631\u064a \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639\u0647\u0627 \u0648\u0641\u0642\u064b\u0627 \u0644\u0630\u0644\u0643\u060c \u062a\u062d\u064a\u0627\u062a\u064a \u0644\u0643 -- Mohanad ( \u0646\u0642\u0627\u0634 ) 15:36\u060c 13 \u064a\u0648\u0646\u064a\u0648 2025 (\u062a \u0639 \u0645) \u0631\u062f\u0651 \u0645\u0631\u062d\u0628\u064b\u0627 Mohanad\u060c \u0634\u0643\u0631\u064b\u0627 \u0644\u062a\u0646\u0628\u064a\u0647\u0643 \u0627\u0644\u0642\u064a\u0651\u0645. \u0623\u0646\u0627 \u0645\u0639\u0644\u0645 \u0644\u063a\u0629 \u0639\u0631\u0628\u064a\u0629\u060c \u0648\u0623\u0639\u0645\u0644 \u0639\u0644\u0649 \u0643\u062a\u0627\u0628\u0629 \u0645\u0642\u0627\u0644\u0627\u062a \u0643\u0627\u0645\u0644\u0629 \u0648\u0645\u0633\u062a\u0648\u0641\u064a\u0629 \u0644\u0644\u0634\u0631\u0648\u0637 \u060c \u0645\u0639 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u062d\u064a\u0627\u062f\u064a\u0629\u060c \u0627\u0644\u062a\u0648\u062b\u064a\u0642 \u0628\u0645\u0635\u0627\u062f\u0631 \u0645\u0648\u062b\u0648\u0642\u0629\u060c \u0648\u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0627\u0644\u0645\u0648\u0633\u0648\u0639\u064a. \u0647\u062f\u0641\u064a \u062a\u0639\u0644\u064a\u0645\u064a \u0628\u062d\u062a\u060c \u0648\u0623\u062d\u0631\u0635 \u0639\u0644\u0649 \u062a\u0642\u062f\u064a\u0645 \u0645\u062d\u062a\u0648\u0649 \u0630\u064a \u0642\u064a\u0645\u0629 \u064a\u062b\u0631\u064a \u0627\u0644\u0645\u0648\u0633\u0648\u0639\u0629. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0647\u0646\u0627\u0643 \u0623\u064a \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u062d\u0648\u0644 \u0627\u0644\u0648\u0635\u0644\u0627\u062a \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0623\u0648 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0639\u0631\u0636\u060c \u0641\u0623\u0646\u0627 \u062c\u0627\u0647\u0632 \u0644\u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0644\u062a\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0633\u064a\u0627\u0633\u0627\u062a\u0643\u0645. \u062a\u062d\u064a\u0627\u062a\u064a \u0644\u0643\u060c Bsthalk ( \u0646\u0642\u0627\u0634 ) 04:41\u060c 14 \u064a\u0648\u0646\u064a\u0648 2025 (\u062a \u0639 \u0645) \u0631\u062f\u0651 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0646\u0642\u0627\u0634_\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:Bsthalk&oldid=144165 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 : Bsthalk \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

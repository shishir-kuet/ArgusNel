  "url": "http://ar.wikibooks.org/wiki/%D9%83%D8%AA%D8%A7%D8%A8_%D8%A7%D9%84%D8%B7%D8%A8%D8%AE",
  "title": "\u0643\u062a\u0627\u0628 \u0627\u0644\u0637\u0628\u062e - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0643\u062a\u0627\u0628 \u0627\u0644\u0637\u0628\u062e - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0643\u062a\u0627\u0628 \u0627\u0644\u0637\u0628\u062e \u0645\u0646\u0633\u0641 \u0635\u064a\u0646\u064a\u0629 \u0643\u0641\u062a\u0629 \u0645\u062e\u0644\u0644 \u0627\u0644\u062e\u064a\u0627\u0631 \u0628\u0642\u0644\u0627\u0648\u0629 \u062a\u0642\u062f\u064a\u0645 [ \u0639\u062f\u0644 ] \u064a\u0647\u062f\u0641 \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0625\u0644\u0649 \u0628\u0646\u0627\u0621 \u062f\u0644\u064a\u0644 \u0644\u062a\u062d\u0636\u064a\u0631 \u0627\u0644\u0645\u0623\u0643\u0648\u0644\u0627\u062a \u0644\u0644\u0645\u0628\u062a\u062f\u0626\u064a\u0646 \u0648\u0627\u0644\u0645\u062a\u0645\u0631\u0633\u064a\u0646.\n\u0645\u062b\u0644\u0627\u064b\u060c \u0647\u0646\u0627\u0643 \u0648\u0635\u0641\u0629 \u0623\u0635\u0627\u0628\u0639 \u0627\u0644\u062f\u062c\u0627\u062c \u0648\u0623\u062e\u0631\u0649 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0625\u062b\u0631\u0627\u0621 \u062a\u062d\u062a \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0642\u0644\u0648\u0628\u0629 \u0648\u0648\u0635\u0641\u0629 \u0623\u062e\u0631\u0649 \u0644\u0644\u0643\u0646\u0627\u0641\u0629 \u0628\u0627\u0644\u0642\u0634\u0637\u0629 . \u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0644\u0623\u0637\u0628\u0627\u0642 \u0627\u0644\u062c\u0627\u0646\u0628\u064a\u0629 \u0648\u0627\u0644\u0634\u0648\u0631\u0628\u0627\u062a \u0645\u062b\u0644 \u0634\u0648\u0631\u0628\u0629 \u0627\u0644\u0628\u0648\u0631\u0634 \u0627\u0644\u0631\u0648\u0633\u064a\u0629. \u0644\u0625\u0636\u0627\u0641\u0629 \u0645\u062f\u062e\u0644\u0629 \u0639\u0646 \u0623\u0643\u0644\u0629 \u0645\u0627\u060c \u0643\u0644 \u0645\u0627 \u0639\u0644\u064a\u0643 \u0641\u0639\u0644\u0647 \u0647\u0648 \u0627\u0644\u0630\u0647\u0627\u0628 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0637\u064a\u0644 (\u062a\u0639\u062f\u064a\u0644) \u0641\u064a \u0623\u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0629 \u0648\u0643\u062a\u0627\u0628\u0629\n\u0641\u062a\u0638\u0647\u0631 \u0644\u0643 \u0628\u0627\u0644\u0634\u0643\u0644 \u0627\u0644\u0622\u062a\u064a: [[\u0643\u062a\u0627\u0628 \u0627\u0644\u0637\u0628\u062e/ \u062d\u0644\u0649 \u0627\u0644\u0642\u0647\u0648\u0629|\u062d\u0644\u0649 \u0627\u0644\u0642\u0647\u0648\u0629]] \u0648\u064a\u0645\u0643\u0646\u0643 \u0639\u0646\u062f\u0647\u0627 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u0648\u0635\u0644\u0629 \u0627\u0644\u0638\u0627\u0647\u0631\u0629 \u0648\u0627\u0644\u0628\u062f\u0621 \u0641\u064a \u0634\u0631\u062d \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u062d\u0648\u0644 \u0647\u0630\u0647 \u0627\u0644\u0623\u0643\u0644\u0629\u060c \u0648\u0625\u0638\u0647\u0627\u0631 \u0628\u0631\u0627\u0639\u062a\u0643 \u0641\u064a \u062a\u062d\u0636\u064a\u0631 \u0627\u0644\u0637\u0639\u0627\u0645. \u0628\u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629\u060c \u064a\u0633\u0645\u062d \u0628\u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0639\u0644\u0649 \u0623\u064a \u0646\u0635 \u064a\u062f\u0631\u062c \u0647\u0646\u0627 \u0644\u0625\u062b\u0631\u0627\u0626\u0647 \u0648\u0625\u0636\u0627\u0641\u0629 \u062a\u0641\u0627\u0635\u064a\u0644 \u0625\u0636\u0627\u0641\u064a\u0629 \u062d\u0648\u0644\u0647\u060c \u0641\u0647\u0648 \u062e\u0627\u0636\u0639 \u0643\u063a\u064a\u0631\u0647 \u0645\u0646 \u0627\u0644\u0646\u0635\u0648\u0635 \u0641\u064a \u0645\u0634\u0631\u0648\u0639 \u0648\u064a\u0643\u064a \u0628\u0625\u0633\u062a\u062b\u0646\u0627\u0621 \u0648\u064a\u0643\u064a \u0627\u0644\u0645\u0635\u062f\u0631 \u0644\u0631\u062e\u0635\u0629 \u0627\u0644\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u062d\u0631\u0651\u0629 FDL. \u0641\u064a \u062d\u0627\u0644 \u0643\u0646\u062a \u062a\u062e\u0634\u0649 \u0627\u0644\u062a\u062e\u0631\u064a\u0628 \u060c \u0641\u0644\u0627 \u062a\u0642\u0644\u0642 \u060c \u0643\u0644 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0625\u0633\u062a\u0631\u062c\u0627\u0639. \u0647\u0646\u0627\u0643 \u0645\u0644\u0641\u0627\u062a \u0639\u0646 Cookbooks \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 . \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0643\u062a\u0627\u0628_\u0627\u0644\u0637\u0628\u062e&oldid=219763 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0641\u0635\u0648\u0644 \u063a\u064a\u0631 \u0645\u0635\u0646\u0641\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u0643\u062a\u0627\u0628 \u0627\u0644\u0637\u0628\u062e 53 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

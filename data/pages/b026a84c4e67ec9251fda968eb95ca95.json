  "url": "http://ar.wikiversity.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D9%83%D9%84%D9%8A%D8%A9_%D8%B9%D9%84%D9%88%D9%85_%D8%A7%D9%84%D8%AA%D8%A7%D8%B1%D9%8A%D8%AE",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u064a\u062d\u0648\u064a 8 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629\u060c \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a 8. \u0627 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a (2 \u0635\u0641\u062d\u0629) \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u062f\u064a\u062b (\u0641\u0627\u0631\u063a) \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0642\u062f\u064a\u0645 (1 \u062a\u0635\u0646\u064a\u0641\u060c 3 \u0635\u0641\u062d\u0629) \u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0627\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0648\u0633\u0637\u0649 \u0627\u0644\u0645\u062a\u0623\u062e\u0631\u0629 (1 \u0635\u0641\u062d\u0629) \u062a \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0631\u0628 (1 \u062a\u0635\u0646\u064a\u0641) \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0648\u0633\u0637\u0649 (1 \u0635\u0641\u062d\u0629) \u0642 \u0642\u0648\u0627\u0644\u0628 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e (1 \u0635\u0641\u062d\u0629) \u0635\u0641\u062d\u0627\u062a \u062a\u0635\u0646\u064a\u0641 \u00ab\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u00bb \u064a\u062d\u0648\u064a \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0648\u0639\u062f\u062f\u0647\u0627 26 \u0645\u0646 \u0623\u0635\u0644 26 \u0625\u062c\u0645\u0627\u0644\u0627\u064b. \u0627 \u0627\u0644\u0623\u0633\u0631\u0629 \u0648\u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0641\u064a \u0627\u0644\u062d\u0636\u0627\u0631\u0627\u062a \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0627\u0644\u062d\u0631\u0643\u0627\u062a \u0627\u0644\u0625\u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u062d\u0636\u0627\u0631\u0629 \u0627\u0644\u0633\u0648\u0645\u0631\u064a\u0629 \u0627\u0644\u062d\u0636\u0627\u0631\u0629 \u0627\u0644\u0634\u0631\u0642\u064a\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0627\u0644\u0641\u0631\u0646\u062c\u0629 \u0642\u0627\u0644\u0628:\u0627\u0644\u0643\u0644\u064a\u0629/\u0627\u0633\u0645/\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0642\u0627\u0644\u0628:\u0627\u0644\u0643\u0644\u064a\u0629/\u0634\u0639\u0627\u0631/\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u063a\u0631\u0628 \u0627\u0644\u0623\u0648\u0633\u0637 (\u0627\u0644\u062c\u0632\u0627\u0626\u0631) \u062a \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u063a\u0631\u0628 \u0627\u0644\u0643\u0628\u064a\u0631 \u062d \u062d\u0636\u0627\u0631\u0627\u062a \u0627\u0644\u0634\u0631\u0642 \u0627\u0644\u0623\u0642\u0635\u0649 \u0643 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u062d\u064a\u0627\u0629 \u0627\u0644\u0646\u0628\u064a \u0645\u062d\u0645\u062f \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0639\u0644\u0627\u0646\u0627\u062a \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u062d\u062f\u064a\u062b \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0642\u062f\u064a\u0645 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0644\u0639\u0631\u0636 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0627\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0648\u0633\u0637\u0649 \u0627\u0644\u0645\u062a\u0623\u062e\u0631\u0629 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0631\u0628 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0631\u0633 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0637\u0627\u0644\u0639 \u0623\u064a\u0636\u0627\u064b \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0642\u0648\u0627\u0644\u0628 \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e/\u0644\u0648\u0646 \u0645 \u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0643\u0644\u064a\u0629_\u0639\u0644\u0648\u0645_\u0627\u0644\u062a\u0627\u0631\u064a\u062e&oldid=7788 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0627\u0644\u0643\u0644\u064a\u0627\u062a \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0635\u0646\u064a\u0641 : \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

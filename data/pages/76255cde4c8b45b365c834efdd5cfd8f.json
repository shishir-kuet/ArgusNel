  "url": "http://ar.wikiversity.org/wiki/%D8%AE%D8%A7%D8%B5:%D8%B9%D8%AF%D9%84_%D8%A7%D9%84%D8%B5%D9%81%D8%AD%D8%A9/%D9%88%D8%AD%D8%AF%D8%A9:Yesno/%D8%B4%D8%B1%D8%AD",
  "title": "\u062a\u0639\u062f\u064a\u0644 \u0648\u062d\u062f\u0629:Yesno/\u0634\u0631\u062d - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u062a\u0639\u062f\u064a\u0644 \u0648\u062d\u062f\u0629:Yesno/\u0634\u0631\u062d - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u062a\u062d\u0630\u064a\u0631: \u0623\u0646\u062a \u063a\u064a\u0631 \u0645\u0633\u062c\u0644 \u0627\u0644\u062f\u062e\u0648\u0644. \u0628\u0645\u062c\u0631\u062f \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u0639\u062f\u064a\u0644\u060c \u0633\u064a\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0645\u0624\u0642\u062a \u0644\u0643. \u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0627\u0644\u0645\u0632\u064a\u062f . \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0623\u0648 \u0625\u0646\u0634\u0627\u0621 \u062d\u0633\u0627\u0628 \u0644\u0645\u0648\u0627\u0635\u0644\u0629 \u062a\u0644\u0642\u064a \u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a \u0628\u0639\u062f \u0627\u0646\u062a\u0647\u0627\u0621 \u0635\u0644\u0627\u062d\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u062d\u0633\u0627\u0628\u060c \u0648\u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u064a\u0632\u0627\u062a \u0623\u062e\u0631\u0649. \u0627\u062e\u062a\u0628\u0627\u0631 \u0636\u062f \u0627\u0644\u0633\u064f\u0651\u062e\u0627\u0645. \u0644\u0627 \u062a\u0645\u0644\u0623 \u0647\u0630\u0627! {{\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u0633\u0639|+76}}\n<!--\u064a\u0631\u062c\u0649 \u0648\u0636\u0639 \u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0623\u0633\u0641\u0644 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0648\u0648\u0635\u0644\u0627\u062a \u0627\u0644\u0644\u063a\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a -->\n== \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 ==\n\n{{#ifeq:{{SUBPAGENAME}}|\u0645\u0644\u0639\u0628| |\n<!-- \u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0623\u0633\u0641\u0644 \u0647\u0630\u0627 \u0627\u0644\u0633\u0637\u0631 \u0648\u0648\u0635\u0644\u0627\u062a \u0627\u0644\u0644\u063a\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a -->\n\n}} \u0645\u0644\u062e\u0635 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u064a\u0639\u0646\u064a \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0645\u0641\u062a\u0627\u062d \u00ab\u0646\u0634\u0631 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a\u00bb \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0634\u0631\u0648\u0637 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u060c \u0648\u064a\u062a\u0636\u0645\u064e\u0651\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0646\u0634\u0631 \u0627\u0644\u0645\u0633\u0627\u0647\u0645\u0629 \u0646\u0634\u0631\u064b\u0627 \u0644\u0627 \u064a\u064f\u0645\u0643\u0650\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646\u0647 \u062a\u062d\u062a \u0631\u062e\u0635\u0629 \u0627\u0644\u0645\u0634\u0627\u0639 \u0627\u0644\u0625\u0628\u062f\u0627\u0639\u064a \u0627\u0644\u0645\u064f\u0644\u0632\u0650\u0645\u0629 \u0628\u0646\u0633\u0628 \u0627\u0644\u0639\u0645\u0644 \u0644\u0644\u0645\u0624\u0644\u0650\u0651\u0641 \u0648\u0628\u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0645\u0634\u062a\u0642\u0627\u062a \u0628\u0627\u0644\u0645\u062b\u0644 4.0 \u0648 \u0631\u062e\u0635\u0629 \u062c\u0646\u0648 \u0644\u0644\u0648\u062b\u0627\u0626\u0642 \u0627\u0644\u062d\u0631\u0629 . \u0625\u0644\u063a\u0627\u0621 \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u062a\u062d\u0631\u064a\u0631 (\u062a\u0641\u062a\u062d \u0641\u064a \u0646\u0627\u0641\u0630\u0629 \u062c\u062f\u064a\u062f\u0629) \u0645\u0639\u0627\u064a\u0646\u0629 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u0639 \u0647\u0630\u0627 \u0627\u0644\u0642\u0627\u0644\u0628 | [] [[]] [[|]] {{}} {{|}} {{{}}} \u060c \u061b \u2013 \u2014 \u201c\u201d \u2018\u2019 \u00ab\u00bb \u2039\u203a \u201e\u201c \u201a\u2018 \u00b7 \u2022 \u00d7 \u00b0 ! \u00a7 ~~~~ {{\u062b\u0628\u062a \u0627\u0644\u0645\u0631\u0627\u062c\u0639}} [[\u062a\u0635\u0646\u064a\u0641:]] [[\u0645\u0644\u0641:]] [[\u0645\u064a\u062f\u064a\u0627:]] {{DEFAULTSORT:}} {{\u0646\u0637\u0627\u0642}} {{\u0627\u0633\u0645 \u0627\u0644\u0635\u0641\u062d\u0629}} #\u062a\u062d\u0648\u064a\u0644 [[]] <references/> <ref></ref> <s></s> <small></small> <sup></sup> <sub></sub> <code></code> <ref name=\"\" /> <ref name=\"\"></ref> <div dir=ltr></div> <nowiki></nowiki> <includeonly></includeonly> <noinclude></noinclude> <!--  --> <br/> \u00a1 \u00bf \u00a6 \u2020 \u2021 \u2190 \u2192 \u2191 \u2193 \u2196 \u2197 \u2198 \u2199 \u2194 \u21d0 \u21d1 \u21d2 \u21d3 \u21d4 \u2026 \u00b7 \u2022 \u00b6 \u00bd \u2153 \u2154 \u00bc \u00be \u215b \u215c \u215d \u215e \u0e3f \u00a2 $ \u20ac \u20ad \u00a3 \u20a6 \u00a5 \u20a9 \u20aa \u2713 \u2717 \u2640 \u2642 \u00b1 \u2212 \u00d7 \u00f7 \u22c5 \u221a \u2260 \u2264 \u2265 \u2261 \u223c \u2248 \u221e \u2205 \u00a7 \u00a9 \u00ae \u2122 \u0627 \u0628 \u062a \u062b \u062c \u062d \u062e \u062f \u0630 \u0631 \u0632 \u0633 \u0634 \u0635 \u0636 \u0637 \u0638 \u0639 \u063a \u0641 \u0642 \u0643 \u0644 \u0645 \u0646 \u0647 \u0648 \u064a \u0652 \u0651 \u064e \u064f \u0650 \u064b \u064c \u064d \u0670 \u0640 \u0622 \u0623 \u0625 \u0621 \u0624 \u0626 \u0649 \u0629 \u067e \u0686 \u0698 \u06af \u06ad \u06a4 \u06a0 \u06f0 \u06f1 \u06f2 \u06f3 \u0664 \u0665 \u0666 \u0667 \u06f8 \u06f9 \u05d0 \u05d1 \u05d2 \u05d3 \u05d4 \u05d5 \u05d6 \u05d7 \u05d8 \u05d9 \u05db \u05da \u05dc \u05de \u05dd \u05e0 \u05df \u05e1 \u05e2 \u05e4 \u05e3 \u05e6 \u05e5 \u05e7 \u05e8 \u05e9 \u05ea \u05be \u05f4 \u05f3 \u05b0 \u05b1 \u05b2 \u05b3 \u05b4 \u05b5 \u05b6 \u05b7 \u05b9 \u05b8 \u05bb \u05bc \u00c1 \u00e1 \u0106 \u0107 \u00c9 \u00e9 \u00cd \u00ed \u00d3 \u00f3 \u015a \u015b \u00da \u00fa \u00dd \u00fd \u01fe \u01ff \u00b7 \u00c0 \u00e0 \u00c8 \u00e8 \u00cc \u00ec \u00d2 \u00f2 \u00d9 \u00f9 \u00b7 \u00c2 \u00e2 \u0108 \u0109 \u00ca \u00ea \u011c \u011d \u0124 \u0125 \u00ce \u00ee \u0134 \u0135 \u00d4 \u00f4 \u015d \u015c \u00db \u00fb \u00b7 \u00c4 \u00e4 \u00cb \u00eb \u00cf \u00ef \u00d6 \u00f6 \u00dc \u00fc \u00ff \u00b7 \u00c3 \u00e3 \u00d1 \u00f1 \u00d5 \u00f5 \u00b7 \u00c5 \u00e5 \u00b7 \u00c7 \u00e7 \u00b7 \u010c \u010d \u0160 \u0161 \u016d \u00b7 \u0141 \u0142 \u00b7 \u0150 \u0151 \u0170 \u0171 \u00b7 \u00d8 \u00f8 \u00b7 \u0100 \u0101 \u0112 \u0113 \u012a \u012b \u014c \u014d \u016a \u016b \u00b7 \u00df \u00b7 \u00c6 \u00e6 \u0152 \u0153 \u00b7 \u00d0 \u00f0 \u00de \u00fe | \u0391 \u0386 \u0392 \u0393 \u0394 \u0395 \u0388 \u0396 \u0397 \u0389 \u0398 \u0399 \u038a \u039a \u039b \u039c \u039d \u039e \u039f \u038c \u03a0 \u03a1 \u03a3 \u03a4 \u03a5 \u038e \u03a6 \u03a7 \u03a8 \u03a9 \u038f \u00b7 \u03b1 \u03ac \u03b2 \u03b3 \u03b4 \u03b5 \u03ad \u03b6 \u03b7 \u03ae \u03b8 \u03b9 \u03af \u03ba \u03bb \u03bc \u03bd \u03be \u03bf \u03cc \u03c0 \u03c1 \u03c3 \u03c2 \u03c4 \u03c5 \u03cd \u03c6 \u03c7 \u03c8 \u03c9 \u03ce \u0410 \u0411 \u0412 \u0413 \u0490 \u0403 \u0414 \u0402 \u0415 \u0400 \u0401 \u0404 \u0416 \u0417 \u0405 \u0418 \u040d \u0419 \u0406 \u0407 \u0408 \u041a \u040c \u041b \u0409 \u041c \u041d \u040a \u041e \u041f \u0420 \u0421 \u0422 \u040b \u0423 \u040e \u0424 \u0425 \u0426 \u0427 \u040f \u0428 \u0429 \u042a \u042b \u042c \u042d \u042e \u042f \u00b7 \u0430 \u0431 \u0432 \u0433 \u0491 \u0453 \u0434 \u0452 \u0435 \u0450 \u0451 \u0454 \u0436 \u0437 \u0455 \u0438 \u045d \u0439 \u0456 \u0457 \u0458 \u043a \u045c \u043b \u0459 \u043c \u043d \u045a \u043e \u043f \u0440 \u0441 \u0442 \u045b \u0443 \u045e \u0444 \u0445 \u0446 \u0447 \u045f \u0448 \u0449 \u044a \u044b \u044c \u044d \u044e \u044f \u0288 \u0256 \u025f \u0261 \u0262 \u02a1 \u0294 \u00b7 \u0278 \u0283 \u0292 \u0255 \u0291 \u0282 \u0290 \u029d \u0263 \u0281 \u0295 \u029c \u02a2 \u0266 \u00b7 \u0271 \u0273 \u0272 \u014b \u0274 \u00b7 \u028b \u0279 \u027b \u0270 \u00b7 \u0299 \u0280 \u027e \u027d \u00b7 \u026b \u026c \u026e \u027a \u026d \u028e \u029f \u00b7 \u0265 \u028d \u0267 \u00b7 \u0253 \u0257 \u0284 \u0260 \u029b \u00b7 \u0298 \u01c0 \u01c3 \u01c2 \u01c1 \u00b7 \u0268 \u0289 \u026f \u00b7 \u026a \u028f \u028a \u00b7 \u0258 \u0275 \u0264 \u00b7 \u0259 \u025a \u00b7 \u025b \u025c \u025d \u025e \u028c \u0254 \u00b7 \u0250 \u0276 \u0251 \u0252 \u00b7 \u02b0 \u02b7 \u02b2 \u02e0 \u02e4 \u207f \u02e1 \u00b7 \u02c8 \u02cc \u02d0 \u02d1 \u203f \u0644\u0648 \u0644\u0645 \u062a\u0643\u0646 \u062a\u0631\u064a\u062f \u0644\u0643\u062a\u0627\u0628\u0627\u062a\u0643 \u0623\u0646 \u062a\u0639\u062f\u0644 \u0648\u064a\u0639\u0627\u062f \u062a\u0648\u0632\u064a\u0639\u0647\u0627\u060c \u0641\u0644\u0627 \u062a\u0636\u0639\u0647\u0627 \u0647\u0646\u0627. \u0644\u0627 \u062a\u0636\u0639 \u0623\u064a \u0646\u0635 \u0644\u064a\u0633 \u0645\u0644\u0643\u0643 \u0648\u0644\u0627 \u062a\u0645\u0644\u0643 \u062a\u0635\u0631\u064a\u062d\u0627 \u0628\u0648\u0636\u0639\u0647 \u0648\u0641\u0642 \u0634\u0631\u0648\u0637 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u060c \u0648\u0623\u0646\u062a \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u062a\u0628\u0627\u0639 \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0631\u062e\u0635\u0629 . \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0641\u064a \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629: \u0644\u0627\u062a\u0646\u0633\u062e \u0634\u064a\u0626\u0627\u064b \u0645\u0646 \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0644\u062a\u062c\u0631\u0628\u0629 \u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0646\u0635\u0648\u0635\u060c \u0627\u0633\u062a\u062e\u062f\u0645 \u0633\u0627\u062d\u0629 \u0627\u0644\u062a\u062c\u0631\u0628\u0629 . \u0644\u0627 \u062a\u0646\u0633\u062e \u0623\u064a \u0646\u0635 \u0630\u0627 \u062d\u0642\u0648\u0642 \u062a\u0623\u0644\u064a\u0641 \u0633\u0628\u0642 \u0646\u0634\u0631\u0647 \u060c \u0648\u0644\u0643\u0646 \u0627\u0643\u062a\u0628 \u0628\u0623\u0633\u0644\u0648\u0628\u0643 \u0648\u0623\u0643\u062f \u0645\u0642\u0648\u0644\u0627\u062a\u0643 \u0628\u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u062e\u0635\u0648\u0635\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0623\u0648 \u062a\u062d\u0644\u064a\u0644\u0627\u062a \u062c\u062f\u064a\u062f\u0629. \u064a\u0645\u0643\u0646\u0643 \u0623\u0646 \u062a\u0646\u0627\u0642\u0634 \u0645\u0627 \u064a\u0631\u062f \u0641\u064a \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u0644\u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0641\u064a \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0646\u0642\u0627\u0634\u061b \u0644\u0643\u0646 \u0644\u0627 \u062a\u062d\u0630\u0641 \u0643\u0644 \u0631\u0623\u064a \u0644\u0627 \u062a\u0639\u062a\u0642\u062f \u0628\u0647 \u0648\u0644\u0627 \u062a\u0631\u0649 \u0635\u0648\u0627\u0628\u0647. \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0644\u0639\u0631\u0636 \u0643\u0627\u0641\u0629 \u0627\u0644\u0622\u0631\u0627\u0621 \u0648\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0644\u064a\u0633\u062a \u0633\u0627\u062d\u0629 \u0639\u0642\u0627\u0626\u062f\u064a\u0629 \u0623\u0648 \u0645\u0630\u0647\u0628\u064a\u0629 \u060c \u0625\u0630\u0627 \u0648\u062c\u062f\u062a \u0631\u0623\u064a\u0627 \u0644\u0645 \u064a\u0639\u062c\u0628\u0643 \u0641\u0636\u0639 \u0627\u0644\u0631\u0623\u064a \u0627\u0644\u0622\u062e\u0631 \u0648\u0627\u062f\u0639\u0645\u0647 \u0628\u0627\u0644\u0634\u0648\u0627\u0647\u062f \u0648\u0627\u0644\u0645\u0635\u0627\u062f\u0631 . \u0644\u0627 \u062a\u0646\u0633 \u0623\u0646 \u062a\u0648\u0642\u0639 \u0641\u064a \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0646\u0642\u0627\u0634 \u0628\u0643\u062a\u0627\u0628\u0629 ~~~~ \u0644\u0643\u0646 \u0644\u0627 \u062a\u062d\u0627\u0648\u0644 \u0627\u0644\u062a\u0648\u0642\u064a\u0639 \u0641\u064a \u0646\u0635 \u0627\u0644\u0645\u0642\u0627\u0644\u0629 \u0644\u0623\u0646 \u0627\u0644\u0645\u0642\u0627\u0644\u0629 \u0644\u064a\u0633\u062a \u0645\u0644\u0643\u0627 \u0644\u0623\u062d\u062f. \u0635\u0641\u062d\u0627\u062a \u0645\u062a\u0636\u0645\u0646\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629: \u0642\u0627\u0644\u0628:Noprint ( \u0639\u062f\u0644 ) \u0642\u0627\u0644\u0628:\u0627\u0633\u062a\u0628\u062f\u0644 ( \u0639\u062f\u0644 ) \u0642\u0627\u0644\u0628:\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0627\u0633\u0639 ( \u0639\u062f\u0644 ) \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0631\u0633\u0627\u0644\u0629 \u0623\u062e\u0631\u0649 ( \u0639\u0631\u0636 \u0627\u0644\u0645\u0635\u062f\u0631 ) (\u062d\u0645\u0627\u064a\u0629 \u062c\u0632\u0626\u064a\u0629) \u0648\u062d\u062f\u0629:Arguments with aliases ( \u0639\u062f\u0644 ) \u0648\u062d\u062f\u0629:Check for unknown parameters ( \u0639\u062f\u0644 ) \u0648\u062d\u062f\u0629:Message box ( \u0639\u062f\u0644 ) \u0648\u062d\u062f\u0629:Message box/configuration ( \u0639\u062f\u0644 ) \u0648\u062d\u062f\u0629:Message box/ombox.css ( \u0639\u062f\u0644 ) \u0648\u062d\u062f\u0629:String ( \u0639\u062f\u0644 ) \u0648\u062d\u062f\u0629:Yesno ( \u0639\u062f\u0644 ) \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u062a\u0635\u0646\u064a\u0641 \u0645\u062e\u0641\u064a \u0648\u0627\u062d\u062f: \u062a\u0635\u0646\u064a\u0641:\u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0642\u0648\u0627\u0644\u0628 \u0628\u0648\u0633\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/wiki/\u0648\u062d\u062f\u0629:Yesno/\u0634\u0631\u062d \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0639\u062f\u064a\u0644 \u0648\u062d\u062f\u0629:Yesno/\u0634\u0631\u062d \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0
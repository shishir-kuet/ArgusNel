{
  "url": "http://avtor.karelia.ru/about/veresov_dmitrii.html",
  "title": "\u00c2\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00c0\u00ed\u00e0\u00f2\u00ee\u00eb\u00fc\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00c2\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00c0\u00ed\u00e0\u00f2\u00ee\u00eb\u00fc\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00c2\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00c0\u00ed\u00e0\u00f2\u00ee\u00eb\u00fc\u00e5\u00e2\u00e8\u00f7 \u00c4\u00e0\u00f2\u00e0 \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: 18.06.1962 \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00cf\u00ee\u00fd\u00f2, \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea, \u00f1\u00f6\u00e5\u00ed\u00e0\u00f0\u00e8\u00f1\u00f2.\u00a0\u00d7\u00eb\u00e5\u00ed \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00d1\u00ee\u00fe\u00e7\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00f1 1996 \u00e3\u00ee\u00e4\u00e0.\u00a0\u00cf\u00e5\u00f7\u00e0\u00f2\u00e0\u00e5\u00f2\u00f1\u00ff \u00f1 1982 \u00e3\u00ee\u00e4\u00e0. \u00cf\u00ee\u00f1\u00eb\u00e5 \u00ee\u00ea\u00ee\u00ed\u00f7\u00e0\u00ed\u00e8\u00ff \u00f8\u00ea\u00ee\u00eb\u00fb \u00f1\u00eb\u00f3\u00e6\u00e8\u00eb \u00e2 \u00e0\u00f0\u00ec\u00e8\u00e8. \u00ce\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e9 \u00e8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2 \u00e8\u00ec. \u00c3\u00ee\u00f0\u00fc\u00ea\u00ee\u00e3\u00ee \u00e2 1991 \u00e3\u00ee\u00e4\u00f3. \u00d1 1992 \u00ef\u00ee 1997 \u00e3\u00ee\u00e4\u00fb \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00e2 \u00c8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00e5 \u00cf\u00e5\u00f2\u00f0\u00c3\u00d3.\u00a0\u00d1 1998 \u00ef\u00ee 2007 \u2013 \u00e2 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e5 \"\u00d1\u00e5\u00e2\u00e5\u00f0\". \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f1\u00f6\u00e5\u00ed\u00e0\u00f0\u00e8\u00e5\u00e2 \u00f2\u00e5\u00eb\u00e5\u00e2\u00e8\u00e7\u00e8\u00ee\u00ed\u00ed\u00fb\u00f5 \u00f5\u00f3\u00e4\u00ee\u00e6\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00f5 \u00f4\u00e8\u00eb\u00fc\u00ec\u00ee\u00e2 (\u00ab\u00cf\u00ee\u00e2\u00f2\u00ee\u00f0\u00e5\u00ed\u00e8\u00e5 \u00ef\u00f0\u00ee\u00e9\u00e4\u00e5\u00ed\u00ed\u00ee\u00e3\u00ee\u00bb, \u00ea \u00f1\u00e5\u00f0\u00e8\u00e0\u00eb\u00f3 \u00ab\u00d3\u00eb\u00e8\u00f6\u00fb \u00f0\u00e0\u00e7\u00e1\u00e8\u00f2\u00fb\u00f5 \u00f4\u00ee\u00ed\u00e0\u00f0\u00e5\u00e9\u00bb, \u00ab\u00cc\u00ee\u00f0\u00f1\u00ea\u00e8\u00e5 \u00e4\u00fc\u00ff\u00e2\u00ee\u00eb\u00fb\u00bb).\u00a0\u00c6\u00e8\u00e2\u00e5\u00f2 \u00e2 \u00e3. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5. \u00cb\u00e0\u00f3\u00f0\u00e5\u00e0\u00f2 \u00ef\u00f0\u00e5\u00ec\u00e8\u00e8 \u00ab\u00d1\u00e0\u00ec\u00ef\u00ee\u00bb \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00e2 2011 \u00e3\u00ee\u00e4\u00f3\u00a0\u00e7\u00e0 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5 \u00ea\u00ed\u00e8\u00e3\u00e8 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00ab\u00ce\u00f2\u00f1\u00f2\u00f3\u00ef\u00eb\u00e5\u00ed\u00e8\u00e5 \u00e2 \u00ee\u00f1\u00e5\u00ed\u00fc\u00bb \u00e8 \u00ef\u00ee\u00fd\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e9 \u00f7\u00e0\u00f1\u00f2\u00e8 \u00f4\u00ee\u00f2\u00ee\u00e0\u00eb\u00fc\u00e1\u00ee\u00ec\u00e0 \u00ab\u00d1\u00ee\u00eb\u00ee\u00e2\u00ea\u00e8. \u00d1\u00ee\u00f2\u00e2\u00ee\u00f0\u00e5\u00ed\u00e8\u00e5 \u00ee\u00f1\u00e5\u00ed\u00e8\u00bb.\u00a0\u00c7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e0\u00e1\u00ee\u00f2\u00ed\u00e8\u00ea \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff (2014). \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 : \u00e1\u00e8\u00ee\u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00ee\u00e2\u00e0\u00f0\u00fc / \u00ca\u00e0\u00f0\u00e5\u00eb. \u00ed\u00e0\u00f3\u00f7. \u00d6\u00e5\u00ed\u00f2\u00f0 \u00d0\u00c0\u00cd, \u00c8\u00ed-\u00f2 \u00ff\u00e7\u00fb\u00ea\u00e0, \u00eb\u00e8\u00f2. \u00e8 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8, \u00cc-\u00e2\u00ee \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e8 \u00ef\u00ee \u00f1\u00e2\u00ff\u00e7\u00ff\u00ec \u00f1 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00f1\u00f2\u00fc\u00fe ; [\u00f1\u00ee\u00f1\u00f2. \u00de. \u00c8. \u00c4\u00fe\u00e6\u00e5\u00e2 ]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2006. - \u00d1. 84. - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 67-68. \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 \u00c8. \u00c8.\u00a0\u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2: \u00ab\u00ca\u00ee\u00e3\u00e4\u00e0 \u00e5\u00f1\u00f2\u00fc \u00e2\u00fb\u00f1\u00f8\u00e8\u00e9 \u00f1\u00ec\u00fb\u00f1\u00eb, \u00e2\u00f1\u00b8 \u00ef\u00f0\u00e5\u00ee\u00e1\u00f0\u00e0\u00e6\u00e0\u00e5\u00f2\u00f1\u00ff\u00bb (27. 06. 2014) [\u00d2\u00e5\u00ea\u00f1\u00f2 : \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e5\u00f1\u00f3\u00f0\u00f1] // \u00cb\u00e8\u00f6\u00e5\u00e9, \u00e8\u00ed\u00f2\u00e5\u00f0\u00ed\u00e5\u00f2-\u00e6\u00f3\u00f0\u00ed\u00e0\u00eb. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00cb\u00e8\u00f6\u00e5\u00e9, 2007 - . URL: http://gazeta-licey.ru/public/lyceumconversation/22891-dmitriy-veresov-kogda-est-vyisshiy-smyisl-vsyo-preobrazhaetsya \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 68-71. \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00c8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ec\u00ee\u00e6\u00ed\u00ee \u00ef\u00f0\u00e8\u00ee\u00e1\u00f0\u00e5\u00f1\u00f2\u00e8 \u00e2 \u00ea\u00ed\u00e8\u00e6\u00ed\u00ee\u00ec \u00ea\u00e8\u00ee\u00f1\u00ea\u00e5 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00d1\u00f2\u00e8\u00f5\u00e8 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00ff \u00c2\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2\u00e0 \u00f7\u00e8\u00f2\u00e0\u00e5\u00f2 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c1\u00e0\u00f3\u00eb\u00e8\u00ed \u00cf\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00e8\u00e7 \u00e0\u00f3\u00e4\u00e8\u00ee\u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0 \u00ab\u00dd\u00f4\u00f4\u00e5\u00ea\u00f2 \u00c4\u00ee\u00ef\u00eb\u00e5\u00f0\u00e0\u00bb \u00d1\u00f2\u00e8\u00f5\u00e8 \u00e8\u00e7 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00ff \u00c2\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2\u00e0 \u00ab\u00d2\u00f0\u00ee\u00ef\u00ee\u00e9 \u00f2\u00e8\u00f8\u00e8\u00ed\u00fb\u00bb \u00e2 \u00e8\u00f1\u00ef\u00ee\u00eb\u00ed\u00e5\u00ed\u00e8\u00e8 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00d1\u00fa\u00b8\u00ec\u00ea\u00e0 - \u00ca. \u00cc\u00e0\u00ea\u00f1\u00e8\u00ec\u00ee\u00e2. \u00cc\u00ee\u00ed\u00f2\u00e0\u00e6 - \u00cd. \u00ca\u00ee\u00f8\u00ea\u00e8\u00ed. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c4\u00e2\u00e0 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00e0 \u00c2\u00e4\u00ee\u00f5\u00ed\u00ee\u00e2\u00e5\u00ed\u00e8\u00e5 \u0096 \u00fd\u00f2\u00ee \u00ea\u00e0\u00ea \u00e2\u00e4\u00ee\u00f5... \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

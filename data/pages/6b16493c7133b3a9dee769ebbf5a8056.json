  "url": "http://ar.wikibooks.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D8%A7%D9%84%D8%AA%D8%B5%D9%86%D9%8A%D9%81_%D8%A7%D9%84%D8%B1%D8%A6%D9%8A%D8%B3%D9%8A",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0631\u0626\u064a\u0633\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0631\u0626\u064a\u0633\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0647\u0646\u0627\u0643 \u0645\u0644\u0641\u0627\u062a \u0639\u0646 CommonsRoot \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 . \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u064a\u062d\u0648\u064a 10 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629\u060c \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a 10. \u0625 \u0625\u0646\u0633\u0627\u0646\u064a\u0627\u062a (10 \u062a\u060c  5 \u0635) \u062b \u062b\u0642\u0627\u0641\u0629 (3 \u062a\u060c  1 \u0635) \u0639 \u0639\u0644\u0648\u0645 \u0648\u062a\u0642\u0646\u064a\u0629 (2 \u062a) \u0641 \u0641\u0646\u0648\u0646 (3 \u062a\u060c  5 \u0635) \u0642 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0643\u062a\u0628 ( 54 \u0635) \u0645 \u0645\u0624\u0644\u0641\u0648\u0646 (7 \u062a\u060c  1 \u0635) \u0645\u0634\u0627\u0631\u064a\u0639 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 (\u0641\u0627\u0631\u063a) \u0648 \u0648\u064a\u0643\u064a \u0627\u0644\u0623\u0637\u0641\u0627\u0644 (11 \u062a\u060c  89 \u0635) \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 (\u0641\u0627\u0631\u063a) \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 (70 \u062a\u060c  32 \u0635) \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u062a\u0635\u0646\u064a\u0641_\u0627\u0644\u0631\u0626\u064a\u0633\u064a&oldid=96326 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0635\u0646\u064a\u0641 : \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0631\u0626\u064a\u0633\u064a \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

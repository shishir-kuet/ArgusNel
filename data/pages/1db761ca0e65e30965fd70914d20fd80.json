{
  "url": "http://avtor.karelia.ru/about/agapitov_vyacheslav.html",
  "title": "\u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e5\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e5\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e5\u00e5\u00e2\u00e8\u00f7 \u00c4\u00e0\u00f2\u00e0 \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: 22.10.1952 \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e4. \u00cb\u00e0\u00ec\u00e1\u00e0\u00f1\u00f0\u00f3\u00f7\u00e5\u00e9 \u00cc\u00e5\u00e4\u00e2\u00e5\u00e6\u00fc\u00e5\u00e3\u00ee\u00f0\u00f1\u00ea\u00ee\u00e3\u00ee \u00f0\u00e0\u00e9\u00ee\u00ed\u00e0  \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00cf\u00ee\u00fd\u00f2, \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea-\u00ef\u00e5\u00e9\u00e7\u00e0\u00e6\u00e8\u00f1\u00f2, \u00ea\u00f0\u00e0\u00e5\u00e2\u00e5\u00e4, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc, \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00e9 \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc. \u00d7\u00eb\u00e5\u00ed \u00d1\u00ee\u00fe\u00e7\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00f1 2004 \u00e3\u00ee\u00e4\u00e0 \u00e8 \u00d2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00ea\u00ee\u00ad\u00e3\u00ee \u00f1\u00ee\u00fe\u00e7\u00e0 \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea\u00ee\u00e2 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00f1 2003 \u00e3\u00ee\u00e4\u00e0. \u00a0\u00d1 1998 \u00e3\u00ee\u00e4\u00e0 \u00ef\u00e8\u00f8\u00e5\u00f2 \u00f1\u00f2\u00e8\u00f5\u00e8 \u00ed\u00e0 \u00e7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00ee\u00ec \u00e4\u00e8\u00e0\u00eb\u00e5\u00ea\u00f2\u00e5. \u00d1 2008 \u00e3\u00ee\u00e4\u00e0 \u2013 \u00ef\u00f0\u00e5\u00e4\u00f1\u00e5\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc \u00ef\u00f0\u00e0\u00e2\u00eb\u00e5\u00ed\u00e8\u00ff \u00ca\u00d0\u00ce\u00ce \u00f0\u00f3\u00f1\u00f1\u00ea\u00ee\u00e9 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00ab\u00d0\u00d3\u00d1\u00d1\u00ca\u00c8\u00c9 \u00d1\u00c5\u0412\u00c5\u00d0\u00bb \u00e8 \u00f1\u00ee\u00ef\u00f0\u00e5\u00e4\u00f1\u00e5\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e3\u00ee \u00e4\u00e2\u00e8\u00e6\u00e5\u00ed\u00e8\u00ff \u00ab\u00c7\u00c0\u00ce\u00cd\u00c5\u00c6\u00dc\u00c5\u00bb. \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2 \u2013 \u00e0\u00e2\u00f2\u00ee\u00f0 \u00e1\u00ee\u00eb\u00e5\u00e5 \u00e4\u00e2\u00e0\u00e4\u00f6\u00e0\u00f2\u00e8 \u00f1\u00f2\u00e0\u00f2\u00e5\u00e9 \u00ef\u00ee \u00f2\u00ee\u00ef\u00ee\u00ed\u00e8\u00ad\u00ec\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00e8 \u00ed\u00e0\u00f3\u00f7\u00ed\u00ee-\u00ef\u00ee\u00ef\u00f3\u00eb\u00ff\u00f0\u00ed\u00ee\u00e9 \u00ea\u00ed\u00e8\u00e3\u00e8 \u00ab\u00cf\u00f3\u00f2\u00e5\u00f8\u00e5\u00f1\u00f2\u00e2\u00e8\u00e5 \u00e2 \u00e4\u00f0\u00e5\u00e2\u00ed\u00e8\u00e5 \u00ca\u00e8\u00e6\u00e8\u00bb. \u0412 1972 \u00e3\u00ee\u00e4\u00f3 \u00ef\u00ee\u00f1\u00f2\u00f3\u00ef\u00e8\u00eb \u00ed\u00e0 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea\u00ee-\u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f4\u00e0\u00ea\u00f3\u00eb\u00fc\u00f2\u00e5\u00f2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00ad\u00e3\u00ee \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e3\u00ee \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2\u00e0. \u00d1 1980 \u00e3\u00ee\u00e4\u00e0 \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00e2 \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2\u00ed\u00ee\u00ec \u00e8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e5 \u00e7\u00e0\u00e2\u00ee\u00e4\u00e0 \u00ab\u00d2\u00ff\u00e6\u00e1\u00f3\u00ec\u00ec\u00e0\u00f8\u00bb. \u00c4\u00e5\u00f1\u00ff\u00f2\u00fc \u00eb\u00e5\u00f2 \u2013 \u00e2 \u00ec\u00f3\u00e7\u00e5\u00e5-\u00e7\u00e0\u00ef\u00ee\u00e2\u00e5\u00e4\u00ed\u00e8\u00ea\u00e5 \u00ab\u00ca\u00e8\u00e6\u00e8\u00bb, \u00e7\u00e0\u00f2\u00e5\u00ec \u00eb\u00e0\u00e1\u00ee\u00f0\u00e0\u00ed\u00f2\u00ee\u00ec \u00e8 \u00ed\u00e0\u00ad\u00f3\u00f7\u00ed\u00fb\u00ec \u00f1\u00ee\u00f2\u00f0\u00f3\u00e4\u00ed\u00e8\u00ea\u00ee\u00ec \u00f1\u00e5\u00ea\u00f2\u00ee\u00f0\u00e0 \u00fd\u00f2\u00ed\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e8 \u00a0\u00c8\u00df\u00cb\u00c8 \u00ca\u00e0\u00f0\u00cd\u00d6 \u00d0\u00c0\u00cd. \u00d1 \u00e4\u00e5\u00ea\u00e0\u00e1\u00f0\u00ff 1991 \u00e3\u00ee\u00e4\u00e0 \u2013 \u00e2\u00e5\u00e4\u00f3\u00f9\u00e8\u00e9 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00ee-\u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00f1\u00e0\u00eb\u00ee\u00ed\u00e0 \u00e2 \u00f1\u00e0\u00ed\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 \u00ab\u00cc\u00e0\u00f0\u00f6\u00e8\u00e0\u00eb\u00fc\u00ed\u00fb\u00e5 \u0412\u00ee\u00e4\u00fb\u00bb. \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 : \u00e1\u00e8\u00ee\u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00ee\u00e2\u00e0\u00f0\u00fc / \u00ca\u00e0\u00f0\u00e5\u00eb. \u00ed\u00e0\u00f3\u00f7. \u00d6\u00e5\u00ed\u00f2\u00f0 \u00d0\u00c0\u00cd, \u00c8\u00ed-\u00f2 \u00ff\u00e7\u00fb\u00ea\u00e0, \u00eb\u00e8\u00f2. \u00e8 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8, \u00cc-\u00e2\u00ee \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e8 \u00ef\u00ee \u00f1\u00e2\u00ff\u00e7\u00ff\u00ec \u00f1 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00f1\u00f2\u00fc\u00fe ; [\u00f1\u00ee\u00f1\u00f2. \u00de. \u00c8. \u00c4\u00fe\u00e6\u00e5\u00e2 ]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2006. - \u00d1. 6-7. - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 21-25.- \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u0412. \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00fc\u00e5 \u00e8 \u00c7\u00c0\u00ce \"\u00d0\u00d4\" [\u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e5\u00f1\u00f3\u00f0\u00f1] : [\u00ec\u00e0\u00f2\u00e5\u00f0\u00e8\u00e0\u00eb\u00fb \u00e1\u00e5\u00f1\u00e5\u00e4\u00fb] / \u0412. \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2 ; \u00e1\u00e5\u00f1\u00e5\u00e4\u00f3 \u00e2\u00e5\u00eb \u0412\u00e0\u00e4\u00e8\u00ec \u00d8\u00f2\u00e5\u00ef\u00e0] //\u00c0\u00cf\u00cd \u00d1\u00e5\u00e2\u00e5\u00f0\u00ee-\u00c7\u00e0\u00ef\u00e0\u00e4 : [\u00f1\u00e0\u00e9\u00f2]. \u2013 2008. \u2013 13 \u00ec\u00e0\u00f0\u00f2\u00e0. \u2013 \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0: http://www.apn-spb.ru/publications/article2784.htm \u00c3\u00e8\u00ed \u00c8. \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00fc\u00e5 \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2\u00e0 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2\u00e0 //\u00a0\u00cb\u00e8\u00f6\u00e5\u00e9. - 1997.- N7-8. - \u00d1.13.- \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e2\u00e5\u00f0\u00f1\u00e8\u00ff . \u00ab\u00c4\u00f0\u00f3\u00e3\u00e0\u00e9 \u00e1\u00e5\u00f0\u00e5\u00e3\u00bb \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2\u00e0 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2\u00e0. \u00cf\u00e5\u00e9\u00e7\u00e0\u00e6\u00e8 \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00fc\u00ff [\u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e5\u00f1\u00f3\u00f0\u00f1] // \u00ca\u00ee\u00f0\u00e5\u00ed\u00ed\u00fb\u00e5 \u00ed\u00e0\u00f0\u00ee\u00e4\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8, \u00f1\u00e0\u00e9\u00f2 : \u00e0\u00f0\u00f5\u00e8\u00e2 \u00f1\u00e0\u00e9\u00f2\u00e0 \u00e7\u00e0 18.12.2009 \u00e3. \u2013\u00a0 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed. \u00e4\u00e0\u00ed. \u2013 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea, 2009. \u2013\u00a0 \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0 : http://knk.karelia.ru/2009/12/drugaj-bereg.html , \u00f1\u00e2\u00e1\u00ee\u00e4\u00ed\u00fb\u00e9. \u2013 \u00c7\u00e0\u00e3\u00eb\u00e0\u00e2\u00e8\u00e5 \u00f1 \u00fd\u00ea\u00f0\u00e0\u00ed\u00e0. \u2013 \u00ce\u00ef\u00e8\u00f1\u00e0\u00ed\u00e8\u00e5 \u00ee\u00f1\u00ed\u00ee\u00e2\u00e0\u00ed\u00ee \u00ed\u00e0 \u00e2\u00e5\u00f0\u00f1\u00e8\u00e8 \u00e4\u00e0\u00f2\u00e8\u00f0. : \u00f4\u00e5\u00e2\u00f0\u00e0\u00eb\u00fc, 05, 2016 \u00c7\u00e2\u00f3\u00f7\u00e0\u00f2 \u00f1\u00f2\u00e8\u00f5\u00e8 \u00ed\u00e0 \u00e7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00ee\u00ec \u00e4\u00e8\u00e0\u00eb\u00e5\u00ea\u00f2\u00e5... [\u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e5\u00f1\u00f3\u00f0\u00f1] // \u00ca\u00ee\u00f0\u00e5\u00ed\u00ed\u00fb\u00e5 \u00ed\u00e0\u00f0\u00ee\u00e4\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8, \u00f1\u00e0\u00e9\u00f2 : \u00e0\u00f0\u00f5\u00e8\u00e2 \u00f1\u00e0\u00e9\u00f2\u00e0 \u00e7\u00e0 3.06.2013 \u00e3. - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed. \u00e4\u00e0\u00ed. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea, 2013. - \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0 : http://knk.karelia.ru/2013/06/zvuchat-stixi-na-zaonezhskom-govore.html , \u00f1\u00e2\u00e1\u00ee\u00e4\u00ed\u00fb\u00e9. - \u00c7\u00e0\u00e3\u00eb. \u00f1 \u00fd\u00ea\u00f0\u00e0\u00ed\u00e0. \u2013 \u00ce\u00ef\u00e8\u00f1\u00e0\u00ed\u00e8\u00e5 \u00ee\u00f1\u00ed\u00ee\u00e2\u00e0\u00ed\u00ee \u00ed\u00e0 \u00e2\u00e5\u00f0\u00f1\u00e8\u00e8 \u00e4\u00e0\u00f2\u00e8\u00f0. : \u00f4\u00e5\u00e2\u00f0\u00e0\u00eb\u00fc, 05, 2016. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u0412. \u00c0. (1952). \u00c7\u00e0\u00e2\u00f2\u00f0\u00e0, \u00e2 \u00e4\u00e5\u00ed\u00fc \u00ef\u00f0\u00e5\u00ea\u00f0\u00e0\u00f1\u00ed\u00fb\u00e9 : [\u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb, \u00e1\u00e0\u00e9\u00ea\u00e8] / \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : Verso, 2011. - 102, [1] \u00f1. : \u00e8\u00eb., \u00f4\u00ee\u00f2. ; 20 \u00f1\u00ec. - \u00ca\u00ee\u00f0\u00ee\u00f2\u00ea\u00ee \u00ee\u00e1 \u00e0\u00e2\u00f2. \u00ed\u00e0 101-\u00e9 \u00f1. \u00f2\u00e5\u00ea\u00f1\u00f2\u00e0. - \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00ee\u00e2\u00ed\u00e8\u00ea : \u00f1. 99-100 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u0412. \u00c0. (1952). \u00c8\u00e7\u00ee\u00f2\u00f7\u00e8\u00ed\u00e0 : \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00e8 \u00ef\u00e5\u00f1\u00e5\u00ed / \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : Verso, 2012. - 111, [1] \u00f1. ; 20 \u00f1\u00ec. - \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00ee\u00e2\u00ed\u00e8\u00ea : \u00f1. 108-110. \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u0412. \u00c0. In a \u00c4\u00e6\u00e0\u00e7 mood / \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00d1\u00ea\u00e0\u00ed\u00e4\u00e8\u00ed\u00e0\u00e2\u00e8\u00ff, 2006. - 108 \u00f1. : \u00e8\u00eb. ; 14 \u00f1\u00ec. \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u0412. \u00c0. \u00ca\u00f0\u00f3\u00e3 \u00f1\u00e5\u00e2\u00e5\u00f0\u00ed\u00fb\u00f5 \u00ef\u00e5\u00f1\u00e5\u00ed : \u00cd\u00ee\u00ed\u00e5\u00f8\u00ed\u00e8 \u00e2\u00e8\u00f0\u00f8\u00e8 / \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e5\u00e5\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00d4\u00ee\u00eb\u00e8\u00f3\u00ec, 2002. - 32 \u00f1. \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u0412.\u00c0. \u00c1\u00e5\u00f0\u00e5\u00e3 : \u00d1\u00f2\u00e8\u00f5\u00e8 / \u0412\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00cf\u00e5\u00f0\u00e8\u00ee\u00e4\u00e8\u00ea\u00e0, 2000. - 80 \u00f1. \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u0412.\u00c0. \u00cf\u00f3\u00f2\u00e5\u00f8\u00e5\u00f1\u00f2\u00e2\u00e8\u00e5 \u00e2 \u00e4\u00f0\u00e5\u00e2\u00ed\u00e8\u00e5 \u00ca\u00e8\u00e6\u00e8 : \u00d2\u00ee\u00ef\u00ee\u00ed\u00e8\u00ec\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00ee\u00f7\u00e5\u00f0\u00ea / \u0412.\u00c0. \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2 ; \u00c3\u00ee\u00f1. \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea\u00ee-\u00e0\u00f0\u00f5\u00e8\u00f2\u00e5\u00ea\u00f2\u00f3\u00f0. \u00e8 \u00fd\u00f2\u00ed\u00ee\u00e3\u00f0. \u00ec\u00f3\u00e7\u00e5\u00e9-\u00e7\u00e0\u00ef\u00ee\u00e2\u00e5\u00e4\u00ed\u00e8\u00ea \"\u00ca\u00e8\u00e6\u00e8\". - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00e9 \u00ed\u00e0\u00f3\u00f7\u00ed\u00fb\u00e9 \u00f6\u00e5\u00ed\u00f2\u00f0 \u00d0\u00c0\u00cd, 2000. - 69 \u00f1. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00cc\u00e5\u00e4\u00e8\u00e0\u00e3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f4\u00ee\u00f2\u00ee \u00c8. \u00c3\u00e5\u00ee\u00f0\u00e3\u00e8\u00e5\u00e2\u00f1\u00ea\u00e8\u00e9 \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f4\u00ee\u00f2\u00ee \u00c8. \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f4\u00ee\u00f2\u00ee \u00c8. \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 \u00c7\u00e0 \u00ec\u00ee\u00eb\u00fc\u00e1\u00e5\u00f0\u00f2\u00ee\u00ec \u00c8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ec\u00ee\u00e6\u00ed\u00ee \u00ef\u00f0\u00e8\u00ee\u00e1\u00f0\u00e5\u00f1\u00f2\u00e8 \u00e2 \u00ea\u00ed\u00e8\u00e6\u00ed\u00ee\u00ec \u00ea\u00e8\u00ee\u00f1\u00ea\u00e5 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00e8\u00e5 \u00e1\u00e0\u00e9\u00ea\u00e8 \u00c2\u00e5\u00f7\u00e5\u00f0 \u00ed\u00e0 \u00e1\u00e5\u00f0\u00e5\u00e3 \u00e7\u00ee\u00f0\u00e5\u00e9 \u00ef\u00e0\u00e4\u00e5 \u00d1\u00f2\u00e8\u00f5\u00e8 \u00ed\u00e0 \u00e7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00ee\u00ec \u00e4\u00e8\u00e0\u00eb\u00e5\u00ea\u00f2\u00e5 \r\n\u00f1\u00e5\u00e2\u00e5\u00f0\u00ed\u00ee\u00e3\u00ee \u00ed\u00e0\u00f0\u00e5\u00f7\u00e8\u00ff \u00e2\u00e5\u00eb\u00e8\u00ea\u00ee\u00f0\u00f3\u00f1\u00f1\u00ea\u00ee\u00e3\u00ee \u00ff\u00e7\u00fb\u00ea\u00e0 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2 \u00c2\u00e8\u00e4\u00e5\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00d1\u00f2\u00e8\u00f5\u00e8 \u00ed\u00e0 \u00e7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00ee\u00ec \u00e4\u00e8\u00e0\u00eb\u00e5\u00ea\u00f2\u00e5 \u00f1\u00e5\u00e2\u00e5\u00f0\u00ed\u00ee\u00e3\u00ee \u00ed\u00e0\u00f0\u00e5\u00f7\u00e8\u00ff \u00e2\u00e5\u00eb\u00e8\u00ea\u00ee\u00f0\u00f3\u00f1\u00f1\u00ea\u00ee\u00e3\u00ee \u00ff\u00e7\u00fb\u00ea\u00e0 Virantanaz \u00d4\u00f0\u00e0\u00e3\u00ec\u00e5\u00ed\u00f2 \u00e2\u00e5\u00ef\u00f1\u00f1\u00ea\u00ee\u00e3\u00ee \u00fd\u00ef\u00ee\u00f1\u00e0 \u00abVirantanaz\u00bb. \u00cf\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4 \u00f1 \u00e2\u00e5\u00ef\u00f1\u00f1\u00ea\u00ee\u00e3\u00ee \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2\u00e0 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2\u00e0. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d2\u00e5\u00f1\u00f2\u00e5\u00ed\u00ed\u00e8\u00ea\u00e8 \u00d1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00ed\u00e0 \u00e7\u00e0\u00ee\u00ed\u00e5\u00e6\u00f1\u00ea\u00e8\u00f5 \u00e3\u00ee\u00e2\u00ee\u00f0\u00e0\u00f5. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cb\u00e8\u00f0\u00e8\u00ea\u00e0 \u00f0\u00e0\u00e7\u00ed\u00fb\u00f5 \u00eb\u00e5\u00f2 \u00cf\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00e8\u00e7 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0  \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00e8 \u00ef\u00e5\u00f1\u00e5\u00ed \u00ab\u00c8\u00e7\u00ee\u00f2\u00f7\u00e8\u00ed\u00e0\u00bb \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

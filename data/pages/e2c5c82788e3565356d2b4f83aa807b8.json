u00e0\u00eb\u00ee\u00e2\u00e8\u00f7. \u00cb\u00e5\u00ed\u00e8\u00ed\u00e3\u00f0\u00e0\u00e4 : \u00d1\u00ee\u00e2\u00ed\u00e0\u00f0\u00ea\u00ee\u00ec \u00c0\u00ca\u00d1\u00d1\u00d0, 1934. 79 \u00f1. : \u00e8\u00eb. \u00d5\u00f0\u00e0\u00ed\u00e8\u00f2\u00f1\u00ff \u00e2 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e5 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00ca\u00e0\u00f0\u00e5\u00eb\u00ee-\u00cc\u00f3\u00f0\u00ec\u00e0\u00ed\u00f1\u00ea\u00e8\u00e9 \u00ea\u00f0\u00e0\u00e9. 1934, \u00b9 3-4 Karjalan-Muurmannin seutu = \u00ca\u00e0\u00f0\u00e5\u00eb\u00ee-\u00cc\u00f3\u00f0\u00ec\u00e0\u00ed\u00f1\u00ea\u00e8\u00e9 \u00ea\u00f0\u00e0\u00e9. 1934, \u00b9 3-4 / Kustantaja KASNT: n Kansankomissaarien Neuvosto. \u00cb\u00e5\u00ed\u00e8\u00ed\u00e3\u00f0\u00e0\u00e4 : \u00d2\u00e8\u00ef\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ca\u00e8\u00f0\u00fc\u00ff\u00ef\u00e0\u00ff, 1934. 64 \u00f1. \u00d5\u00f0\u00e0\u00ed\u00e8\u00f2\u00f1\u00ff \u00e2 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e5 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00ab \u00cd\u00e0\u00e7\u00e0\u00e4 \u00cc\u00e5\u00ed\u00fe \u00f1\u00e0\u00e9\u00f2\u00e0 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00ce \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2\u00e5 \u00d3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea\u00e8 \u00d0\u00e5\u00f1\u00f3\u00f0\u00f1\u00fb \u00c2\u00fb\u00e1\u00e5\u00f0\u00e8\u00f2\u00e5 \u00f2\u00e5\u00f0\u00f0\u00e8\u00f2\u00ee\u00f0\u00e8\u00fe \u00ce \u00ed\u00e0\u00e2\u00e8\u00e3\u00e0\u00f6\u00e8\u00e8 \u00cf\u00ee\u00eb\u00e5\u00e7\u00ed\u00fb\u00e5 \u00f1\u00f1\u00fb\u00eb\u00ea\u00e8 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00ca\u00ee\u00f0\u00e5\u00ed\u00ed\u00fb\u00e5 \u00ed\u00e0\u00f0\u00ee\u00e4\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00d1\u00e2\u00ee\u00e4 \u00ed\u00ee\u00f2\u00ed\u00fb\u00f5 \u00f0\u00f3\u00ea\u00ee\u00ef\u00e8\u00f1\u00e5\u00e9 \u00ea\u00ee\u00ec\u00ef\u00ee\u00e7\u00e8\u00f2\u00ee\u00f0\u00ee\u00e2 \u00e8 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00ed\u00f2\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c2\u00fb\u00e1\u00e5\u00f0\u00e8\u00f2\u00e5 \u00f2\u00e5\u00f0\u00f0\u00e8\u00f2\u00ee\u00f0\u00e8\u00fe \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0 \u00ca\u00ee\u00ec\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0 \u00cc\u00e0\u00f0\u00e8\u00e9 \u00dd\u00eb \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0 \u00cc\u00ee\u00f0\u00e4\u00ee\u00e2\u00e8\u00ff \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0 \u00d3\u00e4\u00ec\u00f3\u00f0\u00f2\u00e8\u00ff \u00d5\u00e0\u00ed\u00f2\u00fb \u00cc\u00e0\u00ed\u00f1\u00e8\u00e9\u00f1\u00ea\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00ed\u00ee\u00ec\u00ed\u00fb\u00e9 \u00ee\u00ea\u00f0\u00f3\u00e3 \u00cc\u00f3\u00f0\u00ec\u00e0\u00ed\u00f1\u00ea\u00e0\u00ff \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00fc \u00d2\u00e2\u00e5\u00f0\u00f1\u00ea\u00e0\u00ff \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00fc \u00c2\u00ee\u00eb\u00ee\u00e3\u00ee\u00e4\u00f1\u00ea\u00e0\u00ff \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00fc \u00ca\u00ee\u00ec\u00e8-\u00cf\u00e5\u00f0\u00ec\u00ff\u00f6\u00ea\u00e8\u00e9 \u00ee\u00ea\u00f0\u00f3\u00e3 \
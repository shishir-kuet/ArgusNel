{
  "url": "http://avtor.karelia.ru/gallery/galereya_irini_larionovoi.html",
  "title": "\u00c3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00c3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00c3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9 \u00c6\u00e8\u00e7\u00e5\u00eb\u00fc \u00d4\u00f0\u00ee\u00e9\u00ed\u00e4 (1908-2000), \u00e2\u00e5\u00eb\u00e8\u00ea\u00e8\u00e9 \u00ec\u00e0\u00f1\u00f2\u00e5\u00f0 \u00f4\u00ee\u00f2\u00ee\u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2\u00e0, \u00ca\u00e0\u00e2\u00e0\u00eb\u00e5\u00f0 \u00ee\u00f0\u00e4\u00e5\u00ed\u00e0 \u00cf\u00ee\u00f7\u00e5\u00f2\u00ed\u00ee\u00e3\u00ee \u00eb\u00e5\u00e3\u00e8\u00ee\u00ed\u00e0 (\u00e2\u00fb\u00f1\u00f8\u00e0\u00ff \u00ed\u00e0\u00e3\u00f0\u00e0\u00e4\u00e0 \u00d4\u00f0\u00e0\u00ed\u00f6\u00e8\u00e8) \u00e7\u00e0 \u00f1\u00e2\u00ee\u00fe \u00e6\u00e8\u00e7\u00ed\u00fc \u00f1\u00ee\u00e7\u00e4\u00e0\u00eb\u00e0 \u00e1\u00ee\u00e3\u00e0\u00f2\u00e5\u00e9\u00f8\u00f3\u00fe \u00ea\u00ee\u00eb\u00eb\u00e5\u00ea\u00f6\u00e8\u00fe \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e9 \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00e5\u00e9 \u00e8\u00ed\u00f2\u00e5\u00eb\u00eb\u00e5\u00ea\u00f2\u00f3\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00fd\u00eb\u00e8\u00f2\u00fb. \u00ab\u2026\u00d2\u00ff\u00e3\u00ee\u00f2\u00e5\u00ff \u00f1 \u00f1\u00e0\u00ec\u00ee\u00e3\u00ee \u00ed\u00e0\u00f7\u00e0\u00eb\u00e0 \u00ea \u00e6\u00e0\u00ed\u00f0\u00f3 \u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2\u00e0, \u00c6\u00e8\u00e7\u00e5\u00eb\u00fc, \u00ed\u00e0\u00e1\u00eb\u00fe\u00e4\u00e0\u00ff \u00f2\u00fb\u00f1\u00ff\u00f7\u00e8 \u00ec\u00e5\u00eb\u00fc\u00ea\u00e0\u00fe\u00f9\u00e8\u00f5 \u00ef\u00e5\u00f0\u00e5\u00e4 \u00ed\u00e5\u00fe \u00eb\u00e8\u00f6, \u00ef\u00f0\u00e8\u00f8\u00eb\u00e0 \u00ea \u00e7\u00e0\u00ea\u00eb\u00fe\u00f7\u00e5\u00ed\u00e8\u00fe, \u00f7\u00f2\u00ee \u00e4\u00e2\u00f3\u00f5 \u00e8\u00e4\u00e5\u00ed\u00f2\u00e8\u00f7\u00ed\u00fb\u00f5 \u00f4\u00e8\u00e7\u00e8\u00ee\u00ed\u00ee\u00ec\u00e8\u00e9 \u00ed\u00e5 \u00f1\u00f3\u00f9\u00e5\u00f1\u00f2\u00e2\u00f3\u00e5\u00f2... \u00cd\u00e5 \u00f1\u00f0\u00e0\u00e7\u00f3, \u00ed\u00ee \u00ee\u00ed\u00e0 \u00ef\u00ee\u00ed\u00ff\u00eb\u00e0, \u00f7\u00f2\u00ee \u00e4\u00eb\u00ff \u00ed\u00e5\u00ea\u00ee\u00f2\u00ee\u00f0\u00fb\u00f5 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2 \u2013 \u00e5\u00e4\u00e8\u00ed\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00e0\u00ff \u00ef\u00f0\u00ff\u00ec\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00ec\u00e5\u00e6\u00e4\u00f3 \u00ed\u00e8\u00ec \u00e8 \u00f7\u00e8\u00f2\u00e0\u00f2\u00e5\u00eb\u00e5\u00ec. \u00c5\u00f1\u00eb\u00e8 \u00f7\u00e8\u00f2\u00e0\u00f2\u00e5\u00eb\u00ff \u00f2\u00f0\u00ee\u00ed\u00f3\u00eb\u00e0 \u00ea\u00ed\u00e8\u00e3\u00e0, \u00ee\u00ed \u00f1 \u00ee\u00f1\u00ee\u00e1\u00fb\u00ec \u00e8\u00ed\u00f2\u00e5\u00f0\u00e5\u00f1\u00ee\u00ec \u00e2\u00f1\u00ec\u00e0\u00f2\u00f0\u00e8\u00e2\u00e0\u00e5\u00f2\u00f1\u00ff \u00e2 \u00eb\u00e8\u00f6\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ed\u00e0 \u00ee\u00e1\u00eb\u00ee\u00e6\u00ea\u00e5. \u00c8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00e8 \u00fd\u00f2\u00ee \u00ef\u00ee\u00ed\u00ff\u00eb\u00e8 \u00ec\u00ed\u00ee\u00e3\u00ee \u00f0\u00e0\u00ed\u00fc\u00f8\u00e5, \u00f1\u00ef\u00f0\u00ee\u00f1 \u00ed\u00e0 \u00f4\u00ee\u00f2\u00ee\u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2\u00fb \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00f0\u00ee\u00f1. \u00ab\u00d4\u00ee\u00f2\u00ee \u00e4\u00eb\u00ff \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00ff \u00e8\u00ec\u00e5\u00e5\u00f2 \u00e1\u00ee\u00eb\u00fc\u00f8\u00ee\u00e5 \u00e7\u00ed\u00e0\u00f7\u00e5\u00ed\u00e8\u00e5. \u00c5\u00f1\u00f2\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee, \u00ee\u00ed \u00ef\u00f0\u00e5\u00e4\u00ef\u00ee\u00f7\u00f2\u00b8\u00f2 \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e0, \u00ea\u00ee\u00f2\u00ee\u00f0\u00ee\u00ec\u00f3 \u00ee\u00ed \u00ec\u00ee\u00e6\u00e5\u00f2 \u00e2\u00f1\u00e5\u00f6\u00e5\u00eb\u00ee \u00e4\u00ee\u00e2\u00e5\u00f0\u00e8\u00f2\u00fc\u00f1\u00ff, \u2013 \u00ef\u00e8\u00f1\u00e0\u00eb\u00e0 \u00c6\u00e8\u00e7\u00e5\u00eb\u00fc \u00d4\u00f0\u00ee\u00e9\u00ed\u00e4 \u00e2 \u00f1\u00e2\u00ee\u00e8\u00f5 \u00e2\u00ee\u00f1\u00ef\u00ee\u00ec\u00e8\u00ed\u00e0\u00ed\u00e8\u00ff\u00f5. \u2013 \u00cc\u00ed\u00ee\u00e3\u00e8\u00e5 \u00e4\u00ee\u00e2\u00e5\u00f0\u00e8\u00eb\u00e8\u00f1\u00fc \u00ec\u00ed\u00e5, \u00f1\u00f2\u00e0\u00eb\u00e8 \u00ec\u00ee\u00e8\u00ec\u00e8 \u00e4\u00f0\u00f3\u00e7\u00fc\u00ff\u00ec\u00e8 \u00e8 \u00eb\u00fe\u00e1\u00e8\u00ec\u00fb\u00ec\u00e8 \u00f1\u00fe\u00e6\u00e5\u00f2\u00e0\u00ec\u00e8 \u00ec\u00ee\u00e5\u00e3\u00ee \u00ee\u00e1\u00fa\u00e5\u00ea\u00f2\u00e8\u00e2\u00e0\u00bb \u00c3\u00f0\u00e5\u00f2\u00e0 \u00c8\u00ee\u00ed\u00ea\u00e8\u00f1, \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ee\u00e2\u00e5\u00e4 \u00e8 \u00ef\u00f3\u00e1\u00eb\u00e8\u00f6\u00e8\u00f1\u00f2. \u00d8\u00f2\u00f0\u00e8\u00f5\u00e8 \u00e1\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e8 \u00e6\u00e5\u00ed\u00f9\u00e8\u00ed\u00fb \u00f1 \u00ab\u00eb\u00e5\u00e9\u00ea\u00ee\u00e9\u00bb - \u00c6\u00e8\u00e7\u00e5\u00eb\u00fc \u00d4\u00f0\u00ee\u00e9\u00ed\u00e4 \u0412 \u00ed\u00e0\u00f8\u00e5\u00ec \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2\u00e5 \u00ec\u00fb \u00ee\u00f2\u00ea\u00f0\u00fb\u00e2\u00e0\u00e5\u00ec \u00e3\u00e0\u00eb\u00e5\u00f0\u00e5\u00fe \u00f4\u00ee\u00f2\u00ee\u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2\u00ee\u00e2 \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00e5\u00e9 \u00e8\u00ed\u00f2\u00e5\u00eb\u00eb\u00e5\u00ea\u00f2\u00f3\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00fd\u00eb\u00e8\u00f2\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u00dd\u00f2\u00ee \u00f0\u00e0\u00e1\u00ee\u00f2\u00fb \u00f4\u00ee\u00f2\u00ee\u00ec\u00e0\u00f1\u00f2\u00e5\u00f0\u00e0 \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9. \u00cd\u00e0\u00f8\u00e0 \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00e0\u00ff \u00e6\u00e5\u00ed\u00f9\u00e8\u00ed\u00e0 \u00f1 \u00ab\u00eb\u00e5\u00e9\u00ea\u00ee\u00e9\u00bb\u00a0 \u00f1 \u00fe\u00ed\u00fb\u00f5 \u00eb\u00e5\u00f2 \u00ef\u00ee\u00e4\u00ee\u00e1\u00ed\u00ee \u00c6\u00e8\u00e7\u00e5\u00eb\u00fc \u00d4\u00f0\u00ee\u00e9\u00ed\u00e4 \u00f4\u00e8\u00ea\u00f1\u00e8\u00f0\u00f3\u00e5\u00f2 \u00eb\u00e8\u00f6\u00e0 \u00f1\u00ee\u00e1\u00e5\u00f1\u00e5\u00e4\u00ed\u00e8\u00ea\u00ee\u00e2. \u00c7\u00e0 36 \u00eb\u00e5\u00f2 \u00f1\u00e2\u00ee\u00e5\u00e9 \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00e8 \u00f4\u00ee\u00f2\u00ee\u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 \u00f1\u00ee\u00e1\u00f0\u00e0\u00eb\u00e0 \u00f3\u00ed\u00e8\u00ea\u00e0\u00eb\u00fc\u00ed\u00f3\u00fe \u00ea\u00ee\u00eb\u00eb\u00e5\u00ea\u00f6\u00e8\u00fe, \u00ea\u00ee\u00f2\u00ee\u00f0\u00f3\u00fe \u00f3\u00f1\u00eb\u00ee\u00e2\u00ed\u00ee \u00ed\u00e0\u00e7\u00e2\u00e0\u00eb\u00e0 \u00ab\u00c7\u00ee\u00eb\u00ee\u00f2\u00ee\u00e9 \u00f4\u00ee\u00ed\u00e4 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8\u00bb. \u00cd\u00e0\u00f8\u00e0 \u00e2\u00e8\u00f0\u00f2\u00f3\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00e2 \u00ec\u00e0\u00f0\u00f2\u00e5 2015 \u00e3\u00ee\u00e4\u00e0 \u00ef\u00ee\u00eb\u00f3\u00f7\u00e8\u00eb\u00e0 \u00f0\u00e5\u00e0\u00eb\u00fc\u00ed\u00ee\u00e5 \u00e2\u00ee\u00ef\u00eb\u00ee\u00f9\u00e5\u00ed\u00e8\u00e5. \u0412 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5 \u00ee\u00f2\u00ea\u00f0\u00fb\u00eb\u00e0\u00f1\u00fc \u00ef\u00e5\u00f0\u00f1\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00f4\u00ee\u00f2\u00ee\u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0 \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9. \u00d1\u00ec\u00ee\u00f2\u00f0\u00e8\u00f2\u00e5 \u00f4\u00ee\u00f2\u00ee\u00f0\u00e5\u00ef\u00ee\u00f0\u00f2\u00e0\u00e6 \u00cd. \u00c0\u00e1\u00f0\u00e0\u00ec\u00ee\u00e2\u00e0 \u00f1 \u00ee\u00f2\u00ea\u00f0\u00fb\u00f2\u00e8\u00ff \u00fd\u00f2\u00ee\u00e9 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e8. \u00c7\u00e0\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb\u00f1\u00ff \u00c3\u00ee\u00e4 \u00ca\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e2 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8. \u00cd\u00e0\u00f7\u00e0\u00eb\u00f1\u00ff \u00c3\u00ee\u00e4 \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb. \u00cf\u00ee\u00fd\u00f2\u00ee\u00ec\u00f3 \u00f0\u00e0\u00ec\u00ea\u00e8 \u00ed\u00e0\u00f8\u00e5\u00e3\u00ee \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2\u00e0 \u00e2 \u00f0\u00e0\u00e7\u00e4\u00e5\u00eb\u00e5 \u00ab\u00c3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9\u00bb \u00f7\u00f3\u00f2\u00fc \u00f0\u00e0\u00e7\u00e4\u00e2\u00e8\u00ed\u00f3\u00f2\u00fb. \u0412\u00ec\u00e5\u00f1\u00f2\u00e5 \u00f1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00ec \u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2\u00ee\u00e2 \u00ec\u00fb \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00eb\u00ff\u00e5\u00ec \u00e2\u00e0\u00f8\u00e5\u00ec\u00f3 \u00e2\u00ed\u00e8\u00ec\u00e0\u00ed\u00e8\u00fe \u00ed\u00e5 \u00f2\u00ee\u00eb\u00fc\u00ea\u00ee \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00e8 \u00ef\u00ee\u00fd\u00f2\u00ee\u00e2, \u00ed\u00ee \u00e8 \u00f3\u00f7\u00b8\u00ed\u00fb\u00f5, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea\u00ee\u00e2, \u00ea\u00ee\u00ec\u00ef\u00ee\u00e7\u00e8\u00f2\u00ee\u00f0\u00ee\u00e2, \u00e0\u00ea\u00f2\u00b8\u00f0\u00ee\u00e2. \u00ce\u00ed\u00e8 \u00e2\u00f1\u00e5 \u2013 \u00f2\u00e2\u00ee\u00f0\u00f6\u00fb. \u00c0\u00e2\u00f2\u00ee\u00f0\u00fb,\u00a0 \u00ef\u00f0\u00e8\u00f3\u00ec\u00ed\u00ee\u00e6\u00e0\u00fe\u00f9\u00e8\u00e5 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00ed\u00ee\u00e5 \u00ed\u00e0\u00f1\u00eb\u00e5\u00e4\u00e8\u00e5 \u00ed\u00e0\u00f8\u00e5\u00e3\u00ee \u00ea\u00f0\u00e0\u00ff. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 [+] \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 , 1958 \u00e3\u00f0. \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4 \u00e8 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2, \u00e7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e0\u00e1\u00ee\u00f2\u00ed\u00e8\u00ea \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u00d0\u00e0\u00e1\u00ee\u00f2\u00e0\u00e5\u00f2 \u00e2 \u00c8\u00ed\u00f2\u00e5\u00f0\u00ed\u00e5\u00f2-\u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e5\u00a0 \u00ab\u00cb\u00e8\u00f6\u00e5\u00e9\u00bb (\u00ee\u00e1\u00f0\u00e0\u00e7\u00ee\u00e2\u00e0\u00ed\u00e8\u00e5, \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00e0, \u00f1\u00e5\u00ec\u00fc\u00ff). \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 - \u00f7\u00eb\u00e5\u00ed\u00a0 \u00d1\u00ee\u00fe\u00e7\u00e0 \u00f4\u00ee\u00f2\u00ee\u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea\u00ee\u00e2 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00f1 1990 \u00e3\u00ee\u00e4\u00e0. \u00cd\u00e5\u00ea\u00ee\u00f2\u00ee\u00f0\u00fb\u00e5 \u00f0\u00e0\u00e1\u00ee\u00f2\u00fb \u00e1\u00fb\u00eb\u00e8 \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00eb\u00e5\u00ed\u00fb \u00ed\u00e0 \u00e7\u00e0\u00f0\u00f3\u00e1\u00e5\u00e6\u00ed\u00fb\u00f5 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0\u00f5 (\u00c3\u00e5\u00f0\u00ec\u00e0\u00ed\u00e8\u00ff, \u00c8\u00f1\u00ef\u00e0\u00ed\u00e8\u00ff, \u00cf\u00ee\u00eb\u00fc\u00f8\u00e0, \u00d8\u00ee\u00f2\u00eb\u00e0\u00ed\u00e4\u00e8\u00ff, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff). \u00d4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ab\u0412\u00ee\u00f1\u00ef\u00ee\u00ec\u00e8\u00ed\u00e0\u00ed\u00e8\u00e5 \u00ee \u00e4\u00e5\u00f2\u00f1\u00f2\u00e2\u00e5\u00bb \u00ed\u00e0 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e5 \u00e2 \u00c8\u00f1\u00ef\u00e0\u00ed\u00e8\u00e8 \u00e2 1987 \u00e3\u00ee\u00e4\u00f3 \u00e1\u00fb\u00eb\u00e0 \u00ee\u00f2\u00ec\u00e5\u00f7\u00e5\u00ed\u00e0 \u00e1\u00f0\u00ee\u00ed\u00e7\u00ee\u00e2\u00ee\u00e9 \u00ec\u00e5\u00e4\u00e0\u00eb\u00fc\u00fe \u00e8 \u00e4\u00e5\u00ed\u00e5\u00e6\u00ed\u00ee\u00e9 \u00ef\u00f0\u00e5\u00ec\u00e8\u00e5\u00e9. \u0412 1992 \u00e3\u00ee\u00e4\u00f3 \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e8 \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9 \u00fd\u00ea\u00f1\u00ef\u00ee\u00ed\u00e8\u00f0\u00ee\u00e2\u00e0\u00eb\u00e8\u00f1\u00fc \u00ed\u00e0 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e5 \u00ab Photo found on the Volga\u00bb \u00e2 \u00cd\u00fc\u00fe \u2013 \u00c9\u00ee\u00f0\u00ea\u00e5 \u00e8 \u00d1\u00e0\u00ed-\u00d4\u00f0\u00e0\u00ed\u00f6\u00e8\u00f1\u00ea\u00ee. \u0412 1995 \u00e3\u00ee\u00e4\u00f3 \u00e2 \u00cc\u00f3\u00e7\u00e5\u00e5 \u00e8\u00e7\u00ee\u00e1\u00f0\u00e0\u00e7\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00fb\u00f5 \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2 \u00d0\u00ca \u00f3\u00f1\u00ef\u00e5\u00f8\u00ed\u00ee \u00ef\u00f0\u00ee\u00f8\u00eb\u00e0 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0 \u00ab\u00c0\u00ef\u00ee\u00f4\u00e5\u00ee\u00e7 \u00f7\u00e0\u00f1\u00f2\u00e8\u00f6 \u00bb, \u00f1\u00ee\u00e2\u00ec\u00e5\u00f1\u00f2\u00ed\u00ee \u00f1 \u00e8\u00e7\u00e2\u00e5\u00f1\u00f2\u00ed\u00fb\u00ec \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00ec \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea\u00ee\u00ec \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00ee\u00ec \u00d2\u00f0\u00e8\u00f4\u00ee\u00ed\u00ee\u00e2\u00fb\u00ec. \u00d4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e8 \u00c8\u00f0\u00e8\u00ed\u00fb \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00ee\u00e9 \u00ef\u00e5\u00f7\u00e0\u00f2\u00e0\u00eb\u00e8\u00f1\u00fc \u00e2\u00a0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0\u00f5: \u00abCarelia\u00bb, \u00ab\u00ca\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00e0 \u00e8 \u00e6\u00e8\u00e7\u00ed\u00fc\u00bb, \u00abC\u00ee\u00e2\u00e5\u00f2\u00f1\u00ea\u00ee\u00e5 \u00f4\u00ee\u00f2\u00ee\u00bb, \u00abKameralehti\u00bb (\u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff), \u00e0 \u00f2\u00e0\u00ea\u00e6\u00e5 \u00e2 \u00ea\u00ed\u00e8\u00e3\u00e0\u00f5: \u00ab\u00cf\u00ee\u00fd\u00f2\u00e8\u00ea\u00e0 \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e8\u00bb (\u00cc\u00ee\u00f1\u00ea\u00e2\u00e0, \u00ab\u00c8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00ee\u00bb, 1989) \u00e8 \u00e2 \u00ea\u00ed\u00e8\u00e3\u00e5 \u00ab\u00d4\u00ee\u00f2\u00ee\u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00ee \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8\u00bb (\u00c8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00ee \u00ab\u00cf\u00eb\u00e0\u00ed\u00e5\u00f2\u00e0\u00bb, 1990). \u00cf\u00e5\u00f0\u00f1\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00fb\u00e5 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e8\u00a0 \u00f1\u00ee\u00f1\u00f2\u00ee\u00ff\u00eb\u00e8\u00f1\u00fc \u00e2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5 (2002) \u00e8 \u00e2 \u00cb\u00e0-\u00d0\u00ee\u00f8\u00e5\u00eb\u00e8 (2005). \u00c7\u00e0 \u00ef\u00ee\u00f1\u00eb\u00e5\u00e4\u00ed\u00e8\u00e5 \u00e3\u00ee\u00e4\u00fb \u00ee\u00f1\u00f3\u00f9\u00e5\u00f1\u00f2\u00e2\u00eb\u00e5\u00ed\u00fb \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2\u00fb: \u00ab\u00cf\u00f0\u00e0\u00e2\u00ee\u00f1\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb (2001), \u00ab\u00cc\u00e8\u00f4, \u00ee\u00e1\u00f0\u00e0\u00e7, \u00f1\u00e8\u00ec\u00e2\u00ee\u00eb\u00bb (2003) (\u00e3\u00e4\u00e5 \u00e1\u00fb\u00eb\u00e8 \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00eb\u00e5\u00ed\u00fb \u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2\u00fb \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9, \u00e0\u00f0\u00f2\u00e8\u00f1\u00f2\u00ee\u00e2, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea\u00ee\u00e2, \u00ef\u00f0\u00e5\u00ef\u00ee\u00e4\u00e0\u00e2\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8), \u00f1\u00ee\u00e2\u00ec\u00e5\u00f1\u00f2\u00ed\u00ee \u00f1 \u0412\u00e8\u00ea\u00f2\u00ee\u00f0\u00e8\u00e5\u00e9 \u00c7\u00ee\u00f0\u00e8\u00ed\u00ee\u00e9; \u0412\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0 \u00ab\u00c3\u00ee\u00f0\u00ee\u00e4 \u00e8 \u00e5\u00e3\u00ee \u00e6\u00e8\u00f2\u00e5\u00eb\u00e8\u00bb, \u00ef\u00ee\u00f1\u00e2\u00ff\u00f9\u00e5\u00ed\u00ed\u00e0\u00ff \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00f3 (2006) , \u00e2 2009 \u00e3\u00ee\u00e4\u00f3 \u00ef\u00ee\u00ea\u00e0\u00e7\u00e0\u00ed\u00e0 \u00e2 \u00d2\u00fe\u00e1\u00e5\u00ed\u00e3\u00e5\u00ed\u00e5 - \u00f1\u00ee\u00e2\u00ec\u00e5\u00f1\u00f2\u00ed\u00ee \u00f1 \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea\u00ee\u00ec \u0412\u00e8\u00ea\u00f2\u00ee\u00f0\u00e8\u00e5\u00e9 \u00c7\u00ee\u00f0\u00e8\u00ed\u00ee\u00e9. \u0412\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0 \u00ab\u0412\u00f7\u00e5\u00f0\u00e0\u00f8\u00ed\u00e8\u00e9 \u00e4\u00e5\u00ed\u00fc\u00bb (\u00f7\u00e5\u00f0\u00ed\u00ee-\u00e1\u00e5\u00eb\u00e0\u00ff \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff) (2006). \u0412\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0 \u00ab\u00ce\u00f1\u00f2\u00e0\u00ed\u00ee\u00e2\u00ea\u00e0 \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb( 2012), \u00f1\u00ee\u00e2\u00ec\u00e5\u00f1\u00f2\u00ed\u00ee \u00f1 \u0412\u00e8\u00ea\u00f2\u00ee\u00f0\u00e8\u00e5\u00e9 \u00c7\u00ee\u00f0\u00e8\u00ed\u00ee\u00e9. \u00d3\u00f7\u00e0\u00f1\u00f2\u00e2\u00ee\u00e2\u00e0\u00eb\u00e0 \u00e2 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0\u00f5 \u00cc\u00f3\u00e7\u00e5\u00ff \u00e8\u00e7\u00ee\u00e1\u00f0\u00e0\u00e7\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00fb\u00f5 \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2 \u00d0\u00ca \u00ab\u00c8 \u00fd\u00f2\u00ee \u00e2\u00f1\u00e5 \u00ee \u00ed\u00e5\u00e9\u00bb (2013), \u00ab\u00c1\u00ee\u00e3\u00e5\u00ec\u00e0\u00bb (2011) \u0412\u00fb\u00f1\u00f2\u00e0\u00e2\u00ea\u00e0 \u00ab\u00c3\u00ee\u00f0\u00ee\u00e4, \u00ea\u00ee\u00f2\u00ee\u00f0\u00fb\u00e9 \u00e2\u00f1\u00e5\u00e3\u00e4\u00e0 \u00f1 \u00f2\u00ee\u00e1\u00ee\u00e9\u00bb\u00a0\u00f2\u00f0\u00e5\u00f5 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 (\u0412.\u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2, \u00c1. \u00d2\u00ee\u00ef\u00f3\u00f0\u00e8\u00ff, \u00c8. \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0) \u00ef\u00ee\u00f1\u00e2\u00ff\u00f9\u00e5\u00ed\u00e0 310-\u00eb\u00e5\u00f2\u00e8\u00fe \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e0 (2013). \u00c3\u00ee\u00f0\u00ee\u00e4\u00f1\u00ea\u00ee\u00e9 \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ee\u00f7\u00ed\u00fb\u00e9 \u00e7\u00e0\u00eb. \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 \u00ef\u00f0\u00e8\u00ed\u00e8\u00ec\u00e0\u00eb\u00e0 \u00f3\u00f7\u00e0\u00f1\u00f2\u00e8\u00e5 \u00e2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00f1\u00e5\u00f0\u00e8\u00e8\u00a0 \u00e1\u00f3\u00ea\u00eb\u00e5\u00f2\u00ee\u00e2 \u00e8 \u00ea\u00ed\u00e8\u00e3 \u00ee \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u00c1\u00ee\u00f0\u00e8\u00f1 \u00c0\u00ea\u00e1\u00f3\u00eb\u00e0\u00f2\u00ee\u00e2, \u00e3\u00f0\u00e0\u00f4\u00e8\u00ea, \u00e6\u00e8\u00e2\u00ee\u00ef\u00e8\u00f1\u00e5\u00f6, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00ea\u00ed\u00e8\u00e3\u00e8 \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0  \u00c1\u00f3\u00f8\u00ea\u00ee\u00e2\u00f1\u00ea\u00e8\u00e9 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00ca\u00ee\u00f8\u00e5\u00eb\u00e5\u00e2, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c3\u00e5\u00ee\u00f0\u00e3\u00e8\u00e9 \u00cd\u00e8\u00ea\u00ee\u00eb\u00e0\u00e5\u00e2, \u00e0\u00ea\u00f2\u00e5\u00f0  \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0  \u00ab\u00d2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00ea\u00e0\u00ff \u00ec\u00e0\u00f1\u00f2\u00e5\u00f0\u00f1\u00ea\u00e0\u00ff\u00bb \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00c2\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2, \u00ef\u00ee\u00fd\u00f2, \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea, \u00f1\u00f6\u00e5\u00ed\u00e0\u00f0\u00e8\u00f1\u00f2 \u00d5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00d3\u00f7\u00f3\u00e2\u00e0\u00f2\u00ea\u00e8\u00ed \u00c5\u00eb\u00e5\u00ed\u00e0 \u00c1\u00fb\u00f7\u00ea\u00ee\u00e2\u00e0, \u00e7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00e0\u00ff \u00e0\u00f0\u00f2\u00e8\u00f1\u00f2\u00ea\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8, \u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00e0\u00ff \u00e0\u00f0\u00f2\u00e8\u00f1\u00f2\u00ea\u00e0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00ee\u00e2\u00e5\u00e4 \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cd\u00e8\u00ea\u00f3\u00eb\u00e8\u00ed\u00e0 \u00cc\u00e0\u00f0\u00e0\u00f2 \u00c2\u00e0\u00f1\u00e8\u00eb\u00fc\u00e5\u00e2\u00e8\u00f7 \u00d2\u00e0\u00f0\u00e0\u00f1\u00ee\u00e2, \u00cd\u00e0\u00f0\u00ee\u00e4\u00ed\u00fb\u00e9 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c0\u00ed\u00e0\u00f2\u00ee\u00eb\u00e8\u00e9 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e5\u00e5\u00e2\u00e8\u00f7 \u00c3\u00ee\u00f0\u00e4\u00e8\u00e5\u00ed\u00ea\u00ee, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00cc\u00e0\u00f0\u00e3\u00e0\u00f0\u00e8\u00f2\u00e0 \u00cf\u00e5\u00f0\u00ec\u00ff\u00ea\u00ee\u00e2\u00e0, \u00ec\u00e0\u00f1\u00f2\u00e5\u00f0 \u00e0\u00ea\u00e2\u00e0\u00f0\u00e5\u00eb\u00e8 \u00ce\u00eb\u00e5\u00e3 \u00cb\u00e8\u00ef\u00ee\u00e2\u00e5\u00f6\u00ea\u00e8\u00e9, \u00f0\u00e5\u00e6\u00e8\u00f1\u00f1\u00e5\u00f0 \u00ce\u00eb\u00fc\u00e3\u00e0 \u00c1\u00e5\u00eb\u00ee\u00e2\u00e0, \u00ec\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4 \u00c1\u00ee\u00f0\u00e8\u00f1 \u00cf\u00ee\u00ec\u00ee\u00f0\u00f6\u00e5\u00e2, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00d0\u00e0\u00e8\u00f1\u00e0 \u00cc\u00f3\u00f1\u00f2\u00ee\u00ed\u00e5\u00ed, \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea, \u00e4\u00f0\u00e0\u00ec\u00e0\u00f2\u00f3\u00f0\u00e3, \u00ea\u00e8\u00ed\u00ee\u00f1\u00f6\u00e5\u00ed\u00e0\u00f0\u00e8\u00f1\u00f2 \u00c3\u00f0\u00e8\u00e3\u00ee\u00f0\u00e8\u00e9 \u00d1\u00e0\u00eb\u00f2\u00f3\u00ef, \u00f1\u00ea\u00f3\u00eb\u00fc\u00ef\u00f2\u00ee\u00f0, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc \u00d2\u00e0\u00f2\u00fc\u00ff\u00ed\u00e0 \u00d8\u00e5\u00f0\u00f3\u00e4\u00e8\u00eb\u00ee, \u00ee\u00f0\u00e3\u00e0\u00ed\u00e8\u00e7\u00e0\u00f2\u00ee\u00f0 \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e9 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00e8 \u00c1\u00e0\u00e4\u00f0\u00e8 \u00d2\u00ee\u00ef\u00f3\u00f0\u00e8\u00ff, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00d2\u00e5\u00f0\u00e5\u00ed\u00f2\u00fc\u00e5\u00e2, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0, \u00e4\u00e8\u00f0\u00e5\u00ea\u00f2\u00ee\u00f0 \u00cc\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0  \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cd\u00e8\u00ea\u00ee\u00eb\u00e0\u00e9 \u00c1\u00e5\u00eb\u00ff\u00ea\u00ee\u00e2, \u00ec\u00e0\u00f1\u00f2\u00e5\u00f0 \u00f5\u00f3\u00e4\u00ee\u00e6\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e9 \u00ea\u00ee\u00e2\u00ea\u00e8 \u00d2\u00e0\u00f2\u00fc\u00ff\u00ed\u00e0 \u00cc\u00e5\u00f8\u00ea\u00ee, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc \u00cf\u00ee\u00fd\u00f2 \u00ce\u00eb\u00e5\u00e3 \u00cc\u00ee\u00f8\u00ed\u00e8\u00ea\u00ee\u00e2 \u00d2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cf\u00f0\u00ee\u00ed\u00e8\u00ed\u00e0 \u00d5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u00d2\u00f0\u00e8\u00f4\u00ee\u00ed\u00ee\u00e2 \u00d0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0 \u00c0\u00ed\u00ed\u00e0 \u00d6\u00f3\u00ed\u00f1\u00ea\u00e0\u00ff \u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c2\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00cf\u00ee\u00fd\u00f2 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u00c2\u00ee\u00f0\u00ee\u00ed\u00e8\u00ed \u00cf\u00f0\u00e5\u00ef\u00ee\u00e4\u00e0\u00e2\u00e0\u00f2\u00e5\u00eb\u00fc \u00cf\u00e5\u00f2\u00f0\u00c3\u00d3 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00df\u00ea\u00ee\u00e2\u00eb\u00e5\u00e2 \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc-\u00e4\u00ee\u00ea\u00f3\u00ec\u00e5\u00ed\u00f2\u00e0\u00eb\u00e8\u00f1\u00f2, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00ca\u00ee\u00ed\u00f1\u00f2\u00e0\u00ed\u00f2\u00e8\u00ed \u00c3\u00ed\u00e5\u00f2\u00ed\u00e5\u00e2 \u00cf\u00ee\u00fd\u00f2 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00c3\u00ee\u00f0\u00e4\u00e8\u00e5\u00ed\u00ea\u00ee \u00c0\u00eb\u00e5\u00ea\u00f1\u00e5\u00e9 \u00c6\u00e8\u00e4\u00ea\u00ee\u00e2, \u00e1\u00e0\u00f0\u00e4, \u00ef\u00ee\u00fd\u00f2 \u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2, \u00ef\u00ee\u00fd\u00f2, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc \u00c0\u00ed\u00e4\u00f0\u00e5\u00e9 \u00d4\u00e0\u00f0\u00f3\u00f2\u00e8\u00ed \u00c0\u00f0\u00f2\u00e8\u00f1\u00f2 \u00cb\u00e5\u00ee\u00ed\u00e8\u00e4 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00ee\u00e2 \u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2, \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00ee\u00f0 \u00c2\u00e5\u00ed\u00e8\u00e0\u00ec\u00e8\u00ed \u00d1\u00eb\u00e5\u00ef\u00ea\u00ee\u00e2 \u00cf\u00e5\u00e2\u00e5\u00f6, \u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00fb\u00e9 \u00e0\u00f0\u00f2\u00e8\u00f1\u00f2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c2\u00e8\u00ea\u00f2\u00ee\u00f0 \u00ca\u00e0\u00eb\u00e8\u00ea\u00e8\u00ed \u00cf\u00ee\u00fd\u00f2, \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2 \u00cf\u00ee\u00fd\u00f2 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00c3\u00ee\u00f0\u00ee\u00f5 \u00cf\u00ee\u00fd\u00f2, \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea, \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00ea\u00f0\u00e8\u00f2\u00e8\u00ea, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00d1\u00e2\u00e8\u00ed\u00f6\u00ee\u00e2 \u00cf\u00ee\u00fd\u00f2,  \u00e3\u00eb\u00e0\u00e2\u00ed\u00fb\u00e9 \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0 \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e9 \u00ea\u00f0\u00e8\u00f2\u00e8\u00ea \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc, \u00ef\u00ee\u00fd\u00f2 \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 \u00c8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00ee\u00e2\u00e5\u00e4 \u00e8 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00ee\u00f0 \u00c5\u00e2\u00e3\u00e5\u00ed\u00e8\u00e9 \u00ca\u00e0\u00eb\u00e8\u00ed\u00e8\u00ed \u00cb\u00e8\u00e4\u00e8\u00ff \u00d2\u00ee\u00eb\u00f1\u00f2\u00ee\u00e2\u00e0, \u00f0\u00e5\u00e6\u00e8\u00f1\u00f1\u00e5\u00f0 \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0 \u00cc\u00ee\u00ed\u00f2\u00e5\u00f1 \u00cc\u00e8\u00f5\u00e0\u00e8\u00eb \u00ca\u00ee\u00ef\u00ef\u00e0\u00eb\u00e5\u00e2, \u00f1\u00ea\u00f3\u00eb\u00fc\u00ef\u00f2\u00ee\u00f0 \u00cf\u00ee\u00fd\u00f2 \u00c5\u00ea\u00e0\u00f2\u00e5\u00f0\u00e8\u00ed\u00e0 \u00ce\u00eb\u00fc\u00f8\u00e8\u00ed\u00e0 \u00d1\u00e2\u00e5\u00f2\u00eb\u00e0\u00ed\u00e0 \u00d7\u00e5\u00f0\u00e5\u00ed\u00ea\u00ee\u00e2\u00e0, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2, \u00ef\u00ee\u00fd\u00f2 \u00d0\u00e5\u00e6\u00e8\u00f1\u00f1\u00e5\u00f0 \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00cf\u00f0\u00ee\u00ed\u00e8\u00ed \u00d5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c0\u00f0\u00ea\u00e0\u00e4\u00e8\u00e9 \u00cc\u00ee\u00f0\u00ee\u00e7\u00ee\u00e2 \u00d5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c3\u00e5\u00ee\u00f0\u00e3\u00e8\u00e9 \u00c8\u00e2\u00e0\u00ed\u00ee\u00e2 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u00ef\u00ee\u00fd\u00f2, \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea, \u00f3\u00f7\u00b8\u00ed\u00fb\u00e9 \u00c0\u00ed\u00e0\u00f2\u00ee\u00eb\u00e8\u00e9 \u00cc\u00e5\u00f8\u00ea\u00ee, \u00f1\u00ee\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc \u00ea\u00e0\u00ed\u00f2\u00e5\u00eb\u00e5 \u00e8 \u00ea\u00e0\u00ed\u00f2\u00e5\u00eb\u00e5\u00e2\u00e5\u00e4 \u00c0\u00f0\u00ec\u00e0\u00f1 \u00cc\u00e0\u00f8\u00e8\u00ed, \u00e3\u00eb\u00e0\u00e2\u00ed\u00fb\u00e9 \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0 \u00abCarelia\u00bb \u00cd\u00e8\u00ea\u00ee\u00eb\u00e0\u00e9 \u00c0\u00e1\u00f0\u00e0\u00ec\u00ee\u00e2 \u00ef\u00ee\u00fd\u00f2, \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e9 \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea \u00c0\u00f0\u00f2\u00e5\u00ec \u00d1\u00f2\u00e0\u00f0\u00ee\u00e4\u00f3\u00e1\u00f6\u00e5\u00e2, \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c1\u00ee\u00f0\u00e8\u00f1 \u00c3\u00f3\u00f9\u00e8\u00ed, \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea, \u00fd\u00f2\u00ed\u00ee\u00e3\u00f0\u00e0\u00f4, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc, \u00e4\u00f0\u00e0\u00ec\u00e0\u00f2\u00f3\u00f0\u00e3 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed, \u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2, \u00ef\u00ee\u00fd\u00f2, \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea \u00e0\u00ed\u00e3\u00eb\u00ee\u00ff\u00e7\u00fb\u00f7\u00ed\u00ee\u00e9 \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00cf\u00eb\u00e0\u00f2\u00ee\u00ed\u00ee\u00e2, \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00ee\u00e2\u00e5\u00e4, \u00f1\u00ef\u00e5\u00f6\u00e8\u00e0\u00eb\u00e8\u00f1\u00f2 \u00ef\u00ee \u00e4\u00f0\u00e5\u00e2\u00ed\u00e5\u00f0\u00f3\u00f1\u00f1\u00ea\u00ee\u00e9 \u00e8\u00ea\u00ee\u00ed\u00e5 \u00cd\u00e0\u00f2\u00e0\u00eb\u00fc\u00ff \u00c3\u00e0\u00eb\u00fc\u00f6\u00e8\u00ed\u00e0, \u00e1\u00e0\u00eb\u00e5\u00f0\u00e8\u00ed\u00e0 \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00cd\u00ee\u00e2\u00e8\u00ea\u00ee\u00e2, \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea \u00c5\u00e3\u00ee\u00f0 \u00d1\u00e5\u00f0\u00e3\u00e5\u00e5\u00e2, \u00ef\u00ee\u00fd\u00f2 \u00c0\u00ed\u00ed\u00e0 \u00d2\u00ee\u00ea\u00e0\u00f0\u00e5\u00e2\u00e0, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00cf\u00ee\u00eb\u00ff\u00ea\u00ee\u00e2, \u00e0\u00f0\u00f2\u00e8\u00f1\u00f2 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0 \u00d0\u00ca \u00de\u00f0\u00e8\u00e9 \u00cb\u00e8\u00ed\u00ed\u00e8\u00ea, \u00f4\u00e8\u00eb\u00ee\u00f1\u00ee\u00f4-\u00ea\u00ee\u00f1\u00ec\u00e8\u00f1\u00f2, \u00ef\u00ee\u00fd\u00f2, \u00e4\u00ee\u00ea\u00f2\u00ee\u00f0 \u00f4\u00e8\u00eb\u00ee\u00f1\u00ee\u00f4\u00f1\u00ea\u00e8\u00f5 \u00ed\u00e0\u00f3\u00ea \u00cc\u00e0\u00f0\u00e8\u00ff \u00de\u00f4\u00e0, \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00ee\u00e2\u00e5\u00e4, \u00e4\u00e8\u00f0\u00e5\u00ea\u00f2\u00ee\u00f0 \u00c3\u00ee\u00f0\u00ee\u00e4\u00f1\u00ea\u00ee\u00e3\u00ee \u00e2\u00fb\u00f1\u00f2\u00e0\u00e2\u00ee\u00f7\u00ed\u00ee\u00e3\u00ee \u00e7\u00e0\u00eb\u00e0 \u00dd\u00e4\u00f3\u00e0\u00f0\u00e4 \u00cf\u00e0\u00f2\u00eb\u00e0\u00e5\u00ed\u00ea\u00ee, \u00ea\u00ee\u00ec\u00ef\u00ee\u00e7\u00e8\u00f2\u00ee\u00f0 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u00cf\u00e0\u00f8\u00ea\u00ee\u00e2, \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea \u00c8\u00f0\u00e8\u00ed\u00e0 \u00d1\u00ef\u00e8\u00f0\u00e8\u00e4\u00ee\u00ed\u00ee\u00e2\u00e0, \u00e4\u00ee\u00ea\u00f2\u00ee\u00f0 \u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00f5 \u00ed\u00e0\u00f3\u00ea, \u00ef\u00f0\u00ee\u00f4\u00e5\u00f1\u00f1\u00ee\u00f0  \u00cf\u00e5\u00f2\u00f0\u00c3\u00d3 \u00d0\u00e0\u00e8\u00f1\u00e0 \u00ca\u00e0\u00eb\u00e8\u00ed\u00ea\u00e8\u00ed\u00e0, \u00e7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e0\u00e1\u00ee\u00f2\u00ed\u00e8\u00ea \u00d0\u00ca \u00e8 \u00d0\u00d4 \u00cc\u00e0\u00f0\u00e8\u00ed\u00e0 \u00c0\u00ed\u00e4\u00f0\u00e5\u00e5\u00e2\u00e0, \u00ef\u00ee\u00fd\u00f2, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00de\u00f0\u00e8\u00e9 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00ee\u00e2\u00e8\u00f7 \u00d1\u00e0\u00e2\u00e2\u00e0\u00f2\u00e5\u00e5\u00e2, \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea \u00c0\u00ea\u00e0\u00e4\u00e5\u00ec\u00e8\u00ff \u00ed\u00e0\u00f3\u00ea \u00c8\u00e2\u00e0\u00ed \u00d0\u00ee\u00e3\u00ee\u00f9\u00e5\u00ed\u00ea\u00ee\u00e2, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb \u00d1\u00e5\u00e2\u00e5\u00f0 \u00c3\u00e0\u00eb\u00e8\u00ed\u00e0 C\u00ea\u00e2\u00ee\u00f0\u00f6\u00ee\u00e2\u00e0, \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea, \u00e4\u00f0\u00e0\u00ec\u00e0\u00f2\u00f3\u00f0\u00e3, \u00ef\u00f3\u00e1\u00eb\u00e8\u00f6\u00e8\u00f1\u00f2, \u00f2\u00e5\u00eb\u00e5\u00e2\u00e5\u00e4\u00f3\u00f9\u00e0\u00ff \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

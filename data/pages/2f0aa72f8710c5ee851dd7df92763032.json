e8\u00f5\u00e0\u00ec\u00e8. / \u00ca\u00ee\u00ed\u00f1\u00f2\u00e0\u00ed\u00f2\u00e8\u00ed \u0412\u00e0\u00ed\u00f8\u00e5\u00ed\u00ea\u00e8\u00ed // \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00cc\u00ee\u00e5\u00e9 \u00ed\u00e0\u00e4\u00e5\u00e6\u00e4\u00fb \u00ed\u00e8\u00f2\u00fc: [c\u00e1. \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2] / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed. \u2013 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea, 2003. \u2013\u00a0 \u00d1. 3. \u00c3\u00e0\u00eb\u00fc\u00f7\u00e5\u00ed\u00ea\u00ee, \u00ce. \u00d1\u00e2\u00ee\u00ff \u00ea\u00ee\u00eb\u00e5\u00ff / \u00ce. \u00c3\u00e0\u00eb\u00fc\u00f7\u00e5\u00ed\u00ea\u00ee // \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e9 \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2. - 2003. - 8 \u00ec\u00e0\u00ff \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 37-39. \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00c3. \u00c6\u00e4\u00f3\u00f9\u00e8\u00e5 \u00f7\u00f3\u00e4\u00e0 : \u00f1\u00f2\u00e8\u00f5\u00e8 / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff, 1990. - 78 \u00f1. \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00c3. \u00cc\u00ee\u00e5\u00e9 \u00ed\u00e0\u00e4\u00e5\u00e6\u00e4\u00fb \u00ed\u00e8\u00f2\u00fc : [\u00f1\u00e1. \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2] / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00c3\u00ee\u00f0\u00ee\u00e6\u00e0\u00ed\u00e8\u00ed, 2003. - 70 \u00f1. \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00c3. \u00a0\u00d1\u00e4\u00e2\u00e8\u00e3 36-40 : \u00ef\u00ee\u00e2\u00e5\u00f1\u00f2\u00fc. - \u00d1. 7-44; \u00cc\u00e0\u00f2\u00e5\u00f0\u00e8\u00e0\u00eb\u00e8\u00e7\u00e0\u00f6\u00e8\u00ff \u00e4\u00f3\u00f5\u00ee\u00e2 : \u00ef\u00ee\u00e2\u00e5\u00f1\u00f2\u00fc. - \u00d1. 45-74; \u00d1\u00ee\u00f5\u00f0\u00e0\u00ed\u00e8 \u00ec\u00ee\u00e9 \u00e0\u00eb\u00fc\u00f4\u00e0-\u00e2\u00e7\u00e3\u00eb\u00ff\u00e4 : \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7. - \u00d1. 75-80; \u00cf\u00ff\u00f2\u00e0\u00ff \u00e3\u00f0\u00f3\u00ef\u00ef\u00e0 \u00ea\u00f0\u00ee\u00e2\u00e8 : \u00ec\u00e0\u00eb\u00ee\u00f4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7. - \u00d1. 80-86 // \u00c7\u00e0\u00e1\u00e5\u00e3 \u00f1 \u00e4\u00f0\u00e0\u00ea\u00ee\u00ed\u00ee\u00ec : \u00f4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2. \u00ef\u00ee\u00e2\u00e5\u00f1\u00f2\u00e8 \u00e8 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00ce\u00eb\u00e5\u00e3 \u00d6\u00e5\u00eb\u00e5\u00e1\u00f0\u00ee\u00e2\u00f1\u00ea\u00e8\u00e9. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff, 1991. - 167 \u00f1. - (\u00d4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2\u00e8\u00ea\u00e0). \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00cf\u00ff\u00f2\u00e0\u00ff \u00e3\u00f0\u00f3\u00ef\u00ef\u00e0 \u00ea\u00f0\u00ee\u00e2\u00e8 ; \u00d1\u00ee\u00f5\u00f0\u00e0\u00ed\u00e8 \u00ec\u00ee\u00e9 \u00e0\u00eb\u00fc\u00f4\u00e0-\u00e2\u00e7\u00e3\u00eb\u00ff\u00e4 : \u00e4\u00e2\u00e0 \u00ec\u00e0\u00eb\u00ee\u00f4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2. \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00e0 / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed // \u0412\u00f1\u00f2\u00f0\u00e5\u00f7\u00e8 : \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e9 \u00e0\u00eb\u00fc\u00ec\u00e0\u00ed\u00e0\u00f5 . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea, 1991. - \u00d1.296-305 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00ce\u00e7\u00e5\u00f0\u00ee ; \u00ca\u00e8\u00e6\u00e8 ; \u00c1\u00e0\u00e1\u00f3\u00f8\u00ea\u00e0 \u0412\u00e5\u00f0\u00e0 ; \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e9 \u00f8\u00eb\u00ff\u00e3\u00e5\u00f0 ; \u00ab\u00cc\u00e5\u00e4\u00eb\u00e5\u00ed\u00ed\u00ee \u00f1\u00e4\u00e2\u00e8\u00e3\u00e0\u00e5\u00f2 \u00f7\u00e8\u00f1\u00eb\u00e0...\u00bb : [\u00f1\u00f2\u00e8\u00f5\u00e8] / \u00d1. \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed // \u00ca\u00f3\u00f0\u00fc\u00e5\u00f0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. - 2003. - 25 \u00e0\u00ef\u00f0. - \u00d1. 4 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00ab\u00ca\u00e0\u00e6\u00e4\u00ee\u00e3\u00ee \u00ca\u00e0\u00ff \u00e6\u00e4\u00e5\u00f2 \u00f1\u00e2\u00ee\u00ff \u00c3\u00e5\u00f0\u00e4\u00e0...\u00bb ; \u00c3\u00f0\u00e0\u00f4\u00f1\u00ea\u00e8\u00e5 \u00f5\u00f0\u00ee\u00ed\u00e8\u00ea\u00e8 ; \u00ab\u00ce\u00e7\u00ff\u00e1\u00f8\u00e0\u00ff \u00e1\u00ff\u00e7\u00fc \u00ef\u00e5\u00f0\u00e5\u00eb\u00e5\u00f1\u00ea\u00e0...\u00bb : [\u00d1\u00f2\u00e8\u00f5\u00e8] / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed // \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e9 \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2. - 2003. - 26 \u00e4\u00e5\u00ea. \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00c0 \u00e2\u00f0\u00e5\u00ec\u00ff \u00e2\u00ee\u00e8\u00f1\u00f2\u00e8\u00ed\u00f3 \u00eb\u00e5\u00f7\u00e8\u00f2... : [\u00f1\u00f2\u00e8\u00f5\u00e8] / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed // \u00ca\u00f3\u00f0\u00fc\u00e5\u00f0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. - 2004. - 14 \u00e0\u00e2\u00e3. - \u00d1. 4 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed, \u00d1. \u00ab\u00c0 \u00ed\u00e5\u00e1\u00e0 \u00f0\u00e5\u00e3\u00e8\u00f1\u00f2\u00f0\u00fb \u00ee\u00f2\u00e2\u00e5\u00f0\u00f1\u00f2\u00fb ...\u00bb : [\u00f1\u00f2\u00e8\u00f5\u00e8] / \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed // \u00cb\u00e8\u00f6\u00e5\u00e9. - 2006. - \u00c0\u00e2\u00e3./\u00f1\u00e5\u00ed\u00f2. (\u00b9 8/9). - \u00d1. 19 \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00cc\u00e5\u00e4\u00e8\u00e0\u00e3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00c2 \u00ee\u00e1\u00fa\u00e5\u00ea\u00f2\u00e8\u00e2\u00e5 \u00f4\u00ee\u00f2\u00ee\u00ea\u00e0\u00ec\u00e5\u00f0\u00fb \u00d1\u00e5\u00f0\u00e3\u00e5\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00e0 - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ec\u00e0\u00f8 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e8\u00e5 \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e8 \u00d1\u00e5\u00f0\u00e3\u00e5\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00e0 \u00d7\u00eb\u00e5\u00ed\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00f0\u00e5\u00e3\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00e0 \u00d1\u00ee\u00fe\u00e7\u00e0 \u00f0\u00ee\u00f1\u00f1\u00e8\u00e9\u00f1\u00ea\u00e8\u00f5 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 (\u00ca\u00d0\u00cf \u00d1\u00d0\u00cf) \u00ef\u00ee\u00f1\u00eb\u00e5 \u00ee\u00e1\u00f9\u00e5\u00e3\u00ee \u00f1\u00ee\u00e1\u00f0\u00e0\u00ed\u00e8\u00ff \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed \u00e8 \u00cd\u00e0\u00e4\u00e5\u00e6\u00e4\u00e0 \u00c2\u00e0\u00f1\u00e8\u00eb\u00fc\u00e5\u00e2\u00e0 \u00ed\u00e0 \u00ef\u00f0\u00e5\u00e7\u00e5\u00ed\u00f2\u00e0\u00f6\u00e8\u00e8 \u00ea\u00ed\u00e8\u00e3\u00e8 \u00cd\u00e0\u00e4\u00e5\u00e6\u00e4\u00fb \u00c2\u00e0\u00f1\u00e8\u00eb\u00fc\u00e5\u00e2\u00ee\u00e9 \u00ab\u00ca\u00ee\u00e3\u00e4\u00e0 \u00e0\u00ed\u00e3\u00e5\u00eb\u00fb \u00ef\u00ee\u00fe\u00f2\u00bb. \u00c0\u00ea\u00f2\u00ee\u00e2\u00fb\u00e9 \u00e7\u00e0\u00eb \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00ec\u00f3\u00e7\u00e5\u00ff \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00c2\u00e5\u00e4\u00f3\u00f9\u00e8\u00e5 \u00ee\u00e4\u00ed\u00ee\u00e3\u00ee \u00e8\u00e7 \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00ea\u00e8\u00f5 \u00e2\u00e5\u00f7\u00e5\u00f0\u00ee\u00e2 \u00ca\u00d0\u00cf \u00d1\u00d0\u00cf: \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9  \u00c3\u00e5\u00ed\u00f0\u00e8\u00f5\u00ee\u00e2\u00e8\u00f7 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed \u00e8 \u00c2\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ed\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e2\u00ed\u00e0 \u00cb\u00e0\u00ef\u00e8\u00f7\u00ea\u00ee\u00e2\u00e0  \u0097 \u00ed\u00e0 \u00f1\u00f6\u00e5\u00ed\u00e5 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e3\u00ee \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00ea\u00ee\u00eb\u00eb\u00e5\u00e4\u00e6\u00e0 \u00e8\u00ec. \u00ca.\u00dd. \u00d0\u00e0\u00f3\u00f2\u00e8\u00ee \u00c2\u00e8\u00e7\u00e8\u00f2 \u00f0\u00f3\u00ea\u00ee\u00e2\u00ee\u00e4\u00e8\u00f2\u00e5\u00eb\u00e5\u00e9 \u00d1\u00ee\u00fe\u00e7\u00e0 \u00f0\u00ee\u00f1\u00f1\u00e8\u00e9\u00f1\u00ea\u00e8\u00f5 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00d1\u00e2\u00e5\u00f2\u00eb\u00e0\u00ed\u00fb \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00ee\u00e2\u00ed\u00fb \u00c2\u00e0\u00f1\u00e8\u00eb\u00e5\u00ed\u00ea\u00ee \u00e8 \u00cb\u00e5\u00e2\u00ee\u00ed\u00e0 \u00ce\u00e3\u00e0\u00ed\u00e5\u00f1\u00ee\u00e2\u00e8\u00f7\u00e0 \u00ce\u00f1\u00e5\u00ef\u00ff\u00ed\u00e0 \u00e2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea \u00ed\u00e0 10-\u00eb\u00e5\u00f2\u00ed\u00e8\u00e9 \u00fe\u00e1\u00e8\u00eb\u00e5\u00e9 \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00f0\u00e5\u00e3\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00e0 \u00d1\u00d0\u00cf. \u00d0\u00f3\u00f1\u00ea\u00e5\u00e0\u00eb\u00e0. \u00cf\u00e5\u00f9\u00e5\u00f0\u00e0 \u00cc\u00f0\u00e0\u00ec\u00ee\u00f0\u00ed\u00ee\u00e3\u00ee \u00ea\u00e0\u00ed\u00fc\u00ee\u00ed\u00e0 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c3\u00f0\u00e0\u00f4\u00f1\u00ea\u00e8\u00e5 \u00f5\u00f0\u00ee\u00ed\u00e8\u00ea\u00e8 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e8\u00e9 \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea \u00f6\u00e8\u00ea\u00eb\u00ee\u00e2 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 Mess Poem \u00cf\u00ee\u00fd\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00fd\u00ea\u00f1\u00ef\u00e5\u00f0\u00e8\u00ec\u00e5\u00ed\u00f2 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00ab\u00df \u00f7\u00e5\u00f0\u00e5\u00e7 2 \u00e3\u00ee\u00e4\u00e0 \u00e2\u00e5\u00f0\u00ed\u00f3\u00f1\u00fc\u0085\u00bb  \u00cf\u00e5\u00f2\u00f0 \u00cf\u00ee\u00e2\u00e0\u00eb\u00ff\u00e5\u00e2 \u0096 \u00ef\u00e8\u00f1\u00fc\u00ec\u00e0 \u00e8\u00e7 \u00e0\u00f0\u00ec\u00e8\u00e8 (1939-1941) \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c3\u00e5\u00f4\u00f1\u00e8\u00ec\u00e0\u00ed\u00f1\u00ea\u00e8\u00e9 \u00f1\u00e0\u00e4 \u00cf\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4 \u00f1 \u00e0\u00ed\u00e3\u00eb\u00e8\u00e9\u00f1\u00ea\u00ee\u00e3\u00ee \u00f1\u00f2\u00e8\u00f5\u00ee\u00f2\u00e2\u00ee\u00f0\u00e5\u00ed\u00e8\u00ff \u00d0. \u00ca\u00e8\u00ef\u00eb\u00e8\u00ed\u00e3\u00e0 \u00c3\u00f0\u00f3\u00f1\u00f2\u00ed\u00fb\u00e9 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00cf\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00fb \u00d1\u00e5\u00f0\u00e3\u00e5\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00e0 \u00cf\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00fb \u00f1\u00f2\u00e8\u00f5\u00ee\u00f2\u00e2\u00ee\u00f0\u00e5\u00ed\u00e8\u00e9 \u00d1\u00e8\u00eb\u00fc\u00e2\u00e8\u00e8 \u00cf\u00eb\u00e0\u00f2, \u00d0\u00e5\u00e4\u00fc\u00ff\u00f0\u00e4\u00e0 \u00ca\u00e8\u00ef\u00eb\u00e8\u00ed\u00e3\u00e0, \u00dd\u00ec\u00e8\u00eb\u00e8 \u00c4\u00e8\u00ea\u00e8\u00ed\u00f1\u00ee\u00ed, \u00d3\u00ee\u00eb\u00f2\u00e5\u00f0\u00e0 \u00d0\u00fd\u00eb\u00e8, \u00cf\u00e8\u00f2\u00e0 \u00d1\u00e8\u00e3\u00e5\u00f0\u00e0, \u00c2\u00e0\u00e6\u00e8 \u00cf\u00f8\u00e0\u00e2\u00e5\u00eb\u00fb. \u00c2\u00e5\u00f0\u00e0 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00e0 \u00ab\u00cd\u00ee \u00e2\u00ee\u00ef\u00f0\u00e5\u00ea\u00e8 \u00e2\u00f1\u00e5\u00ec\u00f3 \u00e6\u00e8\u00e2\u00f3\u00bb, \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed \u00ab\u00c1\u00e0\u00e1\u00f3\u00f8\u00ea\u00e0 \u00c2\u00e5\u00f0\u00e0\u00bb \u00c2 \u00fd\u00f2\u00ee\u00e9 \u00ea\u00ed\u00e8\u00e6\u00ea\u00e5 \u00f1\u00ee\u00f8\u00eb\u00e8\u00f1\u00fc \u00f1\u00f2\u00e8\u00f5\u00e8 \u00e1\u00e0\u00e1\u00f3\u00f8\u00ea\u00e8 \u00e8 \u00e2\u00ed\u00f3\u00ea\u00e0: \u00c2\u00e5\u00f0\u00fb \u00e8 \u00d1\u00e5\u00f0\u00e3\u00e5\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00fb\u00f5. \u00ca\u00f0\u00ee\u00ec\u00e5 \u00f2\u00ee\u00e3\u00ee, \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00eb\u00e5\u00ed \u00e1\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00ee\u00f7\u00e5\u00f0\u00ea \u00ee \u00c2\u00e5\u00f0\u00e5 \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00ee\u00e9 \u00e8 \u00e5\u00e5 \u00f1\u00e5\u00ec\u00fc\u00e5. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cf\u00e0\u00ec\u00ff\u00f2\u00e8 \u00d1\u00e5\u00f0\u00e3\u00e5\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00e0 \u00c0\u00e2\u00f2\u00ee\u00f0\u00fb \u00e2\u00ee\u00f1\u00ef\u00ee\u00ec\u00e8\u00ed\u00e0\u00ed\u00e8\u00e9 \u00ee \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5, \u00ef\u00ee\u00fd\u00f2\u00e5, \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea\u00e5 - \u00cd\u00e0\u00e4\u00e5\u00e6\u00e4\u00e0 \u00c2\u00e0\u00f1\u00e8\u00eb\u00fc\u00e5\u00e2\u00e0, \u00cb\u00e5\u00ee\u00ed\u00e8\u00e4 \u00c0\u00e2\u00ea\u00f1\u00e5\u00ed\u00f2\u00fc\u00e5\u00e2 \u00cf\u00e0\u00ec\u00ff\u00f2\u00e8 \u00d1\u00e5\u00f0\u00e3\u00e5\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00e0: \u00ef\u00e5\u00f1\u00ed\u00e8 \u00ed\u00e0 \u00f1\u00f2\u00e8\u00f5\u00e8 \u00d1\u00e5\u00f0\u00e3\u00e5\u00ff \u00c0\u00f0\u00ea\u00e0\u00e2\u00e8\u00ed\u00e0 \u00e2 \u00e8\u00f1\u00ef\u00ee\u00eb\u00ed\u00e5\u00ed\u00e8\u00e8 \u00cd\u00e0\u00e4\u00e5\u00e6\u00e4\u00fb \u00c2\u00e0\u00f1\u00e8\u00eb\u00fc\u00e5\u00e2\u00ee\u00e9 \u00c0\u00e2\u00f2\u00ee\u00f0 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e8: \u00cd\u00e0\u00e4\u00e5\u00e6\u00e4\u00e0 \u00c2\u00e0\u00f1\u00e8\u00eb\u00fc\u00e5\u00e2\u00e0, \u00e0\u00f0\u00e0\u00ed\u00e6\u00e8\u00f0\u00ee\u00e2\u00ea\u00e0: \u00df\u00f0\u00ee\u00f1\u00eb\u00e0\u00e2 \u00ca\u00f3\u00f7\u00ea\u00ee \u00c0 \u00ed\u00e5\u00e1\u00e0 \u00f0\u00e5\u00e3\u00e8\u00f1\u00f2\u00f0\u00fb \u00ee\u00f2\u00e2\u00e5\u00f0\u00f1\u00f2\u00fb \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00d1\u00f2\u00e8\u00f5\u00e8 \u00e3\u00ee\u00f1\u00ef\u00ee\u00e6\u00e5 \u00c0\u00ec\u00ed\u00e5\u00e7\u00e8 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00c2\u00f1\u00f2\u00f0\u00e5\u00f7\u00e0 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00c8\u00e7 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0 \u00ab\u00c6\u00e4\u00f3\u00f9\u00e8\u00e5 \u00f7\u00f3\u00e4\u00e0\u00bb \u00d4\u00f0\u00e0\u00e3\u00ec\u00e5\u00ed\u00f2\u00fb \u00e8\u00e7 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0 \u00e2\u00fb\u00e1\u00f0\u00e0\u00ed\u00fb \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00ec \u00c8\u00e7 \u00d1\u00e8\u00eb\u00fc\u00e2\u00e8\u00e8 \u00cf\u00eb\u00e0\u00f2 \u00cf\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4 \u00f1\u00f2\u00e8\u00f5\u00ee\u00f2\u00e2\u00ee\u00f0\u00e5\u00ed\u00e8\u00ff \u00d1\u00e8\u00eb\u00fc\u00e2\u00e8\u00e8 \u00cf\u00eb\u00e0\u00f2 - \u00e0\u00ec\u00e5\u00f0\u00e8\u00ea\u00e0\u00ed\u00f1\u00ea\u00ee\u00e3\u00ee \u00ef\u00ee\u00fd\u00f2\u00e0 \u00e8 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00ff \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c7\u00e8\u00ec\u00ed\u00e8\u00e9 \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00d1\u00e5\u00f0\u00e3\u00e5\u00e9 \u00cb\u00ee\u00e1\u00e0\u00ed\u00ee\u00e2 - \u00e3\u00f0\u00e0\u00e6\u00e4\u00e0\u00ed\u00e8\u00ed \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00d8\u00ca\u00c8\u00c4. \u00cf\u00e8\u00f1\u00fc\u00ec\u00ee \u00ee\u00f2 \u00cc. \u00c7\u00ee\u00f9\u00e5\u00ed\u00ea\u00ee. \u00cf\u00e8\u00f1\u00fc\u00ec\u00e0 \u00cb. \u00cf\u00e0\u00ed\u00f2\u00e5\u00eb\u00e5\u00e5\u00e2\u00e0 \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d7\u00e5\u00eb\u00ee\u00e2\u00e5\u00ea \u00ef\u00eb\u00fb\u00eb \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

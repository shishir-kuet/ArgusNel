{
  "url": "http://avtor.karelia.ru/about/sudakov_vladimir.html",
  "title": "\u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00cf\u00e0\u00e2\u00eb\u00ee\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00cf\u00e0\u00e2\u00eb\u00ee\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00cf\u00e0\u00e2\u00eb\u00ee\u00e2\u00e8\u00f7 ( 19.04.1952 - 10.05.2021 ) \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00d1\u00ee\u00f0\u00f2\u00e0\u00e2\u00e0\u00eb\u00e0 \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00cf\u00ee\u00fd\u00f2, \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea, \u00f7\u00eb\u00e5\u00ed \u00d1\u00ee\u00fe\u00e7\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00f1 1993 \u00e3\u00ee\u00e4\u00e0, \u00a0\u00f7\u00eb\u00e5\u00ed \u00d1\u00ee\u00fe\u00e7\u00e0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00ee\u00e2 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8. \u00cf\u00ee\u00f1\u00eb\u00e5 \u00f1\u00eb\u00f3\u00e6\u00e1\u00fb \u00e2 \u00e0\u00f0\u00ec\u00e8\u00e8 \u00ee\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea\u00ee-\u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f4\u00e0\u00ea\u00f3\u00eb\u00fc\u00f2\u00e5\u00f2 \u00cf\u00e5\u00f2\u00f0\u00c3\u00d3. \u00d0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00e2 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5 \u00eb\u00fe\u00e1\u00e8\u00f2\u00e5\u00eb\u00e5\u00e9 \u00ea\u00ed\u00e8\u00e3\u00e8 \u00e8 \u00ee\u00f5\u00f0\u00e0\u00ed\u00fb \u00ef\u00e0\u00ec\u00ff\u00f2\u00ed\u00e8\u00ea\u00ee\u00e2 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 \u00e8 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb (\u0412\u00ce\u00ce\u00cf\u00e8\u00ca), \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00ee\u00ec \u00e2 \u00e3\u00e0\u00e7\u00e5\u00f2\u00e0\u00f5 \u00ab\u00ca\u00ee\u00ec\u00ec\u00f3\u00ed\u00e8\u00f1\u00f2 \u00cf\u00f0\u00e8\u00ee\u00ed\u00e5\u00e6\u00fc\u00ff\u00bb, \u00ab\u00ca\u00f0\u00e0\u00f1\u00ed\u00ee\u00e5 \u00c7\u00ed\u00e0\u00ec\u00ff\u00bb (\u00d1\u00ee\u00f0\u00f2\u00e0\u00e2\u00e0\u00eb\u00e0). \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2 \u00f1\u00ee\u00f2\u00f0\u00f3\u00e4\u00ed\u00e8\u00f7\u00e0\u00e0\u00eb \u00f1 \u00a0\u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00ee\u00ec \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb, \u00ff\u00e2\u00eb\u00ff\u00eb\u00f1\u00ff \u00ee\u00e4\u00ed\u00e8\u00ec \u00e8\u00e7 \u00e8\u00ed\u00e8\u00f6\u00e8\u00e0\u00f2\u00ee\u00f0\u00ee\u00e2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e2 \u00d1\u00ee\u00f0\u00f2\u00e0\u00e2\u00e0\u00eb\u00e5 \u00ea\u00f0\u00e0\u00e5\u00e2\u00e5\u00e4\u00f7\u00e5\u00f1\u00ea\u00ee\u00e3\u00ee \u00ec\u00f3\u00e7\u00e5\u00ff \u00e8 \u00d1\u00ee\u00f0\u00f2\u00e0\u00e2\u00e0\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00e7\u00e5\u00ec\u00eb\u00ff\u00f7\u00e5\u00f1\u00f2\u00e2\u00e0 \u00e2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5. \u00c0\u00e2\u00f2\u00ee\u00f0 \u00ef\u00ff\u00f2\u00e8 \u00ef\u00ee\u00fd\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00f5 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00ee\u00e2, \u00ef\u00f3\u00e1\u00eb\u00e8\u00f6\u00e8\u00f1\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00f5 \u00ee\u00f7\u00e5\u00f0\u00ea\u00ee\u00e2, \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0-\u00f1\u00ee\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00fc \u00f8\u00e5\u00f1\u00f2\u00e8 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00ee\u00e2 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00e4\u00f0\u00f3\u00e3\u00e8\u00f5 \u00ef\u00ee\u00fd\u00f2\u00ee\u00e2. \u00d1\u00f2\u00e8\u00f5\u00e8 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00e8\u00eb\u00e8\u00f1\u00fc \u00ed\u00e0 \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00e9, \u00f4\u00e8\u00ed\u00f1\u00ea\u00e8\u00e9, \u00f8\u00e2\u00e5\u00e4\u00f1\u00ea\u00e8\u00e9 \u00ff\u00e7\u00fb\u00ea\u00e8. \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 : \u00e1\u00e8\u00ee\u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00ee\u00e2\u00e0\u00f0\u00fc / \u00ca\u00e0\u00f0\u00e5\u00eb. \u00ed\u00e0\u00f3\u00f7. \u00d6\u00e5\u00ed\u00f2\u00f0 \u00d0\u00c0\u00cd, \u00c8\u00ed-\u00f2 \u00ff\u00e7\u00fb\u00ea\u00e0, \u00eb\u00e8\u00f2. \u00e8 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8, \u00cc-\u00e2\u00ee \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e8 \u00ef\u00ee \u00f1\u00e2\u00ff\u00e7\u00ff\u00ec \u00f1 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00f1\u00f2\u00fc\u00fe ; [\u00f1\u00ee\u00f1\u00f2. \u00de. \u00c8. \u00c4\u00fe\u00e6\u00e5\u00e2 ]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2006. - \u00d1. 60-62. - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 234-235. - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea, \u00c0. \u0412\u00e5\u00f0\u00ed\u00ee\u00f1\u00f2\u00fc \u00ee\u00f2\u00f7\u00e5\u00ec\u00f3 \u00e4\u00ee\u00ec\u00f3 : \u00e2 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e5 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00f1\u00ee\u00f1\u00f2\u00ee\u00ff\u00eb\u00f1\u00ff \u00e2\u00e5\u00f7\u00e5\u00f0, \u00ef\u00ee\u00f1\u00e2\u00ff\u00f9\u00e5\u00ed\u00ed\u00fb\u00e9 60-\u00eb\u00e5\u00f2\u00e8\u00fe \u00ef\u00ee\u00fd\u00f2\u00e0 \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2\u00e0 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea // \u00d2\u0412\u00d0-\u00cf\u00e0\u00ed\u00ee\u00f0\u00e0\u00ec\u00e0. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea, 2012. - 9 \u00ec\u00e0\u00ff (\u00b9 19). - \u00d1. 23 \u00d2\u00e0\u00f0\u00e0\u00ea\u00e0\u00ed\u00ee\u00e2, \u00ce. \u00ab\u00c6\u00e8\u00e2\u00f3 \u00e2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5, \u00e0 \u00f1\u00e5\u00f0\u00e4\u00f6\u00e5 \u00e2 \u00d1\u00e5\u00f0\u00e4\u00ee\u00e1\u00ee\u00eb\u00e5\u00bb : [\u00ee \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5 \u0412. \u00cf. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2\u00e5] / \u00ce\u00eb\u00e5\u00e3 \u00d2\u00e0\u00f0\u00e0\u00ea\u00e0\u00ed\u00ee\u00e2 // \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. - 2009. - 29 \u00ff\u00ed\u00e2. - \u00d1. 26 \u0412\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2, \u00c4. \u0412\u00e5\u00ed\u00e5\u00f6- \u00ea \u00e2\u00e5\u00ed\u00f6\u00f3, \u00f1\u00eb\u00ee\u00e2\u00ee- \u00ea \u00f1\u00eb\u00ee\u00e2\u00f3 : \u00ce \u00ea\u00ed. \u0412. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2\u00e0 \"\u00d2\u00e2\u00e5\u00f0\u00e4\u00fc\" / \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00e5\u00f1\u00ee\u00e2 // \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. - 2004. - 21 \u00f4\u00e5\u00e2\u00f0. - \u00d1. 9 \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 234-235. - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2, \u0412. \u00cf. (1952). \u00ca\u00f3\u00f5\u00e0 : [\u00e8\u00e7\u00e1\u00f0\u00e0\u00ed\u00ed\u00fb\u00e5 \u00f1\u00f2\u00e8\u00f5\u00e8] / \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : Verso, 2009. - 265 \u00f1. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2, \u0412. \u00cf. \u00cc\u00f3\u00e7\u00e5\u00e9 \u00e4\u00ee \u00ec\u00f3\u00e7\u00e5\u00ff / \u0412. \u00cf. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2 // \u00d1\u00ee\u00f0\u00f2\u00e0\u00e2\u00e0\u00eb\u00fc\u00f1\u00ea\u00e8\u00e9 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea, 2005. - \u0412\u00fb\u00ef. 1. - \u00d1. 211-229. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2, \u0412.\u00cf. \u00d1\u00e5\u00f0\u00e4\u00ee\u00e1\u00ee\u00eb\u00fc : \u00d1\u00f2\u00e8\u00f5\u00e8 / \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2. - \u00cc. : \u00cc\u00ee\u00eb. \u00e3\u00e2\u00e0\u00f0\u00e4\u00e8\u00ff, 1987. - 30 \u00f1. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2, \u0412.\u00cf. \u00d2\u00e5\u00ef\u00eb\u00e0\u00ff \u00e7\u00e5\u00ec\u00eb\u00ff : \u00d1\u00f2\u00e8\u00f5\u00e8 / \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff, 1985. - 38 \u00f1. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2, \u0412.\u00cf. \u00d2\u00e2\u00e5\u00f0\u00e4\u00fc : \u00d1\u00f2\u00e8\u00f5\u00e8 / \u0412.\u00cf. \u00d1\u00f3\u00e4\u00e0\u00ea\u00ee\u00e2 ; \u00d5\u00f3\u00e4\u00ee\u00e6. \u00cd. \u00d2\u00f0\u00f3\u00f5\u00e8\u00ed. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff, 2003. - 126 \u00f1. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00d2\u00f0\u00e8\u00ef\u00f2\u00e8\u00f5 \u00ee \u00cb\u00ee\u00e1\u00e0\u00ed\u00ee\u00e2\u00f1\u00ea\u00ee\u00e9 \u00ef\u00eb\u00ee\u00f2\u00e8\u00ed\u00e5 \u00c2\u00e5\u00f2\u00e5\u00f0, \u00f1\u00f3\u00e6\u00e5\u00ed\u00fb\u00e9 \u00ec\u00ee\u00e9... (\u00ce\u00ed \u00e8 \u00ce\u00ed\u00e0) \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00ab\u00c2 \u00ea\u00e0\u00e6\u00e4\u00fb\u00e9 \u00f3\u00f2\u00f0\u00e5\u00ed\u00ed\u00e8\u00e9 \u00ef\u00f0\u00e0\u00e7\u00e4\u00ed\u00e8\u00ea \u00cf\u00ee\u00e1\u00e5\u00e4\u00fb\u0085 \u00bb \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

{
  "url": "http://a-jidkov.ru/category/chernovik",
  "title": "\u0410\u0440\u0445\u0438\u0432\u044b \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a - \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u0416\u0438\u0434\u043a\u043e\u0432",
  "text": "\u0410\u0440\u0445\u0438\u0432\u044b \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a - \u0410\u043b\u0435\u043a\u0441\u0435\u0439 \u0416\u0438\u0434\u043a\u043e\u0432 \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0413\u043e\u0440\u0434\u044b\u0435 \u0433\u0443\u0441\u0435\u043d\u0438\u0446\u044b \u043a\u043e\u043b\u043b\u0435\u043a\u0446\u0438\u043e\u043d\u0438\u0440\u0443\u044e\u0442 \u0431\u0430\u0431\u043e\u0447\u0435\u043a. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u2014 \u042f \u0442\u0435\u0431\u044f \u043b\u044e\u0431\u043b\u044e! \u2014 \u0418 \u044f \u0442\u0435\u0431\u044f \u043b\u044e\u0431\u043b\u044e! \u2014 \u042f \u0442\u0435\u0431\u044f \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u043b\u044e! \u2014 \u0418 \u044f \u0442\u0435\u0431\u044f \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u043b\u044e! \u2014 \u042f \u0442\u0435\u0431\u044f \u043e\u0447\u0435\u043d\u044c-\u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u043b\u044e! \u2014 \u0418 \u044f \u0442\u0435\u0431\u044f \u043e\u0447\u0435\u043d\u044c-\u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u043b\u044e! \u2014 \u042f \u0442\u0435\u0431\u044f \u043e\u0447\u0435\u043d\u044c-\u043e\u0447\u0435\u043d\u044c-\u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u043b\u044e!\u2026 \u0420\u0430\u0437\u043d\u043e\u0441\u044f\u0442 \u043a\u0440\u0443\u0433\u0438 \u043d\u0430 \u0432\u043e\u0434\u0435 \u043f\u0440\u0438\u0437\u043d\u0430\u043d\u0438\u044f \u041c\u0443-\u043c\u0443 \u0438 \u0413\u0435\u0440\u0430\u0441\u0438\u043c\u0430. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u041c\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043c\u043e\u0436\u0435\u043c \u043a\u0440\u0438\u043a\u043d\u0443\u0442\u044c: \u00ab\u041e\u0441\u0430\u043d\u043d\u0430!\u00bb \u041c\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043c\u043e\u0436\u0435\u043c \u043a\u0440\u0438\u043a\u043d\u0443\u0442\u044c: \u00ab\u0420\u0430\u0441\u043f\u043d\u0438 \u0435\u0433\u043e!\u00bb \u041d\u0438 \u0442\u043e\u0433\u043e, \u043d\u0438 \u0434\u0440\u0443\u0433\u043e\u0433\u043e \u043c\u044b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0434\u0435\u043b\u0430\u0435\u043c. \u0420\u0442\u044b \u043d\u0430\u0448\u0438 \u0437\u0430\u0431\u0438\u0442\u044b. \u0413\u043b\u0430\u0437\u0430 \u043d\u0430\u0448\u0438 \u0441\u043e\u043d\u043d\u044b. \u041c\u0438\u0440 \u043d\u0430\u0448 \u043c\u0443\u0442\u0435\u043d. \u041d\u0430\u043c \u0445\u043e\u0440\u043e\u0448\u043e. \u041d\u0430\u0441 \u0432\u043f\u043e\u043b\u043d\u0435 \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442 \u043d\u0430\u0448 \u043f\u0438\u043a-\u043d\u0438\u043a. \u041d\u0430\u0448 \u0431\u043e\u0433\u0430\u0442\u044b\u0439 \u043f\u0438\u043a\u043d\u0438\u043a. \u0421 \u043f\u0440\u0435\u043a\u0440\u0430\u0441\u043d\u044b\u043c \u0432\u0438\u0434\u043e\u043c \u043d\u0430 \u0413\u043e\u043b\u0433\u043e\u0444\u0443. \u0423\u0449\u0438\u043f\u043d\u0438 \u043c\u0435\u043d\u044f, \u0413\u043e\u0441\u043f\u043e\u0434\u0438\u2026 \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0413\u0443\u0441\u0435\u043d\u0438\u0446\u0430 \u043e\u0447\u0435\u043d\u044c \u043b\u044e\u0431\u0438\u043b\u0430 \u0444\u043e\u0442\u043a\u0430\u0442\u044c\u0441\u044f. \u041e\u043d\u0430 \u0444\u043e\u0442\u043a\u0430\u043b\u0430\u0441\u044c \u043d\u0430 \u0431\u0435\u0440\u0451\u0437\u0435. \u041d\u0430 \u0442\u043e\u043f\u043e\u043b\u0435. \u041d\u0430 \u043a\u043b\u0451\u043d\u0435. \u041d\u0430 \u044f\u0441\u0435\u043d\u0435. \u041d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u0442\u0440\u0430\u0432\u0438\u043d\u043a\u0430\u0445. \u041d\u0430 \u0440\u0430\u0437\u043d\u044b\u0445 \u0446\u0432\u0435\u0442\u043e\u0447\u043a\u0430\u0445. \u041e\u043d\u0430 \u0444\u043e\u0442\u043a\u0430\u043b\u0430\u0441\u044c \u0432\u0435\u0437\u0434\u0435, \u0433\u0434\u0435 \u0436\u0438\u043b\u0430 \u0438 \u0435\u043b\u0430. \u041e\u043d\u0430 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u043b\u0430 \u0444\u043e\u0442\u043a\u0438 \u0434\u0440\u0443\u0433\u0438\u043c \u0433\u0443\u0441\u0435\u043d\u0438\u0446\u0430\u043c. \u0410 \u0434\u0440\u0443\u0433\u0438\u0435 \u0433\u0443\u0441\u0435\u043d\u0438\u0446\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u043b\u0438 \u0435\u0439 \u0441\u0432\u043e\u0438 \u0444\u043e\u0442\u043a\u0438. \u041e\u0431\u0449\u0435\u043c\u0443 \u0441\u0447\u0430\u0441\u0442\u044c\u044e \u043d\u0430 \u0437\u0435\u043c\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u2026 \u0410 \u0432 \u043d\u0435\u0431\u0435 \u043f\u0430\u0445\u043b\u043e \u0433\u0440\u043e\u0437\u043e\u0439. \u0410 \u0432 \u043d\u0435\u0431\u0435 \u043f\u043e\u0440\u0445\u0430\u043b\u0438 \u0431\u0430\u0431\u043e\u0447\u043a\u0438. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u00ab\u0416\u0438\u0437\u043d\u044c \u043d\u0430\u0434\u043e \u043f\u0440\u043e\u0436\u0438\u0442\u044c \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u0432 \u043a\u043e\u043d\u0446\u0435 \u0435\u0451 \u0442\u044b \u043c\u043e\u0433 \u0447\u0435\u0441\u0442\u043d\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0442\u044c\u0441\u044f \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0435\u0431\u0435: \u00ab\u0418\u043b\u044e\u0448\u0430 \u0431\u044b\u043b \u043f\u0440\u0430\u0432!\u00bb\u00bb (\u0410.\u0428\u0442\u043e\u043b\u044c\u0446) \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u041d\u0430\u0447\u0438\u043d\u0430\u043b \u0436\u0438\u0442\u044c \u0441 \u0443\u0434\u0438\u0432\u043b\u0435\u043d\u0438\u0435\u043c. \u0417\u0430\u043a\u0430\u043d\u0447\u0438\u0432\u0430\u044e \u2014 \u0441 \u043d\u0435\u0434\u043e\u0443\u043c\u0435\u043d\u0438\u0435\u043c. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u041b\u0438\u0448\u044c \u043e\u0434\u0438\u043d \u044f\u0437\u044b\u043a \u0434\u043e\u0441\u0442\u043e\u0438\u043d \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u044f. \u042d\u0442\u043e \u044f\u0437\u044b\u043a \u043a\u043e\u043b\u043e\u043a\u043e\u043b\u0430. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u041a\u0423\u0420\u041e\u0427\u041a\u0410 \u0420\u042f\u0411\u0410 \u042f\u0439\u0446\u043e \u043f\u043b\u043e\u0445\u043e \u043e\u0442\u0447\u0438\u0449\u0430\u043b\u043e\u0441\u044c \u043e\u0442 \u0441\u043a\u043e\u0440\u043b\u0443\u043f\u044b. \u00ab\u041f\u043e\u0437\u0434\u043d\u043e \u043e\u0441\u0442\u0443\u0434\u0438\u043b\u00bb, \u2014 \u043f\u043e\u0434\u0443\u043c\u0430\u043b \u0414\u0440\u043e\u043d. \u0414\u0440\u043e\u043d\u044f \u0431\u044b\u043b \u043e\u0447\u0435\u043d\u044c \u0433\u043e\u043b\u043e\u0434\u0435\u043d. \u042f\u0439\u0446\u043e \u0431\u044b\u043b\u043e \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u043c. \u0414\u0440\u043e\u043d\u044f \u0437\u0430\u043f\u0438\u0445\u043d\u0443\u043b \u044f\u0439\u0446\u043e \u0446\u0435\u043b\u0438\u043a\u043e\u043c \u0432 \u0440\u043e\u0442. \u042f\u0439\u0446\u043e \u043f\u0440\u043e\u0441\u043a\u043e\u043b\u044c\u0437\u043d\u0443\u043b\u043e \u0432 \u0433\u043b\u043e\u0442\u043a\u0443. \u0414\u0440\u043e\u043d\u044f \u0440\u0430\u043d\u043e \u0432\u0434\u043e\u0445\u043d\u0443\u043b \u043e\u0442 \u0432\u043e\u0437\u043c\u0443\u0449\u0435\u043d\u0438\u044f. \u0421\u0442\u0430\u043b\u043e \u043f\u043e\u0437\u0434\u043d\u043e. \u042f\u0439\u0446\u043e \u043d\u0430\u043a\u0440\u0435\u043f\u043a\u043e \u043e\u0431\u043e\u0441\u043d\u043e\u0432\u0430\u043b\u043e\u0441\u044c \u043d\u0430\u0434 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0439 \u0449\u0435\u043b\u044c\u044e. \u0421\u0434\u0435\u043b\u0430\u043d\u043d\u043e\u0433\u043e \u0432\u0434\u043e\u0445\u0430 \u0445\u0432\u0430\u0442\u0438\u043b\u043e \u043d\u0435\u043d\u0430\u0434\u043e\u043b\u0433\u043e. \u0412\u044b\u0434\u043e\u0445 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0441\u044f. \u041d\u043e\u0432\u044b\u0439 \u0432\u0434\u043e\u0445 \u0431\u0435\u0437 \u0432\u044b\u0434\u043e\u0445\u0430 \u043d\u0435 \u043f\u043e\u043b\u0443\u0447\u0430\u043b\u0441\u044f \u0442\u043e\u0436\u0435. \u0414\u0440\u043e\u043d \u043f\u043e\u0434\u0430\u0432\u0438\u043b\u0441\u044f. \u041f\u043e\u0442\u043e\u043c \u0414\u0440\u043e\u043d\u044f \u043f\u043e\u043c\u0435\u0440. \u041f\u043e\u0442\u043e\u043c \u043d\u0430 \u043a\u0443\u0445\u043d\u044e \u0432\u043e\u0448\u043b\u0438 \u041a\u0443\u0440\u0438\u0446\u0430 \u0438 \u041c\u044b\u0448\u043a\u0430. \u041e\u043d\u0438 \u0437\u0430\u043a\u0440\u044b\u043b\u0438 \u0433\u043b\u0430\u0437\u0430 \u0414\u0440\u043e\u043d\u0443. \u041f\u043e\u0433\u043b\u044f\u0434\u0435\u043b\u0438 \u043d\u0430 \u043e\u0442\u043a\u0440\u044b\u0442\u0443\u044e \u0414\u0440\u043e\u043d\u0435\u0439, \u043d\u043e \u0435\u0449\u0451 \u043d\u0435 \u043d\u0430\u0447\u0430\u0442\u0443\u044e \u0438\u043c \u043f\u043e\u043b\u043b\u0438\u0442\u0440\u0443. \u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u043b\u0438\u0441\u044c. \u041f\u0438\u043b\u0438 \u043e\u043d\u0438 \u0434\u043e\u043b\u0433\u043e. \u0418 \u043c\u043e\u043b\u0447\u0430. \u0418 \u043c\u043d\u043e\u0433\u043e \u0434\u0443\u043c\u0430\u043b\u0438. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0427\u0442\u043e-\u0442\u043e \u0442\u0430\u043c, \u0437\u0430 \u043f\u043e\u0432\u043e\u0440\u043e\u0442\u043e\u043c? \u0411\u0443\u0434\u0435\u0442 \u0447\u0442\u043e? \u041f\u043e\u0434\u0438, \u0443\u0437\u043d\u0430\u0439\u2026 \u0416\u0434\u0430\u043b \u0432\u0435\u0441\u043d\u043e\u044e \u044f \u0425\u0430\u0440\u043e\u043d\u0430, \u0410 \u043f\u0440\u0438\u043f\u043b\u044b\u043b \u043a\u043e \u043c\u043d\u0435 \u041c\u0430\u0437\u0430\u0439. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u041f\u043e\u0433\u043e\u0441\u0442 \u0437\u0430 \u0440\u0435\u043a\u043e\u0439. \u041d\u044b\u043d\u0447\u0435 \u0441 \u043c\u043e\u0441\u0442\u0430 \u0443\u0432\u0438\u0434\u0435\u043b \u0422\u0440\u043e\u043f\u0443 \u043d\u0430 \u0432\u043e\u0434\u0435. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0413\u043b\u0430\u0437\u0430 \u043d\u0430\u0441\u044b\u0442\u0438\u043b\u0438\u0441\u044c. \u0418 \u0443\u0448\u0438. \u0418 \u043d\u043e\u0432\u044b\u0439 \u0434\u0435\u043d\u044c \u043f\u043e\u0445\u043e\u0436 \u043d\u0430 \u043d\u043e\u0447\u044c. \u0418 \u0441\u0442\u044b\u0434\u043d\u043e \u0432\u0438\u0434\u0435\u0442\u044c \u043d\u0430\u0441. \u0418 \u0441\u043b\u0443\u0448\u0430\u0442\u044c. \u0418 \u0441\u0442\u044b\u0434\u043d\u043e \u0432 \u044d\u0442\u043e\u043c \u043d\u0430\u043c \u043f\u043e\u043c\u043e\u0447\u044c. \u0417\u0430\u0440\u044f\u0434\u043a\u0430 \u043a\u043e\u043d\u0447\u0438\u043b\u0430\u0441\u044c. \u0412\u0441\u0451. \u0411\u0430\u0441\u0442\u0430. \u041f\u043e\u0433\u0430\u0441 \u044d\u043a\u0440\u0430\u043d. \u0427\u0442\u043e \u043c\u043e\u0433 \u2014 \u043d\u0435 \u0441\u043c\u043e\u0433. \u041f\u0440\u043e\u0448\u043b\u0438 \u0438 \u0412\u0435\u0440\u0431\u043d\u043e\u0435, \u0438 \u041f\u0430\u0441\u0445\u0430. \u0418 \u0442\u0435\u043b\u0435\u0444\u043e\u043d \u043c\u043e\u043b\u0447\u0438\u0442. \u0418 \u0411\u043e\u0433. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0417\u0430 \u0411\u0435\u043b\u043e\u0435 \u0443\u0445\u043e\u0434\u0438\u0442 \u0434\u0435\u043d\u044c. \u0414\u0435\u043d\u044c \u0431\u0435\u043b\u044b\u0439, \u044f\u0440\u043a\u0438\u0439. \u0418 \u0431\u0435\u043b\u0430\u044f \u043b\u043e\u0436\u0438\u0442\u0441\u044f \u0442\u0435\u043d\u044c \u041e\u0442 \u0447\u0435\u0440\u043d\u043e\u0439 \u0447\u0430\u0439\u043a\u0438. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u041b\u042e\u0411\u041e\u0412\u042c \u0418\u00a0 \u041a\u0420\u041e\u0412\u042c \u0421\u0435\u043d\u044f \u0437\u0430\u043f\u0440\u043e\u043a\u0438\u043d\u0443\u043b \u0433\u043e\u043b\u043e\u0432\u0443. \u0417\u0430\u0436\u043c\u0443\u0440\u0438\u043b \u0433\u043b\u0430\u0437\u0430 \u043e\u0442 \u044f\u0440\u043a\u043e\u0433\u043e \u0441\u043e\u043b\u043d\u0446\u0430. \u0421\u043e\u043b\u043d\u0446\u0435 \u0441\u043a\u0440\u044b\u043b\u043e\u0441\u044c \u0437\u0430 \u043e\u0431\u043b\u0430\u043a\u043e\u043c. \u0421\u0435\u043d\u044f \u043e\u0442\u0436\u043c\u0443\u0440\u0438\u043b \u043e\u0434\u0438\u043d \u0433\u043b\u0430\u0437. \u041f\u043e\u0442\u043e\u043c \u0434\u0440\u0443\u0433\u043e\u0439. \u041a\u0440\u043e\u0432\u044c \u0438\u0437 \u043d\u043e\u0441\u0430 \u0442\u0435\u043a\u043b\u0430 \u043d\u0435 \u0434\u043e\u043b\u0433\u043e. \u041d\u043e \u0433\u043e\u043b\u043e\u0432\u0443 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044c \u0432 \u043f\u0440\u0438\u0432\u044b\u0447\u043d\u043e\u0435 \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0435 \u0445\u043e\u0442\u0435\u043b\u043e\u0441\u044c. \u0425\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0434\u043e\u0436\u0434\u0430\u0442\u044c\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0441\u043e\u043b\u043d\u0446\u0435 \u0441\u043d\u043e\u0432\u0430 \u0432\u044b\u0433\u043b\u044f\u043d\u0435\u0442. \u0425\u043e\u0442\u0435\u043b\u043e\u0441\u044c \u0441\u043d\u043e\u0432\u0430 \u0437\u0430\u0436\u043c\u0443\u0440\u0438\u0442\u044c\u0441\u044f. \u00ab\u0418 \u0441\u043e\u0432\u0441\u0435\u043c \u043d\u0435 \u0441\u043e\u043b\u0451\u043d\u0430\u044f\u00bb \u2013 \u043f\u043e\u0434\u0443\u043c\u0430\u043b \u043e\u043d, \u0434\u0435\u043b\u0430\u044f \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u0433\u043b\u043e\u0442\u043e\u043a \u0442\u0435\u043f\u043b\u043e\u0439 \u0438 \u0433\u0443\u0441\u0442\u043e\u0439. \u0423\u0434\u0430\u0440 \u043f\u043e\u0434\u0434\u044b\u0445 \u043d\u0435 \u0434\u0430\u043b \u043e\u043f\u0443\u0441\u0442\u0438\u0442\u044c\u0441\u044f \u0442\u0451\u043f\u043b\u043e\u0439 \u0438 \u0433\u0443\u0441\u0442\u043e\u0439 \u0432 \u0436\u0435\u043b\u0443\u0434\u043e\u043a. \u041a\u0440\u043e\u0432\u044c \u0432\u044b\u0441\u043a\u043e\u0447\u0438\u043b\u0430 \u0438\u0437 \u0441\u043e\u0433\u043d\u0443\u0432\u0448\u0435\u0433\u043e\u0441\u044f \u0421\u0435\u043d\u0438. \u0423\u043f\u0430\u043b\u0430 \u0432 \u0442\u0440\u0430\u0432\u0443. \u041c\u0443\u0445\u0430 \u043d\u0430\u0434 \u0435\u0433\u043e \u043a\u0440\u043e\u0432\u044c\u044e \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u0435\u0449\u0451 \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0421\u0435\u043d\u044f \u043e\u0442\u0434\u044b\u0448\u0430\u043b\u0441\u044f \u0438 \u0432\u044b\u043f\u0440\u044f\u043c\u0438\u043b\u0441\u044f. \u0421\u0435\u043d\u044f \u0438 \u043d\u0435 \u0441\u0442\u0430\u043b \u0432\u044b\u043f\u0440\u044f\u043c\u043b\u044f\u0442\u044c\u0441\u044f. \u0423\u043f\u0451\u0440\u0441\u044f \u043b\u0430\u0434\u043e\u043d\u044f\u043c\u0438 \u0432 \u043a\u043e\u043b\u0435\u043d\u0438. \u0421\u0442\u0430\u043b \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0442\u044c \u0437\u0430 \u043c\u0443\u0445\u043e\u0439. \u041f\u043e\u0432\u0435\u0441\u0435\u043b\u0435\u043b. \u041f\u043e\u0434\u0436\u043e\u043f\u043d\u0438\u043a \u0435\u0433\u043e \u0443\u0436\u0435 \u043d\u0435 \u0440\u0430\u0441\u0441\u0442\u0440\u043e\u0438\u043b. \u0423\u043f\u0430\u0432 \u043d\u0430 \u043a\u043e\u043b\u0435\u043d\u0438, \u0421\u0435\u043d\u044f \u0441 \u043b\u044e\u0431\u043e\u043f\u044b\u0442\u0441\u0442\u0432\u043e\u043c \u043e\u0433\u043b\u044f\u0434\u0435\u043b\u0441\u044f. \u041c\u0438\u0440 \u0431\u044b\u043b \u043d\u043e\u0432\u044b\u043c \u0438 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u043c. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0413\u043b\u0443\u043f\u044b\u0439 \u043b\u044e\u0431\u0438\u0442 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0438 \u0441\u043b\u0443\u0448\u0430\u0442\u044c, \u043a\u0430\u043a \u0438\u0434\u0451\u0442 \u0434\u043e\u0436\u0434\u044c. \u041c\u0443\u0434\u0440\u044b\u0439 \u043b\u044e\u0431\u0438\u0442 \u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0438 \u0441\u043b\u0443\u0448\u0430\u0442\u044c, \u043a\u0430\u043a \u0438\u0441\u043f\u0430\u0440\u044f\u0435\u0442\u0441\u044f \u0432\u043e\u0434\u0430. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u041c\u043e\u043b\u0447\u0430\u043d\u0438\u0435 \u2013 \u0441\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0441\u043b\u043e\u0432 \u0432 \u0441\u0435\u0431\u0435. \u0411\u0435\u0437\u043c\u043e\u043b\u0432\u0438\u0435 \u2013 \u0438\u0445 \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435. \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0432\u043e\u0433\u043e \u2013 \u0431\u043e\u0440\u044c\u0431\u0430 \u0441 \u0433\u043e\u0440\u0434\u044b\u043d\u0435\u0439. \u0414\u043e\u0441\u0442\u0438\u0436\u0435\u043d\u0438\u0435 \u0432\u0442\u043e\u0440\u043e\u0433\u043e \u2013 \u043f\u043e\u0431\u0435\u0434\u0430 \u043d\u0430\u0434 \u043d\u0435\u0439. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u041a\u0430\u043c\u043d\u0438 \u043b\u0435\u0436\u0430\u043b\u0438 \u0443 \u0411\u0435\u043b\u043e\u0433\u043e \u043c\u043e\u0440\u044f. \u041a\u0430\u043c\u043d\u0438 \u043f\u0440\u0438\u043b\u0438\u0432\u044b, \u043e\u0442\u043b\u0438\u0432\u044b \u0441\u0442\u044f\u0436\u0430\u043b\u0438. \u041a\u0430\u043c\u043d\u0438 \u043e\u0441\u0442\u044b\u043b\u0438 \u043e\u0442 \u0441\u0447\u0430\u0441\u0442\u044c\u044f \u0438 \u0433\u043e\u0440\u044f. \u041a\u0430\u043c\u043d\u0438 \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u043b\u0438. \u0418 \u043d\u0435 \u0441\u043e\u0431\u0440\u0430\u043b\u0438. \u041a\u0430\u043c\u043d\u0438 \u0438 \u0432\u043e\u0434\u0443, \u0438 \u043a\u0440\u043e\u0432\u044c \u043e\u0442\u0437\u0430\u0431\u044b\u043b\u0438. \u041a\u0430\u043c\u043d\u0438 \u043d\u0430 \u043a\u0430\u043c\u043d\u0438 \u043d\u0435 \u0441\u043c\u043e\u0442\u0440\u044f\u0442. \u0423\u0441\u0442\u0430\u043b\u0438. \u041a\u0430\u043c\u043d\u0438 \u0442\u044f\u0436\u0435\u043b\u044b\u043c \u043c\u043e\u043b\u0447\u0430\u043d\u0438\u0435\u043c \u0431\u044b\u043b\u0438. \u041a\u0430\u043c\u043d\u0438 \u0441\u043c\u0438\u0440\u0435\u043d\u043d\u044b\u043c \u0431\u0435\u0437\u043c\u043e\u043b\u0432\u0438\u0435\u043c \u0441\u0442\u0430\u043b\u0438. \u041a\u0430\u043c\u043d\u0438 \u0432\u043e\u0434\u0430 \u043f\u0440\u0438\u043d\u044f\u043b\u0430 \u0438 \u043d\u0435 \u0442\u043e\u0447\u0438\u0442. \u041a\u0430\u043c\u043d\u0438 \u043d\u0430 \u0434\u043d\u043e \u0438 \u043d\u0430 \u043d\u0435\u0431\u043e \u043d\u0435 \u0434\u0430\u0432\u044f\u0442. \u041a\u0430\u043c\u043d\u0438 \u043d\u0430 \u0411\u0435\u043b\u043e\u043c \u043b\u0435\u0436\u0430\u0442. \u041c\u043d\u043e\u0433\u043e\u0442\u043e\u0447\u044c\u0435. \u0418 \u043c\u043e\u0442\u044b\u043b\u0451\u043a \u043d\u0430\u0434 \u043a\u0430\u043c\u043d\u044f\u043c\u0438 \u043b\u0435\u0442\u0430\u0435\u0442. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u0440\u0443\u043a\u0438. \u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u043d\u043e\u0433\u0438. \u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u0433\u043b\u0430\u0437\u0430. \u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u0443\u0448\u0438. \u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u044f\u0437\u044b\u043a. \u0423 \u043c\u0435\u043d\u044f \u0435\u0441\u0442\u044c \u0440\u0430\u0437\u0443\u043c. \u0418 \u0437\u0430 \u0432\u0441\u0451 \u044d\u0442\u043e \u043c\u043d\u0435 \u043e\u0447\u0435\u043d\u044c \u0441\u0442\u044b\u0434\u043d\u043e \u043f\u0435\u0440\u0435\u0434 \u043c\u043e\u0435\u0439 \u0434\u0443\u0448\u043e\u0439. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0417\u0430\u0441\u043b\u0443\u0448\u0430\u043b\u0430\u0441\u044c \u041b\u0438\u0441\u0430. \u0418 \u043f\u0440\u043e \u0441\u044b\u0440 \u0437\u0430\u0431\u044b\u043b\u0430\u2026 \u041b\u0435\u0442\u0438\u0442 \u043f\u043e \u043b\u0435\u0441\u0443 \u041f\u0435\u0441\u043d\u044f \u0411\u0435\u043b\u043e\u0439 \u0412\u043e\u0440\u043e\u043d\u044b. \u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a *** \u0412\u043e\u0442 \u0438 \u0441
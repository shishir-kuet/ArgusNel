  "title": "\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 package.lua:80: module 'Module:Map' not found \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0623\u0648 \u0627\u0644\u0625\u0646\u063a\u0644\u064a\u0632\u064a\u0629 (\u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629: English)\u060c \u0648\u062a\u0643\u062a\u0628 \u0641\u064a \u0628\u0644\u062f\u0627\u0646 \u0627\u0644\u0634\u0627\u0645 \u0648\u0627\u0644\u0639\u0631\u0627\u0642 \u0625\u0646\u0643\u0644\u064a\u0632\u064a\u0629 \u0647\u064a \u0644\u063a\u0629 \u062c\u0631\u0645\u0627\u0646\u064a\u0629 \u0646\u0634\u0623\u062a \u0641\u064a \u0625\u0646\u062c\u0644\u062a\u0631\u0627 \u0628\u0639\u062f \u062f\u062e\u0648\u0644 \u0627\u0644\u0641\u0627\u064a\u0643\u0646\u062c. \u0647\u064a \u062b\u0627\u0644\u062b \u0623\u0643\u062b\u0631 \u0627\u0644\u0644\u063a\u0627\u062a \u0627\u0644\u0623\u0645 \u0627\u0646\u062a\u0634\u0627\u0631\u0627\u064b \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645 (402 \u0645\u0644\u064a\u0648\u0646 \u0646\u0633\u0645\u0629 \u0628\u062d\u0633\u0628 \u062a\u0639\u062f\u0627\u062f \u0639\u0627\u0645 2002) \u0648\u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0627\u0646\u062a\u0634\u0627\u0631\u0647\u0627 \u0627\u0644\u0643\u0628\u064a\u0631 \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645 \u0628\u0633\u0628\u0628 \u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0639\u0633\u0643\u0631\u064a\u0629 \u0648\u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u064a\u0629 \u0648\u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0648\u0627\u0644\u0633\u064a\u0627\u0633\u064a\u0629 \u0644\u0644\u0625\u0645\u0628\u0631\u0627\u0637\u0648\u0631\u064a\u0629 \u0627\u0644\u0628\u0631\u064a\u0637\u0627\u0646\u064a\u0629 \u0648\u0645\u0646 \u0628\u0639\u062f\u0647\u0627 \u0627\u0644\u0648\u0644\u0627\u064a\u0627\u062a \u0627\u0644\u0645\u062a\u062d\u062f\u0629 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0648\u0647\u064a \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0648\u062d\u064a\u062f\u0629 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0628\u0627\u0644\u0642\u0627\u0631\u0627\u062a \u0627\u0644\u062e\u0645\u0633 \u0628\u062c\u0627\u0646\u0628 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629.... \u0637\u0627\u0644\u0639 \u0627\u0644\u0645\u0632\u064a\u062f \u0639\u0644\u0649 \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 . \u0645\u062d\u062a\u0648\u0649 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 [ \u0639\u062f\u0644 ] \u0637\u0627\u0644\u0639 \u0645\u0642\u0627\u0644\u0629 \u0645\u0648\u0633\u0648\u0639\u064a\u0629 \u062d\u0648\u0644 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0639\u0644\u0649 \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0633\u0627\u0647\u0645 \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u0643\u062a\u0627\u0628 \u0639\u0644\u0645\u064a \u0645\u0641\u062a\u0648\u062d \u062d\u0648\u0644 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0639\u0644\u0649 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 . \u0627\u0642\u062a\u0628\u0627\u0633\u0627\u062a \u062d\u0648\u0644 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0639\u0
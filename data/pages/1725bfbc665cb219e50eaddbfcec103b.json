  "url": "http://ar.wikiversity.org/wiki/%D8%AE%D8%A7%D8%B5:%D8%A3%D9%83%D8%AB%D8%B1_%D8%A7%D9%84%D9%82%D9%88%D8%A7%D9%84%D8%A8_%D9%88%D8%B5%D9%84%D8%A7",
  "title": "\u0623\u0643\u062b\u0631 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u062a\u0636\u0645\u064a\u0646\u0627 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0623\u0643\u062b\u0631 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u062a\u0636\u0645\u064a\u0646\u0627 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0645\u062e\u0632\u0646\u0629\u060c \u0648\u0643\u0627\u0646 \u0622\u062e\u0631 \u062a\u062d\u062f\u064a\u062b \u0644\u0647\u0627 \u0641\u064a 05:08\u060c 13 \u0645\u0627\u0631\u0633 2026. \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0645\u062e\u0632\u0646\u0629 \u0647\u0648 5\u066c000 \u0646\u062a\u064a\u062c\u0629. \u064a\u0638\u0647\u0631 \u0623\u062f\u0646\u0627\u0647 \u0645\u0627 \u064a\u0635\u0644 \u0625\u0644\u0649 50 \u0646\u062a\u0627\u0626\u062c \u0641\u064a \u0627\u0644\u0646\u0637\u0627\u0642 # 1 \u0625\u0644\u0649 # 50 . \u0639\u0631\u0636 ( 50 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 | 50 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 ) ( 20 | 50 | 100 | 250 | 500 ). \u0648\u062d\u062f\u0629:Arguments ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 520 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u062c\u0627\u0646\u0628\u064a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 440 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0634\u0642\u064a\u0642\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 440 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u062a\u0635\u0646\u064a\u0641 \u0643\u0648\u0645\u0646\u0632 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 428 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u062a\u0648\u062b\u064a\u0642/styles.css ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 293 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u062a\u0648\u062b\u064a\u0642/\u0636\u0628\u0637 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 293 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u062a\u0648\u062b\u064a\u0642 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 293 \u0635\u0641\u062d\u0627\u062a ) \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a:Toc ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 266 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0641\u0647\u0631\u0633 \u062a\u0635\u0646\u064a\u0641 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 262 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u062f ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 236 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0645\u0631\u0627\u062c\u0639 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 235 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0628\u0637\u0627\u0642\u0629/\u0628\u064a\u0627\u0646\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 226 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:Math ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 225 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0628\u0637\u0627\u0642\u0629/\u0623\u062f\u0648\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 224 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0628\u0637\u0627\u0642\u0629/\u0648\u064a\u0643\u064a.\u0628\u064a\u0627\u0646\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 220 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:LuaLinq ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 219 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0628\u0637\u0627\u0642\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 219 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0628\u0637\u0627\u0642\u0629/\u0623\u062f\u0648\u0627\u062a/\u0645\u0646\u0638\u0645\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 218 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0628\u0637\u0627\u0642\u0629/\u0623\u062f\u0648\u0627\u062a/\u0645\u0628\u0646\u0649 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 218 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0645\u0635\u0646\u0641 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 218 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0628\u0637\u0627\u0642\u0629/\u0642\u0627\u0644\u0628/\u0639\u0627\u0645\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 217 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0628\u0637\u0627\u0642\u0629 \u0639\u0627\u0645\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 216 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0645\u0635\u0646\u0641 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 216 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 214 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0628\u0637\u0627\u0642\u0629/icones.css ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 210 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0628\u0637\u0627\u0642\u0629/infobox v3/styles.css ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 210 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:Wikidata.Ca/i18n ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 207 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:Wikidata.Ca ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 207 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u063a\u0637\u0627\u0621 \u0635\u0646\u062f\u0648\u0642/1 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 206 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u063a\u0637\u0627\u0621 \u0635\u0646\u062f\u0648\u0642/2 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 206 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0631\u0645\u0632 \u064a\u0633\u0627\u0631 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 205 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0646\u0647\u0627\u064a\u0629 \u0635\u0646\u062f\u0648\u0642 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 202 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u062a\u062d\u062f\u064a\u062f ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 201 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0631\u0645\u0632 \u064a\u0645\u064a\u0646 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 198 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u062a\u0648\u062b\u064a\u0642 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 198 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:- ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 198 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0648\u0635\u0644\u0627\u062a \u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 177 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0645\u0633\u0627\u0642\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 177 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0645\u062d\u062a\u0648\u0649 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 177 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0630\u064a\u0644 \u0627\u0644\u0635\u0641\u062d\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 165 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:0/4 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 162 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u064a\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 143 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0644\u063a\u0627\u062a/\u0628\u064a\u0627\u0646\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 113 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:\u0644\u063a\u0627\u062a ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 112 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0631\u0645 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 106 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0646\u0647\u0627\u064a\u0629 \u0623\u0639\u0645\u062f\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 102 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0623\u0639\u0645\u062f\u0629 \u0645\u062a\u0639\u062f\u062f\u0629 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 102 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0641\u0627\u0635\u0644 \u0639\u0645\u0648\u062f ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 98 \u0635\u0641\u062d\u0627\u062a ) \u0642\u0627\u0644\u0628:\u0627\u0644\u0643\u0644\u064a\u0629/\u0644\u0648\u0646 ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 95 \u0635\u0641\u062d\u0627\u062a ) \u0648\u062d\u062f\u0629:Yesno ( \u0645\u0633\u062a\u062e\u062f\u0645 \u0641\u064a 94 \u0635\u0641\u062d\u0627\u062a ) \u0639\u0631\u0636 ( 50 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 | 50 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 ) ( 20 | 50 | 100 | 250 | 500 ). \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/wiki/\u062e\u0627\u0635:\u0623\u0643\u062b\u0631_\u0627\u0644\u0642\u0648\u0627\u0644\u0628_\u0648\u0635\u0644\u0627 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0623\u0643\u062b\u0631 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u062a\u0636\u0645\u064a\u0646\u0627 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

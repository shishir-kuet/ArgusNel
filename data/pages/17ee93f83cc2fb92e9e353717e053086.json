{
  "url": "http://avtor.karelia.ru/about/kozhin_oleg_igorevich.html",
  "title": "\u00ca\u00ee\u00e6\u00e8\u00ed \u00ce\u00eb\u00e5\u00e3 \u00c8\u00e3\u00ee\u00f0\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00ca\u00ee\u00e6\u00e8\u00ed \u00ce\u00eb\u00e5\u00e3 \u00c8\u00e3\u00ee\u00f0\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00ca\u00ee\u00e6\u00e8\u00ed \u00ce\u00eb\u00e5\u00e3 \u00c8\u00e3\u00ee\u00f0\u00e5\u00e2\u00e8\u00f7 \u00c4\u00e0\u00f2\u00e0 \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: 18.10.1981 \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00cd\u00ee\u00f0\u00e8\u00eb\u00fc\u00f1\u00ea \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc, \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00fe\u00f9\u00e8\u00e9 \u00e2 \u00e6\u00e0\u00ed\u00f0\u00e0\u00f5\u00a0\u00f5\u00ee\u00f0\u00f0\u00ee\u00f0,\u00a0\u00ec\u00e8\u00f1\u00f2\u00e8\u00ea\u00e0,\u00a0\u00e3\u00ee\u00f0\u00ee\u00e4\u00f1\u00ea\u00ee\u00e5 \u00f4\u00fd\u00ed\u00f2\u00e5\u00e7\u00e8,\u00a0\u00f4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2\u00e8\u00ea\u00e0. \u0412 \u00ed\u00e0\u00f1\u00f2\u00ee\u00ff\u00f9\u00e5\u00e5 \u00e2\u00f0\u00e5\u00ec\u00ff\u00a0 \u00e6\u00e8\u00e2\u00e5\u00f2 \u00e2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5. \u00ce\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb \u00cb\u00c3\u00ce\u00d3 \u00e8\u00ec\u00e5\u00ed\u00e8 \u00c0.\u00d1. \u00cf\u00f3\u00f8\u00ea\u00e8\u00ed\u00e0, \u00ef\u00ee \u00f1\u00ef\u00e5\u00f6\u00e8\u00e0\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00e8 \u00ab\u00d1\u00e2\u00ff\u00e7\u00e8 \u00f1 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00f1\u00f2\u00fc\u00fe\u00bb. \u00c4\u00e5\u00e1\u00fe\u00f2\u00ed\u00fb\u00e9 \u00f0\u00ee\u00ec\u00e0\u00ed \u00ab\u00ce\u00f5\u00ee\u00f2\u00e0 \u00ed\u00e0 \u00f3\u00e4\u00e0\u00f7\u00f3\u00bb \u00e2\u00fb\u00f8\u00e5\u00eb \u00e2 2014 \u00e3\u00ee\u00e4\u00f3, \u00e2 \u00e8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00e5 \u00ab\u00c0\u00d1\u00d2\u00bb \u00e8 \u00f1\u00ee\u00e1\u00f0\u00e0\u00eb \u00ef\u00ee\u00eb\u00ee\u00e6\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00f3\u00fe \u00ea\u00f0\u00e8\u00f2\u00e8\u00ea\u00f3 \u00e2\u00ee \u00ec\u00ed\u00ee\u00e3\u00e8\u00f5 \u00ef\u00f0\u00ee\u00f4\u00e8\u00eb\u00fc\u00ed\u00fb\u00f5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff\u00f5. \u00c7\u00e0\u00ed\u00ff\u00eb \u00e2\u00f2\u00ee\u00f0\u00ee\u00e5 \u00ec\u00e5\u00f1\u00f2\u00ee \u00e2 \u00ef\u00f0\u00e5\u00ec\u00e8\u00e8 \u00ab\u00d0\u00f3\u00ea\u00ee\u00ef\u00e8\u00f1\u00fc \u00e3\u00ee\u00e4\u00e0\u00bb. \u00cd\u00ee\u00ec\u00e8\u00ed\u00e8\u00f0\u00ee\u00e2\u00e0\u00eb\u00f1\u00ff \u00ed\u00e0 \u00ef\u00f0\u00e5\u00ec\u00e8\u00fe \u00ab\u00c8\u00ed\u00f2\u00e5\u00f0\u00ef\u00f0\u00e5\u00f1\u00f1\u00ea\u00ee\u00ed\u00bb, \u00e2 \u00ed\u00ee\u00ec\u00e8\u00ed\u00e0\u00f6\u00e8\u00e8 \u00ab\u00cb\u00f3\u00f7\u00f8\u00e8\u00e9 \u00e4\u00e5\u00e1\u00fe\u00f2\u00bb, \u00ed\u00ee\u00ec\u00e8\u00ed\u00e0\u00ed\u00f2 \u00ed\u00e0 \u00ef\u00f0\u00e5\u00ec\u00e8\u00fe \u00ab\u00ca\u00ed\u00e8\u00e3\u00f3\u00f0\u00f3 - 2018\u00bb.\u00a0\u00d0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00ee\u00e2\u00e0\u00eb\u00e8\u00f1\u00fc \u00e2 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0\u00f5 \u00ab\u00cf\u00ee\u00eb\u00e4\u00e5\u00ed\u00fc, 21 \u00e2\u00e5\u00ea\u00bb, \u00ab\u00cc\u00e0\u00f8\u00e8\u00ed\u00fb \u00e8 \u00ec\u00e5\u00f5\u00e0\u00ed\u00e8\u00e7\u00ec\u00fb\u00bb, \u00ab\u00c7\u00ed\u00e0\u00ed\u00e8\u00e5 \u2013 \u00f1\u00e8\u00eb\u00e0. \u00d4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2\u00e8\u00ea\u00e0\u00bb, \u00ab\u00d3\u00f0\u00e0\u00eb\u00fc\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00e5\u00e4\u00ee\u00ef\u00fb\u00f2\u00bb, \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb, \u00e8 \u00e4\u00f0. \u00d2\u00e0\u00ea\u00e6\u00e5 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00e0\u00ea\u00f2\u00e8\u00e2\u00ed\u00ee \u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00fe\u00f2\u00f1\u00ff \u00e2 \u00ec\u00e5\u00e6\u00e0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e8\u00f5 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0\u00f5 \u00e8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2 \u00ab\u00dd\u00ea\u00f1\u00ec\u00ee\u00bb, \u00ab\u00c0\u00d1\u00d2\u00bb, \u00ab\u00c0\u00f1\u00f2\u00f0\u00e5\u00eb\u00fc-\u00d1\u00ef\u00e1\u00bb \u00e8 \u00e4\u00f0.\u00a0\u00d1\u00e5\u00e3\u00ee\u00e4\u00ed\u00ff \u00f1\u00f7\u00e8\u00f2\u00e0\u00e5\u00f2\u00f1\u00ff \u00ee\u00e4\u00ed\u00e8\u00ec \u00e8\u00e7 \u00eb\u00f3\u00f7\u00f8\u00e8\u00f5 \u00ee\u00f2\u00e5\u00f7\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00f5 \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00e5\u00e9 \u00e6\u00e0\u00ed\u00f0\u00e0 \u00f5\u00ee\u00f0\u00f0\u00ee\u00f0. \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00c4\u00e0\u00e2\u00fb\u00e4\u00ee\u00e2, \u00d0. \u00ce\u00eb\u00e5\u00e3 \u00ca\u00ee\u00e6\u00e8\u00ed: \u00ab\u00df \u00ef\u00e8\u00f8\u00f3 \u00f2\u00ee, \u00f7\u00f2\u00ee \u00ec\u00ed\u00e5 \u00ed\u00f0\u00e0\u00e2\u00e8\u00f2\u00f1\u00ff \u00ef\u00e8\u00f1\u00e0\u00f2\u00fc. \u00c3\u00ee\u00ed\u00ff\u00f2\u00fc\u00f1\u00ff \u00e7\u00e0 \u00ef\u00ee\u00ef\u00f3\u00eb\u00ff\u00f0\u00ed\u00ee\u00f1\u00f2\u00fc\u00fe \u00e2 \u00ec\u00ee\u00e8 \u00e7\u00e0\u00e4\u00e0\u00f7\u00e8 \u00ed\u00e5 \u00e2\u00f5\u00ee\u00e4\u00e8\u00f2\u00bb. [\u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e5\u00f1\u00f3\u00f0\u00f1] : [\u00c8\u00ed\u00f2\u00e5\u00f0\u00e2\u00fc\u00fe \u00f1 \u00ef\u00ee\u00e1\u00e5\u00e4\u00e8\u00f2\u00e5\u00eb\u00e5\u00ec \u00ea\u00ee\u00ed\u00ea\u00f3\u00f0\u00f1\u00e0 \u00f5\u00ee\u00f0\u00f0\u00ee\u00f0\u00e0 \u00a0\u00ab\u00d7\u00b8\u00f0\u00f2\u00ee\u00e2\u00e0 \u00e4\u00fe\u00e6\u00e8\u00ed\u00e0 DARKER\u00bb] / \u00e1\u00e5\u00f1\u00e5\u00e4\u00f3 \u00e2\u00b8\u00eb \u00d0\u00ee\u00ec\u00e0\u00ed \u00c4\u00e0\u00e2\u00fb\u00e4\u00ee\u00e2 // DARKER. - \u00a02013. - \u00b9 7.- \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0 : http://darkermagazine.ru/page/oleg-kozhin-ja-pishu-to-chto-mne-nravitsja-pisat-gonjatsja-za-populjarnostju-v-moi-zadachi-ne-vhodit \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00ca\u00ee\u00e6\u00e8\u00ed, \u00ce. \u00ce\u00f5\u00ee\u00f2\u00e0 \u00ed\u00e0 \u00f3\u00e4\u00e0\u00f7\u00f3 / \u00ce\u00eb\u00e5\u00e3 \u00ca\u00ee\u00e6\u00e8\u00ed. - \u00cc\u00ee\u00f1\u00ea\u00e2\u00e0 : \u00c0\u00d1\u00d2, 2014. - 442, [2] \u00f1. \u00ca\u00ee\u00e6\u00e8\u00ed, \u00ce. \u00cf\u00e0\u00ec\u00ff\u00f2\u00ea\u00e0 \u00fe\u00ed\u00ee\u00e3\u00ee \u00e1\u00f0\u00ee\u00e4\u00ff\u00e6\u00ea\u00e8 : [\u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7] / \u00ce\u00eb\u00e5\u00e3 \u00ca\u00ee\u00e6\u00e8\u00ed // \u00d2\u00e5\u00ec\u00ed\u00fb\u00e5 / \u00f1\u00ee\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00fc: \u00cc. \u00d1. \u00cf\u00e0\u00f0\u00f4\u00e5\u00ed\u00ee\u00e2.- \u00cc\u00ee\u00f1\u00ea\u00e2\u00e0, 2016.- \u00d1. 187-222. \u00ca\u00ee\u00e6\u00e8\u00ed, \u00ce. \u00d0\u00ee\u00e4\u00e8\u00f2\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00e9 \u00e4\u00e5\u00ed\u00fc / \u00ce. \u00ca\u00ee\u00e6\u00e8\u00ed // \u00cf\u00ee\u00eb\u00e4\u00e5\u00ed\u00fc. XXI \u00e2\u00e5\u00ea. - 2012. - \u00b9 5. - \u00d1. 119 - 136. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: ...\u00e3\u00e4\u00e5 \u00e6\u00e8\u00e2\u00e5\u00f2 \u00f3\u00e6\u00e0\u00f1 \u00c8\u00e7\u00e1\u00f0\u00e0\u00ed\u00ed\u00fb\u00e5 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00cd\u00e0 \u00d0\u00fd\u00e9\u00ed\u00e5 \u00e2\u00e5\u00f0\u00e8\u00f2\u00fc \u00e2 \u00fd\u00f2\u00ee \u00f2\u00f0\u00f3\u00e4\u00ed\u00ee \u00d0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 \u00e8\u00e7 \u00e0\u00f3\u00e4\u00e8\u00ee\u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0 \u00ab\u00dd\u00f4\u00f4\u00e5\u00ea\u00f2 \u00c4\u00ee\u00ef\u00eb\u00e5\u00f0\u00e0\u00bb \u00f7\u00e8\u00f2\u00e0\u00e5\u00f2 \u00ce\u00eb\u00e5\u00e3 \u00ca\u00ee\u00e6\u00e8\u00ed \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

  "url": "http://ar.wikiversity.org/wiki/%D8%A7%D9%84%D8%A7%D8%AA%D8%B5%D8%A7%D9%84",
  "title": "\u0627\u0644\u0627\u062a\u0635\u0627\u0644 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0627\u062a\u0635\u0627\u0644 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u062f\u0627\u0644\u0629 \u0645\u0633\u062a\u0645\u0631\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0627\u0645\u0629 \u0635\u0646\u0641 \u0641\u0631\u0639\u064a \u0645\u0646 piecewise continuous function (en) \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0635\u064a\u063a\u0629 f : ( X , T 1 ) \u2192 ( Y , T 2 ) \u2227 \u2200 U \u2208 T 2 : f \u2212 1 ( U ) \u2208 T 1 {\\displaystyle f:(X,T_{1})\\to (Y,T_{2})\\quad \\land \\quad \\forall \\,U\\in T_{2}:\\quad f^{-1}(U)\\in T_{1}} \u0644\u0647 \u0645\u064a\u0632\u0629 \u0627\u062a\u0635\u0627\u0644 (\u0631\u064a\u0627\u0636\u064a\u0627\u062a) \u0627\u0644\u0646\u0642\u064a\u0636 discontinuous function (en) discrete function (en) \u062a\u0639\u062f\u064a\u0644 - \u062a\u0639\u062f\u064a\u0644 \u0645\u0635\u062f\u0631\u064a - \u062a\u0639\u062f\u064a\u0644 \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u062e\u0627\u0635\u064a\u0629 \u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u064a \u0627\u0644\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0631\u064a\u0627\u0636\u064a. \u0627\u0644\u062f\u0627\u0644\u0629 \u0627\u0644\u0645\u0633\u062a\u0645\u0631\u0629 \u0623\u0648 \u0627\u0644\u062f\u0627\u0644\u0629 \u0627\u0644\u0645\u062a\u0635\u0644\u0629 (\u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629: Continuous function) \u0647\u064a \u062f\u0627\u0644\u0629 \u0631\u064a\u0627\u0636\u064a\u0629 \u062a\u0624\u062f\u064a \u0641\u064a\u0647\u0627 \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0637\u0641\u064a\u0641\u0629 \u0641\u064a \u0645\u062a\u063a\u064a\u0651\u0631 \u0627\u0644\u062f\u0627\u0644\u0651\u0629 \u0625\u0644\u0649 \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0637\u0641\u064a\u0641\u0629 \u0641\u064a \u0642\u064a\u0645\u062a\u0647\u0627. \u0627\u0644\u0645\u062d\u062a\u0648\u0649 [ \u0639\u062f\u0644 ] \u0627\u0644\u062f\u0631\u0633 [ \u0639\u062f\u0644 ] \u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0642\u0631\u0629 \u0644\u0639\u0631\u0636 \u0645\u062d\u062a\u0648\u0627\u0647\u0627 \u0643\u0627\u0645\u0644\u0627. \u0627\u0644\u0641\u0642\u0631\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u062a\u0635\u0627\u0644 \u062f\u0627\u0644\u0629 \u0641\u064a \u0646\u0642\u0637\u0629 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0639\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646 - \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0639\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631 \u062f\u0627\u0644\u0629 \u0627\u0644\u062c\u0632\u0621 \u0627\u0644\u0635\u062d\u064a\u062d \u0627\u0644\u062a\u0645\u062f\u064a\u062f \u0628\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0639\u0644\u0649 \u0645\u062c\u0627\u0644 \u0627\u062a\u0635\u0627\u0644 \u0645\u0631\u0643\u0628 \u062f\u0627\u0644\u062a\u064a\u0646 \u0645\u0631\u0643\u0628 \u062f\u0627\u0644\u0629 \u0645\u062a\u0635\u0644\u0629 \u0648\u062f\u0627\u0644\u0629 \u062a\u0642\u0628\u0644 \u0646\u0647\u0627\u064a\u0629 \u0635\u0648\u0631\u0629 \u0645\u062c\u0627\u0644 \u0628\u062f\u0627\u0644\u0629 \u0645\u062a\u0635\u0644\u0629 \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0648\u0633\u064a\u0637\u064a\u0629 \u062d\u0627\u0644\u0629 \u062e\u0627\u0635\u0629 \u0644\u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u0648\u0633\u064a\u0637\u064a\u0629 \u0627\u0644\u062f\u0627\u0644\u0629 \u0627\u0644\u0639\u0643\u0633\u064a\u0629 \u0644\u062f\u0627\u0644\u0629 \u0645\u062a\u0635\u0644\u0629 \u0648\u0631\u062a\u064a\u0628\u0629 \u0642\u0637\u0639\u0627 \u062e\u0627\u0635\u064a\u0627\u062a \u0627\u0644\u062f\u0627\u0644\u0629 \u0627\u0644\u0639\u0643\u0633\u064a\u0629 \u062f\u0627\u0644\u0629 \u0642\u0648\u0633 \u0627\u0644\u0638\u0644 \u062f\u0627\u0644\u0629 \u0627\u0644\u062c\u0630\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u062c\u0630\u0648\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0627\u062a\u0635\u0627\u0644 \u0648\u0646\u0647\u0627\u064a\u0629 \u0645\u0631\u0643\u0628 \u062f\u0627\u0644\u0629 \u0648\u062f\u0627\u0644\u0629 \u0627\u0644\u062c\u0630\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u062c\u0630\u0631\u064a\u0629 \u0644\u0639\u062f\u062f \u062d\u0642\u064a\u0642\u064a \u0645\u0648\u062c\u0628 \u0642\u0637\u0639\u0627 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0642\u0648\u0649 \u0627\u0644\u062c\u0630\u0631\u064a\u0629 \u0627\u0644\u062a\u0645\u0627\u0631\u064a\u0646 [ \u0639\u062f\u0644 ] \u062f\u0627\u0644\u0629 \u0642\u0648\u0633 \u0627\u0644\u0638\u0644 \u0627\u0646\u0638\u0631 \u0623\u064a\u0636\u0627 [ \u0639\u062f\u0644 ] \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0646\u0647\u0627\u064a\u0629 \u0645\u062a\u062a\u0627\u0644\u064a\u0629 \u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0639\u062f\u062f\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0644\u0648\u063a\u0627\u0631\u064a\u062a\u0645\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0633\u064a\u0629 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0627\u0644\u0645\u0639\u0627\u062f\u0644\u0627\u062a \u0627\u0644\u062a\u0641\u0627\u0636\u0644\u064a\u0629 \u0647\u0646\u0627\u0643 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 \u062d\u0648\u0644: \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u062a\u0635\u0627\u0644 \u062f\u0627\u0644\u0629 \u0641\u064a \u0646\u0642\u0637\u0629 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u0627\u062a\u0635\u0627\u0644&oldid=117069 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u062d\u062f\u0629 \u0628\u0637\u0627\u0642\u0629 \u0645\u0642\u0627\u0644\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0648\u0627\u0644\u0628 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0642\u0627\u0644\u0627\u062a \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0635\u0648\u0631 \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0631\u0633\u0627\u0644\u0629 \u0646\u0637\u0627\u0642 \u0645\u0639 \u0648\u0633\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 \u062a\u062d\u0644\u064a\u0644 \u0631\u064a\u0627\u0636\u064a \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0642\u0627\u0644\u0628:Notice \u0628\u0648\u0633\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0627\u062a\u0635\u0627\u0644 1 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

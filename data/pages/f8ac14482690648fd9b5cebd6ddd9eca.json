  "url": "http://ar.wikiversity.org/wiki/%D9%85%D9%86%D8%B7%D9%82_%D8%B1%D9%8A%D8%A7%D8%B6%D9%8A",
  "title": "\u0645\u0646\u0637\u0642 \u0631\u064a\u0627\u0636\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0645\u0646\u0637\u0642 \u0631\u064a\u0627\u0636\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u0645\u0646\u0637\u0642 \u0631\u064a\u0627\u0636\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0627\u0645\u0629 \u0635\u0646\u0641 \u0641\u0631\u0639\u064a \u0645\u0646 \u0645\u0646\u0637\u0642 \u062c\u0632\u0621 \u0645\u0646 \u0631\u064a\u0627\u0636\u064a\u0627\u062a mathematical logic, set theory, lattices and universal algebra (en) \u0645\u0646\u0637\u0642 \u0644\u0647 \u0645\u064a\u0632\u0629 \u0645\u0643\u064e\u0645\u0650\u0651\u0645 \u064a\u0632\u0627\u0648\u0644\u0647\u0627 \u0645\u0646\u0637\u0642\u064a \u064a\u0633\u062a\u062e\u062f\u0645\u0647 \u0628\u0631\u0647\u0627\u0646 \u0631\u064a\u0627\u0636\u064a \u062a\u0639\u062f\u064a\u0644 - \u062a\u0639\u062f\u064a\u0644 \u0645\u0635\u062f\u0631\u064a - \u062a\u0639\u062f\u064a\u0644 \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0642\u062f\u0645\u0629 [ \u0639\u062f\u0644 ] \u0625\u0646 \u0644\u063a\u062a\u0646\u0627 \u0627\u0644\u0627\u0639\u062a\u064a\u0627\u062f\u064a\u0629 \u0644\u064a\u0633\u062a \u0648\u0627\u0636\u062d\u0629 \u062f\u0627\u0626\u0645\u0627 \u0643\u0641\u0627\u064a\u0629\u060c \u0641\u0645\u062b\u0644\u0627 \u0641\u064a \u0627\u0644\u0645\u0637\u0639\u0645\u060c \"\u0627\u062e\u062a\u064a\u0627\u0631 \u062c\u0628\u0646 \u0623\u0648 \u062a\u062d\u0644\u064a\u0629\" \u064a\u064f\u0642\u0635\u062f \u0628\u0647 \u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u062d\u062f\u0647\u0645\u0627 \u0641\u0642\u0637\u060c \u0644\u0643\u0646 \u0641\u064a \u0644\u0639\u0628\u0629 \u0627\u0644\u0648\u0631\u0642 \u0625\u0630\u0627 \u0643\u0646\u0627 \u0646\u0628\u062d\u062b \u0639\u0646 \"\u0622\u0633 \u0623\u0648 \u0642\u0644\u0628\" \u0644\u0627 \u064a\u062c\u0628 \u0627\u0633\u062a\u062b\u0646\u0627\u0621 \"\u0622\u0633 \u0627\u0644\u0642\u0644\u0628\": \u0646\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0644\u063a\u0629 \u0623\u0643\u062b\u0631 \u062f\u0642\u0629 . \u0646\u0642\u0648\u0644 \u063a\u0627\u0644\u0628\u0627 \u0628\u0623\u0646 \u062f\u0627\u0644\u0629 \u0645\u0627 \u0647\u064a \u0645\u062a\u0635\u0644\u0629 (\u0645\u0633\u062a\u0645\u0650\u0631\u0629) \u0625\u0630\u0627 \u0627\u0633\u062a\u0637\u0639\u0646\u0627 \u0623\u0646 \u0646\u0631\u0633\u0645 \u0645\u0646\u062d\u0646\u0627\u0647\u0627 \u0627\u0644\u0628\u064a\u0627\u0646\u064a \u062f\u0648\u0646 \u0631\u0641\u0639 \u0627\u0644\u0642\u0644\u0645 \u0639\u0646 \u0627\u0644\u0648\u0631\u0642\u0629 \u0648\u0647\u0630\u0627 \u062a\u0639\u0631\u064a\u0641 \u063a\u064a\u0631 \u0643\u0627\u0641\u060c \u0625\u0644\u064a\u0643 \u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u062f\u0642\u064a\u0642 \u0644\u062f\u0627\u0644\u0629 f : I \u2192 R {\\displaystyle f:I\\to \\mathbb {R} } \u0645\u062a\u0635\u0644\u0629 (\u0645\u0633\u062a\u0645\u0650\u0631\u0629) \u0641\u064a \u0646\u0642\u0637\u0629 a {\\displaystyle a} : [ 1 ] \u2200 \u03b5 > 0 \u2203 \u03b7 > 0 \u2200 x \u2208 I ( | x \u2212 a | < \u03b7 \u21d2 | f ( x ) \u2212 f ( a ) | < \u03b5 ) {\\displaystyle \\forall \\varepsilon >0\\quad \\exists \\eta >0\\quad \\forall x\\in I\\quad \\left(|x-a|<\\eta \\Rightarrow |f(x)-f(a)|<\\varepsilon \\right)} \u0623\u062d\u062f \u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u0645\u0646\u0637\u0642 \u0647\u0648 \u0625\u064a\u0636\u0627\u062d \u0645\u0639\u0646\u0649 \u0647\u0630\u0647 \u0627\u0644\u0643\u062a\u0627\u0628\u0629\u060c \u0647\u062f\u0641 \u0622\u062e\u0631 \u0647\u0648 \u062a\u0645\u064a\u064a\u0632 \u0627\u0644\u0635\u062d\u064a\u062d \u0645\u0646 \u0627\u0644\u062e\u0637\u0625\u060c \u0641\u0645\u062b\u0644\u0627: \u0647\u0644 \u0632\u064a\u0627\u062f\u0629 \u066a20 \u0648\u0628\u0639\u062f \u0630\u0644\u0643 \u066a30 \u0623\u0647\u0645 \u0645\u0646 \u0632\u064a\u0627\u062f\u0629 \u066a50\u061f \u0644\u0627 \u064a\u062a\u0639\u0644\u0642 \u0627\u0644\u0623\u0645\u0631 \u0625\u0630\u0646 \u0628\u0645\u062c\u0631\u062f \u0622\u0631\u0627\u0621 \u0648\u0644\u0643\u0646 \u0628\u0627\u0644\u0642\u062f\u0631\u0629 \u0639\u0644\u0649 \u0639\u0645\u0644 \u0645\u0646\u0647\u062c \u0645\u0646\u0637\u0642\u064a \u0645\u0646 \u0623\u062c\u0644 \u0627\u0644\u0627\u0642\u062a\u0646\u0627\u0639 \u0648\u0625\u0642\u0646\u0627\u0639 \u0627\u0644\u0622\u062e\u0631\u064a\u0646\u060c \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u0647\u062c \u0647\u0648 \u0645\u0627 \u064a\u064f\u0633\u0645\u0649 \u0627\u0644\u0627\u0633\u062a\u062f\u0644\u0627\u0644 . \u0627\u0644\u0639\u0628\u0627\u0631\u0629 [ \u0639\u062f\u0644 ] \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \u0647\u064a \u062c\u0645\u0644\u0629 \u0635\u062d\u064a\u062d\u0629 \u0623\u0648 \u062e\u0627\u0637\u0626\u0629 \u0648\u0644\u0627 \u062a\u0643\u0648\u0646 \u0635\u062d\u064a\u062d\u0629 \u0648\u062e\u0627\u0637\u0626\u0629 \u0641\u064a \u0622\u0646 \u0648\u0627\u062d\u062f. \u0623\u0645\u062b\u0644\u0629: \"\u0625\u0646\u0647\u0627 \u062a\u0645\u0637\u0631\"\u060c \"\u0623\u0646\u0627 \u0623\u0643\u0628\u0631 \u0645\u0646\u0643\"\u060c \u0647\u0630\u0647 \u0643\u0644\u0647\u0627 \u062c\u0645\u0644 \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0635\u062d\u064a\u062d\u0629 \u0623\u0648 \u062e\u0627\u0637\u0626\u0629. \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 2 + 2 = 4 {\\displaystyle 2+2=4} \u0635\u062d\u064a\u062d\u0629 \u0641\u064a \u062d\u064a\u0646 \u0623\u0646 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 2 \u00d7 3 = 7 {\\displaystyle 2\\times 3=7} \u062e\u0627\u0637\u0626\u0629. \u0644\u0643\u0644 \u0639\u062f\u062f \u062d\u0642\u064a\u0642\u064a x {\\displaystyle x} \u0644\u062f\u064a\u0646\u0627 x 2 \u2265 0 {\\displaystyle x^{2}\\geq 0} \u0647\u064a \u0639\u0628\u0627\u0631\u0629 \u0635\u062d\u064a\u062d\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0639\u0628\u0627\u0631\u0629: \u0644\u0643\u0644 \u0639\u062f\u062f \u0639\u0642\u062f\u064a z {\\displaystyle z} \u0644\u062f\u064a\u0646\u0627 | z | = 1 {\\displaystyle |z|=1} \u062e\u0627\u0637\u0626\u0629 \u0644\u0623\u0646\u0647 \u0644\u064a\u0633 \u0635\u062d\u064a\u062d\u0627 \u0644\u0643\u0644 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0623\u0646 | z | = 1 {\\displaystyle |z|=1} . \u0627\u0644\u0639\u0637\u0641 \u0627\u0644\u0645\u0646\u0637\u0642\u064a [ \u0639\u062f\u0644 ] \u0627\u0646\u0637\u0644\u0627\u0642\u0627 \u0645\u0646 \u0639\u0628\u0627\u0631\u0629 \"P\" \u0648\u0639\u0628\u0627\u0631\u0629 \"Q\"\u060c\u0646\u0639\u0631\u0641 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \"Q \u0648P\" \u0648\u0627\u0644\u062a\u064a \u062a\u0643\u0648\u0646 \u0635\u062d\u064a\u062d\u0629 \u0641\u0642\u0637 \u0641\u064a \u062d\u0627\u0644\u0629 \"P\" \u0648\"Q\" \u0635\u062d\u064a\u062d\u062a\u064a\u0646 \u0645\u0639\u0627. \u0647\u0646\u0627\u0643 \u0637\u0631\u064a\u0642\u0629 \u0623\u062e\u0631\u0649 \u0644\u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \"Q \u0648P\" \u0648\u0647\u064a \u0628\u0642\u0648\u0644 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0635\u062d\u064a\u062d\u0629 \u0623\u0648 \u062e\u0627\u0637\u0626\u0629 \u0628\u062f\u0644\u0627\u0644\u0629 \"P\" \u0648\"Q\"\u060c \u0648\u0647\u0630\u0627 \u0645\u0627 \u064a\u064f\u0633\u0645\u0649 \u062c\u062f\u0648\u0644 \u062d\u0642\u064a\u0642\u0629 : \u062c\u062f\u0648\u0644 \u062d\u0642\u064a\u0642\u0629 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \"Q \u0648P\" \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P {\\displaystyle P} \u0627\u0644\u0639\u0628\u0627\u0631\u0629 Q {\\displaystyle Q} \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P \u2227 Q {\\displaystyle P\\land Q} \u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629 \u062e\u0627\u0637\u0626\u0629 \u062e\u0627\u0637\u0626\u0629 \u062e\u0627\u0637\u0626\u0629 \u0635\u062d\u064a\u062d\u0629 \u062e\u0627\u0637\u0626\u0629 \u062e\u0627\u0637\u0626\u0629 \u062e\u0627\u0637\u0626\u0629 \u062e\u0627\u0637\u0626\u0629 \u0645\u062b\u0644\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a P {\\displaystyle P} \u0647\u064a \u0627\u0644\u0639\u0628\u0627\u0631\u0629: \"\u0647\u0630\u0647 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0647\u064a \u0622\u0633\": \u0648 Q {\\displaystyle Q} \u0647\u064a \u0627\u0644\u0639\u0628\u0627\u0631\u0629: \"\u0647\u0630\u0647 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0647\u064a \u0642\u0644\u0628\"\u060c \u0641\u0625\u0646 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P \u2227 Q {\\displaystyle P\\land Q} \u0633\u062a\u0643\u0648\u0646 \u0635\u062d\u064a\u062d\u0629 \u0625\u0630\u0627\u0643\u0627\u0646\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0647\u064a \"\u0622\u0633 \u0627\u0644\u0642\u0644\u0628\"\u060c \u0648\u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0633\u062a\u0643\u0648\u0646 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P \u2227 Q {\\displaystyle P\\land Q} \u062e\u0627\u0637\u0626\u0629. \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0645\u0646\u0637\u0642\u064a [ \u0639\u062f\u0644 ] \u062a\u0643\u0648\u0646 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \"Q \u0623\u0648 P\" \u0635\u062d\u064a\u062d\u0629 \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u0625\u062d\u062f\u0649 \u0627\u0644\u0639\u0628\u0627\u0631\u062a\u064a\u0646 \"P\" \u0623\u0648 \"Q\" \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0635\u062d\u064a\u062d\u0629. \u0648\u062a\u0643\u0648\u0646 \u062e\u0627\u0637\u0626\u0629 \u0641\u064a \u062d\u0627\u0644\u0629 \"P\" \u0648 \"Q\" \u062e\u0627\u0637\u0626\u062a\u064a\u0646 \u0645\u0639\u0627. \u062c\u062f\u0648\u0644 \u062d\u0642\u064a\u0642\u0629 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \"Q \u0623\u0648 P\" \u0647\u0648 \u0627\u0644\u062a\u0627\u0644\u064a: \u062c\u062f\u0648\u0644 \u062d\u0642\u064a\u0642\u0629 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 \"Q \u0623\u0648 P\" \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P {\\displaystyle P} \u0627\u0644\u0639\u0628\u0627\u0631\u0629 Q {\\displaystyle Q} \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P \u2228 Q {\\displaystyle P\\lor Q} \u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629 \u062e\u0627\u0637\u0626\u0629 \u0635\u062d\u064a\u062d\u0629 \u062e\u0627\u0637\u0626\u0629 \u0635\u062d\u064a\u062d\u0629 \u0635\u062d\u064a\u062d\u0629 \u062e\u0627\u0637\u0626\u0629 \u062e\u0627\u0637\u0626\u0629 \u062e\u0627\u0637\u0626\u0629 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0645\u062b\u0627\u0644 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u062a\u0643\u0648\u0646 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P \u2228 Q {\\displaystyle P\\lor Q} \u0635\u062d\u064a\u062d\u0629 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \"\u0622\u0633\" \u0623\u0648 \"\u0642\u0644\u0628\" \u0623\u0648 \"\u0622\u0633 \u0648\u0642\u0644\u0628\"\u060c \u0648\u0644\u0643\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0641\u0625\u0646 \u0627\u0644\u0639\u0628\u0627\u0631\u0629 P \u2228 Q {\\displaystyle P\\lor Q} \u062e\u0627\u0637\u0626\u0629. \u0639\u0645\u0648\u0645\u0627 \u0627\u0644\u0641\u0635\u0644 \u0627\u0644\u0645\u0646\u0637\u0642\u064a \u0644\u064a\u0633 \u0647\u0648 \u0627\u0644\u0641\u0635\u0644 \u0641\u064a \u0627\u0644\u062d\u064a\u0627\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0645\u062b\u0644\u0627 \"\u0627\u062e\u062a\u064a\u0627\u0631 \u062c\u0628\u0646 \u0623\u0648 \u062a\u062d\u0644\u064a\u0629\" \u062a\u0639\u0646\u064a \u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u062d\u062f\u0647\u0645\u0627 \u0641\u0642\u0637\u060c \u062f\u0648\u0646 \u0627\u0644\u062c\u0645\u0639 \u0628\u064a\u0646\u0647\u0645\u0627. \u0627\u0644\u0645\u0631\u0627\u062c\u0639 [ \u0639\u062f\u0644 ] \u2191 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0645\u0648\u062d\u064e\u062f - \u062c\u0627\u0645\u0639\u0629 \u0648\u064a\u0633\u0643\u0648\u0646\u0633\u0646 \u0645\u0627\u062f\u064a\u0633\u0648\u0646 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0645\u0646\u0637\u0642_\u0631\u064a\u0627\u0636\u064a&oldid=124004 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u062d\u062f\u0629 \u0628\u0637\u0627\u0642\u0629 \u0645\u0642\u0627\u0644\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0648\u0627\u0644\u0628 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u062e\u0627\u0635\u064a\u0629 P18 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645 \u062a\u0646\u0633\u064a\u0642\u0627 \u0645\u0647\u0645\u0644\u0627 \u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u0628\u062d\u062b \u0628\u062d\u062b \u0645\u0646\u0637\u0642 \u0631\u064a\u0627\u0636\u064a 5 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

{
  "url": "https://ar.wikipedia.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D8%A7%D9%84%D9%82%D8%B1%D9%86_11",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u0642\u0631\u0646 11 - \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u0642\u0631\u0646 11 - \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627\u060c \u0627\u0644\u0645\u0648\u0633\u0648\u0639\u0629 \u0627\u0644\u062d\u0631\u0629 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0648\u0633\u0637\u0649 \u0628\u0648\u0627\u0628\u0629 \u0632\u0645\u0646 \u0627\u0644\u0645\u0642\u0627\u0644\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u060c \u0647\u064a \u0627\u0644\u0642\u0631\u0646 11 . \u0633\u0646\u0648\u0627\u062a  \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 \u0627\u0644\u0642\u0631\u0646  6 \u0627\u0644\u0642\u0631\u0646  7 \u0627\u0644\u0642\u0631\u0646  8 \u0627\u0644\u0642\u0631\u0646  9 \u0627\u0644\u0642\u0631\u0646  10 \u0627\u0644\u0642\u0631\u0646  11 \u0627\u0644\u0642\u0631\u0646  12 \u0627\u0644\u0642\u0631\u0646  13 \u0627\u0644\u0642\u0631\u0646  14 \u0627\u0644\u0642\u0631\u0646  15 \u0627\u0644\u0642\u0631\u0646  16 \u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u0642\u0631\u0646 11 \u0641\u064a \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0634\u0642\u064a\u0642\u0629 \u0648\u0633\u0627\u0626\u0637 \u0645\u0646 \u0643\u0648\u0645\u0646\u0632 \u0627\u0642\u062a\u0628\u0627\u0633\u0627\u062a \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0627\u0642\u062a\u0628\u0627\u0633 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u064a\u0634\u062a\u0645\u0644 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0639\u0644\u0649 43 \u062a\u0635\u0646\u064a\u0641\u0627 \u0641\u0631\u0639\u064a\u0627\u060c \u0645\u0646 \u0623\u0635\u0644 43. 1 \u0639\u0642\u062f 1000 (30 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1010 (26 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1020 (28 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1030 (24 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1040 (23 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1050 (27 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1060 (27 \u062a\u060c 2 \u0635) \u0639\u0642\u062f 1070 (27 \u062a\u060c 2 \u0635) \u0639\u0642\u062f 1080 (25 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1090 (32 \u062a\u060c 1 \u0635) 1100 (11 \u062a\u060c 1 \u0635) \u0639\u0642\u062f 1100 (29 \u062a\u060c 1 \u0635) \u0623 \u0623\u0634\u062e\u0627\u0635 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (19 \u062a\u060c 15 \u0635) \u0623\u0639\u0645\u0627\u0644 \u062e\u064a\u0627\u0644\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (8 \u062a) \u0623\u0639\u0645\u0627\u0644 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (23 \u062a\u060c 1 \u0635) \u0623\u0641\u0644\u0627\u0645 \u062a\u0642\u0639 \u0623\u062d\u062f\u0627\u062b\u0647\u0627 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (4 \u062a\u060c 6 \u0635) \u0627 \u0627\u0644\u0642\u0631\u0646 11 \u062d\u0633\u0628 \u0627\u0644\u0628\u0644\u062f (94 \u062a) \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (1 \u062a\u060c 1 \u0635) \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0633\u0643\u0631\u064a \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (7 \u062a\u060c 1 \u0635) \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (2 \u062a) \u0627\u0644\u062f\u064a\u0646 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (23 \u062a\u060c 1 \u0635) \u0627\u0644\u0639\u0644\u0645 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (3 \u062a\u060c 5 \u0635) \u0627\u0644\u0641\u0646\u0648\u0646 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (16 \u062a) \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (5 \u062a) \u0627\u0644\u0642\u0631\u0646 11 \u062d\u0633\u0628 \u0627\u0644\u0642\u0627\u0631\u0629 (18 \u062a) \u0627\u0644\u0642\u0631\u0646 11 \u062d\u0633\u0628 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 (2 \u062a) \u0627\u0644\u0645\u0633\u064a\u062d\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (16 \u062a\u060c 4 \u0635) \u0627\u0646\u062d\u0644\u0627\u0644\u0627\u062a \u0627\u0644\u0642\u0631\u0646 11 (14 \u062a) \u0628 \u0628\u062f\u0627\u064a\u0627\u062a \u0627\u0644\u0642\u0631\u0646 11 (21 \u062a) \u062a \u062a\u0623\u0633\u064a\u0633\u0627\u062a \u0622\u0633\u064a\u0627 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (8 \u062a) \u062a\u0623\u0633\u064a\u0633\u0627\u062a \u0623\u0648\u0631\u0648\u0628\u0627 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (9 \u062a) \u062a\u0623\u0633\u064a\u0633\u0627\u062a \u0627\u0644\u0642\u0631\u0646 11 (20 \u062a\u060c 2 \u0635) \u0633 \u0633\u0646\u0648\u0627\u062a \u0627\u0644\u0642\u0631\u0646 11 (101 \u062a) \u0633\u064a\u0627\u0633\u0629 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (2 \u062a) \u0639 \u0627\u0644\u0639\u0631\u0627\u0642 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (2 \u062a\u060c 8 \u0635) \u0639\u0645\u0627\u0631\u0629 \u0627\u0644\u0642\u0631\u0646 11 (10 \u062a\u060c 8 \u0635) \u0642 \u0642\u0648\u0627\u0626\u0645 \u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0642\u0631\u0646 11 (3 \u0635) \u0643 \u0643\u0648\u0627\u0631\u062b \u0627\u0644\u0642\u0631\u0646 11 (1 \u062a) \u0643\u0648\u0627\u0631\u062b \u0637\u0628\u064a\u0639\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (1 \u062a\u060c 2 \u0635) \u0645 \u0645\u0648\u0627\u0644\u064a\u062f \u0627\u0644\u0642\u0631\u0646 11 (11 \u062a\u060c 109 \u0635) \u0646 \u0646\u0632\u0627\u0639\u0627\u062a \u0641\u064a \u0627\u0644\u0642\u0631\u0646 11 (58 \u062a\u060c 14 \u0635) \u0646\u0647\u0627\u064a\u0627\u062a \u0627\u0644\u0642\u0631\u0646 11 (25 \u062a) \u0648 \u0648\u0641\u064a\u0627\u062a \u0627\u0644\u0642\u0631\u0646 11 (21 \u062a\u060c 49 \u0635) \u0635\u0641\u062d\u0627\u062a \u062a\u0635\u0646\u064a\u0641 \u00ab\u0627\u0644\u0642\u0631\u0646 11\u00bb \u064a\u0634\u062a\u0645\u0644 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0639\u0644\u0649 12 \u0635\u0641\u062d\u0629\u060c \u0645\u0646 \u0623\u0635\u0644 12. \u0627\u0644\u0642\u0631\u0646 11 \u0627 \u0627\u0644\u062d\u0642\u0628\u0629 \u0627\u0644\u0642\u0631\u0648\u0633\u0637\u064a\u0629 \u0627\u0644\u062f\u0627\u0641\u0626\u0629 \u0627\u0644\u062d\u0645\u0644\u0629 \u0627\u0644\u062d\u0645\u0627\u062f\u064a\u0629 \u0639\u0644\u0649 \u0625\u0641\u0631\u064a\u0642\u064a\u0629 (1068-1069) \u0627\u0644\u063a\u0632\u0648 \u0627\u0644\u0647\u0644\u0627\u0644\u064a \u0644\u0625\u0641\u0631\u064a\u0642\u064a\u0629 \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062d\u0627\u062f\u064a \u0639\u0634\u0631 \u0641\u064a \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0646\u0647\u0636\u0629 \u0627\u0644\u0633\u0646\u064a\u0629 \u062d \u062d\u0631\u0628 \u0628\u0646\u064a \u064a\u0627\u0633\u064a\u0646 \u0648\u0628\u0646\u064a \u0647\u0644\u0627\u0644 \u0632 \u0632\u0648\u0628\u064a\u0646 \u062f\u0645\u0627\u0646\u064a\u0627 \u0639 \u0639\u064a\u062f \u0627\u0644\u0639\u062c\u0627\u0626\u0628 \u0645 \u0645\u0639\u0631\u0643\u0629 \u062d\u064a\u062f\u0631\u0627\u0646 \u0645\u0639\u0631\u0643\u0629 \u0633\u0628\u064a\u0628\u0629 \u0645\u0646\u0638\u0648\u0645\u0629 \u0627\u0644\u0625\u0644\u0628\u064a\u0631\u064a \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikipedia.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u0642\u0631\u0646_11&oldid=62690745 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0627\u0644\u0623\u0644\u0641\u064a\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0627\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0648\u0633\u0637\u0649 \u0642\u0631\u0648\u0646 \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0635\u0646\u064a\u0641 : \u0627\u0644\u0642\u0631\u0646 11 146 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

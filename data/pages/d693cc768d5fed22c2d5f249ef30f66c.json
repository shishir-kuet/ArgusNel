  "title": "\u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u062f\u0627\u0644\u0629 \u0623\u0635\u0644\u064a\u0629 \u0644\u062f\u0627\u0644\u0629 \u0639\u0644\u0649 \u0645\u062c\u0627\u0644 [ \u0639\u062f\u0644 ] \u062a\u0639\u0631\u064a\u0641 \u0644\u062a\u0643\u0646 f {\\displaystyle f} \u0648 F {\\displaystyle F} \u062f\u0627\u0644\u062a\u064a\u0646 \u0645\u0639\u0631\u0641\u062a\u064a\u0646 \u0639\u0644\u0649 \u0645\u062c\u0627\u0644 I {\\displaystyle I} \u0646\u0642\u0648\u0644 \u0625\u0646 F {\\displaystyle F} \u0647\u064a \u062f\u0627\u0644\u0629 \u0623\u0635\u0644\u064a\u0629 \u0644\u0644\u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0627\u0644 I {\\displaystyle I} \u0625\u0630\u0627 \u0643\u0627\u0646\u062a F {\\displaystyle F} \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0639\u0644\u0649 I {\\displaystyle I} \u0648 F \u2032 ( x ) = f ( x ) {\\displaystyle F'(x)=f(x)} \u0644\u0643\u0644 x {\\displaystyle x} \u0645\u0646 I {\\displaystyle I} \u062e\u0627\u0635\u064a\u0629 \u0643\u0644 \u062f\u0627\u0644\u0629 \u0645\u062a\u0635\u0644\u0629 \u0639\u0644\u0649 \u0645\u062c\u0627\u0644 I {\\displaystyle I} \u062a\u0642\u0628\u0644 \u062f\u0627\u0644\u0629 \u0623\u0635\u0644\u064a\u0629 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u062c\u0627\u0644. \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0644\u062f\u0627\u0644\u0629 \u0645\u062a\u0635\u0644\u0629 [ \u0639\u062f\u0644 ] \u062e\u0627\u0635\u064a\u0629 \u0644\u062a\u0643\u0646 f {\\displaystyle f} \u062f\u0627\u0644\u0629 \u0645\u062a\u0635\u0644\u0629 \u0639\u0644\u0649 \u0645\u062c\u0627\u0644 I {\\displaystyle I} \u0625\u0630\u0627 \u0643\u0627\u0646\u062a F {\\displaystyle F} \u062f\u0627\u0644\u0629 \u0623\u0635\u0644\u064a\u0629 \u0644\u0644\u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0627\u0644 I {\\displaystyle I} \u0641\u0625\u0646 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0644\u0623\u0635\u0644\u064a\u0629 \u0644\u0644\u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0639\u0644\u0649 I {\\displaystyle I} \u0647\u064a \u0627\u0644\u062f\u0648\u0627\u0644 x \u21a6 F ( x ) + c {\\displaystyle x\\mapsto F(x)+c} \u062d\u064a\u062b c {\\displaystyle c} \u0639\u062f\u062f \u062d\u0642\u064a\u0642\u064a \u062b\u0627\u0628\u062a. \u0644\u0643\u0644 x 0 {\\displaystyle x_{0}} \u0645\u0646 I {\\displaystyle I} \u0648 y 0 {\\displaystyle y_{0}} \u0645\u0646 R {\\displaystyle \\mathbb {R} } \u060c \u062a\u0648\u062c\u062f \u062f\u0627\u0644\u0629 \u0623\u0635\u0644\u064a\u0629 \u0648\u062d\u064a\u062f\u0629 G {\\displaystyle G} \u0644\u0644\u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0627\u0644 I {\\displaystyle I} \u0628\u062d\u064a\u062b\u00a0: G ( x 0 ) = y 0 {\\displaystyle G(x_{0})=y_{0}} \u062c\u062f\u0648\u0644 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0644\u0628\u0639\u0636 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0627\u0639\u062a\u064a\u0627\u062f\u064a\u0629 [ \u0639\u062f\u0644 ] \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u062a\u0627\u0644\u064a \u064a\u064f\u0639\u0637\u064a \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0644\u0628\u0639\u0636 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0627\u0639\u062a\u064a\u0627\u062f\u064a\u0629 \u0639\u0644\u0649 \u0645\u062c\u0627\u0644 I {\\displaystyle I} \u062d\u064a\u062b c {\\displaystyle c} \u062b\u0627\u0628\u062a\u0629 \u062d\u0642\u064a\u0642\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0644\u0628\u0639\u0636 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0627\u0639\u062a\u064a\u0627\u062f\u064a\u0629 \u0627\u0644\u062f\u0627\u0644\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0627\u0644\u0645\u062c\u0627\u0644 I {\\displaystyle I} x \u21a6 0 {\\displaystyle x\\mapsto 0} x \u21a6 c {\\displaystyle x\\mapsto c} R {\\displaystyle \\mathbb {R} } x \u21a6 a {\\displaystyle x\\mapsto a} x \u21a6 a x + c {\\displaystyle x\\mapsto ax+c} R {\\displaystyle \\mathbb {R} } x \u21a6 x n ( n \u2208 N \u2217 ) {\\displaystyle x\\mapsto x^{n}\\quad (n\\in \\mathbb {N} ^{*})} x \u21a6 x n + 1 n + 1 + c {\\displaystyle x\\mapsto {\\frac {x^{n+1}}{n+1}}+c} R {\\displaystyle \\mathbb {R} } x \u21a6 x n ( n \u2208 Z \u2212 \u2217 \u2216 { \u2212 1 } ) {\\displaystyle x\\mapsto x^{n}\\quad (n\\in \\mathbb {Z} ^{-*}\\smallsetminus \\{-1\\})} x \u21a6 x n + 1 n + 1 + c {\\displaystyle x\\mapsto {\\frac {x^{n+1}}{n+1}}+c} R + \u2217 {\\displaystyle \\mathbb {R} ^{+*}} \u0623\u0648 R \u2212 \u2217 {\\displaystyle \\mathbb {R} ^{-*}} x \u21a6 x r ( r \u2208 Q \u2212 \u2217 \u2216 { \u2212 1 } ) {\\displaystyle x\\mapsto x^{r}\\quad (r\\in \\mathbb {Q} ^{-*}\\smallsetminus \\{-1\\})} x \u21a6 x r + 1 r + 1 + c {\\displaystyle x\\mapsto {\\frac {x^{r+1}}{r+1}}+c} R + \u2217 {\\displaystyle \\mathbb {R} ^{+*}} x \u21a6 1 x 2 {\\displaystyle x\\mapsto {\\frac {1}{x^{2}}}} x \u21a6 \u2212 1 x + c {\\displaystyle x\\mapsto -{\\frac {1}{x}}+c} R + \u2217 {\\displaystyle \\mathbb {R} ^{+*}} \u0623\u0648 R \u2212 \u2217 {\\displaystyle \\mathbb {R} ^{-*}} x \u21a6 1 x {\\displaystyle x\\mapsto {\\frac {1}{\\sqrt {x}}}} x \u21a6 2 x + c {\\displaystyle x\\mapsto 2{\\sqrt {x}}+c} R + \u2217 {\\displaystyle \\mathbb {R} ^{+*}} x \u21a6 cos \u2061 x {\\displaystyle x\\mapsto \\cos x} x \u21a6 sin \u2061 x + c {\\displaystyle x\\mapsto \\sin x+c} R {\\displaystyle \\mathbb {R} } x \u21a6 sin \u2061 x {\\displaystyle x\\mapsto \\sin x} x \u21a6 \u2212 cos \u2061 x + c {\\displaystyle x\\mapsto -\\cos x+c} R {\\displaystyle \\mathbb {R} } x \u21a6 cos \u2061 ( a x + b ) ( a \u2208 R \u2217 ) {\\displaystyle x\\mapsto \\cos(ax+b)\\quad (a\\in \\mathbb {R} ^{*})} x \u21a6 1 a sin \u2061 ( a x + b ) + c {\\displaystyle x\\mapsto {\\frac {1}{a}}\\sin(ax+b)+c} R {\\displaystyle \\mathbb {R} } x \u21a6 sin \u2061 ( a x + b ) ( a \u2208 R \u2217 ) {\\displaystyle x\\mapsto \\sin(ax+b)\\quad (a\\in \\mathbb {R} ^{*})} x \u21a6 \u2212 1 a cos \u2061 ( a x + b ) + c {\\displaystyle x\\mapsto -{\\frac {1}{a}}\\cos(ax+b)+c} R {\\displaystyle \\mathbb {R} } x \u21a6 1 + tan 2 \u2061 x = 1 cos 2 \u2061 x {\\displaystyle x\\mapsto 1+\\tan ^{2}{x}={\\frac {1}{\\cos ^{2}{x}}}} x \u21a6 tan \u2061 x + c {\\displaystyle x\\mapsto \\tan x+c} ] \u2212 \u03c0 2 + k \u03c0 , \u03c0 2 + k \u03c0 [ , ( k \u2208 Z ) {\\displaystyle \\left]-{\\frac {\\pi }{2}}+k\\pi ,{\\frac {\\pi }{2}}+k\\pi \\right[,(k\\in \\mathbb {Z} )} x \u21a6 1 1 + x 2 {\\displaystyle x\\mapsto {\\frac {1}{1+x^{2}}}} x \u21a6 arctan \u2061 x + c {\\displaystyle x\\mapsto \\arctan x+c} R {\\displaystyle \\mathbb {R} } x \u21a6 u \u2032 ( x ) 1 + ( u ( x ) ) 2 {\\displaystyle x\\mapsto {\\frac {u'(x)}{1+(u(x))^{2}}}} x \u21a6 arctan \u2061 ( u ( x ) ) + c {\\displaystyle x\\mapsto \\arctan(u(x))+c} D u \u2032 {\\displaystyle D_{u'}} \u0627\u0646\u0638\u0631 \u0623\u064a\u0636\u0627 [ \u0639\u062f\u0644 ] \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0646\u0647\u0627\u064a\u0629 \u0645\u062a\u062a\u0627\u0644\u064a\u0629 \u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0639\u062f\u062f\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0644\u0648\u063a\u0627\u0631\u064a\u062a\u0645\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0633\u064a\u0629 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0627\u0644\u0645\u0639\u0627\u062f\u0644\u0627\u062a \u0627\u0644\u062a\u0641\u0627\u0636\u0644\u064a\u0629 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u062f\u0648\u0627\u0644_\u0627\u0644\u0623\u0635\u0644\u064a\u0629&oldid=72504 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u062a\u062d\u0644\u064a\u0644 \u0631\u064a\u0627\u0636\u064a \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 1 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

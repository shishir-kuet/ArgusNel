  "title": "\u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0627\u0644\u0623\u064a\u0628\u064a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u064491.186.249.79 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0627\u0644\u0623\u064a\u0628\u064a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u064491.186.249.79 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0644\u0640 91.186.249.79 \u0646\u0642\u0627\u0634 \u0633\u062c\u0644 \u0627\u0644\u0645\u0646\u0639 \u0633\u062c\u0644\u0627\u062a \u0633\u062c\u0644 \u0627\u0644\u0645\u0646\u0639 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0633\u062c\u0644 \u0627\u0644\u0625\u0633\u0627\u0621\u0629 \u0627\u0646\u0638\u0631 \u0646\u0637\u0627\u0642\u064b\u0627 \u0623\u0648\u0633\u0639 \u0646\u0637\u0627\u0642\u0627\u062a: /16 \u060c /24 \u0628\u062d\u062b \u0639\u0646 \u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0625\u0638\u0647\u0627\u0631 \u0625\u062e\u0641\u0627\u0621 \u29fccontribs-top\u29fd \u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0625\u0646\u062a\u0631\u0646\u062a \u0623\u0648 \u0627\u0633\u0645 \u0645\u0633\u062a\u062e\u062f\u0645: \u0627\u0644\u0646\u0637\u0627\u0642: \u0627\u0644\u0643\u0644 (\u0631\u0626\u064a\u0633\u064a) \u0646\u0642\u0627\u0634 \u0645\u0633\u062a\u062e\u062f\u0645 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u064a\u0643\u064a \u0643\u062a\u0628 \u0646\u0642\u0627\u0634 \u0648\u064a\u0643\u064a \u0643\u062a\u0628 \u0645\u0644\u0641 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0644\u0641 \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a \u0646\u0642\u0627\u0634 \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a \u0642\u0627\u0644\u0628 \u0646\u0642\u0627\u0634 \u0627\u0644\u0642\u0627\u0644\u0628 \u0645\u0633\u0627\u0639\u062f\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u062a\u0635\u0646\u064a\u0641 \u0646\u0642\u0627\u0634 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 TimedText TimedText tal
  "url": "http://ar.wikibooks.org/wiki/%D8%A7%D9%84%D8%A3%D9%84%D9%85%D8%A7%D9%86%D9%8A%D8%A9",
  "title": "\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0645\u0631\u062d\u0628\u0627 \u0628\u0643\u0645 \u0641\u064a \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0643\u062a\u0627\u0628 \u0645\u062c\u0627\u0646\u064a \u0644\u062a\u0639\u0644\u0645 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 . \u0648\u0628\u0645\u0627 \u0623\u0646 \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0644\u0627 \u064a\u0632\u0627\u0644 \u0642\u064a\u062f \u0627\u0644\u062a\u0637\u0648\u064a\u0631\u060c \u0641\u0623\u0646\u062a \u0645\u062f\u0639\u0648 \u0644\u062a\u0642\u062f\u064a\u0645 \u0623\u064a \u0645\u0634\u0627\u0643\u0644 \u0648\u0627\u0642\u062a\u0631\u0627\u062d\u0627\u062a \u0641\u064a \u0635\u0641\u062d\u0629 \u0627\u0644\u0646\u0642\u0627\u0634 . \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u063a\u0628 \u0641\u064a \u0627\u0644\u0645\u0633\u0627\u0647\u0645\u0629\u060c \u0644\u0627 \u062a\u0631\u062f\u062f \u0641\u064a \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629. \u2713\u0647\u0644 \u062a\u0639\u0644\u0645\u061f\u2193 \u0623\u0646 \u0627\u0644\u0625\u0639\u0631\u0627\u0628 \u0641\u064a \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 \u0645\u0647\u0645 \u062c\u062f\u0627\u064b\u060c \u0628\u0644 \u064a\u063a\u064a\u0631 \u0627\u0644\u0645\u0639\u0646\u0649 \u0627\u0644\u0645\u0642\u0635\u0648\u062f \u0643\u0644\u064a\u0627\u064b. \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0642\u0627\u0645 \u0627\u0644\u0623\u0648\u0644 \u0641\u064a \u0623\u0644\u0645\u0627\u0646\u064a\u0627 (\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0625\u0644\u0649 \u0623\u0643\u062b\u0631 \u0645\u0646 95 \u066a \u0645\u0646 \u0627\u0644\u0633\u0643\u0627\u0646)\u060c \u0627\u0644\u0646\u0645\u0633\u0627 (89 \u066a) \u0648\u0633\u0648\u064a\u0633\u0631\u0627 (65 \u066a). \u0648\u063a\u0627\u0644\u0628\u064a\u0629 \u0627\u0644\u0633\u0643\u0627\u0646 \u0641\u064a \u0644\u064a\u062e\u062a\u0646\u0634\u062a\u0627\u064a\u0646 \u064a\u062a\u062d\u062f\u062b \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629. \u0645\u062d\u062a\u0648\u064a\u0627\u062a [ \u0639\u062f\u0644 ] ( \u062a\u0639\u062f\u064a\u0644 \u0642\u0627\u0644\u0628 ) \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 ( \u0627\u0644\u0645\u0646\u0627\u0642\u0634\u0629 ) \u062f\u0631\u0648\u0633 : \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0623\u0648\u0644 \u2022 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062b\u0627\u0646\u064a \u2022 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062b\u0627\u0644\u062b \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0631\u0627\u0628\u0639 \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062e\u0627\u0645\u0633 \u0642\u0648\u0627\u0639\u062f \u2022 \u0645\u0644\u062d\u0642\u0627\u062a \u2022 \u062f\u0648\u0631\u0629 \u0644\u0644\u0645\u0628\u062a\u062f\u0626\u064a\u0646 \u2022 \u062d\u0648\u0644 (\u062a\u062a\u0636\u0645\u0646 \u0637\u0628\u0627\u0639\u0629 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a ) \u2022 Q&A \u2022 \u062a\u0635\u0645\u064a\u0645 \u0642\u0627\u0644\u0628:\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629/\u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0623\u0648\u0644/\u0645\u0642\u062f\u0645\u0629 \u0642\u0627\u0644\u0628:\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629/\u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062b\u0627\u0646\u064a/\u0645\u0642\u062f\u0645\u0629 \u0642\u0627\u0644\u0628:\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629/\u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062b\u0627\u0644\u062b/\u0645\u0642\u062f\u0645\u0629 \u0642\u0627\u0644\u0628:\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629/\u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0631\u0627\u0628\u0639 \u0642\u0627\u0644\u0628:\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629/\u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062e\u0627\u0645\u0633 ( \u062a\u0639\u062f\u064a\u0644 \u0642\u0627\u0644\u0628 ) ( \u0627\u0644\u0645\u0646\u0627\u0642\u0634\u0629 ) \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0635\u0641\u0627\u062a \u0648\u0627\u0644\u0638\u0631\u0648\u0641 \u2022 \u0627\u0644\u0623\u0628\u062c\u062f\u064a\u0629 \u2022 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u2022 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u2022 \u062d\u0631\u0648\u0641 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u2022 \u0627\u0644\u0636\u0645\u0627\u0626\u0631 \u2022 \u0627\u0644\u062c\u0645\u0644 \u2022 \u0627\u0644\u0623\u0641\u0639\u0627\u0644 \u0627\u0644\u0623\u0641\u0639\u0627\u0644 |} ( \u062a\u0639\u062f\u064a\u0644 \u0642\u0627\u0644\u0628 ) \u0645\u0644\u062d\u0642\u0627\u062a ( \u0627\u0644\u0645\u0646\u0627\u0642\u0634\u0629 ) \u0623\u0644\u0641\u0628\u0627\u0626\u064a\u0629 \u2022 \u0645\u0641\u0631\u062f\u0627\u062a \u2022 \u062c\u0645\u0644 \u0643\u062a\u0627\u0628\u064a\u0629 \u2022 \u0645\u0635\u0627\u062f\u0631 \u2022 \u0627\u0644\u0623\u0633\u0627\u0645\u064a \u2022 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 \u2022 \u062f\u0648\u0644 \u0627\u0644\u0639\u0627\u0644\u0645 \u2022 False Friends \u2022 \u0627\u0644\u0623\u0631\u0642\u0627\u0645 \u2022 Keyboard Layout \u062a\u0645\u0627\u0631\u064a\u0646 \u2022 ( \u062a\u0639\u062f\u064a\u0644 \u0642\u0627\u0644\u0628 ) \u062f\u0648\u0631\u0629 \u0644\u0644\u0645\u0628\u062a\u062f\u0626\u064a\u0646 ( \u0627\u0644\u0645\u0646\u0627\u0642\u0634\u0629 ) \u0627\u0644\u062f\u0631\u0633 1 \u2022 \u0627\u0644\u062f\u0631\u0633 2 \u2022 \u0627\u0644\u062f\u0631\u0633 3 \u2022 \u0627\u0644\u062f\u0631\u0633 4 \u2022 \u0627\u0644\u062f\u0631\u0633 5 \u2022 \u0627\u0644\u062f\u0631\u0633 6 \u2022 \u0627\u0644\u062f\u0631\u0633 7 \u2022 \u0627\u0644\u062f\u0631\u0633 8 \u2022 \u0627\u0644\u062f\u0631\u0633 9 \u2022 \u0627\u0644\u062f\u0631\u0633 10 \u2022 \u0627\u0644\u062f\u0631\u0633 11 \u2022 \u0627\u0644\u062f\u0631\u0633 12 \u2022 \u0627\u0644\u062f\u0631\u0633 13 \u2022 \u0627\u0644\u062f\u0631\u0633 14 \u2022 \u0627\u0644\u062f\u0631\u0633 15 \u2022 \u0627\u0644\u062f\u0631\u0633 16 \u2022 \u0627\u0644\u062f\u0631\u0633 17 \u2022 \u0627\u0644\u062f\u0631\u0633 18 \u2022 \u0627\u0644\u062f\u0631\u0633 19 \u2022 \u0627\u0644\u062f\u0631\u0633 20 \u2022 \u0627\u0644\u062f\u0631\u0633 21 \u2022 \u0627\u0644\u062f\u0631\u0633 22 \u2022 \u0627\u0644\u062f\u0631\u0633 23 \u2022 \u0627\u0644\u062f\u0631\u0633 24 \u2022 \u0627\u0644\u062f\u0631\u0633 25 \u2022 \u0645\u0635\u0627\u062f\u0631 [ \u0639\u062f\u0644 ] \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0648\u062c\u0648\u062f \u0639\u0644\u0649 \u0646\u0633\u062e\u0629 PDF . \u0627\u0646\u0638\u0631 \u0627\u064a\u0636\u0627 [ \u0639\u062f\u0644 ] \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0644\u063a\u0627\u062a \u0647\u0646\u0627\u0643 \u0645\u0644\u0641\u0627\u062a \u0639\u0646 German language \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 . \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629&oldid=223495 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0644\u063a\u0627\u062a \u0639\u0644\u0645 \u0627\u0644\u0644\u063a\u0627\u062a \u0623\u0644\u0645\u0627\u0646\u064a\u0629 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0643\u062a\u0628 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0623\u0644\u0645\u0627\u0646\u064a\u0629 35 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

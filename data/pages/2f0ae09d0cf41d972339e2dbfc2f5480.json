{
  "url": "http://ar.wikibooks.org/wiki/%D8%B9%D8%A8%D8%B1%D9%8A%D8%A9/%D9%86%D8%B3%D8%A8%D8%A7%D8%A1",
  "title": "\u0639\u0628\u0631\u064a\u0629/\u0646\u0633\u0628\u0627\u0621 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0639\u0628\u0631\u064a\u0629/\u0646\u0633\u0628\u0627\u0621 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 < \u0639\u0628\u0631\u064a\u0629 \u0647\u0630\u0647 \u0642\u0627\u0626\u0645\u0629 \u0628\u0628\u0639\u0636 \u0627\u0644\u0646\u0633\u0628\u0627\u0621 (\u0625\u0646\u06af\u0644\u064a\u0632\u064a\u0629: Cognates)\u060c \u0623\u064a \u0627\u0644\u0623\u0644\u0641\u0627\u0638 \u0630\u0627\u062a \u0627\u0644\u0623\u0635\u0644 \u0627\u0644\u0645\u0634\u062a\u0631\u0643 \u0648\u0627\u0644\u0644\u0641\u0638 \u0648\u0627\u0644\u0645\u0639\u0646\u0649 \u0627\u0644\u0645\u062a\u0634\u0627\u0628\u0647\u060c \u0628\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u0627\u0644\u0639\u0628\u0631\u064a\u0629. \u0627\u0644\u0639\u0627\u0626\u0644\u0629 [ \u0639\u062f\u0644 ] \u0623\u0628: \u05d0\u05d1 \u0623\u0645: \u05d0\u05de\u05d0 \u0623\u062e: \u05d0\u05d7 \u0623\u062e\u062a: \u05d0\u05b8\u05d7\u05d5\u05b9\u05ea \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u062c\u0633\u062f [ \u0639\u062f\u0644 ] \u0631\u0623\u0633: \u05e8\u05d0\u05e9 \u0639\u064a\u0646: \u05e2\u05b7\u05d9\u05b4\u05df \u0623\u0630\u0646: \u05d0\u05b9\u05d6\u05b6\u05df \u0623\u0646\u0641: \u05d0\u05e3 \u0641\u0645: \u05e4\u05b6\u05bc\u05d4 \u0644\u0633\u0627\u0646: \u05dc\u05b8\u05e9\u05c1\u05d5\u05b9\u05df \u0633\u0650\u0646\u0652 (\u0636\u0650\u0631\u0652\u0633): \u05e9\u05df \u064a\u062f: \u05d9\u05b8\u05d3 \u0631\u0650\u062c\u0644: \u05e8\u05b6\u05d2\u05b6\u05dc \u0646\u0633\u0628\u0627\u0621 \u0633\u0644\u0628\u064a\u0648\u0646 [ \u0639\u062f\u0644 ] \u0647\u0630\u0647 \u0642\u0627\u0626\u0645\u0629 \u0628\u0628\u0639\u0636 \u0627\u0644\u0646\u0633\u0628\u0627\u0621 \u0627\u0644\u0633\u0644\u0628\u064a\u064a\u0646 (\u0625\u0646\u06af\u0644\u064a\u0632\u064a\u0629: False Cognates)\u060c \u0648\u0647\u064a \u062a\u062a\u0634\u0627\u0628\u0647 \u0641\u064a \u0627\u0644\u0631\u0633\u0645 \u0623\u0648 \u0627\u0644\u0644\u0641\u0638 \u0648\u062a\u062e\u062a\u0644\u0641 \u0641\u064a \u0627\u0644\u0645\u0639\u0646\u0649. \u0642\u0633\u0645 / \u0633\u062d\u0631 \u05e7\u05e1\u05dd \u062e\u0631\u064a\u0641 / \u0634\u062a\u0627\u0621 \u05d7\u05d5\u05e8\u05e3 \u0643\u0627\u0646 / \u0647\u0646\u0627 \u05db\u05d0\u05df \u0646\u062e\u0644 / \u0646\u0647\u0631 \u05e0\u05d7\u05e8 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0639\u0628\u0631\u064a\u0629/\u0646\u0633\u0628\u0627\u0621&oldid=219728 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0641\u0635\u0648\u0644 \u063a\u064a\u0631 \u0645\u0635\u0646\u0641\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u0639\u0628\u0631\u064a\u0629/\u0646\u0633\u0628\u0627\u0621 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

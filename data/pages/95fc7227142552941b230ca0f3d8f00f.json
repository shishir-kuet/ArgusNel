  "title": "\u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0635\u0644 \u0625\u0644\u0649 \u00ab\u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0647\u0646\u062f\u0633\u0629\u00bb - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0635\u0644 \u0625\u0644\u0649 \u00ab\u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0647\u0646\u062f\u0633\u0629\u00bb - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u2192 \u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0647\u0646\u062f\u0633\u0629 \u0645\u0627\u0630\u0627 \u064a\u0635\u0644 \u0647\u0646\u0627 \u29fcwhatlinkshere-whatlinkshere-target\u29fd \u0627\u0644\u0635\u0641\u062d\u0629: \u29fcwhatlinkshere-whatlinkshere-ns\u29fd \u0627\u0644\u0646\u0637\u0627\u0642: \u0627\u0644\u0643\u0644 (\u0631\u0626\u064a\u0633\u064a) \u0646\u0642\u0627\u0634 \u0645\u0633\u062a\u062e\u062f\u0645 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0646\u0642\u0627\u0634 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0645\u0644\u0641 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0644\u0641 \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a \u0646\u0642\u0627\u0634 \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a \u0642\u0627\u0644\u0628 \u0646\u0642\u0627\u0634 \u0627\u0644\u0642\u0627\u0644\u0628 \u0645\u0633\u0627\u0639\u062f\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u062a\u0635\u0646\u064a\u0641 \u0646\u0642\u0627\u0634 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0645\u062f\u0631\u0633\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0628\u0648\u0627\u0628\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 \u0645\u0648\u0636\u0648\u0639 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u0645\u062c\u0645\u0648\u0639\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 TimedText TimedText talk \u0648\u062d\u062f\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0648\u062d\u062f\u0629 \u0641\u0639\u0627\u0644\u064a\u0629 \u0646\u0642\u0627\u0634 \u0641\u0639\u0627\u0644\u064a\u0629 \u0645\u0648\u0636\u0648\u0639 \u0627\u0639\u0643\u0633 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u29fcwhatlinkshere-whatlinkshere-filter\u29fd \u0623\u062e\u0641 \u0627\u0644\u062a\u0636\u0645\u064a\u0646\u0627\u062a \u0623\u062e\u0641 \u0627\u0644\u0648\u0635\u0644\u0627\u062a \u0623\u062e\u0641 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0630\u0647\u0628 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u062a\u0635\u0644 \u0625\u0644\u0649 \u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0647\u0646\u062f\u0633\u0629 : \u062a\u0639\u0631\u0636 4 \u0639\u0646\u0627\u0635\u0631. \u0639\u0631\u0636 ( \u0627\u064450 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 | \u0627\u064450 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 ) ( 20 | 50 | 100 | 250 | 500 ). \u0645\u0633\u062a\u062e\u062f\u0645:\u0641\u0627\u0631\u0633 \u0627\u0644\u062a\u0648\u062d\u064a\u062f (\u0645\u0636\u0645\u0646) ( \u0648\u0635\u0644\u0627\u062a | \u0639\u062f\u0644 ) \u0645\u0633\u062a\u062e\u062f\u0645:Lucas624 (\u0645\u0636\u0645\u0646) ( \u0648\u0635\u0644\u0627\u062a | \u0639\u062f\u0644 ) \u0645\u0633\u062a\u062e\u062f\u0645:Mulham94 (\u0645\u0636\u0645\u0646) ( \u0648\u0635\u0644\u0627\u062a | \u0639\u062f\u0644 ) \u0642\u0627\u0644\u0628:\u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0647\u0646\u062f\u0633\u0629/\u0642\u0648\u0627\u0644\u0628 (\u0645\u0636\u0645\u0646) ( \u0648\u0635\u0644\u0627\u062a | \u0639\u062f\u0644 ) \u0639\u0631\u0636 ( \u0627\u064450 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 | \u0627\u064450 \u0627\u0644\u062a\u0627\u0644\u064a\u0629 ) ( 20 | 50 | 100 | 250 | 500 ). \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/wiki/\u062e\u0627\u0635:\u0645\u0627\u0630\u0627_\u064a\u0635\u0644_\u0647\u0646\u0627/\u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645_\u0643\u0644\u064a\u0629_\u0639\u0644\u0648\u0645_\u0627\u0644\u0647\u0646\u062f\u0633\u0629 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0635\u0644 \u0625\u0644\u0649 \u00ab\u0642\u0627\u0644\u0628:\u0645\u0633\u062a\u062e\u062f\u0645 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0647\u0646\u062f\u0633\u0629\u00bb \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

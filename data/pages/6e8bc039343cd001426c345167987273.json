00ec\u00e5\u00ed\u00ff \u00f1\u00eb\u00ee\u00e2\u00ee\u00ec, \u00f0\u00ee\u00e4\u00ed\u00e0\u00ff \u00d0\u00ee\u00f1\u00f1\u00e8\u00ff\u2026\u00bb / \u00c8\u00e2\u00e0\u00ed \u00c3\u00ee\u00eb\u00f3\u00e1\u00ed\u00e8\u00f7\u00e8\u00e9. - \u00d2\u00e5\u00ea\u00f1\u00f2 : \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 // \u00ca\u00e0\u00ec\u00e5\u00f0\u00f2\u00ee\u00ed : \u00f1\u00e5\u00f2\u00e5\u00e2\u00ee\u00e9 \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00e8 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb. - 2022. - \u00b9 156. - URL: https://webkamerton.ru/2022/10/utesh-menya-slovom-rodnaya-rossiya (\u00e4\u00e0\u00f2\u00e0 \u00ee\u00e1\u00f0\u00e0\u00f9\u00e5\u00ed\u00e8\u00ff: 21.11.2022). - \u00d0\u00e5\u00f6\u00e5\u00ed\u00e7\u00e8\u00ff \u00ed\u00e0 \u00ea\u00ed\u00e8\u00e3\u00f3: \u00c7\u00e0\u00ef\u00ee\u00e2\u00e5\u00e4\u00ed\u00e8\u00ea \u00eb\u00fe\u00e1\u00e2\u00e8 : \u00f1\u00f2\u00e8\u00f5\u00e8 / \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2019. 160 \u00f1. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 200-205. \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed, \u00c5. \u00c5. \u00ce\u00f2\u00f2\u00e0\u00ff\u00e2\u00f8\u00e8\u00e9 \u00f1\u00e2\u00e5\u00f2 : \u00d1\u00f2\u00e8\u00f5\u00e8 / \u00d0\u00e5\u00e4.,\u00e0\u00e2\u00f2.\u00e2\u00f1\u00f2\u00f3\u00ef.\u00f1\u00f2.\u00cc\u00e8\u00f8\u00e8\u00ed \u00c0.\u00c8. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00d4\u00e0\u00e9\u00ed \u00cb\u00e0\u00e9\u00ed, 1998. - 60\u00f1. \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed, \u00c5. \u00c5. \u0412\u00f0\u00e5\u00ec\u00ff \u00e4\u00ee\u00e6\u00e4\u00e5\u00e9 : [\u00d1\u00e1. \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2] / \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed. - \u00cc. : \u00c1\u00e0\u00f0\u00f1, 2002. - 151 \u00f1. \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed, \u00c5. \u00c5. \u00cf\u00f0\u00e5\u00e4\u00ee\u00f9\u00f3\u00f9\u00e5\u00ed\u00e8\u00e5 : [\u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2] / \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed ; [\u00f5\u00f3\u00e4\u00ee\u00e6. \u00cd. \u00d2\u00f0\u00f3\u00f5\u00e8\u00ed]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : [\u00e1. \u00e8.], 2010. : \u00d2\u00e8\u00ef. \u00e8\u00ec. \u00cf. \u00d4. \u00c0\u00ed\u00ee\u00f5\u00e8\u00ed\u00e0. - 199 \u00f1. \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed, \u00c5. \u00c5. \u00c1\u00ee\u00eb\u00fc\u00f8\u00e8\u00ec\u00e8 \u00f8\u00e0\u00e3\u00e0\u00ec\u00e8 : \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9 \u00e4\u00ee\u00f8\u00ea\u00ee\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00e8 \u00ec\u00eb\u00e0\u00e4\u00f8\u00e5\u00e3\u00ee \u00f8\u00ea\u00ee\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00e2\u00ee\u00e7\u00f0\u00e0\u00f1\u00f2\u00e0 / \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed ; [\u00f5\u00f3\u00e4\u00ee\u00e6. \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00cb\u00f3\u00ea\u00ea\u00ee\u00ed\u00e5\u00ed]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : [\u00e1. \u00e8.], 2011. : \u00d2\u00e8\u00ef\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e8\u00ec. \u00cf. \u00d4. \u00c0\u00ed\u00ee\u00f5\u00e8\u00ed\u00e0. - 31 \u00f1. \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed, \u00c5.\u00a0\u00cf\u00ee\u00ea\u00e0 \u00e3\u00ee\u00f0\u00e8\u00f2 \u00ed\u00e5\u00e3\u00e0\u00f1\u00ed\u00f3\u00f9\u00e5\u00e5 \u00f1\u00eb\u00ee\u00e2\u00ee // \u00cd\u00e5\u00e2\u00f1\u00ea\u00e8\u00e9 \u00e0\u00eb\u00fc\u00ec\u00e0\u00ed\u00e0\u00f5, \u00b9 1 (68), 2013. \u00d1. 45. \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e2\u00e5\u00f0\u00f1\u00e8\u00ff \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00c5. \u00cc\u00e5\u00e6\u00e4\u00f3 \u00cb\u00e0\u00e4\u00ee\u00e3\u00ee\u00e9 \u00e8 \u00ce\u00ed\u00e5\u00e3\u00ee : \u00f1\u00f2\u00e8\u00f5\u00e8 / \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2016. \u2013 160 \u00f1. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00cc\u00e5\u00e4\u00e8\u00e0\u00e3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00cc\u00c8\u00cd\u00d3\u00d2\u00db \u00cf\u00ce\u00dd\u00c7\u00c8\u00c8... \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00f7\u00e8\u00f2\u00e0\u00e5\u00f2 \u00f1\u00e2\u00ee\u00e8 \u00f1\u00f2\u00e8\u00f5\u00e8 \u00c5.\u00c5. \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed - \u00e3\u00eb\u00e0\u00e2\u00ed\u00fb\u00e9 \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0 \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb \u00c5.\u00c5. \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00e8 \u00cc\u00f3\u00e6\u00f1\u00ea\u00ee\u00e9 \u00e2\u00ee\u00ea\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00e0\u00ed\u00f1\u00e0\u00ec\u00e1\u00eb\u00fc \u00ab\u00cf\u00e5\u00f2\u00f0\u00ee\u00e3\u00eb\u00e8\u00f4\u00bb \u00e2 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e5 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00f1 \u00fe\u00ed\u00fb\u00ec\u00e8 \u00f7\u00e8\u00f2\u00e0\u00f2\u00e5\u00eb\u00ff\u00ec\u00e8 \u00ca\u00ee\u00ec\u00ef\u00ee\u00e7\u00e8\u00f2\u00ee\u00f0 \u00df\u00ea\u00ee\u00e2 \u00d4\u00e8\u00eb\u00e8\u00ed, \u00ef\u00ee\u00fd\u00f2 \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed, \u00f0\u00f3\u00ea\u00ee\u00e2\u00ee\u00e4\u00e8\u00f2\u00e5\u00eb\u00fc \u00e0\u00ed\u00f1\u00e0\u00ec\u00e1\u00eb\u00ff \u00ab\u00cf\u00e5\u00f2\u00f0\u00ee\u00e3\u00eb\u00e8\u00f4\u00bb \u00cc\u00e8\u00f0\u00ee\u00ed \u00d1\u00ea\u00f0\u00ff\u00e1\u00e8\u00ed \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed. \u00c2\u00e4\u00ee\u00f5\u00ed\u00ee\u00e2\u00e5\u00ed\u00e8\u00e5 \u00e2 \u00ea\u00e0\u00e6\u00e4\u00ee\u00ec \u00f1\u00eb\u00ee\u00e2\u00e5... \u00c1\u00e5\u00eb\u00ee\u00e5 \u00ec\u00ee\u00f0\u00e5 \u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 - \u00df\u00ea\u00ee\u00e2 \u00d4\u00e8\u00eb\u00e8\u00ed \u00d1\u00eb\u00ee\u00e2\u00e0 - \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed. \u00c8\u00f1\u00ef\u00ee\u00eb\u00ed\u00e8\u00f2\u00e5\u00eb\u00e8: \u00e0\u00ed\u00f1\u00e0\u00ec\u00e1\u00eb\u00fc \u00ab\u00cf\u00e5\u00f2\u00f0\u00ee\u00e3\u00eb\u00e8\u00f4\u00bb, \u00f1\u00ee\u00eb\u00e8\u00f1\u00f2 - \u00cc\u00e8\u00f0\u00ee\u00ed \u00d1\u00ea\u00f0\u00ff\u00e1\u00e8\u00ed. \u00c7\u00c0\u00cf\u00ce\u00c2\u00c5\u00c4\u00cd\u00c8\u00ca \u00cb\u00de\u00c1\u00c2\u00c8 \u00c0\u00e2\u00f2\u00ee\u00f0 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e8 - \u00df\u00ea\u00ee\u00e2 \u00d4\u00e8\u00eb\u00e8\u00ed. \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f1\u00eb\u00ee\u00e2 - \u00c5\u00eb\u00e5\u00ed\u00e0 \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed. \u00c8\u00f1\u00ef\u00ee\u00eb\u00ed\u00ff\u00e5\u00f2 \u00ec\u00f3\u00e6\u00f1\u00ea\u00ee\u00e9 \u00e2\u00ee\u00ea\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00e0\u00ed\u00f1\u00e0\u00ec\u00e1\u00eb\u00fc \u00cf\u00c5\u00d2\u00d0\u00ce\u00c3\u00cb\u00c8\u00d4 \u00cf\u00ee\u00f1\u00eb\u00e5 \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00eb\u00e5\u00ed\u00e8\u00ff \u00ef\u00e5\u00f1\u00e5\u00ed\u00ed\u00ee\u00e9 \u00ef\u00f0\u00ee\u00e3\u00f0\u00e0\u00ec\u00ec\u00fb \u00ed\u00e0 \u00f1\u00f2\u00e8\u00f5\u00e8 \u00c5\u00eb\u00e5\u00ed\u00fb \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00ab\u00d1\u00f3\u00e4\u00fc\u00e1\u00e0 \u00ec\u00ee\u00ff \u0096 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb \u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e9 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00e8, 2024\u00e3 \u00c8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ec\u00ee\u00e6\u00ed\u00ee \u00ef\u00f0\u00e8\u00ee\u00e1\u00f0\u00e5\u00f1\u00f2\u00e8 \u00e2 \u00ea\u00ed\u00e8\u00e6\u00ed\u00ee\u00ec \u00ea\u00e8\u00ee\u00f1\u00ea\u00e5 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00df \u00ee \u00e6\u00e8\u00e7\u00ed\u00e8 \u00f1\u00f3\u00e4\u00e8\u00f2\u00fc \u00ed\u00e5 \u00e1\u00e5\u00f0\u00f3\u00f1\u00fc... \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00c1\u00ee\u00eb\u00fc\u00f8\u00e8\u00ec\u00e8 \u00f8\u00e0\u00e3\u00e0\u00ec\u00e8 \u00d0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9 \u00e4\u00ee\u00f8\u00ea\u00ee\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00e8 \u00ec\u00eb\u00e0\u00e4\u00f8\u00e5\u00e3\u00ee \u00f8\u00ea\u00ee\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00e2\u00ee\u00e7\u00f0\u00e0\u00f1\u00f2\u00e0 \u00ca\u00f2\u00ee \u00e6\u00e8\u00e2\u00e5\u00f2 \u00e2 \u00eb\u00e5\u00f1\u00f3 \u00e8 \u00e2 \u00e4\u00ee\u00ec\u00e5? \u00d1\u00f2\u00e8\u00f5\u00e8 \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9 \u00e4\u00ee\u00f8\u00ea\u00ee\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00e2\u00ee\u00e7\u00f0\u00e0\u00f1\u00f2\u00e0. \u00d5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0 \u00cb\u00f3\u00ea\u00ea\u00ee\u00ed\u00e5\u00ed. \u00d1\u00f2\u00e8\u00f5\u00e8 \u00c5\u00eb\u00e5\u00ed\u00fb \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00c2\u00e8\u00e4\u00e5\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed\u00ee \u00e8 \u00ef\u00ee\u00e4\u00e3\u00ee\u00f2\u00ee\u00e2\u00eb\u00e5\u00ed\u00ee \u00ea \u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0\u00f6\u00e8\u00e8 \u00e2 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e5 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00d1\u00f7\u00e0\u00f1\u00f2\u00eb\u00e8\u00e2\u00fb\u00e9 \u00f1\u00eb\u00f3\u00f7\u00e0\u00e9 \u00d0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9 \u00c7\u00e0\u00ef\u00ee\u00e2\u00e5\u00e4\u00ed\u00e8\u00ea \u00eb\u00fe\u00e1\u00e2\u00e8 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00eb\u00e8\u00f0\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00f5 \u00f1\u00f2\u00e8\u00f5\u00ee\u00f2\u00e2\u00ee\u00f0\u00e5\u00ed\u00e8\u00e9 \u00d1\u00f2\u00e8\u00f5\u00e8 \u00e8\u00e7 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0 \u00c5\u00eb\u00e5\u00ed\u00fb \u00cf\u00e8\u00e5\u00f2\u00e8\u00eb\u00ff\u00e9\u00ed\u00e5\u00ed \u00ab\u00cc\u00e5\u00e6\u00e4\u00f3 \u00cb\u00e0\u00e4\u00ee\u00e3\u00ee\u00e9 \u00e8 \u00ce\u00ed\u00e5\u00e3\u00ee\u00bb \u00e2 \u00e8\u00f1\u00ef\u00ee\u00eb\u00ed\u00e5\u00ed\u00e8\u00e8 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5 \u00d1\u00f3\u00e4\u00fc\u00e1\u00e0 \u00ec\u00ee\u00ff \u0096 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff! \u00d6\u00e8\u00ea\u00eb \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2 \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

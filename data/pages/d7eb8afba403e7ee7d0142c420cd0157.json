{
  "url": "http://ar.wikiversity.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D8%A5%D8%AF%D8%A7%D8%B1%D8%A9_%D9%88%D9%8A%D9%83%D9%8A_%D8%A7%D9%84%D8%AC%D8%A7%D9%85%D8%B9%D8%A9",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0625\u062f\u0627\u0631\u0629 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0625\u062f\u0627\u0631\u0629 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u0647\u0646\u0627\u0643 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 \u062d\u0648\u0644: \u0625\u062f\u0627\u0631\u0629 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u064a\u062d\u0648\u064a 14 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629\u060c \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a 14. \u0625 \u0625\u062e\u0637\u0627\u0631 \u0627\u0644\u0625\u062f\u0627\u0631\u064a\u064a\u0646 (2 \u0635\u0641\u062d\u0629) \u0627 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 (2 \u062a\u0635\u0646\u064a\u0641\u060c 2 \u0635\u0641\u062d\u0629) \u062a \u062a\u0627\u0631\u064a\u062e \u0645\u0634\u0631\u0648\u0639 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 (1 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u062a\u062d\u0648\u064a\u0644\u0627\u062a (1 \u062a\u0635\u0646\u064a\u0641) \u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0644\u064a\u0646\u0629 (4 \u0635\u0641\u062d\u0629) \u0633 \u0633\u064a\u0627\u0633\u0627\u062a \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 (3 \u062a\u0635\u0646\u064a\u0641\u060c 5 \u0635\u0641\u062d\u0629) \u0635 \u0635\u0641\u062d\u0627\u062a \u0644\u0644\u062d\u0630\u0641 \u0627\u0644\u0633\u0631\u064a\u0639 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0629 \u0627\u0644\u0625\u062f\u0627\u0631\u0629 (8 \u0635\u0641\u062d\u0629) \u0642 \u0642\u0648\u0627\u0644\u0628 \u0625\u062f\u0627\u0631\u064a\u0629 (3 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0642\u0648\u0627\u0644\u0628 \u062a\u0646\u0638\u064a\u0645 \u0641\u064a \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 (1 \u062a\u0635\u0646\u064a\u0641\u060c 3 \u0635\u0641\u062d\u0629) \u0645 \u0645\u0633\u0627\u0639\u062f\u0629 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 (3 \u062a\u0635\u0646\u064a\u0641\u060c 2 \u0635\u0641\u062d\u0629) \u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u062d\u0633\u0628 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 (3 \u062a\u0635\u0646\u064a\u0641) \u0645\u064a\u062f\u0627\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 (1 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0648 \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a (2 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0635\u0641\u062d\u0627\u062a \u062a\u0635\u0646\u064a\u0641 \u00ab\u0625\u062f\u0627\u0631\u0629 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629\u00bb \u064a\u062d\u0648\u064a \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0648\u0639\u062f\u062f\u0647\u0627 8 \u0645\u0646 \u0623\u0635\u0644 8 \u0625\u062c\u0645\u0627\u0644\u0627\u064b. \u0625 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u0625\u062f\u0627\u0631\u064a\u0648\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u0625\u062f\u0627\u0631\u064a\u0648\u0646/\u062a\u0635\u0648\u064a\u062a/\u0623\u0631\u0634\u064a\u0641 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u0625\u062f\u0627\u0631\u064a\u0648\u0646/\u062a\u0635\u0648\u064a\u062a/\u0623\u0631\u0634\u064a\u0641 \u0633\u0627\u0628\u0642 \u0627 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u0627\u0644\u0625\u062f\u0627\u0631\u0629 \u062a \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u062a\u062e\u0631\u064a\u0628 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u0625\u062f\u0627\u0631\u064a\u0648\u0646/\u062a\u0635\u0648\u064a\u062a \u0635 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0648 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629:\u0648\u0633\u0648\u0645 \u062d\u0642\u0648\u0642 \u0646\u0634\u0631 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0625\u062f\u0627\u0631\u0629_\u0648\u064a\u0643\u064a_\u0627\u0644\u062c\u0627\u0645\u0639\u0629&oldid=70646 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0635\u0646\u064a\u0641 : \u0625\u062f\u0627\u0631\u0629 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 8 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

  "title": "\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u062f\u062e\u0644 \u0627\u0633\u0645 \u0645\u0633\u062a\u062e\u062f\u0645: \u062a\u062d\u0645\u064a\u0644 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0631\u0636 \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0631\u0636 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 Syunsyunminmin ( \u0646\u0642\u0627\u0634 | \u0645\u0633\u0627\u0647\u0645\u0627\u062a ) \u0639\u0636\u0648 \u0636\u0645\u0646\u064a \u0641\u064a: \u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0645\u0624\u0643\u062f\u0648\u0646 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0651\u0627 \u0633\u062c\u0644 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u062f\u062e\u0644\u0627\u062a \u0645\u0637\u0627\u0628\u0642\u0629 \u0641\u064a \u0627\u0644\u0633\u062c\u0644. \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/wiki/\u062e\u0627\u0635:\u0635\u0644\u0627\u062d\u064a\u0627\u062a_\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645/Syunsyunminmin \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

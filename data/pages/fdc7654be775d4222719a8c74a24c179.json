  "url": "http://ar.wikibooks.org/wiki/%D8%A7%D9%84%D8%A5%D8%B1%D8%B6%D8%A7%D8%B9/%D8%B1%D8%B6%D9%8A%D8%B9/%D8%A3%D8%B3%D8%A8%D9%88%D8%B9_%D8%B1%D9%82%D9%85_6",
  "title": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 6 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 6 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 < \u0627\u0644\u0625\u0631\u0636\u0627\u0639 | \u0631\u0636\u064a\u0639 \u064a\u0631\u062c\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u062d\u0648\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0637\u0628\u064a . \u0627\u0644\u0637\u0641\u0644 \u0628\u0639\u0645\u0631 \u0633\u062a\u0629 \u0623\u0633\u0627\u0628\u064a\u0639 \u060c \u0646\u0645\u0648 \u0627\u0644\u0637\u0641\u0644 [ \u0639\u062f\u0644 ] \u0643\u0645 \u0646\u0645\u0648 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639: \u0641\u064a \u0647\u0630\u0627 \u0644\u0639\u0645\u0631 \u0646\u0635\u0641 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0627\u0644\u0631\u0636\u0651\u0639 \u064a\u0633\u062a\u0637\u064a\u0639\u0648\u0646 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 \u0648\u062c\u0648\u0647 \u0623\u0628\u0627\u0626\u0647\u0645\u060c \u0648\u064a\u0641\u0636\u0651\u0644\u0648\u0646 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639\u0647\u0645 \u0639\u0644\u0649 \u0627\u0644\u063a\u0631\u0628\u0627\u0621. \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0642\u062f \u064a\u0628\u062f\u0623 \u0627\u0644\u0622\u0646 \u0628\u0627\u0644\u0623\u0628\u062a\u0633\u0627\u0645 \u0639\u0646\u062f\u0645\u0627 \u064a\u0631\u0627\u0643 \u0648\u064a\u0647\u062f\u0644 \u0648\u064a\u0631\u0641\u0633 \u0628\u0643\u0644 \u0633\u0631\u0648\u0631. \u0628\u0634\u0643\u0644 \u0639\u0627\u0645\u060c \u064a\u0635\u0628\u062d \u0627\u0644\u0637\u0641\u0644 \u0623\u0643\u062b\u0631 \u062d\u0633\u0651\u0627\u0633\u064a\u0629 \u0625\u0644\u0649 \u0628\u064a\u0626\u062a\u0647 \u0627\u0644\u0645\u062d\u064a\u0637\u0629. \u0625\u0630\u0627 \u062f\u0642\u0642\u0651\u062a \u062c\u0631\u0633\u060c \u0633\u064a\u0633\u062a\u062c\u064a\u0628 \u0627\u0644\u0637\u0641\u0644 \u0628\u0637\u0631\u064a\u0642\u0629 \u0645\u0627\u060c \u0627\u0644\u0628\u0643\u0627\u0621\u060c \u0627\u0644\u0633\u0643\u0648\u062a \u0623\u0648 \u0627\u0644\u0625\u0628\u062a\u0633\u0627\u0645. \u0623\u064a\u0636\u0627 \u064a\u0628\u062f\u0623 \u0627\u0644\u0637\u0641\u0644 \u0641\u064a \u0627\u0644\u0623\u0633\u062a\u0645\u062a\u0627\u0639 \u0628\u0633\u0645\u0627\u0639 \u0627\u0644\u0645\u0648\u0633\u064a\u0642\u0649\u060c \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u063a\u0646\u0627\u0621 \u0627\u0644\u0623\u0628\u0648\u064a\u0646 \u0623\u0648 \u0645\u0648\u0633\u064a\u0642\u0649 \u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629 \u0635\u0627\u062f\u0631\u0629 \u0645\u0646 \u0627\u0644\u0631\u0627\u062f\u064a\u0648. \u0628\u0639\u0636 \u0627\u0644\u0623\u0628\u0627\u0621 \u064a\u0628\u062f\u0623 \u0628\u062a\u0631\u064a\u0644 \u0646\u0635\u0648\u0635 \u062f\u064a\u0646\u064a\u0629 \u0630\u0627\u062a \u0646\u063a\u0645\u0629 \u0645\u0648\u0633\u064a\u0642\u064a\u0629 \u0628\u0635\u0648\u0631\u0629 \u0645\u062a\u0643\u0631\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0637\u0641\u0644\u060c \u0642\u062f \u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0623\u0646 \u064a\u0643\u0631\u0631\u0647\u0627 \u0627\u0644\u0637\u0641\u0644 \u0648\u0644\u0643\u0646\u0647 \u0628\u0627\u0644\u062a\u0623\u0643\u064a\u062f \u064a\u0628\u062f\u0623 \u0628\u062d\u0641\u0638 \u0642\u0633\u0645 \u0645\u0646 \u0627\u0644\u0646\u063a\u0645\u0629. \u0625\u0646 \u0642\u062f\u0631\u0629 \u0627\u0644\u0637\u0641\u0644 \u0639\u0644\u0649 \u0627\u0644\u0625\u0633\u062a\u0645\u062a\u0627\u0639 \u0648\u0627\u0644\u062a\u0639\u0644\u0645 \u062a\u0641\u0648\u0642 \u0628\u0643\u062b\u064a\u0631 \u0645\u0627 \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u062a\u0635\u0648\u0631\u0647 \u0627\u0644\u0643\u062b\u064a\u0631. \u0643\u0645 \u062a\u062a\u063a\u064a\u0651\u0631 \u062d\u064a\u0627\u062a\u0643 [ \u0639\u062f\u0644 ] \u0643\u0644\u0645\u0629 \u0648\u0627\u062d\u062f\u0629 \u2014 \u0627\u0644\u0625\u0639\u064a\u0627\u0621. \u0643\u0645\u064a\u0629 \u0627\u0644\u0623\u062f\u0631\u064a\u0646\u0627\u0644\u064a\u0646 \u0627\u0644\u062a\u064a \u0633\u0627\u0639\u062f\u062a\u0643 \u062e\u0644\u0627\u0644 \u0627\u0644\u0623\u0633\u0627\u0628\u064a\u0639 \u0627\u0644\u0642\u0644\u064a\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0632\u0627\u0644 \u062a\u0623\u062b\u064a\u0631\u0647\u0627 \u0627\u0644\u0622\u0646\u060c \u0648\u062d\u064a\u0627\u062a\u0643 \u0642\u062f \u062a\u0628\u062f\u0648 \u0645\u062b\u0644 \u0633\u0644\u0633\u0644\u0629 \u0644\u0627\u0646\u0647\u0627\u0626\u064a\u0629 \u0645\u0646 \u062a\u063a\u064a\u064a\u0631 \u062d\u0641\u0651\u0627\u0638\u0629 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u062a\u062a\u063a\u064a\u0651\u0631\u060c \u0631\u0636\u0627\u0639\u0629\u060c \u0648\u062a\u0647\u062f\u0626\u0629 \u0627\u0644\u0637\u0641\u0644. \u0648\u0631\u063a\u0645 \u0630\u0644\u0643\u060c \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0644\u0631\u0628\u0645\u0627 \u0628\u062f\u0623 \u0628\u0627\u0644\u062a\u0642\u064a\u064a\u0644 \u062a\u0642\u0631\u064a\u0628\u0627 \u0646\u0641\u0633 \u0627\u0644\u0648\u0642\u062a \u0643\u0644\u0651 \u064a\u0648\u0645. \u0625\u0630\u0627 \u0644\u0645 \u064a\u0635\u0644 \u0625\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u062d\u0644\u0629 \u0644\u0627 \u062a\u0642\u0644\u0642\u064a\u060c \u0623\u0646\u0647\u0627 \u0645\u062c\u0631\u062f \u0645\u0633\u0623\u0644\u0629 \u0623\u0633\u0627\u0628\u064a\u0639 \u0642\u0628\u0644 \u0638\u0647\u0648\u0631 \u0646\u0645\u0637\u060c \u0623\u0648 \u0631\u0648\u062a\u064a\u0646 \u064a\u062a\u0628\u0639\u0647 \u0627\u0644\u0637\u0641\u0644 \u0648\u064a\u062e\u0641\u0641 \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u0646\u0641\u0633\u064a \u0639\u0646\u0643. \u0632\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0623\u0647\u0644 \u0644\u0643\u0645 \u062a\u0633\u0627\u0639\u062f \u062c\u062f\u0627. \u0627\u0644\u062a\u063a\u0630\u064a\u0629 [ \u0639\u062f\u0644 ] \u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0627\u0644\u062a\u0637\u0648\u0631 [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u062a\u0637\u0648\u0631 \u0644\u062f\u0649 \u0627\u0644\u0637\u0641\u0644 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0635\u0651\u062f\u0631 [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0642\u0627\u0644\u0627\u062a \u0639\u0646 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0627\u0644\u0639\u0644\u0627\u0642\u0627\u062a [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0627\u0644\u0632\u0648\u062c\u064a\u0629 \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0628\u0627\u0644\u0623\u0645 \u0628\u0639\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629 [ \u0639\u062f\u0644 ] \u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0628\u0627\u0644\u0623\u0645 \u0627\u0644\u0633\u0641\u0631 \u0645\u0639 \u0627\u0644\u0637\u0641\u0644 [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0642\u0627\u0644\u0627\u062a \u0627\u0644\u0633\u0641\u0631 \u0627\u0644\u0623\u0645\u0627\u0646 [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0648\u0627\u0636\u064a\u0639 \u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0623\u0645\u0627\u0646 \u0627\u0644\u0635\u062d\u0629 [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0648\u0627\u0636\u064a\u0639 \u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0635\u062d\u0629 \u0646\u0648\u0645 \u0627\u0644\u0645\u0648\u0644\u0648\u062f \u0627\u0644\u062c\u062f\u064a\u062f [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u0646\u0648\u0645 \u0648\u0635\u0644\u0627\u062a \u062e\u0627\u0631\u062c\u064a\u0629 [ \u0639\u062f\u0644 ] \u0645\u0631\u0643\u0632 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 (\u0644\u063a\u0629 \u0625\u0646\u062c\u0644\u0632\u064a\u0629) \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639_\u0631\u0642\u0645_6&oldid=95045 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0637\u0628 \u0623\u0637\u0641\u0627\u0644 \u0623\u0637\u0641\u0627\u0644 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 6 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

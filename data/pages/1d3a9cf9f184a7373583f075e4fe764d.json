{
  "url": "http://avtor.karelia.ru/about/mamaeva_irina.html",
  "title": "\u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e5\u00ee\u00ed\u00e8\u00e4\u00ee\u00e2\u00ed\u00e0 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e5\u00ee\u00ed\u00e8\u00e4\u00ee\u00e2\u00ed\u00e0 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e5\u00ee\u00ed\u00e8\u00e4\u00ee\u00e2\u00ed\u00e0 \u00c4\u00e0\u00f2\u00e0 \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: 15.04.1978 \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc, \u00ef\u00ee\u00fd\u00f2. \u00a0\u00d7\u00eb\u00e5\u00ed \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00d1\u00ee\u00fe\u00e7\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00f1 2004 \u00e3\u00ee\u00e4\u00e0. \u00c7\u00e0\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb\u00e0 \u00f1\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00f5\u00ee\u00e7\u00ff\u00e9\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f4\u00e0\u00ea\u00f3\u00eb\u00fc\u00f2\u00e5\u00f2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e3\u00ee \u00e3\u00ee\u00f1\u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2\u00e0 \u00e2 2000 \u00e3. \u00cf\u00e0\u00f0\u00e0\u00eb\u00eb\u00e5\u00eb\u00fc\u00ed\u00ee \u00e7\u00e0\u00ee\u00f7\u00ed\u00ee \u00f3\u00f7\u00e8\u00eb\u00e0\u00f1\u00fc \u00e2 \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00ee\u00ec \u00e8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e5 \u00e8\u00ec. \u00c3\u00ee\u00f0\u00fc\u00ea\u00ee\u00e3\u00ee. \u00d0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb\u00e0 \u00ed\u00e0 \u00ea\u00ee\u00ed\u00ed\u00fb\u00f5 \u00e7\u00e0\u00e2\u00ee\u00e4\u00e0\u00f5 \u00ca\u00f0\u00e0\u00f1\u00ed\u00ee\u00e4\u00e0\u00f0\u00f1\u00ea\u00ee\u00e3\u00ee \u00ea\u00f0\u00e0\u00ff \u00e8 \u00d0\u00ff\u00e7\u00e0\u00ed\u00f1\u00ea\u00ee\u00e9 \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00e8, \u00e1\u00fb\u00eb\u00e0 \u00ef\u00f0\u00e5\u00e4\u00ef\u00f0\u00e8\u00ed\u00e8\u00ec\u00e0\u00f2\u00e5\u00eb\u00e5\u00ec, \u00ea\u00ee\u00f0\u00f0\u00e5\u00f1\u00ef\u00ee\u00ed\u00e4\u00e5\u00ed\u00f2\u00ee\u00ec \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00f5 \u00f0\u00e5\u00e3\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00fb\u00f5 \u00e3\u00e0\u00e7\u00e5\u00f2. \u00d3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea 4-9 \u00d4\u00ee\u00f0\u00f3\u00ec\u00ee\u00e2 \u00ec\u00ee\u00eb\u00ee\u00e4\u00fb\u00f5 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00e2 \u00cc\u00ee\u00f1\u00ea\u00e2\u00e5 (2004 - 2009 \u00e3\u00ee\u00e4\u00fb), \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea \u00e2\u00f2\u00ee\u00f0\u00ee\u00e3\u00ee \u00f4\u00ee\u00f0\u00f3\u00ec\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9, \u00ef\u00e8\u00f8\u00f3\u00f9\u00e8\u00f5 \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9, \u00e2 \u00cf\u00e5\u00f0\u00e5\u00e4\u00e5\u00eb\u00ea\u00e8\u00ed\u00ee \u00e2 2004 \u00e3\u00ee\u00e4\u00f3, \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea \u00ec\u00e5\u00e6\u00e4\u00f3\u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00ee\u00e3\u00ee \u00f1\u00e5\u00ec\u00e8\u00ed\u00e0\u00f0\u00e0 \u00e6\u00e5\u00ed\u00f9\u00e8\u00ed-\u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00e2 \u00d0\u00ee\u00e2\u00e0\u00ed\u00e8\u00e5\u00ec\u00e8 (\u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff) \u00e2 2005 \u00e3\u00ee\u00e4\u00f3, \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea \u00f1\u00e5\u00ec\u00e8\u00ed\u00e0\u00f0\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9, \u00ef\u00e8\u00f8\u00f3\u00f9\u00e8\u00f5 \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9, \u00e2 \u00df\u00f1\u00ed\u00ee\u00e9 \u00cf\u00ee\u00eb\u00ff\u00ed\u00e5 \u00e2 2006 \u00e3\u00ee\u00e4\u00f3.\u00a0\u00d3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea 23 \u00c8\u00e5\u00f0\u00f3\u00f1\u00e0\u00eb\u00e8\u00ec\u00f1\u00ea\u00ee\u00e9 \u00ec\u00e5\u00e6\u00e4\u00f3\u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00ee\u00e9 \u00ea\u00ed\u00e8\u00e6\u00ed\u00ee\u00e9 \u00ff\u00f0\u00ec\u00e0\u00f0\u00ea\u00e8 (\u00c8\u00e7\u00f0\u00e0\u00e8\u00eb\u00fc), \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea \u00e2\u00f1\u00f2\u00f0\u00e5\u00f7\u00e8 \u00ec\u00ee\u00eb\u00ee\u00e4\u00fb\u00f5 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00f1 \u00ef\u00f0\u00e5\u00e7\u00e8\u00e4\u00e5\u00ed\u00f2\u00ee\u00ec \u00d0\u00d4 \u0412. \u0412. \u00cf\u00f3\u00f2\u00e8\u00ed\u00fb\u00ec \u00e2 2007 \u00e3\u00ee\u00e4\u00f3, \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea II \u00e8 IV \u00d4\u00ee\u00f0\u00f3\u00ec\u00ee\u00e2 \u00e8\u00ed\u00f2\u00e5\u00eb\u00eb\u00e8\u00e3\u00e5\u00ed\u00f6\u00e8\u00e8 \u00f1\u00f2\u00f0\u00e0\u00ed \u00d1\u00cd\u00c3 \u00e2 \u00c0\u00f1\u00f2\u00e0\u00ed\u00e5 (\u00ca\u00e0\u00e7\u00e0\u00f5\u00f1\u00f2\u00e0\u00ed) \u00e8 \u00ca\u00e8\u00f8\u00e8\u00ed\u00b8\u00e2\u00e5 (\u00cc\u00ee\u00eb\u00e4\u00ee\u00e2\u00e0) \u00e2 2007 \u00e8 2009 \u00e3\u00ee\u00e4\u00e0\u00f5, \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea \u00f1\u00e5\u00ec\u00e8\u00ed\u00e0\u00f0\u00e0 \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00ed\u00fb\u00e9 \u00ca\u00e0\u00e2\u00ea\u00e0\u00e7: \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00e0 \u00e8 \u00e4\u00e5\u00e9\u00f1\u00f2\u00e2\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00fc\u00bb \u00e2 \u00e3. \u00c3\u00f0\u00ee\u00e7\u00ed\u00fb\u00e9 \u00e2 2008 \u00e3\u00ee\u00e4\u00f3. \u00d3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea VI \u00e8 VIII \u00cc\u00e5\u00e6\u00e4\u00f3\u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00fb\u00f5 \u0412\u00ee\u00eb\u00ee\u00f8\u00e8\u00ed\u00f1\u00ea\u00e8\u00f5 \u00f4\u00e5\u00f1\u00f2\u00e8\u00e2\u00e0\u00eb\u00e5\u00e9 \u00e2 \u00e3. \u00ca\u00ee\u00ea\u00f2\u00e5\u00e1\u00e5\u00eb\u00fc (\u00d3\u00ea\u00f0\u00e0\u00e8\u00ed\u00e0) \u00e2 2008, 2010 \u00e8 2011 \u00e3\u00ee\u00e4\u00e0\u00f5, \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea \u00f4\u00e5\u00f1\u00f2\u00e8\u00e2\u00e0\u00eb\u00ff \u00ab\u00ca\u00e8\u00e5\u00e2\u00f1\u00ea\u00e8\u00e5 \u00cb\u00e0\u00e2\u00f0\u00fb\u00bb \u00e2 2011 \u00e3\u00ee\u00e4\u00f3 \u00e2 \u00ca\u00e8\u00e5\u00e2\u00e5 (\u00d3\u00ea\u00f0\u00e0\u00e8\u00ed\u00e0). \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e5 \u00ef\u00f0\u00e5\u00ec\u00e8\u00e8: \u00ef\u00f0\u00e5\u00ec\u00e8\u00ff \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e0 \u00ab\u00ce\u00f2\u00ea\u00f0\u00fb\u00f2\u00e0\u00ff \u00d0\u00ee\u00f1\u00f1\u00e8\u00ff\u00bb (2004 \u00e3\u00ee\u00e4), \u00ef\u00f0\u00e5\u00ec\u00e8\u00ff \u00ab\u00d1\u00ee\u00ea\u00ee\u00eb\u00ee\u00f4\u00f4-\u00ef\u00f0\u00e8\u00e7\u00bb (2005 \u00e3\u00ee\u00e4), \u00ef\u00f0\u00e5\u00ec\u00e8\u00ff \u00ab\u00dd\u00e2\u00f0\u00e8\u00ea\u00e0\u00bb (2006 \u00e3\u00ee\u00e4), \u00ef\u00f0\u00e5\u00ec\u00e8\u00ff \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ed\u00e0 \u00d0\u00e0\u00f1\u00ef\u00f3\u00f2\u00e8\u00ed\u00e0 (2007 \u00e3\u00ee\u00e4), \u00ef\u00f0\u00e5\u00ec\u00e8\u00ff \u00c0\u00ed\u00f2\u00ee\u00ed\u00e0 \u00c4\u00e5\u00eb\u00fc\u00e2\u00e8\u00e3\u00e0 (2008 \u00e3\u00ee\u00e4), \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0 \u00ab\u00c4\u00f0\u00f3\u00e6\u00e1\u00e0 \u00ed\u00e0\u00f0\u00ee\u00e4\u00ee\u00e2\u00bb (2010 \u00e3\u00ee\u00e4), \u00ab\u00df\u00f1\u00ed\u00e0\u00ff \u00ef\u00ee\u00eb\u00ff\u00ed\u00e0\u00bb (2011 \u00e3\u00ee\u00e4). \u00c6\u00e8\u00e2\u00e5\u00f2 \u00e2 \u00e3. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 : \u00e1\u00e8\u00ee\u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00ee\u00e2\u00e0\u00f0\u00fc / \u00ca\u00e0\u00f0\u00e5\u00eb. \u00ed\u00e0\u00f3\u00f7. \u00d6\u00e5\u00ed\u00f2\u00f0 \u00d0\u00c0\u00cd, \u00c8\u00ed-\u00f2 \u00ff\u00e7\u00fb\u00ea\u00e0, \u00eb\u00e8\u00f2. \u00e8 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8, \u00cc-\u00e2\u00ee \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e8 \u00ef\u00ee \u00f1\u00e2\u00ff\u00e7\u00ff\u00ec \u00f1 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00f1\u00f2\u00fc\u00fe ; [\u00f1\u00ee\u00f1\u00f2. \u00de. \u00c8. \u00c4\u00fe\u00e6\u00e5\u00e2 ]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2006. - \u00d1. 84. - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u00c7\u00e0\u00e9\u00f6\u00e5\u00e2\u00e0 \u00cd. \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 \u00e2 \u00cc\u00ee\u00f1\u00ea\u00e2\u00e5 \u00e8 \u00c8\u00e7\u00f0\u00e0\u00e8\u00eb\u00e5 : [\u00e1\u00e5\u00f1\u00e5\u00e4\u00e0 \u00f1 \u00c8\u00f0\u00e8\u00ed\u00ee\u00e9 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00ee\u00e9 / \u00e1\u00e5\u00f1\u00e5\u00e4\u00f3 \u00e2\u00e5\u00eb\u00e0 \u00cd\u00e0\u00f2\u00e0\u00eb\u00fc\u00ff \u00c7\u00e0\u00e9\u00f6\u00e5\u00e2\u00e0] // \u0412\u00e0\u00f8 \u00e4\u00ee\u00f1\u00f3\u00e3. 2007.-16 \u00e0\u00ef\u00f0.- \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0 : http://dosug.ptz.ru/art/view/id/191/ \u00c1\u00ee\u00e9\u00ea\u00ee, \u00cc. \u00cd\u00e0\u00f1\u00f2\u00ee\u00ff\u00f9\u00e8\u00e9 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc \u00ef\u00ee\u00f5\u00ee\u00e6 \u00ed\u00e0 \u00f0\u00e5\u00e1\u00e5\u00ed\u00ea\u00e0: [\u00e1\u00e5\u00f1\u00e5\u00e4\u00e0 \u00f1 \u00c8\u00f0\u00e8\u00ed\u00ee\u00e9 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00ee\u00e9 / \u00e1\u00e5\u00f1\u00e5\u00e4\u00f3 \u00e2\u00e5\u00eb \u00cc\u00e8\u00f5\u00e0\u00e8\u00eb \u00c1\u00ee\u00e9\u00ea\u00ee] // \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00e0\u00ff \u00d0\u00ee\u00f1\u00f1\u00e8\u00ff.-2007.- 20 \u00e0\u00ef\u00f0.(\u00b9 16). - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e2\u00e5\u00f0\u00f1\u00e8\u00ff \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0, \u00c8. \u00cc\u00e0\u00ec\u00e0 \u00c5\u00e2\u00e0 : \u00eb\u00e8\u00f2\u00f0\u00e0\u00e7\u00e2\u00e5\u00f0\u00f1\u00f2\u00ea\u00e0 / \u00e8\u00ed\u00f2\u00e5\u00f0\u00e2\u00fc\u00fe \u00c8\u00f0\u00e8\u00ed\u00fb \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00ee\u00e9 \u00c7\u00e0\u00f5\u00e0\u00f0\u00f3 \u00cf\u00f0\u00e8\u00eb\u00e5\u00ef\u00e8\u00ed\u00f3. // \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00e0\u00ff \u00e3\u00e0\u00e7\u00e5\u00f2\u00e0,-2007.-19 \u00f1\u00e5\u00ed\u00f2\u00ff\u00e1\u00f0\u00ff (\u00b937).- \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e2\u00e5\u00f0\u00f1\u00e8\u00ff \u00c6\u00e5\u00ed\u00f1\u00ea\u00e0\u00ff \u00ef\u00f0\u00ee\u00e7\u00e0 tv 100. \u0412\u00f1\u00f2\u00f0\u00e5\u00f7\u00e8 \u00ed\u00e0 \u00e4\u00e0\u00f7\u00e5 \u00cb\u00e8\u00ed\u00e4\u00f1\u00f2\u00f0\u00e5\u00ec\u00e0 [\u0412\u00e8\u00e4\u00e5\u00ee\u00e7\u00e0\u00ef\u00e8\u00f1\u00fc] / \u00f0\u00e5\u00e6.-\u00ef\u00ee\u00f1\u00f2. \u00cc. \u00ce\u00e3\u00e5\u00ed\u00e5\u00e2\u00e0\u00ff ; \u00e2\u00e5\u00e4\u00f3\u00f9\u00e8\u00e9 \u00c0. \u00c3\u00e0\u00eb\u00e8\u00e1\u00e8\u00ed ; \u00e3\u00ee\u00f1\u00f2\u00e8 (\u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e8): \u00c4\u00f3\u00ed\u00ff \u00d1\u00ec\u00e8\u00f0\u00ed\u00ee\u00e2\u00e0 (\u00e3. \u00cc\u00ee\u00f1\u00ea\u00e2\u00e0), \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 (\u00e3. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea), \u00c1\u00e8\u00ed\u00e0 \u00c1\u00ee\u00e3\u00e0\u00f7\u00e5\u00e2\u00e0 (\u00e3. \u00d1\u00e0\u00ed\u00ea\u00f2-\u00cf\u00e5\u00f2\u00e5\u00f0\u00e1\u00f3\u00f0\u00e3) \u00e8 \u00e4\u00f0. \u2013 \u00cc\u00ee\u00f1\u00ea\u00e2\u00e0 : \u00d2\u00e5\u00eb\u00e5\u00ea\u00e0\u00ed\u00e0\u00eb \u00ab100 \u00d2\u0412\u00bb, 2007. \u2013 1 \u00f4\u00e0\u00e9\u00eb (38 \u00ec\u00e8\u00ed 19 \u00f1). \u2013 \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0: https://vk.com/videos9701979?z=video9701979_140019529%2Fpl_9701979 . \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0, \u00c8. \u00cb.\u00a0 \u00cb\u00f3\u00f7\u00f8\u00e5 \u00ee\u00eb\u00e5\u00ed\u00e5\u00e9 :\u00a0 \u00d0\u00ee\u00ec\u00e0\u00ed / \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 // \u00cd\u00ee\u00e2\u00fb\u00e9 \u00ec\u00e8\u00f0. - 2020. - N 11. \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0, \u00c8. \u00cb. \u00d1 \u00e4\u00e5\u00e1\u00e8\u00eb\u00fc\u00ed\u00fb\u00ec \u00eb\u00e8\u00f6\u00ee\u00ec : [\u00f0\u00ee\u00ec\u00e0\u00ed] / \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0. - \u00cc\u00ee\u00f1\u00ea\u00e2\u00e0 : \u00c0\u00d1\u00d2, 2009. - 223 \u00f1. \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0, \u00c8. \u00cb. \u00c7\u00e5\u00ec\u00eb\u00ff \u00c3\u00e0\u00e9 / \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 ; [\u00f5\u00f3\u00e4\u00ee\u00e6. - \u00c0\u00e8\u00e4\u00e0 \u00d1\u00e8\u00e4\u00ee\u00f0\u00e5\u00ed\u00ea\u00ee]. - \u00cc\u00ee\u00f1\u00ea\u00e2\u00e0 : \u0412\u00e0\u00e3\u00f0\u00e8\u00f3\u00f1, 2006. - 319 \u00f1. \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0, \u00c8. \u00cb. \u00cb\u00fe\u00e1\u00e8\u00f2\u00fc \u00e8 \u00e6\u00e0\u00eb\u00e5\u00f2\u00fc / \u00c8. \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 ; [\u00f5\u00f3\u00e4\u00ee\u00e6. \u00cd\u00e8\u00ea\u00ee\u00eb\u00e0\u00e9 \u00d2\u00f0\u00f3\u00f5\u00e8\u00ed]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : Verso, 2006. - 286 \u00f1. \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0, \u00c8. \u00cb\u00e5\u00ed\u00ea\u00e8\u00ed\u00e0 \u00f1\u00e2\u00e0\u00e4\u00fc\u00e1\u00e0 : \u00cf\u00ee\u00e2\u00e5\u00f1\u00f2\u00fc / \u00c8. \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00e0 // \u00c4\u00f0\u00f3\u00e6\u00e1\u00e0 \u00ed\u00e0\u00f0\u00ee\u00e4\u00ee\u00e2. - 2005. - N 6. - \u00d1. 96-147 \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c7\u00e5\u00ec\u00eb\u00ff \u00c3\u00e0\u00e9 \u00cf\u00ee\u00e2\u00e5\u00f1\u00f2\u00fc \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c1\u00f3\u00f2\u00fb\u00eb\u00fc \u00d0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 \u00d1 \u00e4\u00e5\u00e1\u00e8\u00eb\u00fc\u00ed\u00fb\u00ec \u00eb\u00e8\u00f6\u00ee\u00ec \u00d0\u00ee\u00ec\u00e0\u00ed. \u00cf\u00ee \u00ec\u00ed\u00e5\u00ed\u00e8\u00fe \u00ea\u00f0\u00e8\u00f2\u00e8\u00ea\u00ee\u00e2, \u00ef\u00f0\u00ee\u00f7\u00e8\u00f2\u00e0\u00e2 \u00e5\u00e3\u00ee, \u00e2\u00fb \u00f3\u00e7\u00ed\u00e0\u00e5\u00f2\u00e5 \u00ab\u00f1\u00ee\u00e2\u00f1\u00e5\u00ec \u00e4\u00f0\u00f3\u00e3\u00f3\u00fe \u00cc\u00e0\u00ec\u00e0\u00e5\u00e2\u00f3\u00bb. \u00cb\u00e5\u00ed\u00ea\u00e8\u00ed\u00e0 \u00f1\u00e2\u00e0\u00e4\u00fc\u00e1\u00e0 \u00cf\u00ee\u00e2\u00e5\u00f1\u00f2\u00fc \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d0\u00ee\u00f1\u00ee\u00ec\u00e0\u00f5\u00e0 \u00d0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

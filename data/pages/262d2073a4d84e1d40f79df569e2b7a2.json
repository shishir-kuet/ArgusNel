{
  "url": "http://ar.wikibooks.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D8%B7%D8%A8_%D8%A3%D8%B7%D9%81%D8%A7%D9%84",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0637\u0628 \u0623\u0637\u0641\u0627\u0644 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0637\u0628 \u0623\u0637\u0641\u0627\u0644 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0647\u0646\u0627\u0643 \u0645\u0644\u0641\u0627\u062a \u0639\u0646 Pediatrics \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 . \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u064a\u062d\u0648\u064a \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0627\u0644\u0641\u0631\u0639\u064a\u060c \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a 1. \u0631 \u0631\u0636\u0627\u0639\u0629 ( 26 \u0635) \u0635\u0641\u062d\u0627\u062a \u062a\u0635\u0646\u064a\u0641 \u00ab\u0637\u0628 \u0623\u0637\u0641\u0627\u0644\u00bb \u064a\u062d\u0648\u064a \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0648\u0639\u062f\u062f\u0647\u0627 13 \u0645\u0646 \u0623\u0635\u0644 13 \u0625\u062c\u0645\u0627\u0644\u0627\u064b. \u0627 \u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u0627\u0639\u0629 \u0637\u0628\u064a\u0639\u064a\u0629 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 1 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 2 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 3 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 4 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 5 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 6 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 7 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u062d\u062f\u064a\u062b \u0627\u0644\u0648\u0644\u0627\u062f\u0629 \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0647\u0644 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062d\u0644\u064a\u0628 \u0643\u0627\u0641 \u062a \u062a\u0636\u062e\u0645 \u0627\u0644\u0635\u062f\u0631 \u0631 \u0631\u0636\u064a\u0639/\u062a\u0637\u0648\u0631 \u0627\u0644\u062f\u0645\u0627\u063a \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0637\u0628_\u0623\u0637\u0641\u0627\u0644&oldid=96409 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0637\u0628 \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0635\u0646\u064a\u0641 : \u0637\u0628 \u0623\u0637\u0641\u0627\u0644 1 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

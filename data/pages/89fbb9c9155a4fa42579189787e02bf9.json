  "title": "\u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629 \u0644\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0625\u0634\u0639\u0627\u0639\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629 \u0644\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0625\u0634\u0639\u0627\u0639\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 < \u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629 \u0644\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0625\u0634\u0639\u0627\u0639\u064a [ \u0639\u062f\u0644 ] \u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u062d\u0635\u064a\u0644\u0629 \u0627\u0644\u0643\u062a\u0644\u064a\u0629 \u0648\u0627\u0644\u0637\u0627\u0642\u064a\u0629 \u0644\u062a\u0641\u0627\u0639\u0644 \u0646\u0648\u0648\u064a \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u0646\u0648\u0649\u060c_\u0627\u0644\u0643\u062a\u0644\u0629\u060c_\u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a_\u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629_\u0644\u0644\u0646\u0634\u0627\u0637_\u0627\u0644\u0625\u0634\u0639\u0627\u0639\u064a&oldid=117174 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0639\u0644\u0645 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0621 \u0627\u0644\u0630\u0631\u064a\u0629 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0621 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0629 \u0644\u0644\u0646\u0634\u0627\u0637 \u0627\u0644\u0625\u0634\u0639\u0627\u0639\u064a \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

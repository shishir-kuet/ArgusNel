  "title": "\u0410\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0430:\u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430 \u0440\u044b\u043b\u0430 \u2014 \u0410\u0432\u0438\u043a\u0438\u043f\u0435\u0434\u0438\u0430",
  "text": "\u0410\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0430:\u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430 \u0440\u044b\u043b\u0430 \u2014 \u0410\u0432\u0438\u043a\u0438\u043f\u0435\u0434\u0438\u0430 \u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043a \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044e \u0421\u043f\u0440\u0430\u0432\u043a\u0430 \u0410\u043c\u0430\u0442\u0435\u0440\u0438\u0430\u043b \u0410\u0432\u0438\u043a\u0438\u043f\u0435\u0434\u0438\u0430 \u0430\u049f\u044b\u043d\u0442\u04d9 - \u0437\u0445\u044b \u0438\u0430\u049b\u04d9\u0438\u04ad\u0443 \u0430\u0435\u043d\u0446\u0438\u043a\u043b\u043e\u043f\u0435\u0434\u0438\u0430 \u0410\u0432\u0438\u043a\u0438\u043c\u0435\u0434\u0438\u0430\u04bf \u0435\u0438\u0437\u0433\u043e\u0443\u043f \u0430\u0431\u0440\u0438 \u0430\u0442\u0435\u043c\u0430 \u0438\u0430\u0437\u043a\u0443 \u0430\u0444\u0430\u0438\u043b\u049b\u04d9\u0430: \u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430 \u0440\u044b\u043b\u0430 \u0410\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0435\u0438\u04b5\u0430\u049b\u04d9\u0430 \u0410\u0440\u0438 \u0430\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0430 \u0438\u0430\u0430\u043d\u0430\u0440\u0525\u0448\u0443\u0435\u0438\u0442 6 \u0430\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0435\u0438\u04b5\u0430\u049b\u04d9\u0430 \u0438\u049f\u043e\u0443\u00a0\u0440\u049f\u044b\u043d\u0442\u04d9\u0438\u00a06. \u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0440\u0430\u0430\u043d \u0438\u043d\u0445\u043e\u0437 \u0430\u0443\u0430\u0430 \u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430 \u0440\u044b\u043b\u0430 (2 \u041a) + \u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0440\u0430\u0430\u043d \u041c\u0440\u0430\u0433\u044b\u043b\u0430\u0440\u0430 \u0410\u0430\u0438\u0433\u04d9\u0430 \u0438\u049f\u0430\u0437 \u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430 (2 \u041a) \u0410 \u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0440\u0437\u044b \u0410\u0525\u0441\u043d\u044b (1 \u041a) \u0418 \u0418\u0525\u0448\u044c\u043e\u0443 \u0420\u0438\u043c\u0442\u04d9\u0438 \u0430\u0438\u043c\u043f\u0435\u0440\u0438\u0430 \u0430\u0431\u0436\u044c\u0430\u0440\u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u0442\u04d9 \u04ad\u043e\u0443\u0440\u044b\u0445 (1 \u041a) \u0418\u0442\u0430\u043b\u0438\u0430 \u0430\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0440\u04ad\u043e\u0443\u0440\u044b\u0445 (4 \u041a) \u0424 \u0424\u0440\u0430\u043d\u0446\u0438\u0430 \u0430\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0440\u04ad\u043e\u0443\u0440\u044b\u0445 (1 \u041a) \u0410\u0445\u044b\u04b5\u0445\u044b\u0440\u04ad\u0430 \u2013 https://ab.wikipedia.org/w/index.php?title=\u0410\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0430:\u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438_\u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430_\u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430_\u0440\u044b\u043b\u0430&oldid=133354 \u0410\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0430\u049b\u04d9\u0430 : \u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0410\u04ad\u043e\u0443\u0440\u044b\u0445 \u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430 \u0440\u044b\u043b\u0430 \u0410\u0525\u0448\u0430\u0430\u0440\u0430 \u0410\u0525\u0448\u0430\u0430\u0440\u0430 \u0410\u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0430 : \u0410\u0431\u0436\u044c\u0430\u0440\u0430\u0442\u04d9\u0438 \u0430\u0448\u04d9\u044b\u0448\u044b\u049b\u04d9\u0441\u0430\u049b\u04d9\u0430 \u0430\u0442\u04d9\u044b\u043b\u0430\u049b\u04d9\u0430 \u0440\u044b\u043b\u0430 \u0430\u0431\u044b\u0437\u0448\u04d9\u0430\u049b\u04d9\u0430: 56 \u0410\u0442\u0435\u043c\u0430 \u0430\u0446\u04b5\u0430\u0442\u04d9\u0443\u043f",

0649 \u0645\u0648\u0642\u0639 \u0625\u062f\u0631\u0627\u0643. \u0627\u0644\u0645\u0633\u0627\u0642\u0627\u062a \u062d\u0648\u0644 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0631\u0648\u0627\u0642. \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u064a\u0629 \u062d\u0648\u0644 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 \u062e\u0627\u0646. \u0627\u0644\u0645\u0633\u0627\u0642\u0627\u062a \u062d\u0648\u0644 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0639\u0644\u0649 \u0645\u0648\u0642\u0639 \u0643\u0648\u0631\u0633\u064a\u0627. \u0641\u064a\u062f\u064a\u0648\u0647\u0627\u062a [ \u0639\u062f\u0644 ] \u064a\u0648\u062a\u0648\u0628 \u0628\u0627\u0644\u0639\u0631\u0628\u064a \u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a \u062a\u064a\u062f \u0628\u0627\u0644\u0639\u0631\u0628\u064a \u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a \u0645\u0631\u0627\u062c\u0639 [ \u0639\u062f\u0644 ] \u0648\u0635\u0644\u0627\u062a \u062e\u0627\u0631\u062c\u064a\u0629 [ \u0639\u062f\u0644 ] \u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0639\u0644\u0645\u064a\u0629 \u0639\u0644\u0649 \u0633\u0643\u0648\u0644\u064a\u0627 \u0635\u0641\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 Online Etymology Dictionary \u0645\u0639\u062c\u0645 \u0627\u0644\u062a\u0623\u062b\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0645\u0639\u062c\u0645 \u0627\u0644\u062a\u0623\u062b\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0645\u0639\u062c\u0645 \u0627\u0644\u062a\u0623\u062b\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u0625\u06
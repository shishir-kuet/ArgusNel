{
  "url": "http://bn.wikivoyage.org/wiki/%E0%A6%97%E0%A6%A8%E0%A7%8D%E0%A6%A4%E0%A6%AC%E0%A7%8D%E0%A6%AF",
  "title": "\u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af - \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3",
  "text": "\u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af - \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u09c7 \u099a\u09b2\u09c1\u09a8 \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3 \u09a5\u09c7\u0995\u09c7 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u09aa\u09b0\u09bf\u099a\u09cd\u099b\u09c7\u09a6\u09b8\u09ae\u09c2\u09b9 \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3\u09c7 \u09ac\u09bf\u09b6\u09cd\u09ac\u09c7\u09b0 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09b8\u09cd\u09a5\u09be\u09a8\u09c7\u09b0 \u0989\u09aa\u09b0 \u09e8,\u09e9\u09ed\u09ec \u099f\u09bf \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u0989\u09aa\u09be\u09af\u09bc\u09c7 \u098f\u0987 \u0993\u09af\u09bc\u09c7\u09ac\u09b8\u09be\u0987\u099f \u09a5\u09c7\u0995\u09c7 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af\u09c7\u09b0 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8\u0964 \u09ae\u09b9\u09be\u09a6\u09c7\u09b6\u0997\u09c1\u09b2\u09bf\u09b0 \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09a4\u09c7 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8 \u09a8\u09bf\u099a\u09c7\u09b0 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c7 \u0995\u09cb\u09a8\u09cb \u098f\u0995\u099f\u09bf \u09ae\u09b9\u09be\u09a6\u09c7\u09b6\u09c7\u09b0 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09c7 \u09af\u09be\u09a8 \u098f\u09ac\u0982 \u09b8\u09c7\u0996\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af\u09c7 \u09aa\u09cc\u0981\u099b\u09a8 (\u0989\u09a6\u09be\u09b9\u09b0\u09a3: \u098f\u09b6\u09bf\u09af\u09bc\u09be \u2192 \u09a6\u0995\u09cd\u09b7\u09bf\u09a3 \u098f\u09b6\u09bf\u09af\u09bc\u09be \u2192 \u09ac\u09be\u0982\u09b2\u09be\u09a6\u09c7\u09b6 \u2192 \u099a\u099f\u09cd\u099f\u0997\u09cd\u09b0\u09be\u09ae \u09ac\u09bf\u09ad\u09be\u0997 \u2192 \u0995\u0995\u09cd\u09b8\u09ac\u09be\u099c\u09be\u09b0 \u099c\u09c7\u09b2\u09be \u2192 \u0995\u0995\u09cd\u09b8\u09ac\u09be\u099c\u09be\u09b0 ): \u09a8\u09c0\u099a\u09c7\u09b0 \u09b8\u0982\u09af\u09cb\u0997 \u09a5\u09c7\u0995\u09c7 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u0996\u09c1\u0981\u099c\u09c1\u09a8 \u09a8\u09bf\u099a\u09c7\u09b0 \u09b8\u0982\u09af\u09cb\u0997\u09c7 \u0995\u09cd\u09b2\u09bf\u0995 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u09b8\u09c7\u0996\u09be\u09a8 \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af\u09c7 \u09aa\u09cc\u0981\u099b\u09a8 (\u0989\u09a6\u09be\u09b9\u09b0\u09a3: \u098f\u09b6\u09bf\u09af\u09bc\u09be \u2192 \u09a6\u0995\u09cd\u09b7\u09bf\u09a3 \u098f\u09b6\u09bf\u09af\u09bc\u09be \u2192 \u09ad\u09be\u09b0\u09a4 \u2192 \u09aa\u09b6\u09cd\u099a\u09bf\u09ae\u09ac\u0999\u09cd\u0997 \u2192 \u0995\u09b2\u0995\u09be\u09a4\u09be ): \u0985\u09cd\u09af\u09be\u09a8\u09cd\u099f\u09be\u09b0\u09cd\u0995\u099f\u09bf\u0995\u09be \u0986\u09ab\u09cd\u09b0\u09bf\u0995\u09be \u0987\u0989\u09b0\u09cb\u09aa \u0989\u09a4\u09cd\u09a4\u09b0 \u0986\u09ae\u09c7\u09b0\u09bf\u0995\u09be \u098f\u09b6\u09bf\u09af\u09bc\u09be \u0993\u09b6\u09c7\u09a8\u09bf\u09af\u09bc\u09be \u09a6\u0995\u09cd\u09b7\u09bf\u09a3 \u0986\u09ae\u09c7\u09b0\u09bf\u0995\u09be \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u09ac\u09be\u0995\u09cd\u09af\u09be\u0982\u09b6 \u09ac\u0987 \u09ad\u09cd\u09b0\u09ae\u09a3 \u09aa\u09cd\u09b0\u09b8\u0999\u09cd\u0997 \u09ad\u09cd\u09b0\u09ae\u09a3\u09aa\u09a5 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09c7\u09b0 \u09a8\u09be\u09ae \u09a7\u09b0\u09c7 \u0996\u09c1\u0981\u099c\u09c1\u09a8 \u09a8\u09bf\u099a\u09c7\u09b0 \u09ac\u09be\u0995\u09cd\u09b8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u0995\u09cb\u09a8 \u098f\u0995\u099f\u09bf \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u09ac\u09be \u09ac\u09bf\u09b7\u09af\u09bc \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0995\u09b0\u09c1\u09a8 (\u0989\u09a6\u09be\u09b9\u09b0\u09a3: \"\u09a2\u09be\u0995\u09be\" \u09ac\u09be \"\u09ad\u09be\u09b0\u09a4\u09c7 \u09b0\u09c7\u09b2 \u09ad\u09cd\u09b0\u09ae\u09a3\"): \u098f\u0995\u099f\u09bf \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af\u09b8\u09cd\u09a5\u09b2 \u09ac\u09cd\u09b0\u09be\u0989\u099c \u0995\u09b0\u09c1\u09a8 \u09a8\u09bf\u099a\u09c7\u09b0 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u0995\u09cb\u09a8 \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u0996\u09c1\u0981\u099c\u09c7 \u09ac\u09c7\u09b0 \u0995\u09b0\u09c7 \u09b8\u0982\u09b6\u09cd\u09b2\u09bf\u09b7\u09cd\u099f \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7 \u09aa\u09a1\u09bc\u09c1\u09a8: \u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af\u09c7\u09b0 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0 ' https://bn.wikivoyage.org/w/index.php?title=\u0997\u09a8\u09cd\u09a4\u09ac\u09cd\u09af&oldid=63877 ' \u09a5\u09c7\u0995\u09c7 \u0986\u09a8\u09c0\u09a4 \u09b2\u09c1\u0995\u09be\u09a8\u09cb \u09ac\u09bf\u09b7\u09af\u09bc\u09b6\u09cd\u09b0\u09c7\u09a3\u09c0: \u0989\u0987\u0995\u09bf\u09aa\u09bf\u09a1\u09bf\u09af\u09bc\u09be \u09b8\u0982\u09af\u09cb\u0997\u09b9\u09c0\u09a8 \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7 (\u0989\u0987\u0995\u09bf\u0989\u09aa\u09be\u09a4\u09cd\u09a4 \u09a6\u09bf\u09af\u09bc\u09c7) \u09b8\u09cd\u09ac\u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09bf\u09a4 \u09ac\u09cd\u09af\u09be\u09a8\u09be\u09b0 \u0986\u099b\u09c7 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0\u09c7\u09b0 \u0995\u09be\u09a0\u09be\u09ae\u09cb \u0986\u099b\u09c7 \u0985-\u09aa\u09c2\u09b0\u09cd\u09ac\u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09bf\u09a4 \u09aa\u09cd\u09b0\u09be\u09a8\u09cd\u09a4\u09bf\u0995\u0995\u09b0\u09a3 \u09b8\u09b9 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0 \u0985-\u09aa\u09c2\u09b0\u09cd\u09ac\u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09bf\u09a4 \u0986\u0995\u09be\u09b0 \u09b8\u09b9 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0 \u09b6\u09bf\u09b0\u09cb\u09a8\u09be\u09ae \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7 \u0995\u09be\u09b0\u09cd\u099f\u09cb\u0997\u09cd\u09b0\u09be\u09ab\u09be\u09b0 \u098f\u0995\u09cd\u09b8\u099f\u09c7\u09a8\u09b6\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09be \u09aa\u09be\u09a4\u09be \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u09e7\u09ed\u099f\u09bf \u09ad\u09be\u09b7\u09be \u0986\u09b2\u09cb\u099a\u09a8\u09be \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8",

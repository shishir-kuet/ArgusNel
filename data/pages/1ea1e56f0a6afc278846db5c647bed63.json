  "url": "http://ar.wikibooks.org/wiki/%D8%A7%D9%84%D8%A5%D8%B1%D8%B6%D8%A7%D8%B9/%D9%85%D9%83%D9%88%D9%86%D8%A7%D8%AA_%D8%A3%D8%B3%D8%A7%D8%B3%D9%8A%D8%A9_%D9%81%D9%8A_%D8%A8%D8%AF%D8%A7%D8%A6%D9%84_%D8%A7%D9%84%D8%AD%D9%84%D9%8A%D8%A8",
  "title": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0645\u0643\u0648\u0646\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u064a \u0628\u062f\u0627\u0626\u0644 \u0627\u0644\u062d\u0644\u064a\u0628 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0645\u0643\u0648\u0646\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u064a \u0628\u062f\u0627\u0626\u0644 \u0627\u0644\u062d\u0644\u064a\u0628 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 < \u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u064a\u0631\u062c\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u062d\u0648\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0637\u0628\u064a . \u00ab \u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u0645\u0643\u0648\u0646\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u064a \u0628\u062f\u0627\u0626\u0644 \u0627\u0644\u062d\u0644\u064a\u0628 \u00bb \u0645\u062a\u0649 \u064a\u0645\u0643\u0646\u0646\u064a \u0625\u0639\u0637\u0627\u0621 \u0627\u0644\u0631\u0636\u064a\u0639 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u0643\u0627\u0645\u0644\u061f \u062d\u0642\u0627\u0626\u0642 \u0639\u0646 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0646\u0634\u0631\u062a\u0647\u0627 \u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u062a\u062d\u062f\u062f \u0644\u062c\u0646\u0629 \u0627\u0644\u062a\u063a\u0630\u064a\u0629 \u0645\u0646 \u0627\u0644\u0623\u0643\u0627\u062f\u064a\u0645\u064a\u0629 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629 \u0644\u0644\u0623\u0637\u0641\u0627\u0644 \u0636\u0631\u0648\u0631\u0629 \u0627\u062d\u062a\u0648\u0627\u0621 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a \u0639\u0644\u0649 \u0627\u0644\u0645\u0631\u0643\u0628\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629: \u0627\u0644\u0628\u0631\u0648\u062a\u064a\u0646 \u2013 \u0627\u0644\u062f\u0633\u0645 \u2013 \u062d\u0645\u0636 \u0627\u0644\u0644\u064a\u0646\u0648\u0644\u064a\u0643 \u2013 \u0627\u0644\u0641\u064a\u062a\u0627\u0645\u064a\u0646\u0627\u062a : \u0623 \u060c \u062f \u060c \u0623\u064a \u060c \u0643 \u060c \u06281 \u060c \u06282 \u060c \u062812 \u060c \u0646\u064a\u0627\u0633\u064a\u0646\u060c \u062d\u0645\u0636 \u0627\u0644\u0648\u0631\u0642\u060c \u062d\u0645\u0636 \u0627\u0644\u0628\u0627\u0646\u062a\u0648\u062a\u064a\u0646\u0643\u060c \u062b\u060c \u0648 \u0627\u0644\u0645\u0639\u0627\u062f\u0646 : \u0627\u0644\u0643\u0627\u0644\u0633\u064a\u0648\u0645\u060c \u0641\u0633\u0641\u0648\u0631\u060c \u0645\u063a\u0646\u064a\u0632\u064a\u0648\u0645\u060c \u062d\u062f\u064a\u062f\u060c \u0645\u0646\u063a\u0646\u064a\u0632\u060c \u0646\u062d\u0627\u0633\u060c \u064a\u0648\u062f\u060c \u0635\u0648\u062f\u064a\u0648\u0645\u060c \u0628\u0648\u062a\u0627\u0633\u064a\u0648\u0645\u060c \u0643\u0644\u0648\u0631 \u2013 \u0648\u062a\u0636\u064a\u0641 \u0634\u0631\u0637 \u062e\u0627\u0635 \u0628\u0627\u0644\u062a\u0631\u0643\u064a\u0628\u0627\u062a \u0627\u0644\u062a\u064a \u0644\u0645 \u062a\u0635\u0646\u0639 \u0645\u0646 \u062d\u0644\u064a\u0628 \u0627\u0644\u0628\u0642\u0631 \u0623\u0646 \u062a\u062d\u0648\u064a \u0639\u0644\u0649 \u0627\u0644\u0628\u064a\u0648\u062a\u064a\u0646 \u0648\u0627\u0644\u0643\u0648\u0644\u064a\u0646 \u0648\u0627\u0644\u0625\u064a\u0646\u0648\u0632\u064a\u062a\u0648\u0644. \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u064a [ \u0639\u062f\u0644 ] \u064a\u0645\u0643\u0646 \u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0636\u0631\u0648\u0631\u0629 \u0623\u0646 \u064a\u0645\u0632\u0642 (\u064a\u0645\u0632\u062c) \u062d\u0644\u064a\u0628 \u0627\u0644\u0628\u0642\u0631 \u0628 \u0646\u0635\u0641 \u0648\u0632\u0646\u0647 \u0645\u0627\u0621 \u0648\u064a\u0636\u0627\u0641 \u0639\u0634\u0631 \u0648\u0632\u0646\u0647 \u0633\u0643\u0631\u0627\u064b \u0648\u0644\u0627 \u0628\u062f \u0645\u0646 \u0625\u0636\u0627\u0641\u0629 \u0634\u064a\u0621 \u0645\u0646 \u0627\u0644\u0632\u064a\u062a \u0627\u0644\u0646\u0628\u0627\u062a\u064a \u0648\u0645\u0639\u0648\u0636\u0627\u062a \u0627\u0644\u0641\u064a\u062a\u0627\u0645\u064a\u0646\u0627\u062a \u0648\u0627\u0644\u0645\u0639\u0627\u062f\u0646 \u0644\u062a\u0639\u0648\u064a\u0636 \u0645\u063a\u0630\u064a\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629 \u0644\u0644\u0631\u0636\u064a\u0639. \u0648\u0633\u0628\u0642 \u0644\u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0623\u0646 \u0623\u0648\u0635\u062a \u0628\u0625\u0646\u062a\u0627\u062c \u0647\u0630\u0647 \u0627\u0644\u0645\u0643\u0648\u0646\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0646\u0642\u0635 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u064a \u0627\u0644\u0645\u0639\u062f\u0644 \u0648\u0644\u0643\u0646 \u0644\u0645 \u062a\u062a\u0648\u062c\u0647 \u0623\u064a \u0634\u0631\u0643\u0629 \u0644\u0625\u0646\u062a\u0627\u062c \u0627\u0644\u0645\u0636\u0627\u0641\u0627\u062a \u0627\u0644\u0636\u0631\u0648\u0631\u064a\u0629 \u0644\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u0645\u0645\u062f\u062f \u0648\u0644\u0630\u0644\u0643 \u0644\u0627 \u064a\u062c\u0648\u0632 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u062d\u064a\u0648\u0627\u0646\u064a \u0627\u0644\u0645\u0645\u062f\u062f \u0648\u0627\u0644\u0645\u062d\u0644\u0649 \u0625\u0644\u0627 \u0644\u0641\u062a\u0631\u0629 \u0642\u0635\u064a\u0631\u0629 \u0648\u0639\u0646\u062f \u0627\u0644\u0636\u0631\u0648\u0631\u0629 . \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0645\u0643\u0648\u0646\u0627\u062a_\u0623\u0633\u0627\u0633\u064a\u0629_\u0641\u064a_\u0628\u062f\u0627\u0626\u0644_\u0627\u0644\u062d\u0644\u064a\u0628&oldid=216031 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0631\u0636\u0627\u0639\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0645\u0643\u0648\u0646\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u064a \u0628\u062f\u0627\u0626\u0644 \u0627\u0644\u062d\u0644\u064a\u0628 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

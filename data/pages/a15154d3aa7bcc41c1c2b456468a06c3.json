  "title": "\u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629/\u0627\u0644\u0648\u062d\u062f\u0629 01 - \u0627\u0644\u062d\u0631\u0648\u0641 \u0648\u0627\u0644\u0646\u0637\u0642 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629/\u0627\u0644\u0648\u062d\u062f\u0629 01 - \u0627\u0644\u062d\u0631\u0648\u0641 \u0648\u0627\u0644\u0646\u0637\u0642 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 < \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629 \u0627\u0644\u062d\u0631\u0648\u0641 \u0648\u0627\u0644\u0646\u0637\u0642 [ \u0639\u062f\u0644 ] \u0627\u0644\u0623\u0628\u062c\u062f\u064a\u0629 \u0627\u0644\u0627\u0633\u0628\u0627\u0646\u064a\u0629 \u062a\u0636\u0645 27 \u062d\u0631\u0641\u0627\u060c \u0628\u064a\u0646\u0647\u0627 \u062d\u0631\u0641 \u00f1. \u0627\u0644\u062d\u0631\u0641\u0627\u0646 ch \u0648 ll \u0644\u064a\u0633\u0627 \u062d\u0631\u0648\u0641\u0627 \u0645\u0633\u062a\u0642\u0644\u0629 \u0628\u0644 \u0627\u0632\u062f\u0648\u0627\u062c\u0627\u062a. \u0627\u0644\u062d\u0631\u0648\u0641 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 [ \u0639\u062f\u0644 ] \u0627\u0644\u062d\u0631\u0641 \u0627\u0633\u0645 \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0646\u0637\u0642 \u0627\u0644\u062a\u0642\u0631\u064a\u0628\u064a \u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0645\u0644\u0627\u062d\u0638\u0629 a a \u0645\u062b\u0644 \u0627\u0644\u0641\u062a\u062d\u0629 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 e e \u0628\u064a\u0646 \u0627\u0644\u0641\u062a\u062d\u0629 \u0648\u0627\u0644\u0643\u0633\u0631\u0629 i i \u0642\u0631\u064a\u0628 \u0645\u0646 \u0627\u0644\u064a\u0627\u0621 o o \u0628\u064a\u0646 \u0627\u0644\u0641\u062a\u062d\u0629 \u0648\u0627\u0644\u0636\u0645\u0629 u u \u0642\u0631\u064a\u0628 \u0645\u0646 \u0627\u0644\u0648\u0627\u0648 \u0627\u0644\u062d\u0631\u0648\u0641 \u0627\u0644\u0633\u0627\u0643\u0646\u0629 \u0648\u0627\u0633\u0645\u0627\u0624\u0647\u0627 [ \u0639\u062f\u0644 ] \u0627\u0644\u062d\u0631\u0641 \u0627\u0644\u0627\u0633\u0645 \u0645\u0644\u0627\u062d\u0638\u0629 b be c ce \u0642\u0628\u0644 e,i \u062a\u0646\u0637\u0642 \u062b \u0641\u064a \u0627\u0633\u0628\u0627\u0646\u064a\u0627 \u0648 \u0633 \u0641\u064a \u0627\u063a\u0644\u0628 \u0627\u0645\u0631\u064a\u0643\u0627 d de f efe g ge \u0642\u0628\u0644 e,i = \u062e \u062a\u0642\u0631\u064a\u0628\u0627\u061b \u063a\u064a\u0631 \u0630\u0644\u0643 = \u062c \u0635\u0644\u0628\u0629 h hache \u0644\u0627 \u064a\u0646\u0637\u0642 j jota \u062e \u062a\u0642\u0631\u064a\u0628\u0627 k ka l ele m eme n ene \u00f1 e\u00f1e \u0646 \u064a p pe q cu \u064a\u0623\u062a\u064a \u0645\u0639 ue, ui \u0641\u0642\u0637 r ere \u0631\u062e\u0648\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0643\u0644\u0645\u0629 rr erre \u0631 \u0645\u0634\u062f\u062f\u0629 s ese t te v uve \u064a\u0646\u0637\u0642 \u0643\u0627\u0644\u0628\u0627\u0621 \u0627\u0644\u062e\u0641\u064a\u0641\u0629 \u063a\u0627\u0644\u0628\u0627 w uve doble \u0642\u0644\u064a\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u0639\u0645\u0627\u0644 x equis y ye \u062a\u0633\u062a\u0639\u0645\u0644 \u0643\u062d\u0631\u0641 \u0639\u0644\u0651\u0629 \u0627\u064a\u0636\u0627 z zeta \u0645\u062b\u0644 c \u0642\u0628\u0644 e,i (\u062b \u0641\u064a \u0627\u0633\u0628\u0627\u0646\u064a\u0627\u060c \u0633 \u0641\u064a \u0627\u0645\u0631\u064a\u0643\u0627) \u0627\u0645\u062b\u0644\u0629 \u0633\u0631\u064a\u0639\u0629 [ \u0639\u062f\u0644 ] casa \u0645\u0646\u0632\u0644\u060c gato \u0642\u0637\u060c gente \u0646\u0627\u0633\u060c hijo \u0627\u0628\u0646\u060c queso \u062c\u0628\u0646\u060c rosa \u0648\u0631\u062f\u0629\u060c perro \u0643\u0644\u0628\u060c zapato \u062d\u0630\u0627\u0621. \u062a\u0645\u0631\u064a\u0646 [ \u0639\u062f\u0644 ] \u062a\u0645\u0631\u064a\u0646: \u0627\u0633\u062a\u0645\u0639 \u0644\u0627\u0645\u062b\u0644\u0629 \u0645\u0646 \u0643\u0648\u0645\u0646\u0632 \u0644\u062d\u0631\u0648\u0641 a e i o u\u060c \u0648\u0627\u0643\u062a\u0628 \u062b\u0644\u0627\u062b \u0643\u0644\u0645\u0627\u062a \u0627\u0633\u0628\u0627\u0646\u064a\u0629 \u0644\u0643\u0644 \u062d\u0631\u0641. \u0645\u0644\u062d\u0642 \u0627\u0644\u0646\u0637\u0642 \u0627\u0644\u0639\u0645\u0644\u064a [ \u0639\u062f\u0644 ] \u0645\u0644\u0627\u062d\u0638\u0629: \u0627\u0644\u062a\u0647\u062c\u0626\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u062a\u0642\u0631\u064a\u0628\u064a\u0629 \u0644\u062a\u064a\u0633\u064a\u0631 \u0627\u0644\u0646\u0637\u0642 \u0641\u0642\u0637. 1) \u0627\u0644\u062d\u0631\u0648\u0641 \u0627\u0644\u0645\u062a\u062d\u0631\u0643\u0629 \u0641\u064a \u0635\u0641 \u0648\u0627\u062d\u062f [ \u0639\u062f\u0644 ] a e i o u a e i o u \u0627 \u0627\u064a \u0642\u0631\u064a\u0628\u0629 \u0625\u064a \u0635\u0627\u0641\u064a\u0629 \u0627\u0648 \u0627\u0648 \u0627\u0645\u062b\u0644\u0629: pan \u062e\u0628\u0632\u060c leche \u062d\u0644\u064a\u0628\u060c vino \u0646\u0628\u064a\u0630\u060c sol \u0634\u0645\u0633\u060c lunes \u0627\u0644\u0627\u062b\u0646\u064a\u0646. 2) \u0627\u0644\u062d\u0631\u0648\u0641 \u0627\u0644\u0633\u0627\u0643\u0646\u0629 (\u062b\u0644\u0627\u062b \u0645\u062c\u0645\u0648\u0639\u0627\u062a) [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0623 [ \u0639\u062f\u0644 ] b c d f g h j b c d f g h j \u0628 \u0633 \u0642\u0628\u0644 e,i \u2014 \u0643 \u0642\u0628\u0644 a,o,u \u062f \u0641 \u062e \u0642\u0628\u0644 e,i \u2014 \u062c \u0642\u0628\u0644 a,o,u \u0635\u0627\u0645\u062a \u0644\u0627 \u064a\u0646\u0637\u0642 \u062e \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0628 [ \u0639\u062f\u0644 ] k l m n \u00f1 p q k l m n \u00f1 p q \u0643 \u0644 \u0645 \u0646 \u0646 \u064a \u0628 \u0643 \u0645\u0639 ue, ui \u0641\u0642\u0637 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u062c [ \u0639\u062f\u0644 ] r rr s t v w x y z r rr s t v w x y z \u0631 \u062e\u0641\u064a\u0641\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0643\u0644\u0645\u0629 \u0631 \u0645\u0634\u062f\u062f\u0629 \u0633 \u062a \u0628 \u062e\u0641\u064a\u0641\u0629 \u063a\u0627\u0644\u0628\u0627 \u0648 \u0627\u0643\u0633 \u063a\u0627\u0644\u0628\u0627 \u0643\u0633\u060c \u0648\u0627\u062d\u064a\u0627\u0646\u0627 \u062e \u0641\u064a M\u00e9xico \u064a \u0643\u0633\u0627\u0643\u0646\u060c \u0648\u0627\u064a \u0643\u0639\u0644\u0651\u0629 \u0633 3) \u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0646\u0637\u0642 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 [ \u0639\u062f\u0644 ] 3.1 \u062d\u0631\u0641 c \u0645\u0639 \u0627\u0644\u062d\u0631\u0643\u0627\u062a [ \u0639\u062f\u0644 ] ca ce ci co cu ca ce ci co cu \u0643\u0627 \u0633\u064a \u0633\u064a \u0643\u0648 \u0643\u0648 3.2 \u062d\u0631\u0641 g \u0645\u0639 \u0627\u0644\u062d\u0631\u0643\u0627\u062a [ \u0639\u062f\u0644 ] ga ge gi go gu ga ge gi go gu \u062c\u0627 \u062e\u064a \u062e\u064a \u062c\u0648 \u062c\u0648 3.3 gue/gui \u0645\u0642\u0627\u0628\u0644 g\u00fce/g\u00fci [ \u0639\u062f\u0644 ] gue gui g\u00fce g\u00fci gue gui g\u00fce g\u00fci \u062c\u064a (\u0627\u0644\u0640 u \u0635\u0627\u0645\u062a\u0629) \u062c\u064a (\u0627\u0644\u0640 u \u0635\u0627\u0645\u062a\u0629) \u062c\u0648\u064a \u062c\u0648\u064a 3.4 que/qui [ \u0639\u062f\u0644 ] que qui que qui \u0643\u064a \u0643\u064a 3.5 \u0627\u0632\u062f\u0648\u0627\u062c\u0627\u062a \u0634\u0627\u0626\u0639\u0629 [ \u0639\u062f\u0644 ] ch ll y (\u0639\u0644\u0651\u0629) ch ll y \u062a\u0634 \u064a\u064a (\u0648\u0627\u062d\u064a\u0627\u0646\u0627 \u062c \u0641\u064a \u0627\u0644\u0627\u0631\u062c\u0646\u062a\u064a\u0646) \u0627\u064a 4) \u0627\u0645\u062b\u0644\u0629 \u0633\u0631\u064a\u0639\u0629 \u062d\u0633\u0628 \u0627\u0644\u062d\u0631\u0641 [ \u0639\u062f\u0644 ] casa \u0645\u0646\u0632\u0644\u060c gente \u0646\u0627\u0633\u060c hijo \u0627\u0628\u0646\u060c queso \u062c\u0628\u0646\u060c perro \u0643\u0644\u0628\u060c zapato \u062d\u0630\u0627\u0621\u060c llave \u0645\u0641\u062a\u0627\u062d\u060c yo \u0627\u0646\u0627\u060c calle \u0634\u0627\u0631\u0639\u060c guerra \u062d\u0631\u0628\u060c gu\u00eda \u062f\u0644\u064a\u0644. 5) \u0627\u0644\u0646\u0628\u0631 \u0648\u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a [ \u0639\u062f\u0644 ] \u0627\u0644\u0642\u0627\u0639\u062f\u0629: \u0627\u0644\u0645\u0642\u0637\u0639 \u0642\u0628\u0644 \u0627\u0644\u0627\u062e\u064a\u0631 \u0627\u0630\u0627 \u0627\u0646\u062a\u0647\u062a \u0627\u0644\u0643\u0644\u0645\u0629 \u0628\u062d\u0631\u0641 \u0639\u0644\u0651\u0629 \u0627\u0648 n \u0627\u0648 s\u060c \u0648\u0627\u0644\u0627 \u0641\u0627\u0644\u0645\u0642\u0637\u0639 \u0627\u0644\u0627\u062e\u064a\u0631. \u062a\u0648\u0636\u0639 \u0639\u0644\u0627\u0645\u0629 \u00b4 \u0639\u0646\u062f \u0645\u062e\u0627\u0644\u0641\u0629 \u0627\u0644\u0642\u0627\u0639\u062f\u0629: tel\u00e9fono\u060c ingl\u00e9s. \u00f1 \u0635\u0648\u062a \u0645\u0633\u062a\u0642\u0644 \u0646 \u064a: ni\u00f1o \u0637\u0641\u0644. \u00a8 \u0639\u0644\u0649 \u00fc \u062a\u062f\u0644 \u0639\u0644\u0649 \u0646\u0637\u0642 \u0627\u0644\u0640 u: ping\u00fcino \u0628\u0637\u0631\u064a\u0642. 6) \u0627\u062e\u062a\u0644\u0627\u0641\u0627\u062a \u0644\u0647\u062c\u064a\u0629 \u0645\u062e\u062a\u0635\u0631\u0629 [ \u0639\u062f\u0644 ] \u0641\u064a \u0627\u0633\u0628\u0627\u0646\u064a\u0627: ce, ci, z = \u062b. \u0641\u064a \u0645\u0639\u0638\u0645 \u0627\u0645\u0631\u064a\u0643\u0627: \u0633. ll \u0648 y \u0642\u062f \u064a\u0646\u0637\u0642\u0627\u0646 \u064a\u060c \u0648\u0641\u064a \u0627\u0644\u0627\u0631\u062c\u0646\u062a\u064a\u0646 \u0648\u0627\u0648\u0631\u0648\u063a\u0648\u0627\u064a \u0627\u0642\u0631\u0628 \u0625\u0644\u0649 \u062c. 7) \u062a\u0645\u0627\u0631\u064a\u0646 \u062a\u0637\u0628\u064a\u0642\u064a\u0629 [ \u0639\u062f\u0644 ] \u062a\u0645\u0631\u064a\u0646: \u0627\u0643\u062a\u0628 \u0635\u0641\u0627 \u0645\u0646 \u062e\u0645\u0633 \u0643\u0644\u0645\u0627\u062a \u062a\u0628\u062f\u0623 \u0628\u0643\u0644 \u0645\u0646 ca, ce, ci, co, cu \u0645\u0639 \u062a\u0631\u062c\u0645\u0629 \u0639\u0631\u0628\u064a\u0629 \u0645\u0648\u062c\u0632\u0629. \u062a\u0645\u0631\u064a\u0646: \u062d\u0648\u0651\u0644 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0625\u0644\u0649 \u0646\u0637\u0642 \u0639\u0631\u0628\u064a \u062a\u0642\u0631\u064a\u0628\u064a: gato, gente, queso, ping\u00fcino, llave. \u062d\u0644 \u0645\u0642\u062a\u0631\u062d: \u062c\u0627\u062a\u0648\u060c \u062e\u064a\u0646\u062a\u064a\u060c \u0643\u064a\u0633\u0648\u060c \u0628\u064a\u0646\u063a\u0648\u064a\u0646\u0648\u060c \u064a\u0627\u0641\u064a \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629/\u0627\u0644\u0648\u062d\u062f\u0629_01_-_\u0627\u0644\u062d\u0631\u0648\u0641_\u0648\u0627\u0644\u0646\u0637\u0642&oldid=222853 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629/\u0627\u0644\u0648\u062d\u062f\u0629 01 - \u0627\u0644\u062d\u0631\u0648\u0641 \u0648\u0627\u0644\u0646\u0637\u0642 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

{
  "url": "http://ar.wikibooks.org/wiki/%D8%A7%D9%84%D8%A5%D8%B1%D8%B6%D8%A7%D8%B9/%D8%B1%D8%B6%D9%8A%D8%B9/%D9%87%D9%84_%D9%8A%D8%AD%D8%B5%D9%84_%D8%B9%D9%84%D9%89_%D8%AD%D9%84%D9%8A%D8%A8_%D9%83%D8%A7%D9%81",
  "title": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0647\u0644 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062d\u0644\u064a\u0628 \u0643\u0627\u0641 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0647\u0644 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062d\u0644\u064a\u0628 \u0643\u0627\u0641 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 < \u0627\u0644\u0625\u0631\u0636\u0627\u0639 | \u0631\u0636\u064a\u0639 \u064a\u0631\u062c\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u062d\u0648\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0637\u0628\u064a . \u0623\u062b\u0646\u0627\u0621 \u0623\u0648\u0644 \u0625\u0633\u0628\u0648\u0639\u064a\u0646\u060c \u0642\u062f \u062a\u062a\u0633\u0627\u0626\u0644 \u0625\u0630\u0627 \u0645\u0627 \u0643\u0627\u0646 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0643\u0641\u0627\u064a\u062a\u0647 \u0645\u0646 \u0627\u0644\u062d\u0644\u064a\u0628\u060c \u062e\u0635\u0648\u0635\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u064a\u0631\u064a\u062f \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u062f\u0627\u0626\u0645\u0627 \u0623\u0648 \u0643\u0627\u0646 \u0639\u0635\u0628\u064a\u0627 \u0628\u0639\u062f \u0627\u0644\u0631\u0636\u0627\u0639\u0629. \u062d\u0644\u064a\u0628 \u0627\u0644\u0623\u0645 \u0633\u0647\u0644 \u0627\u0644\u0647\u0636\u0645\u060c \u064a\u062a\u0645 \u0627\u0645\u062a\u0635\u0627\u0635\u0647 \u0648\u0647\u0636\u0645\u0647 \u062e\u0644\u0627\u0644 \u0633\u0627\u0639\u062a\u0627\u0646\u060c \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0628\u062f\u0648 \u062c\u0627\u0626\u0639 \u062f\u0627\u0626\u0645\u0627 (\u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644\u060c \u0643\u0644\u0651 \u0633\u0627\u0639\u0629 \u0625\u0644\u0649 \u062b\u0644\u0627\u062b \u0633\u0627\u0639\u0627\u062a). \u0647\u0630\u0627 \u0627\u0644\u0643\u0644\u0627\u0645 \u0644\u0627 \u064a\u0646\u0637\u0628\u0642 \u0639\u0644\u0649 \u0623\u0648\u0644 \u064a\u0648\u0645 \u0623\u0648 \u064a\u0648\u0645\u064a\u0646 \u0645\u0646 \u062d\u064a\u0627\u0629 \u0627\u0644\u0637\u0641\u0644\u060c \u062d\u064a\u062b \u064a\u0643\u0648\u0646 \u0646\u0627\u0626\u0645\u0627 \u0645\u0639\u0638\u0645 \u0627\u0644\u0648\u0642\u062a. \u0623\u0643\u062b\u0631 \u0627\u0644\u0645\u0648\u0627\u0644\u064a\u062f \u0627\u0644\u062c\u062f\u062f \u064a\u0637\u0644\u0628\u0648\u0646 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0645\u0646 8 \u0625\u0644\u0649 15 \u064a\u0648\u0645\u064a\u0627\u0648 \u0630\u0644\u0643 \u0628\u0639\u062f \u062b\u0644\u0627\u062b\u0629 \u0625\u0644\u0649 \u0623\u0631\u0628\u0639\u0629 \u0623\u064a\u0627\u0645 \u0645\u0646 \u0627\u0644\u0648\u0644\u0627\u062f\u0629. \u063a\u0630\u0651 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0643\u0644\u0645\u0627 \u0637\u0644\u0628 \u0630\u0644\u0643. \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f \u0644\u064a\u0633 \u0644\u0647\u0627 \u0645\u0643\u0627\u0646 \u0641\u064a \u062c\u062f\u0648\u0644 \u0631\u0648\u062a\u064a\u0646\u0643 \u0639\u0646\u062f\u0645\u0627 \u064a\u062a\u0639\u0644\u0642 \u0627\u0644\u0623\u0645\u0631 \u0628\u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629. \u0645\u0633\u062a\u0634\u0627\u0631\u0648\u0627 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0648\u0623\u0637\u0628\u0627\u0621 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u064a\u0645\u0643\u0646\u0647\u0645 \u0645\u0639\u0631\u0641\u0629 \u0625\u0630\u0627 \u0645\u0627 \u0643\u0627\u0646 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0643\u0641\u0627\u064a\u062a\u0647 \u0645\u0646 \u0627\u0644\u062d\u0644\u064a\u0628\u060c \u0648\u0630\u0644\u0643 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0632\u064a\u0627\u062f\u0629 \u0648\u0632\u0646\u0647. \u064a\u0641\u0642\u062f \u0627\u0644\u0645\u0648\u0627\u0644\u064a\u062f \u0627\u0644\u062c\u062f\u062f \u0639\u0627\u062f\u0629 \u0628\u064a\u0646 5 \u0625\u0644\u0649 9 \u0628\u0627\u0644\u0645\u0627\u0626\u0629 \u0645\u0646 \u0648\u0632\u0646\u0647\u0645 \u0639\u0646\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629 \u062b\u0645 \u064a\u0633\u062a\u0639\u064a\u062f\u0648\u0646\u0647 \u0628\u0639\u0645\u0631 \u0627\u0644\u0625\u0633\u0628\u0648\u0639\u064a\u0646 \u062a\u0642\u0631\u064a\u0628\u0627. \u064a\u062c\u0628 \u0623\u0646 \u064a\u0628\u062f\u0623\u0648\u0627 \u0628\u0643\u0633\u0628 \u0623\u0648\u0646\u0633 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0623\u0628\u062a\u062f\u0623 \u0645\u0646 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062e\u0627\u0645\u0633 \u0628\u0639\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629.\u0625\u0630\u0627 \u0643\u0646\u062a \u0642\u0644\u0642\u0627 \u0623\u0637\u0628 \u0645\u0646 \u0637\u0628\u064a\u0628 \u0627\u0644\u0637\u0641\u0644 \u062a\u062f\u0642\u064a\u0642 \u0648\u0632\u0646\u0647. \u0647\u0646\u0627\u0643 \u0637\u0631\u0642 \u0623\u062e\u0631\u0649 \u0644\u062a\u0642\u064a\u0645 \u062d\u0635\u0648\u0644 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0639\u0644\u0649 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u0643\u0627\u0641\u064a\u060c \u0647\u0646\u0627\u0643 \u0625\u0634\u0627\u0631\u0627\u062a \u062a\u0641\u064a\u062f \u0628\u0623\u0646\u0647 \u0642\u062f \u0644\u0627 \u064a\u0633\u062a\u0644\u0645 \u0645\u0627 \u0641\u064a\u0647 \u0627\u0644\u0643\u0641\u0627\u064a\u0629. \u0627\u0644\u062c\u0641\u0627\u0641 \u0641\u064a \u0627\u0644\u0645\u0648\u0627\u0644\u064a\u062f \u0627\u0644\u062c\u062f\u062f \u0646\u0627\u062f\u0631\u060c \u0645\u0646 \u0627\u0644\u0645\u0647\u0645 \u0645\u0639\u0631\u0641\u0629 \u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0637\u0641\u0644 \u0627\u0644\u0645\u062a\u0645\u062a\u0639 \u0628\u0635\u062d\u062a\u0647 \u0628\u062d\u064a\u062b \u062a\u0646\u0628\u0647 \u0637\u0628\u064a\u0628 \u0623\u0637\u0641\u0627\u0644\u0643 \u0625\u0630\u0627 \u0628\u062f\u0627 \u0644\u0643 \u0623\u064a\u0651 \u0634\u0626 \u062e\u0627\u0637\u0626\u0627. \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u062c\u064a\u062f\u0629 [ \u0639\u062f\u0644 ] - \u064a\u0623\u0643\u0644 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0643\u0644\u0651 \u0627\u062b\u0646\u0627\u0646 \u0625\u0644\u0649 \u062b\u0644\u0627\u062b \u0633\u0627\u0639\u0627\u062a \u0623\u0648 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u062b\u0645\u0627\u0646\u064a \u0645\u0631\u0627\u062a \u0643\u0644 \u064a\u0648\u0645 \u0641\u064a \u0623\u0648\u0644 \u0623\u0633\u0628\u0648\u0639\u064a\u0646 \u0625\u0644\u0649 \u062b\u0644\u0627\u062b\u0629 \u0623\u0633\u0627\u0628\u064a\u0639 \u0645\u0646 \u0639\u0645\u0631\u0647. - \u0641\u064a \u0634\u0647\u0631\u0647 \u0627\u0644\u0623\u0648\u0644\u060c \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u064a\u062a\u0628\u0631\u0632 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u062b\u0644\u0627\u062b\u0629 \u0645\u0631\u0627\u062a \u064a\u0648\u0645\u064a\u0627\u060c \u0644\u0648\u0646 \u0627\u0644\u0628\u0631\u0627\u0632 \u062e\u0631\u062f\u0644 \u0645\u0635\u0641\u0631\u0651 \u0641\u0627\u062a\u062d\u060c \u0648\u0630\u0644\u0643 \u0628\u0639\u062f \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062e\u0627\u0645\u0633 \u0645\u0646 \u0627\u0644\u0648\u0644\u0627\u062f\u0629. \u0642\u0628\u0644 \u0630\u0644\u0643 \u064a\u0643\u0648\u0646 \u0644\u0648\u0646 \u0627\u0644\u0628\u0631\u0627\u0632 \u063a\u0627\u0645\u0642 \u062c\u062f\u0627. \u0628\u0639\u062f \u0639\u0645\u0631 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0623\u0648\u0644\u060c \u062a\u0635\u0628\u062d \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u062a\u0628\u0631\u0632 \u0623\u0642\u0644 \u062a\u0643\u0631\u0627\u0631. \u0628\u0639\u0636 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0627\u0644\u0631\u0636\u0651\u0639 \u0642\u062f \u064a\u0646\u0638\u0631\u0648\u0646 \u0645\u0646 \u064a\u0648\u0645 \u0625\u0644\u0649 \u064a\u0648\u0645\u064a\u0646 \u0628\u064a\u0646 \u0627\u0644\u062a\u0628\u0631\u0632 \u0648\u0627\u0644\u0622\u062e\u0631. - \u064a\u0643\u0633\u0628 \u0623\u0648\u0646\u0633 \u064a\u0648\u0645\u064a\u0627 \u0623\u0628\u062a\u062f\u0623 \u0645\u0646 \u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062e\u0627\u0645\u0633 \u0628\u0639\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629 \u062e\u0644\u0627\u0644 \u0627\u0644\u0634\u0647\u0648\u0631 \u0627\u0644\u062b\u0644\u0627\u062b\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0645\u0646 \u0639\u0645\u0631\u0647. - \u064a\u0628\u0644\u0651\u0644 \u0641\u0648\u0637\u0647 \u0627\u0644\u0642\u0637\u0646\u064a\u0629 \u0633\u0628\u0639\u0629 \u0623\u0648 \u062b\u0645\u0627\u0646 \u0645\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u064a\u0648\u0645\u060c \u0623\u0648 \u062d\u0641\u0627\u0638\u0627\u062a\u0647 \u062e\u0645\u0633\u0629 \u0625\u0644\u0649 \u0633\u062a\u0629 \u0645\u0631\u0627\u062a. \u062d\u0641\u0627\u0638\u0629 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0644\u062f\u064a\u0647\u0627 \u0627\u0644\u0642\u062f\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0645\u062a\u0635\u0627\u0635 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0644\u0641\u0648\u0637 \u0627\u0644\u0642\u0637\u0646\u064a\u0629\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644 \u0623\u0644\u0623\u0645\u0648\u0631 \u0623\u0635\u0639\u0628 \u0644\u0645\u0639\u0631\u0641\u0629 \u0625\u0630\u0627 \u0645\u0627 \u0628\u0644\u0644\u0647\u0627 \u0627\u0644\u0631\u0636\u064a\u0639. \u0625\u0630\u0627 \u0623\u0631\u062f\u062a \u0627\u0644\u062a\u0623\u0643\u062f\u060c \u0642\u0627\u0631\u0646 \u0648\u0632\u0646\u0647\u0627 \u0645\u0639 \u062d\u0641\u0627\u0638\u0629 \u062c\u062f\u064a\u062f\u0629 \u0628\u0648\u0627\u0633\u0637\u0629 \u064a\u062f\u064a\u0643. \u0623\u064a \u0628\u0644\u0644 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0644\u0647 \u0648\u0632\u0646 \u0648\u0627\u0636\u062d\u060c \u0648\u062a\u0643\u0648\u0646 \u0627\u0644\u062d\u0641\u0627\u0636\u0629 \u0623\u062b\u0642\u0644 \u0642\u0644\u064a\u0644\u0627. \u0645\u0644\u0627\u062d\u0638\u0629: \u0644\u0648\u062d\u062f\u0647\u0627\u060c \u062d\u0641\u0651\u0627\u0638\u0629 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0627\u0644\u0631\u0637\u0628\u0629 \u063a\u064a\u0631 \u0643\u0627\u0641\u064a\u0629 \u0644\u0644\u062a\u0642\u0631\u064a\u0631 \u0625\u0630\u0627 \u0645\u0627 \u0643\u0627\u0646 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u0643\u0627\u0641\u064a. \u0623\u064a \u0637\u0641\u0644 \u0631\u0636\u064a\u0639 \u0645\u0635\u0627\u0628 \u0628\u0627\u0644\u062c\u0641\u0627\u0641 \u064a\u0645\u0643\u0646\u0647 \u0623\u0646 \u064a\u0628\u0644\u0651\u0644 \u062d\u0641\u0651\u0627\u0638\u0629. \u0627\u0644\u0628\u0631\u0627\u0632 \u0648\u0632\u064a\u0627\u062f\u0629 \u0627\u0644\u0648\u0632\u0646 \u0647\u0645\u0627 \u0623\u0641\u0636\u0644 \u0627\u0644\u0637\u0631\u0642 \u0644\u0645\u0639\u0631\u0641\u0629 \u0648\u0636\u0639 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639. - \u0628\u0625\u0645\u0643\u0627\u0646\u0643 \u0623\u0646 \u062a\u0633\u0645\u0639 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0648\u0647\u0648 \u064a\u0628\u062a\u0644\u0639 \u0627\u0644\u062d\u0644\u064a\u0628 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 (\u0625\u0630\u0627 \u0627\u0644\u063a\u0631\u0641\u0629 \u0647\u0627\u062f\u0626\u0629). - \u0633\u064a\u0635\u0628\u062d \u0627\u0644\u062b\u062f\u064a \u0623\u0642\u0644 \u0625\u0645\u0645\u062a\u0644\u0623 \u0628\u0639\u062f \u0627\u0644\u0631\u0636\u0627\u0639\u0629. \u0623\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u062d\u0630\u064a\u0631 [ \u0639\u062f\u0644 ] \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062f\u0644 \u0639\u0644\u0649 \u0623\u0646 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0644\u0627 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u0643\u0641\u0627\u064a\u062a\u0647 \u0645\u0646 \u0627\u0644\u062d\u0644\u064a\u0628 \u062a\u0636\u0645\u0651\u0646 \u0639\u0627\u062f\u0629 \u0623\u063a\u0644\u0628 \u0627\u0644\u062a\u0627\u0644\u064a: - \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u064a\u0641\u0642\u062f 10 \u0628\u0627\u0644\u0645\u0627\u0626\u0629 \u0623\u0648 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0648\u0632\u0646\u0647 \u0639\u0646\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629 \u0641\u064a \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u0623\u0648\u0644\u0649 \u0627\u0644\u062e\u0645\u0633\u0629 \u0645\u0646 \u0627\u0644\u062d\u064a\u0627\u0629. \u062a\u0630\u0643\u0651\u0631\u060c \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0644\u0644\u0645\u0648\u0644\u0648\u062f \u0627\u0644\u062c\u062f\u064a\u062f \u0647\u0648 \u0641\u0642\u062f\u0627\u0646 \u0645\u0627 \u0628\u064a\u0646 5 \u0625\u0644\u0649 9 \u0628\u0627\u0644\u0645\u0627\u0626\u0629 \u0645\u0646 \u0648\u0632\u0646\u0647 \u0639\u0646\u062f \u0627\u0644\u0648\u0644\u0627\u062f\u0629. \u0644\u0643\u0646 \u0628\u0627\u0644\u064a\u0648\u0645 \u0627\u0644\u062e\u0627\u0645\u0633\u060c \u064a\u062c\u0628 \u0623\u0646 \u064a\u0628\u062f\u0623 \u0628\u0643\u0633\u0628 \u0623\u0648\u0646\u0633 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u064a\u0648\u0645\u064a\u0627. - \u0646\u0627\u062f\u0631\u0627 \u0645\u0627 \u062a\u0633\u0645\u0639 \u0635\u0648\u062a \u0631\u0636\u0627\u0639\u0629 \u0648\u0628\u0644\u0639 \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639. - \u0627\u0644\u062b\u062f\u064a \u064a\u0628\u0642\u0649 \u0645\u0645\u062a\u0644\u0623 \u0628\u0639\u062f \u0627\u0644\u0631\u0636\u0627\u0639\u0629. - \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0645\u062a\u0639\u0628 \u0623\u0648 \u062e\u0627\u0645\u0644 \u0645\u0639\u0638\u0645 \u0627\u0644\u0648\u0642\u062a. - \u0638\u0647\u0648\u0631 \u062f\u0645\u0627\u0645\u0644 \u0641\u064a \u062e\u062f\u0648\u062f \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0623\u0648 \u0625\u0635\u062f\u0627\u0631\u0647 \u0644\u0635\u0648\u062a \u0642\u0631\u0642\u0639\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0631\u0636\u0627\u0639\u0629. - \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u064a\u062a\u0628\u0648\u0651\u0644 \u0623\u0642\u0644 \u0645\u0646 \u0633\u062a\u0651 \u0645\u0631\u0627\u062a \u0643\u0644 24 \u0633\u0627\u0639\u0629\u060c \u0628\u0639\u062f \u0627\u0644\u0623\u064a\u0627\u0645 \u0627\u0644\u062e\u0645\u0633\u0629 \u0627\u0644\u0623\u0648\u0644\u0649. - \u0637\u0641\u0644\u0643 \u0627\u0644\u0631\u0636\u064a\u0639 \u0644\u0627 \u064a\u062a\u0628\u0631\u0632 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0645\u0631\u0629 \u0643\u0644 \u064a\u0648\u0645 \u0623\u0648 \u0628\u0631\u0627\u0632\u0647 \u0630\u0648 \u0644\u0648\u0646 \u063a\u0627\u0645\u0642\u060c \u0648\u0630\u0644\u0643 \u0628\u0639\u062f \u062e\u0645\u0633\u0629 \u0623\u064a\u0627\u0645 \u0645\u0646 \u0627\u0644\u0648\u0644\u0627\u062f\u0629. \u0625\u0630\u0627 \u0644\u0627\u062d\u0638\u062a \u0623\u064a\u0651 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a\u060c \u0623\u062a\u0635\u0644 \u0628\u0637\u0628\u064a\u0628\u0643 \u0623\u0648 \u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0631\u0636\u0627\u0639\u0629. \u0625\u062d\u062f\u0649 \u0627\u0644\u0623\u0645\u0648\u0631 \u0627\u0644\u0635\u0639\u0628\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0645 \u0641\u064a \u0628\u062f\u0627\u064a\u0629 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0635\u0651\u062f\u0631 \u0647\u0648 \u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0639\u062f\u0645 \u0627\u0644\u062b\u0642\u0629 \u0628\u0623\u0646\u0651\u0647\u0627 \u062a\u0639\u0637\u064a \u0627\u0644\u0637\u0641\u0644 \u0627\u0644\u0631\u0636\u064a\u0639 \u0645\u0627 \u0641\u064a\u0647 \u0627\u0644\u0643\u0641\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u062d\u0644\u064a\u0628. \u064a\u062c\u0628 \u0623\u0646 \u0644\u0627 \u062a\u062a\u0631\u062f\u0651\u062f \u0641\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0645\u0639 \u0645\u0633\u062a\u0634\u0627\u0631 \u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u0623\u0648 \u0627\u0644\u0645\u0645\u0631\u0636\u0629. \u0631\u0628\u0645\u0627 \u064a\u0643\u0648\u0646 \u0645\u0646 \u0627\u0644\u0623\u0641\u0636\u0644 \u0623\u0646 \u062a\u0642\u0648\u0645 \u0627\u0644\u0623\u0645 \u0628\u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u0628\u064a\u0646\u0645\u0627 \u062a\u0631\u0627\u0642\u0628 \u0627\u0644\u0645\u0645\u0631\u0636\u0629 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0648\u0630\u0644\u0643 \u0644\u0625\u0639\u0637\u0627\u0621 \u0627\u0644\u0646\u0635\u0627\u0626\u062d. \u0628\u0628\u0628 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0647\u0644_\u064a\u062d\u0635\u0644_\u0639\u0644\u0649_\u062d\u0644\u064a\u0628_\u0643\u0627\u0641&oldid=97747 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0631\u0636\u0627\u0639\u0629 \u0637\u0628 \u0623\u0637\u0641\u0627\u0644 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0625\u0631\u0636\u0627\u0639/\u0631\u0636\u064a\u0639/\u0647\u0644 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062d\u0644\u064a\u0628 \u0643\u0627\u0641 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

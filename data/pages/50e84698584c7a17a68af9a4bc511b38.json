  "title": "\u0627\u0644\u0637\u0627\u0642\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0637\u0627\u0642\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0641\u0647\u0631\u0633 \u0627\u0644\u0645\u062d\u062a\u0648\u064a\u0627\u062a [ \u0639\u062f\u0644 ] \u0645\u0642\u062f\u0645\u0629 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0637\u0627\u0642\u0629 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u062d\u0631\u0627\u0631\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0634\u0645\u0633\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0636\u0648\u0626\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0643\u0647\u0631\u0648\u0645\u063a\u0646\u0627\u0637\u064a\u0633\u064a\u0629 \u0627\u0644\u062d\u0631\u0643\u0629 \u0627\u0644\u0645\u0648\u062c\u0628\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0643\u064a\u0645\u064a\u0627\u0626\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u064a\u0643\u0627\u0646\u064a\u0643\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0646\u0648\u0648\u064a\u0629 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0647\u064a\u062f\u0631\u0648\u062c\u064a\u0646\u064a\u0629 \u0627\u0644\u063a\u0627\u0632 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0627\u0644\u0641\u062d\u0645 \u0627\u0644\u062d\u062c\u0631\u064a \u0627\u0644\u0646\u0641\u0637 \u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0637\u0627\u0642\u0629 \u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u062a\u062c\u062f\u062f\u0629 \u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0637\u0627\u0642\u0629 \u063a\u064a\u0631 \u0627\u0644\u0645\u062a\u062c\u062f\u062f\u0629 \u0645\u0646\u0634\u0622
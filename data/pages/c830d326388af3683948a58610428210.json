{
  "url": "http://avtor.karelia.ru/about/verhoglyadov_valerii.html",
  "title": "\u00c2\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00cd\u00e8\u00ea\u00ee\u00eb\u00e0\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00c2\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00cd\u00e8\u00ea\u00ee\u00eb\u00e0\u00e5\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00c2\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00cd\u00e8\u00ea\u00ee\u00eb\u00e0\u00e5\u00e2\u00e8\u00f7 ( 13.03.1946 - 15.01.2019 ) \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00cf\u00f3\u00e4\u00ee\u00e6 \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc, \u00f7\u00eb\u00e5\u00ed\u00a0 \u00d1\u00ee\u00fe\u00e7\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00f1 2000 \u00e3\u00ee\u00e4\u00e0. \u00c7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00fb\u00e9 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. \u0412 1964 \u00e3\u00ee\u00e4\u00f3 \u00ee\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb \u00f1\u00f0\u00e5\u00e4\u00ed\u00fe\u00fe \u00f8\u00ea\u00ee\u00eb\u00f3 \u00e8 \u00ef\u00ee\u00f1\u00f2\u00f3\u00ef\u00e8\u00eb \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00f2\u00fc \u00ed\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00f3\u00fe \u00d0\u00dd\u00c1 \u00f4\u00eb\u00ee\u00f2\u00e0. \u00d5\u00ee\u00e4\u00e8\u00eb \u00ed\u00e0 \u00f1\u00f3\u00e4\u00e0\u00f5 \u00c1\u00e5\u00eb\u00ee\u00ec\u00ee\u00f0\u00f1\u00ea\u00ee-\u00ce\u00ed\u00e5\u00e6\u00f1\u00ea\u00ee\u00e3\u00ee \u00ef\u00e0\u00f0\u00ee\u00f5\u00ee\u00e4\u00f1\u00f2\u00e2\u00e0 \u00ec\u00ee\u00f2\u00ee\u00f0\u00e8\u00f1\u00f2\u00ee\u00ec-\u00ec\u00e0\u00f2\u00f0\u00ee\u00f1\u00ee\u00ec 1 \u00ea\u00eb\u00e0\u00f1\u00f1\u00e0. \u0412 1965 \u00e3\u00ee\u00e4\u00f3 \u00ef\u00ee\u00f1\u00f2\u00f3\u00ef\u00e8\u00eb \u00f3\u00f7\u00e8\u00f2\u00fc\u00f1\u00ff \u00ed\u00e0 \u00ee\u00f2\u00e4\u00e5\u00eb\u00e5\u00ed\u00e8\u00e5 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea\u00ee-\u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e3\u00ee \u00f4\u00e0\u00ea\u00f3\u00eb\u00fc\u00f2\u00e5\u00f2\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e3\u00ee \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e3\u00ee \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2\u00e0. \u00cf\u00ee \u00ee\u00ea\u00ee\u00ed\u00f7\u00e0\u00ed\u00e8\u00e8 \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2\u00e0 \u00e2 1971 \u00e3\u00ee\u00e4\u00f3 \u00e1\u00fb\u00eb \u00ef\u00f0\u00e8\u00ed\u00ff\u00f2 \u00e2 \u00f8\u00f2\u00e0\u00f2 \u00f0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0\u00ed\u00f1\u00ea\u00ee\u00e9 \u00ec\u00ee\u00eb\u00ee\u00e4\u00e5\u00e6\u00ed\u00ee\u00e9 \u00e3\u00e0\u00e7\u00e5\u00f2\u00fb \u00ab\u00ca\u00ee\u00ec\u00f1\u00ee\u00ec\u00ee\u00eb\u00e5\u00f6\u00bb, \u00e2 \u00ea\u00ee\u00f2\u00ee\u00f0\u00ee\u00e9 \u00ef\u00f0\u00ee\u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00ef\u00ff\u00f2\u00ed\u00e0\u00e4\u00f6\u00e0\u00f2\u00fc \u00eb\u00e5\u00f2. \u00d1 1986 \u00ef\u00ee 1989 \u00e3.\u00e3. \u00e1\u00fb\u00eb \u00e7\u00e0\u00e2\u00e5\u00e4\u00f3\u00fe\u00f9\u00e8\u00ec \u00f0\u00e5\u00e4\u00e0\u00ea\u00f6\u00e8\u00e5\u00e9 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee-\u00ef\u00ee\u00eb\u00e8\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e9 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb \u00e8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00e0 \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u0412 1989 \u00e3\u00ee\u00e4\u00f3 \u00e2\u00e5\u00f0\u00ed\u00f3\u00eb\u00f1\u00ff \u00e2 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e8\u00ea\u00f3, \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00e2 \u00e3\u00e0\u00e7\u00e5\u00f2\u00e0\u00f5 \u00ab\u00cb\u00e5\u00ed\u00e8\u00ed\u00f1\u00ea\u00e0\u00ff \u00ef\u00f0\u00e0\u00e2\u00e4\u00e0\u00bb (\u00ab\u00ca\u00f3\u00f0\u00fc\u00e5\u00f0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8\u00bb), \u00ab\u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00bb, \u00ab\u00c3\u00ee\u00f0\u00ee\u00e4\u00bb, \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00cf\u00e5\u00f0\u00e2\u00fb\u00e9 \u00ee\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00ee\u00e2\u00e0\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0\u00a0 \u2013 \u00ab\u00ce\u00f2\u00e4\u00e0\u00f2\u00fc \u00f8\u00e2\u00e0\u00f0\u00f2\u00ee\u00e2\u00fb\u00bb \u2013 \u00f3\u00e2\u00e8\u00e4\u00e5\u00eb \u00f1\u00e2\u00e5\u00f2 \u00ed\u00e0 \u00f1\u00f2\u00f0\u00e0\u00ed\u00e8\u00f6\u00e0\u00f5 \u00ab\u00ca\u00ee\u00ec\u00f1\u00ee\u00ec\u00ee\u00eb\u00fc\u00f6\u00e0\u00bb \u00e2 1967 \u00e3\u00ee\u00e4\u00f3. \u0412 \u00fd\u00f2\u00ee\u00e9 \u00e6\u00e5 \u00e3\u00e0\u00e7\u00e5\u00f2\u00e5 \u00e1\u00fb\u00eb\u00e8 \u00e2\u00ef\u00ee\u00f1\u00eb\u00e5\u00e4\u00f1\u00f2\u00e2\u00e8\u00e8 \u00ed\u00e0\u00ef\u00e5\u00f7\u00e0\u00f2\u00e0\u00ed\u00fb \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00ab\u00cf\u00e5\u00f2\u00f3\u00f5\u00bb, \u00ab\u00d0\u00e0\u00e4\u00e8\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00e5 \u00f1\u00f0\u00e5\u00e4\u00f1\u00f2\u00e2\u00ee\u00bb, \u00ab\u00c4\u00ee\u00ec\u00bb \u00e8 \u00e4\u00f0\u00f3\u00e3\u00e8\u00e5. \u0412 1988 \u00e3\u00ee\u00e4\u00f3 \u00e4\u00e2\u00e0 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00e0 \u2013 \u00ab\u00c3\u00e0\u00f1\u00f2\u00f0\u00ee\u00eb\u00e5\u00f0\u00bb \u00e8 \u00ab\u00d3\u00f7\u00e0\u00f1\u00f2\u00ee\u00ea \u00e2 \"\u00dd\u00f4\u00e8\u00f0\u00e5\"\u00bb \u2014 \u00e1\u00fb\u00eb\u00e8 \u00ee\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00ee\u00e2\u00e0\u00ed\u00fb \u00e2 \u00ef\u00e5\u00f0\u00e2\u00ee\u00ec \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e5 \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e9 \u00f4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2\u00e8\u00ea\u00e8 \u00ab\u00cf\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00ea\u00e0\u00ec\u00e5\u00ed\u00fc\u00bb. \u0412\u00fb\u00f1\u00f2\u00f3\u00ef\u00e0\u00eb \u00f1 \u00ee\u00f7\u00e5\u00f0\u00ea\u00e0\u00ec\u00e8 \u00e2 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e5 \u00ab\u00c3\u00f0\u00e0\u00ed\u00e8 \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e0\u00bb (1976), \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00ee\u00ec \u00a0\u00e0\u00eb\u00fc\u00ec\u00e0\u00ed\u00e0\u00f5\u00e5 \u00ab\u00c7\u00ee\u00f0\u00fc\u00ea\u00e0\u00bb (1989), \u00e2 \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e5 \u00ab\u00ca\u00f0\u00e0\u00e5\u00e2\u00e5\u00e4 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8\u00bb \u00e8 \u00e4\u00f0. \u0412 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e5 \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb \u00e4\u00e5\u00e1\u00fe\u00f2\u00e8\u00f0\u00ee\u00e2\u00e0\u00eb \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00ee\u00ec \u00ab\u00cf\u00ee\u00f5\u00ee\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00ef\u00ee\u00eb\u00ea\u00ee\u00e2\u00ed\u00e8\u00ea\u00bb \u00e2 1990 \u00e3\u00ee\u00e4\u00f3. \u0412. \u00c8. \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00e1\u00fb\u00eb \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0\u00ee\u00ec-\u00f1\u00ee\u00f1\u00f2\u00e0\u00e2\u00e8\u00f2\u00e5\u00eb\u00e5\u00ec \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00ee\u00e2 \u00ab\u00d0\u00ff\u00e4\u00ee\u00e2\u00fb\u00e5 \u00f0\u00e5\u00e2\u00ee\u00eb\u00fe\u00f6\u00e8\u00e8\u00bb (1988) \u00ab\u00c5\u00f1\u00f2\u00fc \u00f3 \u00ce\u00f2\u00e5\u00f7\u00e5\u00f1\u00f2\u00e2\u00e0 \u00ef\u00f0\u00ee\u00f0\u00ee\u00ea\u00e8\u00bb (1989), \u00e4\u00e0\u00e9\u00e4\u00e6\u00e5\u00f1\u00f2\u00e0 \u00ab\u00cd\u00e0\u00f8\u00e5 \u00ed\u00e0\u00f1\u00eb\u00e5\u00e4\u00e8\u00e5\u00bb (1996). \u00cf\u00e5\u00f0\u00e2\u00e0\u00ff \u00ea\u00ed\u00e8\u00e3\u00e0 \u00e4\u00ee\u00ea\u00f3\u00ec\u00e5\u00ed\u00f2\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00ef\u00f0\u00ee\u00e7\u00fb \u00a0\u00ab\u00cf\u00f0\u00ff\u00e6\u00e0\u00bb \u00e2\u00fb\u00f8\u00eb\u00e0 \u00e2 \u00f1\u00e2\u00e5\u00f2 \u00e2 1977 \u00e3\u00ee\u00e4\u00f3. \u00c7\u00e0 \u00ed\u00e5\u00e9 \u00ef\u00ee\u00f1\u00eb\u00e5\u00e4\u00ee\u00e2\u00e0\u00eb\u00e8 \u00e4\u00f0\u00f3\u00e3\u00e8\u00e5 \u00ea\u00ed\u00e8\u00e3\u00e8. \u0412. \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00a0\u00ec\u00ed\u00ee\u00e3\u00ee \u00eb\u00e5\u00f2 \u00ef\u00eb\u00ee\u00e4\u00ee\u00f2\u00e2\u00ee\u00f0\u00ed\u00ee \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00e2 \u00e6\u00e0\u00ed\u00f0\u00e5 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e3\u00ee \u00ee\u00f7\u00e5\u00f0\u00ea\u00e0. \u0412 1986 \u00e3\u00ee\u00e4\u00f3 \u00e7\u00e0 \u00ee\u00f7\u00e5\u00f0\u00ea \u00ab\u00cf\u00ee\u00ea\u00f3\u00f8\u00e5\u00ed\u00e8\u00e5 \u00ed\u00e0 \u00f3\u00eb\u00e8\u00f6\u00e5 \u00d1\u00ee\u00e1\u00ee\u00f0\u00ed\u00ee\u00e9\u00bb \u00e8 \u00f6\u00e8\u00ea\u00eb \u00ee\u00f7\u00e5\u00f0\u00ea\u00ee\u00e2 \u00ee \u00eb\u00fe\u00e4\u00ff\u00f5 \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00fc\u00ff \u00f3\u00e4\u00ee\u00f1\u00f2\u00ee\u00e5\u00ed \u00ef\u00f0\u00e5\u00ec\u00e8\u00e8 \u00e8\u00ec\u00e5\u00ed\u00e8 \u00ca. \u00c5\u00f0\u00e5\u00ec\u00e5\u00e5\u00e2\u00e0. \u00c8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00ee \u00ab\u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0\u00bb \u00e7\u00e0 \u00ea\u00ed\u00e8\u00e3\u00f3\u00a0\u00ab\u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00ff \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2\u00e0: \u00e7\u00e0\u00ef\u00e8\u00f1\u00ea\u00e8 \u00ea\u00f0\u00e0\u00e5\u00e2\u00e5\u00e4\u00e0\u00bb, 2019 \u00e3\u00ee\u00e4\u00e0 \u00e2\u00fb\u00ef\u00f3\u00f1\u00ea\u00e0 \u00ef\u00ee\u00eb\u00f3\u00f7\u00e8\u00eb\u00ee \u00f1\u00ef\u00e5\u00f6\u00e8\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00e4\u00e8\u00ef\u00eb\u00ee\u00ec \u00ab\u00d7\u00e8\u00f2\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00ea\u00e0\u00ff \u00f1\u00e8\u00ec\u00ef\u00e0\u00f2\u00e8\u00ff\u00bb XX \u00f0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0\u00ed\u00f1\u00ea\u00ee\u00e3\u00ee \u00ea\u00ee\u00ed\u00ea\u00f3\u00f0\u00f1\u00e0 \u00ab\u00ca\u00ed\u00e8\u00e3\u00e0 \u00e3\u00ee\u00e4\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u2013 2019\u00bb \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00cf\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 : \u00e1\u00e8\u00ee\u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00eb\u00ee\u00e2\u00e0\u00f0\u00fc / \u00ca\u00e0\u00f0\u00e5\u00eb. \u00ed\u00e0\u00f3\u00f7. \u00d6\u00e5\u00ed\u00f2\u00f0 \u00d0\u00c0\u00cd, \u00c8\u00ed-\u00f2 \u00ff\u00e7\u00fb\u00ea\u00e0, \u00eb\u00e8\u00f2. \u00e8 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8, \u00cc-\u00e2\u00ee \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e8 \u00ef\u00ee \u00f1\u00e2\u00ff\u00e7\u00ff\u00ec \u00f1 \u00ee\u00e1\u00f9\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00f1\u00f2\u00fc\u00fe ; [\u00f1\u00ee\u00f1\u00f2. \u00de. \u00c8. \u00c4\u00fe\u00e6\u00e5\u00e2 ]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2006. - \u00d1. 41-44. - \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff \u0412\u00fb\u00f1\u00ee\u00ea\u00e0\u00ff \u00ed\u00e0\u00e3\u00f0\u00e0\u00e4\u00e0 : [\u0412.\u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00f3\u00e4\u00ee\u00f1\u00f2\u00ee\u00e5\u00ed \u00e7\u00e2\u00e0\u00ed\u00e8\u00ff \"\u00c7\u00e0\u00f1\u00eb\u00f3\u00e6. \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8\"] //\u00a0\u00d1\u00e5\u00e2.\u00ea\u00f3\u00f0\u00fc\u00e5\u00f0.-1996.-15 \u00ec\u00e0\u00f0\u00f2\u00e0 \u00cc\u00e8\u00ec\u00ec\u00e8\u00e5\u00e2\u00e0, \u00ce. \u00d0\u00e0\u00e7\u00fa\u00ff\u00f1\u00ed\u00e5\u00ed\u00e8\u00e5 \u00e4\u00eb\u00ff \"\u00f7\u00e0\u00e9\u00ed\u00e8\u00ea\u00ee\u00e2\" : \u00ef\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e9 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00e8 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00fc \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 \u00e8\u00e7\u00e4\u00e0\u00eb \u00ea\u00ed\u00e8\u00e3\u00f3 \u00e1\u00e0\u00e5\u00ea \u00f1\u00e2\u00ee\u00e8\u00f5 \u00ea\u00ee\u00eb\u00eb\u00e5\u00e3 / \u00ce\u00eb\u00fc\u00e3\u00e0 \u00cc\u00e8\u00ec\u00ec\u00e8\u00e5\u00e2\u00e0 // \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea, 2014. - 3 \u00e0\u00ef\u00f0\u00e5\u00eb\u00ff (\u00b9 14). - \u00d1. 23. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2, \u0412. \u00cd. \u00cf\u00f0\u00ff\u00e6\u00e0 / \u0412. \u00cd. \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 ; [\u00f0\u00e5\u00e4. \u00d2. \u00cc. \u00de\u00f0\u00ed\u00e0 ; \u00f5\u00f3\u00e4\u00ee\u00e6. \u00cb. \u00cd. \u00c4\u00e5\u00e3\u00f2\u00ff\u00f0\u00e5\u00e2]. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff, 1977. - 125 \u00f1. \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2, \u0412. \u00cf\u00ee\u00f5\u00ee\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00ef\u00ee\u00eb\u00ea\u00ee\u00e2\u00ed\u00e8\u00ea : \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 / \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 // \u00d1\u00e5\u00e2\u00e5\u00f0. - 1990. - N 4. - \u00d1. 91-96 \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2, \u0412. \u00cd. \u00cf\u00ee\u00ea\u00ee\u00eb\u00e5\u00ed\u00e8\u00e5, \u00e2\u00ee\u00e7\u00f0\u00ee\u00e4\u00e8\u00e2\u00f8\u00e5\u00e5 \u00f2\u00e5\u00eb\u00e5\u00e3\u00f0\u00e0\u00f4 : \u0412\u00e5\u00f2\u00e5\u00f0\u00e0\u00ed\u00fb \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e9 \u00d2\u00d2\u00d1 \u00ee \u00e2\u00f0\u00e5\u00ec\u00e5\u00ed\u00e8 \u00e8 \u00ee \u00f1\u00e5\u00e1\u00e5 / \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00c8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00ee \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0, 2003. - 200 \u00f1. \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2, \u0412. \u00cd. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e5 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 / \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00c8\u00e7\u00e4\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00f2\u00e2\u00ee \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0, 2003. - 95 \u00f1. \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2, \u0412. \u00cd.\u00a0\u00a0 \u0412 \u00ed\u00e0\u00f8\u00f3 \u00e3\u00e0\u00e2\u00e0\u00ed\u00fc \u00e7\u00e0\u00f5\u00ee\u00e4\u00e8\u00eb\u00e8 \u00ea\u00ee\u00f0\u00e0\u00e1\u00eb\u00e8... : \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 \u00ee \u00ef\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e9 \u00ef\u00f0\u00e8\u00f1\u00f2\u00e0\u00ed\u00e8 \u00e8 \u00ed\u00e5 \u00f2\u00ee\u00eb\u00fc\u00ea\u00ee \u00ee \u00ed\u00e5\u00e9 / \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : [\u00e1. \u00e8.], 2011. : \u00d2\u00e8\u00ef\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \"\u00d6\u00e8\u00f4\u00f0\u00e0\". - 44 \u00f1. \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2, \u0412. \u00cf\u00ee\u00eb\u00f7\u00e0\u00f1\u00e0 \u00ed\u00e5\u00f1\u00ef\u00e5\u00f8\u00ed\u00fb\u00ec \u00f8\u00e0\u00e3\u00ee\u00ec, \u00e8\u00eb\u00e8 \u00cf\u00f0\u00ee\u00e3\u00f3\u00eb\u00ea\u00e0 \u00ef\u00ee \u00f1\u00f2\u00e0\u00f0\u00fb\u00ec \u00f3\u00eb\u00e8\u00f6\u00e0\u00ec \u00e3\u00ee\u00f0\u00ee\u00e4\u00e0 / \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u0412\u00e5\u00f0\u00f5\u00ee\u00e3\u00eb\u00ff\u00e4\u00ee\u00e2 [\u00d2\u00e5\u00ea\u00f1\u00f2] // \u00d1\u00e5\u00e2\u00e5\u00f0. - 2011. - N 9/10. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00d1\u00ee\u00eb\u00ee \u00e4\u00eb\u00ff \u00ee\u00e4\u00ed\u00ee\u00e3\u00ee \u00cf\u00ee\u00eb\u00f7\u00e0\u00f1\u00e0 \u00ed\u00e5\u00f1\u00ef\u00e5\u00f8\u00ed\u00fb\u00ec \u00f8\u00e0\u00e3\u00ee\u00ec \u00ce\u00f7\u00e5\u00f0\u00ea \u00e8\u00e7 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e0. \u00cf\u00f0\u00ee\u00e3\u00f3\u00eb\u00ea\u00e0 \u00ef\u00ee \u00f1\u00f2\u00e0\u00f0\u00fb\u00ec \u00f3\u00eb\u00e8\u00f6\u00e0\u00ec. \u00ce\u00f4\u00ee\u00f0\u00ec\u00eb\u00e5\u00ed\u00e8\u00e5 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cf\u00f0\u00e8\u00e2\u00e5\u00f2 \u00e8\u00e7 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e0 \u00c8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ff \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e0 \u00e2 \u00ef\u00ee\u00f7\u00f2\u00ee\u00e2\u00fb\u00f5 \u00ee\u00f2\u00ea\u00f0\u00fb\u00f2\u00ea\u00e0\u00f5. \u00ce\u00f4\u00ee\u00f0\u00ec\u00eb\u00e5\u00ed\u00e8\u00e5 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d1\u00ea\u00ee\u00f0\u00e1\u00ed\u00fb\u00e9 \u00e1\u00f0\u00e0\u00f2 \u00d5\u00f0\u00e8\u00f1\u00f2\u00e0 \u00d1\u00ef\u00e0\u00f1\u00e8\u00f2\u00e5\u00eb\u00ff \u00ce\u00f7\u00e5\u00f0\u00ea \u00e8\u00e7 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e0. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e9 \u00ca\u00e0\u00f4\u00e5\u00e4\u00f0\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00f1\u00ee\u00e1\u00ee\u00f0. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e8\u00ea\u00e0 \u00ea\u00e0\u00ea \u00ea\u00e0\u00e7\u00f3\u00f1 \u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00f1\u00ea\u00e8\u00e5 \u00e1\u00e0\u00e9\u00ea\u00e8. \u00d1\u00ee\u00e0\u00e2\u00f2\u00ee\u00f0\u00fb \u00ef\u00ee\u00e2\u00e5\u00f1\u00f2\u00e2\u00ee\u00e2\u00e0\u00ed\u00e8\u00ff \u0096  \u00e0\u00e2\u00f2\u00ee\u00f0\u00fb, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00fb, \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00e8 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e8 \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e5 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 \u00d5\u00f3\u00e4\u00ee\u00e6\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee-\u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c2 \u00ee\u00f4\u00ee\u00f0\u00ec\u00eb\u00e5\u00ed\u00e8\u00e8 \u00ea\u00ed\u00e8\u00e3\u00e8 \u00e8\u00f1\u00ef\u00ee\u00eb\u00fc\u00e7\u00ee\u00e2\u00e0\u00ed\u00fb \u00f4\u00ee\u00f2\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00e8 \u00e8 \u00ee\u00f2\u00ea\u00f0\u00fb\u00f2\u00ea\u00e8, \u00ef\u00f0\u00e8\u00ed\u00e0\u00e4\u00eb\u00e5\u00e6\u00e0\u00f9\u00e8\u00e5 \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c1\u00ee\u00ec\u00e1\u00e0\u00f0\u00e4\u00e8\u00f0 \u00e8 \u00ef\u00f3\u00f8\u00ea\u00e8 \u00ce\u00f7\u00e5\u00f0\u00ea \u00e8\u00e7 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e0 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c2 \u00ed\u00e0\u00f8\u00f3 \u00e3\u00e0\u00e2\u00e0\u00ed\u00fc \u00e7\u00e0\u00f5\u00ee\u00e4\u00e8\u00eb\u00e8 \u00ea\u00ee\u00f0\u00e0\u00e1\u00eb\u00e8... \u00d0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 \u00ee \u00ef\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e9 \u00e3\u00ee\u00f0\u00ee\u00e4\u00f1\u00ea\u00ee\u00e9 \u00ef\u00f0\u00e8\u00f1\u00f2\u00e0\u00ed\u00e8 \u00e8 \u00ed\u00e5 \u00f2\u00ee\u00eb\u00fc\u00ea\u00ee \u00ee \u00ed\u00e5\u00e9. \u00ce\u00f4\u00ee\u00f0\u00ec\u00eb\u00e5\u00ed\u00e8\u00e5 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

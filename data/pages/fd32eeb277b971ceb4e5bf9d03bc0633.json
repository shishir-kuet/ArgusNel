  "url": "http://ar.wikibooks.org/wiki/%D8%AE%D8%A7%D8%B5:%D9%85%D8%B3%D8%A7%D9%87%D9%85%D8%A7%D8%AA/%D8%A5%D8%B3%D9%84%D8%A7%D9%85_%D8%AD%D9%85%D8%AF%D8%A7%D9%86",
  "title": "\u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u0633\u0644\u0627\u0645 \u062d\u0645\u062f\u0627\u0646 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u0633\u0644\u0627\u0645 \u062d\u0645\u062f\u0627\u0646 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0646\u062a\u0627\u0626\u062c \u0644\u0640 \u0625\u0633\u0644\u0627\u0645 \u062d\u0645\u062f\u0627\u0646 \u0646\u0642\u0627\u0634 \u0633\u062c\u0644 \u0627\u0644\u0645\u0646\u0639 \u0645\u0631\u0641\u0648\u0639\u0627\u062a \u0633\u062c\u0644\u0627\u062a \u0633\u062c\u0644 \u0627\u0644\u0645\u0646\u0639 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u062d\u0633\u0627\u0628 \u0639\u0627\u0644\u0645\u064a \u0633\u062c\u0644 \u0627\u0644\u0625\u0633\u0627\u0621\u0629 \u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0647 \u0641\u064a \u0633\u062c\u0644\u0647 11 \u062a\u0639\u062f\u064a\u0644\u064b\u0627. \u0623\u064f\u0646\u0634\u0650\u0626\u064e \u0627\u0644\u062d\u0633\u0627\u0628 \u0641\u064a 31 \u064a\u0648\u0644\u064a\u0648 2018. \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0645\u0646\u0648\u0639 \u062d\u0627\u0644\u064a\u0627.\n\u0622\u062e\u0631 \u0645\u062f\u062e\u0644\u0629 \u0641\u064a \u0633\u062c\u0644 \u0627\u0644\u0645\u0646\u0639 \u0627\u0644\u0646\u0634\u0637 \u0645\u0648\u0641\u0631\u0629 \u0628\u0627\u0644\u0623\u0633\u0641\u0644 \u0643\u0645\u0631\u062c\u0639: 19:19\u060c 31 \u064a\u0648\u0644\u064a\u0648 2018 \u0645\u0646\u0639 OmarWiki \u0646\u0642\u0627\u0634 \u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0625\u0633\u0644\u0627\u0645 \u062d\u0645\u062f\u0627\u0646 \u0646\u0642\u0627\u0634 \u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0644\u0641\u062a\u0631\u0629 \u0632\u0645\u0646\u064a\u0629 \u0645\u062f\u062a\u0647\u0627 \u062f\u0627\u0626\u0645 (\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0645\u0645\u0646\u0648\u0639\u060c \u0627\u0644\u0645\u0646\u0639 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0645\u0639\u0637\u0644\u060c \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0645\u0645\u0646\u0648\u0639\u060c \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0639\u062f\u064a\u0644 \u0635\u0641\u062d\u0629 \u0627\u0644\u0646\u0642\u0627\u0634 \u0627\u0644\u062e\u0627\u0635\u0629) (\u062d\u0633\u0627\u0628 \u0644\u0644\u062a\u062e\u0631\u064a\u0628) \u0647\u0630\u0627 \u0627\u0644\u062d\u0633\u0627\u0628 \u0645\u0642\u0641\u0644 \u0639\u0627\u0644\u0645\u064a\u0627.\n\u0627\u0646\u0638\u0631 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a. \u0628\u062d\u062b \u0639\u0646 \u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0625\u0638\u0647\u0627\u0631 \u0625\u062e\u0641\u0627\u0621 \u29fccontribs-top\u29fd \u0639\u0646\u0648\u0627\u0646 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u0625\u0646\u062a\u0631\u0646\u062a \u0623\u0648 \u0627\u0633\u0645 \u0645\u0633\u062a\u062e\u062f\u0645: \u0627\u0644\u0646\u0637\u0627\u0642: \u0627\u0644\u0643\u0644 (\u0631\u0626\u064a\u0633\u064a) \u0646\u0642\u0627\u0634 \u0645\u0633\u062a\u062e\u062f\u0645 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u064a\u0643\u064a \u0643\u062a\u0628 \u0646\u0642\u0627\u0634 \u0648\u064a\u0643\u064a \u0643\u062a\u0628 \u0645\u0644\u0641 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0644\u0641 \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a \u0646\u0642\u0627\u0634 \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a \u0642\u0627\u0644\u0628 \u0646\u0642\u0627\u0634 \u0627\u0644\u0642\u0627\u0644\u0628 \u0645\u0633\u0627\u0639\u062f\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u062a\u0635\u0646\u064a\u0641 \u0646\u0642\u0627\u0634 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 TimedText TimedText talk \u0648\u062d\u062f\u0629 \u0646\u0642\u0627\u0634 \u0627\u0644\u0648\u062d\u062f\u0629 \u0627\u0639\u0643\u0633 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0642\u062a\u0631\u0646 \u0645\u0631\u0634\u062d \u0627\u0644\u0648\u0633\u0648\u0645 : discussiontools (\u0639\u0644\u0627\u0645\u0629 \u0645\u062e\u0641\u064a\u0629) discussiontools-added-comment (\u0639\u0644\u0627\u0645\u0629 \u0645\u062e\u0641\u064a\u0629) discussiontools-source (\u0639\u0644\u0627\u0645\u0629 \u0645\u062e\u0641\u064a\u0629) discussiontools-source-enhanced (\u0639\u0644\u0627\u0645\u0629 \u0645\u062e\u0641\u064a\u0629) discussiontools-visual (\u0639\u0644\u0627\u0645\u0629 \u0645\u062e\u0641\u064a\u0629) meta spam id PAWS [2.1] SWViewer [1.2] SWViewer [1.3] SWViewer [1.4] SWViewer [1.6] wikieditor (\u0639\u0644\u0627\u0645\u0629 \u0645\u062e\u0641\u064a\u0629) \u0623\u0632\u0627\u0644 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u0629 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0625\u0641\u0631\u0627\u063a \u0625\u064a\u0645\u0648\u062c\u064a \u0627\u0633\u062a\u0628\u062f\u0644 \u0627\u0633\u062a\u0631\u062c\u0627\u0639 \u0627\u0644\u0645\u062d\u0631\u0631 \u0627\u0644\u0645\u0631\u0626\u064a: \u062a\u0628\u062f\u064a\u0644 \u062a\u062d\u0631\u064a\u0631 \u0645\u0631\u0626\u064a \u062a\u062d\u0631\u064a\u0631 \u0645\u0646 \u0627\u0644\u0645\u062d\u0645\u0648\u0644 \u062a\u062d\u0648\u064a\u0644\u0629 \u062c\u062f\u064a\u062f\u0629 \u062a\u0631\u0627\u062c\u0639 \u064a\u062f\u0648\u064a \u062a\u0633\u0644\u064a\u0645 \u0631\u0633\u0627\u0626\u0644 \u0643\u0645\u064a\u0629 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u062d\u0645\u0648\u0644 \u0627\u0644\u0645\u062a\u0642\u062f\u0645 \u062a\u0639\u062f\u064a\u0644 \u0628\u062a\u0637\u0628\u064a\u0642 \u0623\u0646\u062f\u0631\u0648\u064a\u062f \u062a\u0639\u062f\u064a\u0644 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u062d\u0645\u0648\u0644\u0629 \u062a\u0639\u062f\u064a\u0644 \u0645\u0635\u062f\u0631 2017 \u062a\u0639\u062f\u064a\u0644 \u0648\u064a\u0628 \u0645\u062d\u0645\u0648\u0644 \u062a\u0645 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0628\u0648\u0627\u0633\u0637\u0629 \u0645\u0633\u062a\u0648\u0631\u062f \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u062a\u0645\u062a \u0625\u0639\u0627\u062f\u0629 \u0625\u0646\u0634\u0627\u0626\u0647\u0627 \u062d\u0630\u0641 \u0643\u0645\u064a \u0631\u062c\u0648\u0639 \u0631\u062f\u0651 \u063a\u064f\u064a\u064e\u0651\u0631 \u0647\u062f\u0641 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u0629 \u0645\u0633\u062a\u0631\u062c\u0639 \u0645\u0648\u0636\u0648\u0639 \u062c\u062f\u064a\u062f \u0627\u0639\u0643\u0633 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u0638\u0647\u0631 \u0627\u0644\u0646\u0633\u062e \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0641\u0642\u0637 \u0623\u0638\u0647\u0631 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0641\u0642\u0637 \u0623\u062e\u0641 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0637\u0641\u064a\u0641\u0629 \u29fccontribs-date\u29fd \u0645\u0646 \u062a\u0627\u0631\u064a\u062e: \u062d\u062a\u0649 \u062a\u0627\u0631\u064a\u062e: \u0628\u062d\u062b 31 \u064a\u0648\u0644\u064a\u0648 2018 17:11 17:11\u060c 31 \u064a\u0648\u0644\u064a\u0648 2018 \u0641\u0631\u0642 \u062a\u0627\u0631\u064a\u062e +2 \u0637 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0645\u0633\u0627\u0639\u062f\u0629 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u062c\u062f\u062f \u0644\u0627 \u0645\u0644\u062e\u0635 \u062a\u0639\u062f\u064a\u0644 17:10 17:10\u060c 31 \u064a\u0648\u0644\u064a\u0648 2018 \u0641\u0631\u0642 \u062a\u0627\u0631\u064a\u062e \u221226 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0645\u0633\u0627\u0639\u062f\u0629 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u062c\u062f\u062f \u0644\u0627 \u0645\u0644\u062e\u0635 \u062a\u0639\u062f\u064a\u0644 16:57 16:57\u060c 31 \u064a\u0648\u0644\u064a\u0648 2018 \u0641\u0631\u0642 \u062a\u0627\u0631\u064a\u062e +951 \u0637 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0645\u0633\u0627\u0639\u062f\u0629 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u062c\u062f\u062f \u0644\u0627 \u0645\u0644\u062e\u0635 \u062a\u0639\u062f\u064a\u0644 \u0625\u0633\u0644\u0627\u0645 \u062d\u0645\u062f\u0627\u0646 : \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0641\u0631\u0639\u064a\u0629 \u00b7 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u00b7 \u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0633\u0627\u0647\u0645\u0627\u062a \u00b7 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0631\u0641\u0648\u0639\u0629 \u00b7 \u062d\u0633\u0627\u0628\u0627\u062a \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u0645\u0648\u062d\u062f \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/wiki/\u062e\u0627\u0635:\u0645\u0633\u0627\u0647\u0645\u0627\u062a/\u0625\u0633\u0644\u0627\u0645_\u062d\u0645\u062f\u0627\u0646 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0645\u0633\u0627\u0647\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0625\u0633\u0644\u0627\u0645 \u062d\u0645\u062f\u0627\u0646 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

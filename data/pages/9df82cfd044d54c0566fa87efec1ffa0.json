  "url": "http://ar.wikibooks.org/wiki/%D9%82%D8%A7%D9%84%D8%A8:%D9%81%D9%87%D8%B1%D8%B3/%D8%AA%D8%B5%D9%81%D8%AD",
  "title": "\u0642\u0627\u0644\u0628:\u0641\u0647\u0631\u0633/\u062a\u0635\u0641\u062d - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0642\u0627\u0644\u0628:\u0641\u0647\u0631\u0633/\u062a\u0635\u0641\u062d - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0628\u062d\u062b \u0648\u062a\u0635\u0641\u062d \u0645\u0642\u062f\u0645\u0629 \u0628\u062d\u062b \u062a\u0635\u0641\u062d \u0627\u0644\u0645\u062d\u062a\u0648\u064a\u0627\u062a \u0645\u062d\u062a\u0648\u064a\u0627\u062a \u0627\u0633\u062a\u0639\u0631\u0627\u0636 \u0642\u0648\u0627\u0626\u0645 \u0642\u0648\u0627\u0626\u0645 \u0645\u0648\u0627\u0636\u064a\u0639 \u0642\u0648\u0627\u0626\u0645 \u0645\u0631\u062c\u0639\u064a\u0629 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0627\u0644\u0645\u0648\u0627\u0636\u064a\u0639 \u0628\u0648\u0627\u0628\u0627\u062a \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062d\u062a\u0648\u0649 \u0645\u062e\u062a\u0627\u0631 \u0645\u0634\u0627\u0631\u0643\u0629 \u0648\u062a\u062d\u0631\u064a\u0631 \u0633\u064a\u0627\u0633\u0627\u062a \u0648\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u062a\u0644\u0645\u064a\u062d\u0627\u062a \u0648\u0646\u0635\u0627\u0626\u062d \u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u0648\u0645\u0639\u0627\u064a\u064a\u0631\u0647\u0627 \u062d\u0642\u0648\u0642 \u0627\u0644\u0646\u0634\u0631 \u0645\u0642\u0627\u0644\u0627\u062a \u0645\u0642\u062a\u0631\u062d\u0629 \u0623\u0647\u0645\u064a\u0629 \u0648\u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u062f\u0644\u064a\u0644 \u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0645\u0642\u0627\u0644\u0627\u062a \u062f\u0644\u064a\u0644 \u0627\u0644\u0623\u0633\u0644\u0648\u0628 \u0645\u0634\u0627\u0631\u064a\u0639 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0648\u064a\u0643\u064a \u064a\u0648\u0645 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0645\u062c\u062a\u0645\u0639 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0639\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0645\u0624\u0633\u0633\u0629 \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0627\u0644\u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0634\u0642\u064a\u0642\u0629 \u062f\u0639\u0645 \u0627\u0644\u0645\u0648\u0642\u0639 \u0645\u0633\u0627\u0639\u062f\u0629 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 ( \u0645\u0633\u0627\u0639\u062f\u0629 ) \u062a\u0648\u0627\u0635\u0644 \u0645\u064a\u062f\u0627\u0646 \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0625\u062f\u0627\u0631\u064a\u0648\u0646 ( \u062a\u0635\u0648\u064a\u062a ) \u0645\u0634\u0627\u0631\u064a\u0639 \u0648\u064a\u0643\u064a \u0623\u0633\u0628\u0648\u0639 \u0627\u0644\u0648\u064a\u0643\u064a \u0646\u0642\u0627\u0634\u0627\u062a \u062c\u0627\u0631\u064a\u0629 \u0627\u0633\u0623\u0644 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0644\u0635\u0648\u0631 \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0641\u064a \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0631\u0648\u0627\u0628\u0637 \u0627\u0644\u0645\u0635\u0627\u062f\u0631 \u0648\u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0648\u0633\u0627\u0626\u0637 \u0627\u0644\u0645\u062a\u0639\u062f\u062f\u0629 \u0623\u0633\u0626\u0644\u0629 \u0645\u062a\u0643\u0631\u0631\u0629 \u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0645\u0628\u062a\u062f\u0626\u064a\u0646 \u062f\u0631\u0648\u0633 \u0644\u0644\u0645\u0628\u062a\u062f\u0626\u064a\u0646 \u0641\u0631\u064a\u0642 \u0627\u0644\u062e\u0628\u0631\u0627\u0621 \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0633\u0631\u064a\u0639\u0629 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0645\u062a\u0643\u0631\u0631\u0629 \u0623\u0639\u0636\u0627\u0621 \u0627\u0644\u0641\u0631\u064a\u0642 \u0633\u064a\u0627\u0633\u0627\u062a \u0648\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u062a\u0635\u0641\u062d \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0627\u0644\u062a\u0635\u0641\u062d \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u062a\u0642\u062f\u0645\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062a\u0642\u0646\u064a\u0629 \u0637\u0631\u062d \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0642\u0627\u0644\u0628:\u0641\u0647\u0631\u0633/\u062a\u0635\u0641\u062d&oldid=97375 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0642\u0648\u0627\u0644\u0628 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0642\u0648\u0627\u0644\u0628 \u0645\u062d\u0645\u064a\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u0642\u0627\u0644\u0628 : \u0641\u0647\u0631\u0633/\u062a\u0635\u0641\u062d \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

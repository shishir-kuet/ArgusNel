{
  "url": "http://ar.wikibooks.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D9%88%D9%8A%D9%83%D9%8A_%D8%A7%D9%84%D9%83%D8%AA%D8%A8",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0647\u0646\u0627\u0643 \u0645\u0644\u0641\u0627\u062a \u0639\u0646 Wikibooks \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 . \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u064a\u062d\u0648\u064a 70 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629\u060c \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a 70. * \u0628\u0630\u0631\u0629 ( 20 \u0635) \u0623 \u0623\u0646\u0645\u0627\u0637 \u0635\u0641\u062d\u0627\u062a \u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u0642\u0627\u0644\u0628 \u0628\u0623\u062e\u0637\u0627\u0621 (\u0641\u0627\u0631\u063a) \u0625 \u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 ( 4 \u0635) \u0627 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u0635\u0644\u0627\u062a ISBN \u0627\u0644\u0633\u062d\u0631\u064a\u0629 ( 3 \u0635) \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u0635\u0644\u0627\u062a PMID \u0627\u0644\u0633\u062d\u0631\u064a\u0629 ( 2 \u0635) \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u0635\u0644\u0627\u062a RFC \u0627\u0644\u0633\u062d\u0631\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0628\u0623\u062e\u0637\u0627\u0621 \u0639\u0631\u0636 \u0631\u064a\u0627\u0636\u064a\u0627\u062a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0628\u062d\u0644\u0642\u0627\u062a \u0642\u0627\u0644\u0628 (3 \u062a\u060c  7 \u0635) \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0628\u062e\u0635\u0627\u0626\u0635 \u063a\u064a\u0631 \u0645\u062d\u0644\u0648\u0644\u0629 (\u0641\u0627\u0631\u063a) \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0628\u0639\u0646\u0627\u0648\u064a\u0646 \u0639\u0631\u0636 \u062a\u0645 \u062a\u062c\u0627\u0647\u0644\u0647\u0627 ( 3 \u0635) \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 (1 \u062a\u060c  5 \u0635) \u0628 \u0628\u0648\u062a\u0627\u062a ( 45 \u0635) \u062a \u062a\u062c\u0627\u0648\u0632\u0627\u062a \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0645\u0643\u0644\u0641\u0629 (\u0641\u0627\u0631\u063a) \u062a\u062c\u0627\u0648\u0632\u0627\u062a \u062a\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f (\u0641\u0627\u0631\u063a) \u062a\u062c\u0627\u0648\u0632\u0627\u062a \u062d\u062c\u0645 \u0627\u0644\u062a\u0636\u0645\u064a\u0646 \u0628\u0639\u062f \u0627\u0644\u062a\u0648\u0633\u064a\u0639 (\u0641\u0627\u0631\u063a) \u062a\u062c\u0627\u0648\u0632\u0627\u062a \u0639\u0645\u0642 \u0627\u0644\u062a\u0648\u0633\u064a\u0639 (\u0641\u0627\u0631\u063a) \u062a\u062c\u0627\u0648\u0632\u0627\u062a \u0645\u0639\u0637\u064a\u0627\u062a \u0627\u0644\u0642\u0648\u0627\u0644\u0628 (\u0641\u0627\u0631\u063a) \u062a\u062d\u0648\u064a\u0644 \u0644\u0648\u064a\u0643\u064a \u0645\u0635\u062f\u0631 (\u0641\u0627\u0631\u063a) \u062a\u062d\u0648\u064a\u0644 \u0644\u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 ( 2 \u0635) \u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u062a\u0635\u0646\u064a\u0641\u0627\u062a (12 \u062a) \u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0645\u062a\u0635\u0644\u0629 \u0628\u0639\u0646\u0635\u0631 \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a ( 1 \u0635) \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629 (80 \u062a) \u0635 \u0635\u0641\u062d\u0627\u062a \u0628\u0623\u062e\u0637\u0627\u0621 \u0623\u0646\u0645\u0627\u0637 \u0627\u0644\u0642\u0627\u0644\u0628 ( 2 \u0635) \u0635\u0641\u062d\u0627\u062a \u0628\u0623\u062e\u0637\u0627\u0621 \u0641\u064a \u0627\u0644\u0645\u0631\u0627\u062c\u0639 ( 9 \u0635) \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0623\u062e\u0637\u0627\u0621 \u0631\u064a\u0627\u0636\u064a\u0627\u062a (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0623\u062e\u0637\u0627\u0621 \u0641\u064a \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0646\u0635\u064a ( 1 \u0635) \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0623\u062e\u0637\u0627\u0621 \u0641\u064a \u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u0635\u064a\u063a\u0629 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u062e\u0637\u0623 \u0641\u064a \u062a\u062d\u0648\u064a\u0644 \u0627\u0644\u062d\u0631\u0632 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0645\u062e\u0637\u0637\u0627\u062a (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0645\u062e\u0637\u0637\u0627\u062a Vega 1.0 \u0645\u0647\u0645\u0644\u0629 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0645\u062e\u0637\u0637\u0627\u062a \u0645\u0639\u0637\u0648\u0628\u0629 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u062a\u062d\u0648\u064a \u0648\u0635\u0644\u0627\u062a \u0645\u0644\u0641\u0627\u062a \u0645\u0639\u0637\u0648\u0628\u0629 ( 14 \u0635) \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u062e\u0637\u0627 \u0632\u0645\u0646\u064a\u0627 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u0633\u0648\u0645 HTML \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u0633\u0648\u0645 \u0623\u062a\u0634 \u062a\u064a \u0623\u0645 \u0623\u0644 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d\u0629 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0627\u0644\u0628\u0627 \u0628\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0643\u0631\u0631\u0629 ( 1 \u0635) \u0635\u0641\u062d\u0627\u062a \u063a\u064a\u0631 \u0645\u0641\u0647\u0631\u0633\u0629 ( 29 \u0635) \u0635\u0641\u062d\u0627\u062a \u0644\u0644\u062a\u0642\u0633\u064a\u0645 ( 2 \u0635) \u0635\u0641\u062d\u0627\u062a \u0645\u0639 \u0627\u0644\u062e\u0631\u0627\u0626\u0637 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u0645\u0639 \u062e\u0631\u0627\u0626\u0637 \u0645\u0639\u0637\u0648\u0628\u0629 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u0645\u0641\u0647\u0631\u0633\u0629 ( 1 \u0635) \u0635\u0641\u062d\u0627\u062a \u0645\u0641\u064a\u062f\u0629 \u0628\u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 ( 1 \u0635) \u0635\u0648\u0631 (8 \u062a) \u0635\u064a\u0627\u0646\u0629 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 (7 \u062a\u060c  2 \u0635) \u0641 \u0641\u0635\u0648\u0644 \u063a\u064a\u0631 \u0645\u0635\u0646\u0641\u0629 ( 193 \u0635) \u0642 \u0642\u0648\u0627\u0626\u0645 \u0628\u0639\u062b \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0643\u0645\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0642\u0648\u0627\u0644\u0628 \u0625\u062f\u0627\u0631\u064a\u0629 \u0644\u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 ( 1 \u0635) \u0643 \u0643\u062a\u0628 (2 \u062a\u060c  21 \u0635) \u0643\u062a\u0628 \u0628\u062d\u0627\u062c\u0629 \u0644\u062a\u0631\u062c\u0645\u0629 (1 \u062a\u060c  5 \u0635) \u0643\u062a\u0628 \u0628\u062d\u0627\u062c\u0629 \u0644\u062a\u0646\u0633\u064a\u0642 ( 32 \u0635) \u0643\u062a\u0628 \u0628\u062d\u0627\u062c\u0629 \u0644\u0644\u062a\u0635\u062d\u064a\u062d \u0627\u0644\u0644\u063a\u0648\u064a ( 1 \u0635) \u0643\u062a\u0628 \u0628\u062d\u0627\u062c\u0629 \u0644\u0644\u0645\u0631\u0627\u062c\u0639\u0629 ( 67 \u0635) \u0643\u062a\u0628 \u0628\u0646\u0633\u062e PDF \u0644\u0644\u062a\u062d\u0645\u064a\u0644 ( 3 \u0635) \u0643\u062a\u0628 \u0630\u0627\u062a \u0645\u0636\u0645\u0648\u0646 \u063a\u0627\u0645\u0636 (\u0641\u0627\u0631\u063a) \u0643\u062a\u0628 \u0641\u064a \u0637\u0648\u0631 \u0627\u0644\u0625\u0646\u062c\u0627\u0632 (1 \u062a\u060c  3 \u0635) \u0643\u062a\u0628 \u0644\u0644\u062f\u0645\u062c ( 1 \u0635) \u0645 \u0645\u0633\u0627\u0639\u062f\u0629 (1 \u062a\u060c  15 \u0635) \u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u064a\u0643\u064a \u0643\u062a\u0628 (3 \u062a) \u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 (1 \u062a) \u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u062d\u0633\u0628 \u0627\u0644\u0644\u063a\u0629 (\u0641\u0627\u0631\u063a) \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629 (1 \u062a) \u0645\u0642\u0627\u0644\u0627\u062a \u062a\u062d\u062a\u0627\u062c \u0644\u0639\u0645\u0644 \u0625\u062f\u0627\u0631\u064a (3 \u062a) \u0645\u0643\u062a\u0628\u0627\u062a (1 \u062a\u060c  26 \u0635) \u0645\u0644\u0641\u0627\u062a \u0628\u0644\u0627 \u0627\u0633\u0645 \u0645\u0624\u0644\u0641 \u0642\u0627\u0628\u0644 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0622\u0644\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0645\u0644\u0641\u0627\u062a \u0628\u0644\u0627 \u0628\u0631\u0627\u0621\u0629 \u0627\u062e\u062a\u0631\u0627\u0639 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0622\u0644\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0645\u0644\u0641\u0627\u062a \u0628\u0644\u0627 \u0631\u062e\u0635\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0622\u0644\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0645\u0644\u0641\u0627\u062a \u0628\u0644\u0627 \u0645\u0635\u062f\u0631 \u0642\u0627\u0628\u0644 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0622\u0644\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0645\u0644\u0641\u0627\u062a \u0628\u0644\u0627 \u0648\u0635\u0641 \u0642\u0627\u0628\u0644 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0622\u0644\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0645\u064a\u062f\u0627\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 ( 1 \u0635) \u0648 \u0648\u062d\u062f\u0627\u062a \u0628\u0647\u0627 \u0623\u062e\u0637\u0627\u0621 (\u0641\u0627\u0631\u063a) \u0635\u0641\u062d\u0627\u062a \u062a\u0635\u0646\u064a\u0641 \u00ab\u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628\u00bb \u064a\u062d\u0648\u064a \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0648\u0639\u062f\u062f\u0647\u0627 32 \u0645\u0646 \u0623\u0635\u0644 32 \u0625\u062c\u0645\u0627\u0644\u0627\u064b. \u0645\u0633\u062a\u062e\u062f\u0645:FShbib/\u0645\u0644\u0639\u0628 \u0645\u0633\u062a\u062e\u062f\u0645:MrJoker07/\u0645\u0644\u0639\u0628 \u0627\u0644\u0635\u0641\u062d\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0623 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0623\u0642\u0633\u0627\u0645 \u062e\u0627\u0635\u0629 \u0625 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0625\u062e\u0644\u0627\u0621 \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0639\u0627\u0645 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0625\u062f\u0627\u0631\u064a\u0648 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627 \u0645\u0633\u0627\u0639\u062f\u0629:\u0627\u0644\u0628\u062d\u062b \u0645\u0633\u0627\u0639\u062f\u0629:\u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0634\u062e\u0635\u064a \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0648\u0627\u0644\u0645\u0648\u0636\u0648\u0639\u064a\u0629 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0627\u0644\u0645\u064a\u062f\u0627\u0646/\u0623\u0631\u0634\u064a\u0641 1 \u0628 \u0648\u064a\u0643\u064a \u0643\u062a\u0628:\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u062a \u0645\u0633\u06
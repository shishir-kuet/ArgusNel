  "title": "\u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629 \u0645\u0633\u062a\u0648\u0649 \u0645\u0628\u062a\u062f\u0626 A1 \u0625\u0644\u0649 A2 \u0644\u0644\u0645\u062a\u0639\u0644\u0645\u064a\u0646 \u0639\u0631\u0628 \u0628\u0644\u0627 \u062e\u0644\u0641\u064a\u0629 \u0633\u0627\u0628\u0642\u0629 \u0627\u0644\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0645\u0639\u0631\u0641\u0629 \u0627\u0633\u0627\u0633\u064a\u0627\u062a \u0627\u0644\u062d\u0631\u0648\u0641 \u0627\u0644\u0627\u0633\u0628\u0627\u0646\u064a\u0629 \u0645\u062e\u0631\u062c\u0627\u062a \u062a\u062d\u064a\u0627\u062a\u060c \u0646\u0637\u0642 \u0635\u062d\u064a\u062d\u060c \u0627\u0631\u0642\u0627\u0645 \u0648\u062a\u0648\u0627\u0631\u064a\u062e\u060c \u062c\u0645\u0644 \u064a\u0648\u0645\u064a\u0629\u060c \u0627\u0633\u0627\u0633\u064a\u0627\u062a \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u062d\u0627\u0644\u0629 \u0642\u064a\u062f \u0627\u0644\u062a\u0637\u0648\u064a\u0631 \u0627\u0635\u062f\u0627\u0631 0.1 \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629 \u0644\u063a\u0629 \u0631\u0648\u0645\u0627\u0646\u0633\u064a\u0629 \u064a\u062a\u062d\u062f\u062b \u0628\u0647\u0627 \u0623\u0643\u062b\u0631 \u0645\u0646 \u0627\u0631\u0628\u0639 \u0645\u0626\u0629 \u0645\u0644\u064a\u0648\u0646. \u0647\u0630\u0627 \u0627\u0644\u0643\u062a\u0627\u0628 \u0645\u0642\u0631\u0631 \u062a\u0645\u0647\u064a\u062f\u064a \u0639\u0645\u0644\u064a \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0627\u0644\u0646\u0637\u0642 \u0627\u0644\u0633\u0644\u064a\u0645\u060c \u0627\u0644\u0639\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u0627\u0633\u0627\u0633\u064a\u0629\u060c \u0648\u0627\u0644\u0627\u0633\u0627\u0633\u064a\u0627\u062a \u0627\u0644\u0642\u0648\u0627\u0639\u062f\u064a\u0629. \u0627\u0644\u0641\u0647\u0631\u0633 \u0627\u0644\u0643\u0627\u0645\u0644 \u062f\u0644\u064a\u0644 \u0627\u0644\u0645\u0639\u0644\u0645 \u0645\u0639\u062c\u0645 \u0627\u0644\u0645\u0635\u0637\u0644\u062d\u0627\u062a \u0627\u0635\u062f\u0627\u0631 PDF (\u064a\u064f\u0646\u0634\u0623 \u0644\u0627\u062d\u0642\u064b\u0627) \u0647\u0646\u0627\u0643 \u0645\u0644\u0641\u0627\u062a \u0639\u0646 Spanish language \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 . \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629&oldid=222852 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0645\u0643\u062a\u0628\u0629 \u0627\u0644\u0644\u063a\u0627\u062a \u0639\u0644\u0645 \u0627\u0644\u0644\u063a\u0627\u062a \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0625\u0633\u0628\u0627\u0646\u064a\u0629 28 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

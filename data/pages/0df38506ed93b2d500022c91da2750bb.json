  "url": "http://ar.wikiversity.org/wiki/%D8%A7%D9%84%D8%A7%D8%B4%D8%AA%D9%82%D8%A7%D9%82/%D9%85%D8%A8%D8%B1%D9%87%D9%86%D8%A9_%D8%B1%D9%88%D9%84_-_%D9%85%D8%A8%D8%B1%D9%87%D9%86%D8%A9_%D8%A7%D9%84%D8%AA%D8%B2%D8%A7%D9%8A%D8%AF%D8%A7%D8%AA_%D8%A7%D9%84%D9%85%D9%86%D8%AA%D9%87%D9%8A%D8%A9",
  "title": "\u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642/\u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 - \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642/\u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 - \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 < \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 - \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 [ \u0639\u062f\u0644 ] \u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 [ \u0639\u062f\u0644 ] \u0645\u0628\u0631\u0647\u0646\u0629 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0645\u062a\u0635\u0644\u0629 \u0639\u0644\u0649 \u0642\u0637\u0639\u0629 [ a , b ] {\\displaystyle [a,b]} \u0648\u0642\u0627\u0644\u0628\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0627\u0644 \u0627\u0644\u0645\u0641\u062a\u0648\u062d ] a , b [ {\\displaystyle ]a,b[} \u0648 f ( a ) = f ( b ) {\\displaystyle f(a)=f(b)} \u0641\u0625\u0646\u0647 \u064a\u0648\u062c\u062f \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0639\u0646\u0635\u0631 c {\\displaystyle c} \u0645\u0646 ] a , b [ {\\displaystyle ]a,b[} \u0628\u062d\u064a\u062b f \u2032 ( c ) = 0 {\\displaystyle f'(c)=0} \u0647\u0646\u062f\u0633\u064a\u0627\u060c \u0648\u062c\u0648\u062f \u0639\u0646\u0635\u0631 c {\\displaystyle c} \u0645\u0646 ] a , b [ {\\displaystyle ]a,b[} \u0628\u062d\u064a\u062b f \u2032 ( c ) = 0 {\\displaystyle f'(c)=0} \u064a\u0639\u0646\u064a \u0623\u0646 \u0645\u0646\u062d\u0646\u0649 \u0627\u0644\u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0639\u0644\u0649 [ a , b ] {\\displaystyle [a,b]} \u0644\u0647 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0645\u0645\u0627\u0633 \u0645\u0648\u0627\u0632 \u0644\u0645\u062d\u0648\u0631 \u0627\u0644\u0623\u0641\u0627\u0635\u064a\u0644. \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 [ \u0639\u062f\u0644 ] \u0645\u0628\u0631\u0647\u0646\u0629 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0645\u062a\u0635\u0644\u0629 \u0639\u0644\u0649 \u0642\u0637\u0639\u0629 [ a , b ] {\\displaystyle [a,b]} \u0648\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0627\u0644 \u0627\u0644\u0645\u0641\u062a\u0648\u062d ] a , b [ {\\displaystyle ]a,b[} \u0641\u0625\u0646\u0647 \u064a\u0648\u062c\u062f c {\\displaystyle c} \u0645\u0646 ] a , b [ {\\displaystyle ]a,b[} \u0628\u062d\u064a\u062b\u00a0: f ( b ) \u2212 f ( a ) = ( b \u2212 a ) f \u2032 ( c ) {\\displaystyle f(b)-f(a)=(b-a)f'(c)} \u0647\u0646\u062f\u0633\u064a\u0627\u060c \u0648\u062c\u0648\u062f \u0639\u0646\u0635\u0631 c {\\displaystyle c} \u0645\u0646 ] a , b [ {\\displaystyle ]a,b[} \u0628\u062d\u064a\u062b f \u2032 ( c ) = f ( b ) \u2212 f ( a ) b \u2212 a {\\displaystyle f'(c)={\\frac {f(b)-f(a)}{b-a}}} \u064a\u0639\u0646\u064a \u0623\u0646 \u0644\u0645\u0646\u062d\u0646\u0649 \u0627\u0644\u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0645\u0645\u0627\u0633\u0627 \u0645\u0648\u0627\u0632\u064a\u0627 \u0644\u0644\u0645\u0633\u062a\u0642\u064a\u0645 \u0627\u0644\u0645\u0627\u0631 \u0645\u0646 \u0627\u0644\u0646\u0642\u0637\u062a\u064a\u0646 A ( a , f ( a ) ) {\\displaystyle A(a,f(a))} \u0648 B ( b , f ( b ) ) {\\displaystyle B(b,f(b))} \u0645\u062a\u0641\u0627\u0648\u062a\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 [ \u0639\u062f\u0644 ] \u062e\u0627\u0635\u064a\u0629 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0645\u062a\u0635\u0644\u0629 \u0639\u0644\u0649 \u0642\u0637\u0639\u0629 [ a , b ] {\\displaystyle [a,b]} \u0648\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0639\u0644\u0649 \u0627\u0644\u0645\u062c\u0627\u0644 \u0627\u0644\u0645\u0641\u062a\u0648\u062d ] a , b [ {\\displaystyle ]a,b[} \u060c \u0648\u0625\u0630\u0627 \u0648\u064f\u062c\u0650\u062f\u064e \u0639\u062f\u062f\u0627\u0646 \u062d\u0642\u064a\u0642\u064a\u0627\u0646 \u03b1 {\\displaystyle \\alpha } \u0648 \u03b2 {\\displaystyle \\beta } \u0628\u062d\u064a\u062b \u03b1 \u2264 f \u2032 ( x ) \u2264 \u03b2 {\\displaystyle \\alpha \\leq f'(x)\\leq \\beta } \u0644\u0643\u0644 x {\\displaystyle x} \u0645\u0646 ] a , b [ {\\displaystyle ]a,b[} \u0641\u0625\u0646\u00a0: \u03b1 ( a \u2212 b ) \u2264 f ( b ) \u2212 f ( a ) \u2264 \u03b2 ( b \u2212 a ) {\\displaystyle \\alpha (a-b)\\leq f(b)-f(a)\\leq \\beta (b-a)} \u0644\u0627\u0632\u0645\u0629 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u062f\u0627\u0644\u0629 f {\\displaystyle f} \u0645\u062a\u0635\u0644\u0629 \u0639\u0644\u0649 [ a , b ] {\\displaystyle [a,b]} \u0648\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0639\u0644\u0649 ] a , b [ {\\displaystyle ]a,b[} \u060c \u0648\u0625\u0630\u0627 \u0648\u064f\u062c\u0650\u062f\u064e \u0639\u062f\u062f \u062d\u0642\u064a\u0642\u064a \u0645\u0648\u062c\u0628 k {\\displaystyle k} \u0628\u062d\u064a\u062b\u00a0: ( \u2200 t \u2208 ] a , b [ ) | f \u2032 ( t ) | \u2264 k {\\displaystyle (\\forall t\\in ]a,b[)\\quad |f'(t)|\\leq k} \u0641\u0625\u0646\u0647 \u0644\u0643\u0644 x {\\displaystyle x} \u0648 y {\\displaystyle y} \u0645\u0646 ] a , b [ {\\displaystyle ]a,b[} : | f ( x ) \u2212 f ( y ) | \u2264 k | x \u2212 y | {\\displaystyle |f(x)-f(y)|\\leq k|x-y|} \u0647\u0646\u0627\u0643 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 \u062d\u0648\u0644: \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642/\u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 - \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0645\u0634\u062a\u0642\u0629 \u062f\u0627\u0644\u0629 \u0627\u0644\u062c\u0630\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0631\u062a\u0627\u0628\u0629 \u062f\u0627\u0644\u0629 \u0639\u062f\u062f\u064a\u0629 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642/\u0645\u0628\u0631\u0647\u0646\u0629_\u0631\u0648\u0644_-_\u0645\u0628\u0631\u0647\u0646\u0629_\u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a_\u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629&oldid=73148 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u062a\u062d\u0644\u064a\u0644 \u0631\u064a\u0627\u0636\u064a \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642/\u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 - \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

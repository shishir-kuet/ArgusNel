  "title": "\u062a\u0635\u0646\u064a\u0641:\u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0627\u0644\u0628\u0627 \u0628\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0643\u0631\u0631\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0627\u0644\u0628\u0627 \u0628\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0643\u0631\u0631\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0647\u0646\u0627\u0643 \u0645\u0644\u0641\u0627\u062a \u0639\u0646 Pages using duplicate arguments in template calls \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 . \u0635\u0641\u062d\u0627\u062a \u062a\u0635\u0646\u064a\u0641 \u00ab\u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0627\u0644\u0628\u0627 \u0628\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u0643\u0631\u0631\u0629\u00bb \u064a\u062d\u0648\u064a \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 \u0648\u0639\u062f\u062f\u0647\u0627 1 \u0645\u0646 \u0623\u0635\u0644 1 \u0625\u062c\u0645\u0627\u0644\u0627\u064b. \u0639 \u0639\u0644\u0645 \u0627\u0644\u0641\u0644\u0643/\u062f\u0631\u0628 \u0627\u0644\u062a\u0628\u0627\u0646\u0629 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0635\u0641\u062d\u0627\u062a_\u062a\u0633\u062a\u0639\u0645\u0644_\u0642\u0627\u0644\u0628\u0627_\u0628\u0628\u064a\u0627\u0646\u0627\u062a_\u0645\u0643\u0631\u0631\u0629&oldid=96397 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0635\u0646\u064a\u0641 : \u0635\u
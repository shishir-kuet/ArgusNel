  "url": "http://ar.wikibooks.org/wiki/%D8%A5%D8%AD%D8%B5%D8%A7%D8%A1/%D8%A7%D9%84%D9%85%D8%AA%D9%88%D8%B3%D8%B7%D8%A7%D8%AA/%D8%A7%D9%84%D8%B9%D9%84%D8%A7%D9%82%D8%A9_%D8%A8%D9%8A%D9%86_%D8%A7%D9%84%D9%85%D8%AA%D9%88%D8%B3%D8%B7_%D8%A7%D9%84%D8%AD%D8%B3%D8%A7%D8%A8%D9%8A_%D9%88%D8%A7%D9%84%D9%87%D9%86%D8%AF%D8%B3%D9%8A_%D9%88%D8%A7%D9%84%D8%AA%D9%88%D8%A7%D9%81%D9%82%D9%8A",
  "title": "\u0625\u062d\u0635\u0627\u0621/\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a/\u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062d\u0633\u0627\u0628\u064a \u0648\u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0648\u0627\u0644\u062a\u0648\u0627\u0641\u0642\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0625\u062d\u0635\u0627\u0621/\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a/\u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062d\u0633\u0627\u0628\u064a \u0648\u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0648\u0627\u0644\u062a\u0648\u0627\u0641\u0642\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 < \u0625\u062d\u0635\u0627\u0621 | \u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a [ \u0639\u062f\u0644 ] \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a\u060c \u062a\u0648\u062c\u062f \u0639\u062f\u0629 \u0623\u0646\u0648\u0627\u0639 \u0645\u0646 \u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0648\u0635\u0641 \u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0623\u0639\u062f\u0627\u062f\u060c \u0648\u0645\u0646 \u0623\u0634\u0647\u0631\u0647\u0627: \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062d\u0633\u0627\u0628\u064a (Arithmetic Mean) \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u0647\u0646\u062f\u0633\u064a (Geometric Mean) \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062a\u0648\u0627\u0641\u0642\u064a (Harmonic Mean) \u0647\u0630\u0647 \u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a \u062a\u062e\u062a\u0644\u0641 \u0641\u064a \u0637\u0631\u064a\u0642\u0629 \u062d\u0633\u0627\u0628\u0647\u0627 \u0648\u062a\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u0633\u064a\u0627\u0642\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629. \u0627\u0644\u062a\u0639\u0631\u064a\u0641\u0627\u062a [ \u0639\u062f\u0644 ] \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062d\u0633\u0627\u0628\u064a \u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0648\u062c\u0628\u0629 \ue001x_1, x_2, \\ldots, x_n\ue001 \u064a\u064f\u062d\u0633\u0628 \u0643\u0627\u0644\u062a\u0627\u0644\u064a: A = 1 n \u2211 i = 1 n x i {\\displaystyle A={\\frac {1}{n}}\\sum _{i=1}^{n}x_{i}} \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u064a\u064f\u062d\u0633\u0628 \u0643\u0627\u0644\u062a\u0627\u0644\u064a: G = ( \u220f i = 1 n x i ) 1 n {\\displaystyle G=\\left(\\prod _{i=1}^{n}x_{i}\\right)^{\\frac {1}{n}}} \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062a\u0648\u0627\u0641\u0642\u064a \u064a\u064f\u062d\u0633\u0628 \u0643\u0627\u0644\u062a\u0627\u0644\u064a: H = n \u2211 i = 1 n 1 x i {\\displaystyle H={\\frac {n}{\\sum _{i=1}^{n}{\\frac {1}{x_{i}}}}}} \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a [ \u0639\u062f\u0644 ] \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u062c\u0645\u064a\u0639 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0645\u0648\u062c\u0628\u0629\u060c \u0641\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a \u062a\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629: H \u2264 G \u2264 A {\\displaystyle H\\leq G\\leq A} \u0634\u0631\u062d \u0627\u0644\u0639\u0644\u0627\u0642\u0629 [ \u0639\u062f\u0644 ] - \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062d\u0633\u0627\u0628\u064a \u064a\u0639\u0637\u064a \u0648\u0632\u0646\u064b\u0627 \u0623\u0643\u0628\u0631 \u0644\u0644\u0642\u064a\u0645 \u0627\u0644\u0623\u0643\u0628\u0631.\n- \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0645\u0646\u0627\u0633\u0628 \u0644\u062d\u0633\u0627\u0628 \u0645\u062a\u0648\u0633\u0637\u0627\u062a \u0627\u0644\u0646\u0645\u0648.\n- \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062a\u0648\u0627\u0641\u0642\u064a \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0641\u064a \u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u0639\u062f\u0644\u0627\u062a \u0645\u062b\u0644 \u0627\u0644\u0633\u0631\u0639\u0629. \u0627\u0644\u0645\u0631\u0627\u062c\u0639 [ \u0639\u062f\u0644 ] \u0645\u062a\u0648\u0633\u0637\u0627\u062a - \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0625\u062d\u0635\u0627\u0621/\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a/\u0627\u0644\u0639\u0644\u0627\u0642\u0629_\u0628\u064a\u0646_\u0627\u0644\u0645\u062a\u0648\u0633\u0637_\u0627\u0644\u062d\u0633\u0627\u0628\u064a_\u0648\u0627\u0644\u0647\u0646\u062f\u0633\u064a_\u0648\u0627\u0644\u062a\u0648\u0627\u0641\u0642\u064a&oldid=221838 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0625\u062d\u0635\u0627\u0621/\u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0627\u062a/\u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0633\u0637 \u0627\u0644\u062d\u0633\u0627\u0628\u064a \u0648\u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0648\u0627\u0644\u062a\u0648\u0627\u0641\u0642\u064a \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

{
  "url": "http://avtor.karelia.ru/about/kovlakova_olga.html",
  "title": "\u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0 \u00ce\u00eb\u00fc\u00e3\u00e0 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0 \u00ce\u00eb\u00fc\u00e3\u00e0 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0 \u00ce\u00eb\u00fc\u00e3\u00e0 \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00c2\u00ee\u00f0\u00ee\u00ed\u00e5\u00e6 \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00d2\u00e5\u00e0\u00f2\u00f0\u00ee\u00e2\u00e5\u00e4, \u00e4\u00f0\u00e0\u00ec\u00e0\u00f2\u00f3\u00f0\u00e3, \u00e0\u00e2\u00f2\u00ee\u00f0 \u00ef\u00ee\u00e4\u00ea\u00e0\u00f1\u00f2\u00ee\u00e2, YouTube-\u00ea\u00e0\u00ed\u00e0\u00eb\u00e0, \u00e0\u00f3\u00e4\u00e8\u00ee\u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00e5\u00e9 \u00e8 \u00e0\u00f3\u00e4\u00e8\u00ee\u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00e5\u00e9-\u00ef\u00f0\u00ee\u00ec\u00e5\u00ed\u00e0\u00e4\u00ee\u00e2. \u00d7\u00eb\u00e5\u00ed \u00d1\u00ee\u00fe\u00e7\u00e0 \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00fb\u00f5 \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00e5\u00e9 \u00f1 2021 \u00e3\u00ee\u00e4\u00e0. \u00ce\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb\u00e0 \u00d1\u00e0\u00ed\u00ea\u00f2-\u00cf\u00e5\u00f2\u00e5\u00f0\u00e1\u00f3\u00f0\u00e3\u00f1\u00ea\u00e8\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2 \u00f2\u00e5\u00eb\u00e5\u00ea\u00ee\u00ec\u00ec\u00f3\u00ed\u00e8\u00ea\u00e0\u00f6\u00e8\u00e9 \u00e8\u00ec. \u00c1\u00ee\u00ed\u00f7-\u00c1\u00f0\u00f3\u00e5\u00e2\u00e8\u00f7\u00e0 \u00e8\u00a0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e9\u00f1\u00ea\u00e8\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00e9 \u00e8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2 \u00f1\u00f6\u00e5\u00ed\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00f5 \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2 (\u00ab\u00d2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00ee\u00e5 \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00ee\u00bb). \u0412 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5 \u00ee\u00ed\u00e0 \u00ef\u00f0\u00ee\u00e6\u00e8\u00e2\u00e0\u00e5\u00f2 \u00f1 1989 \u00e3\u00ee\u00e4\u00e0. \u00d1\u00e2\u00ee\u00fe \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00ea\u00f3\u00fe \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00fc \u00ed\u00e0\u00e7\u00fb\u00e2\u00e0\u00e5\u00f2 \u00ab\u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00e8\u00e7\u00e0\u00f6\u00e8\u00e5\u00e9 \u00ef\u00e0\u00ec\u00ff\u00f2\u00e8\u00bb \u00e8\u00eb\u00e8 \u00ab\u00e2\u00ee\u00e7\u00e2\u00f0\u00e0\u00f9\u00e5\u00ed\u00e8\u00e5\u00ec \u00e3\u00ee\u00eb\u00ee\u00f1\u00e0 \u00ec\u00e5\u00f1\u00f2\u00f3\u00bb. \u00c5\u00e5 \u00e0\u00f3\u00e4\u00e8\u00ee\u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00e8-\u00ef\u00f0\u00ee\u00ec\u00e5\u00ed\u00e0\u00e4\u00fb, \u00ef\u00ee\u00e4\u00ea\u00e0\u00f1\u00f2\u00fb \u00e8 \u00e2\u00e8\u00e4\u00e5\u00ee\u00f1\u00fe\u00e6\u00e5\u00f2\u00fb \u00f1\u00e2\u00ff\u00e7\u00e0\u00ed\u00fb \u00f1 \u00f1\u00ee\u00f5\u00f0\u00e0\u00ed\u00e5\u00ed\u00e8\u00e5\u00ec \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00ed\u00ee\u00e3\u00ee \u00ed\u00e0\u00f1\u00eb\u00e5\u00e4\u00e8\u00ff \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00ea\u00f0\u00e0\u00ff, \u00f1 \u00ef\u00ee\u00e8\u00f1\u00ea\u00ee\u00ec \u00ed\u00ee\u00e2\u00ee\u00e3\u00ee \u00e2\u00e7\u00e3\u00eb\u00ff\u00e4\u00e0 \u00ed\u00e0 \u00e5\u00e3\u00ee \u00e8\u00e7\u00e2\u00e5\u00f1\u00f2\u00ed\u00fb\u00e5, \u00ec\u00e0\u00eb\u00ee\u00e8\u00e7\u00e2\u00e5\u00f1\u00f2\u00ed\u00fb\u00e5 \u00e8\u00eb\u00e8 \u00e7\u00e0\u00e1\u00fb\u00f2\u00fb\u00e5 \u00f1\u00f2\u00f0\u00e0\u00ed\u00e8\u00f6\u00fb. \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e8\u00e5 \u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0\u00f6\u00e8\u00e8 \u00ce\u00eb\u00fc\u00e3\u00e8 \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00ee\u00e9 \u00ed\u00e0\u00f7\u00e0\u00eb\u00e8 \u00ef\u00ee\u00ff\u00e2\u00eb\u00ff\u00f2\u00fc\u00f1\u00ff \u00f1 2016 \u00e3\u00ee\u00e4\u00e0 \u00e2 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff\u00f5: \u00ab\u00d2\u00e5\u00e0\u00f2\u00f0\u00bb, \u00ab\u00cf\u00e5\u00f2\u00e5\u00f0\u00e1\u00f3\u00f0\u00e3\u00f1\u00ea\u00e8\u00e9 \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00bb, \u00ab\u00dd\u00ea\u00f0\u00e0\u00ed \u00e8 \u00f1\u00f6\u00e5\u00ed\u00e0\u00bb, \u00ab\u0412\u00e0\u00f8 \u00e4\u00ee\u00f1\u00f3\u00e3\u00bb, \u00abAffiche Paris\u00bb, \u00ab\u00cf\u00e5\u00f2\u00e5\u00f0\u00e1\u00f3\u00f0\u00e3\u00f1\u00ea\u00e8\u00e9 \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00bb \u00e8\u00a0 \u00e4\u00f0\u00f3\u00e3\u00e8\u00f5. \u00c0\u00f3\u00e4\u00e8\u00ee\u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00fc-\u00ef\u00f0\u00ee\u00ec\u00e5\u00ed\u00e0\u00e4 \u00ab\u0412\u00f0\u00e5\u00ec\u00ff, \u00e2\u00ef\u00e5\u00f0\u00e5\u00e4?\u00bb \u00ed\u00e0\u00e3\u00f0\u00e0\u00e6\u00e4\u00e5\u00ed \u00e4\u00e8\u00ef\u00eb\u00ee\u00ec\u00ee\u00ec \u00d1\u00ee\u00fe\u00e7\u00e0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00ee\u00e2 \u00d0\u00ca (2020). \u00cf\u00ee\u00e4\u00ea\u00e0\u00f1\u00f2 \u00ab\u00cc\u00e0\u00f1\u00ea\u00e0\u00bb \u00e2\u00ee\u00f8\u00e5\u00eb \u00e2 \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2 \u00ab\u00d2\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00ea\u00e0\u00f1\u00f2 \u00ed\u00e0 \u00ab\u00d0\u00e0\u00e4\u00e8\u00ee \u00ca\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00e0\u00bb (2022). \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0. \u00ce. \u00ab\u00ca\u00e0\u00ea \u00e4\u00ee\u00ef\u00e8\u00f1\u00e0\u00f2\u00fc \u00ab\u00f1\u00e2\u00ee\u00e1\u00ee\u00e4\u00f3\u00bb : \u00f0\u00e0\u00e7\u00e3\u00ee\u00e2\u00ee\u00f0 \u00ee \u00f0\u00e0\u00e1\u00ee\u00f2\u00e5, \u00f1\u00e5\u00ec\u00fc\u00e5, \u00f1\u00e0\u00ec\u00ee\u00f0\u00e5\u00e0\u00eb\u00e8\u00e7\u00e0\u00f6\u00e8\u00e8, \u00e8\u00ed\u00f2\u00e5\u00f0\u00e5\u00f1\u00e0\u00f5 \u00e8 \u00ef\u00f0\u00ee\u00e1\u00eb\u00e5\u00ec\u00e0\u00f5 \u00e6\u00e5\u00ed\u00f9\u00e8\u00ed. - \u00d2\u00e5\u00ea\u00f1\u00f2 : \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 // \u00ab\u00c6\u00e5\u00ed\u00f1\u00ea\u00e0\u00ff \u00f2\u00e5\u00ec\u00e0\u00bb : \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e0 \u00c0\u00ed\u00ed\u00fb \u00c3\u00f0\u00e8\u00ed\u00e5\u00e2\u00e8\u00f7. \u2013 2022. \u2013\u00a0 URL: https://rk.karelia.ru/zhenskaya-tema/kak-dopisat-svobodu/ (\u00e4\u00e0\u00f2\u00e0 \u00ee\u00e1\u00f0\u00e0\u00f9\u00e5\u00ed\u00e8\u00ff: 05.12.2022). \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0, \u00ce. \u00c5. \u00cf\u00ee\u00f1\u00ec\u00ee\u00f2\u00f0\u00e5\u00f2\u00fc \u00ed\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea \u00e3\u00eb\u00e0\u00e7\u00e0\u00ec\u00e8 \u00f2\u00f3\u00f0\u00e8\u00f1\u00f2\u00e0 \u00ef\u00ee\u00ec\u00ee\u00e6\u00e5\u00f2 \u00e0\u00f3\u00e4\u00e8\u00ee\u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00fc-\u00ef\u00f0\u00ee\u00ec\u00e5\u00ed\u00e0\u00e4 \u00ab\u00d0\u00e0\u00e4\u00e8\u00f3\u00f1 \u00ef\u00e0\u00ec\u00ff\u00f2\u00e8\u00bb / \u00ce\u00eb\u00fc\u00e3\u00e0 \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0 ; \u00c3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00e0\u00ff \u00f2\u00e5\u00eb\u00e5\u00e2\u00e8\u00e7\u00e8\u00ee\u00ed\u00ed\u00e0\u00ff \u00e8 \u00f0\u00e0\u00e4\u00e8\u00ee\u00e2\u00e5\u00f9\u00e0\u00f2\u00e5\u00eb\u00fc\u00ed\u00e0\u00ff \u00ea\u00ee\u00ec\u00ef\u00e0\u00ed\u00e8\u00ff \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u2013 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb, 2021. \u2013 1 \u00e0\u00f3\u00e4\u00e8\u00ee\u00f4\u00e0\u00e9\u00eb (26 \u00ec\u00e8\u00ed 20 \u00f1). \u2013 URL: https://tv-karelia.ru/17-06-2021-posmotret-na-petrozavodsk-glazami-turista-pomozhet-audiospektakl-promenad-radius-pamyati/ (\u00e4\u00e0\u00f2\u00e0 \u00ee\u00e1\u00f0\u00e0\u00f9\u00e5\u00ed\u00e8\u00ff: 06.12.2022). \u2013 \u00d3\u00f1\u00f2\u00ed\u00e0\u00ff \u00f0\u00e5\u00f7\u00fc (\u00e8\u00f1\u00ef\u00ee\u00eb\u00ed\u00e8\u00f2\u00e5\u00eb\u00fc\u00f1\u00ea\u00e0\u00ff) : \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff. \u00ca\u00ee\u00e7\u00e8\u00f7, \u00d1. \u00c4\u00ed\u00e5\u00e2\u00ed\u00e8\u00ea \u00e8\u00f1\u00f7\u00e5\u00e7\u00e0\u00fe\u00f9\u00e5\u00e3\u00ee \u00e7\u00e0\u00e2\u00ee\u00e4\u00e0 : [\u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ff \u00ce\u00ed\u00e5\u00e6\u00f1\u00ea\u00ee\u00e3\u00ee \u00f2\u00f0\u00e0\u00ea\u00f2\u00ee\u00f0\u00ed\u00ee\u00e3\u00ee \u00e7\u00e0\u00e2\u00ee\u00e4\u00e0 \u00e2 \u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00e5-\u00ef\u00f0\u00ee\u00ec\u00e5\u00ed\u00e0\u00e4\u00e5 \u00ce\u00eb\u00fc\u00e3\u00e8 \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00ee\u00e9 \u00ab\u0412\u00f0\u00e5\u00ec\u00ff, \u00e2\u00ef\u00e5\u00f0\u00e5\u00e4?\u00bb] / \u00d1\u00ee\u00f4\u00fc\u00ff \u00ca\u00ee\u00e7\u00e8\u00f7. - \u00d2\u00e5\u00ea\u00f1\u00f2 : \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 // \u00cf\u00e5\u00f2\u00e5\u00f0\u00e1\u00f3\u00f0\u00e3\u00f1\u00ea\u00e8\u00e9 \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb : \u00f1\u00e0\u00e9\u00f2. - 2017. - URL: https://ptj.spb.ru/blog/dnevnik-ischezayushhego-zavoda/ (\u00e4\u00e0\u00f2\u00e0 \u00ee\u00e1\u00f0\u00e0\u00f9\u00e5\u00ed\u00e8\u00ff: 07.12.2022). \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0, \u00ce. \u00cc\u00e0\u00f1\u00ea\u00e0 : \u00ee\u00f4\u00e8\u00f6\u00e8\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00f1\u00e0\u00e9\u00f2 / \u00ce\u00eb\u00fc\u00e3\u00e0 \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0. \u2013 [\u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea], 2022. \u2013 URL: http://maskaok.ru/ (\u00e4\u00e0\u00f2\u00e0 \u00ee\u00e1\u00f0\u00e0\u00f9\u00e5\u00ed\u00e8\u00ff: 05.12.2022). \u2013 \u00d0\u00e0\u00e7\u00ed\u00fb\u00e5 \u00e2\u00e8\u00e4\u00fb \u00f1\u00ee\u00e4\u00e5\u00f0\u00e6\u00e0\u00ed\u00e8\u00ff : \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5. \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0, \u00ce. \u00c5. \u00d2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00ec\u00e5\u00f2\u00ee\u00e4 \u00f0\u00e5\u00e6\u00e8\u00f1\u00f1\u00e5\u00f0\u00e0 \u00cc\u00e0\u00ea\u00f1\u00e8\u00ec\u00e0 \u00c4\u00e8\u00e4\u00e5\u00ed\u00ea\u00ee . - \u00d2\u00e5\u00ea\u00f1\u00f2 : \u00ed\u00e5\u00ef\u00ee\u00f1\u00f0\u00e5\u00e4\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00e9 / \u00ce. \u00c5. \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00e0 // \u00d2\u00e5\u00e0\u00f2\u00f0\u00ee\u00ed : \u00ed\u00e0\u00f3\u00f7\u00ed. \u00e0\u00eb\u00fc\u00ec\u00e0\u00ed\u00e0\u00f5. \u2013 \u00d1\u00ef\u00e1. \u2013 2018. \u2013 \u00b9 2 (24). \u2013 \u00d1. 80-95. \u2013\u00a0 (\u00c7\u00e5\u00f0\u00ea\u00e0\u00eb\u00ee \u00f1\u00f6\u00e5\u00ed\u00fb). \u2013 URL: http://www.rgisi.ru/elektronnyij-arxiv-nomerov?page=2 (\u00e4\u00e0\u00f2\u00e0 \u00ee\u00e1\u00f0\u00e0\u00f9\u00e5\u00ed\u00e8\u00ff: 06.12.2022).\u2013 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e2 \u00ef\u00f0\u00e8\u00ec\u00e5\u00f7\u00e0\u00ed\u00e8\u00ff\u00f5: \u00f1. 94-95. \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0\u00f6\u00e8\u00e8 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0\u00a0 \u00e2 \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00f5 \u00d1\u00cc\u00c8: \u00cf\u00e5\u00f2\u00e5\u00f0\u00e1\u00f3\u00f0\u00e3\u00f1\u00ea\u00e8\u00e9 \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00fb\u00e9 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb \u00d2\u00e5\u00e0\u00f2\u00f0 \u00d2\u00e5\u00e0\u00f2\u00f0 \u00e2 \u00ea\u00eb\u00f3\u00e1\u00e5 \u00f1 \u00ce\u00eb\u00fc\u00e3\u00ee\u00e9 \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00ee\u00e9 \u00c0\u00f4\u00e8\u00f8\u00e0 \u00cf\u00e0\u00f0\u00e8\u00e6-\u00c5\u00e2\u00f0\u00ee\u00ef\u00e0 \u00dd\u00ea\u00f0\u00e0\u00ed \u00e8 \u00f1\u00f6\u00e5\u00ed\u00e0. \u00c3\u00e0\u00e7\u00e5\u00f2\u00e0 \u00ee \u00f2\u00e5\u00e0\u00f2\u00f0\u00e5 \u00e8 \u00ea\u00e8\u00ed\u00ee \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00d0\u00e0\u00e4\u00e8\u00f3\u00f1 \u00ef\u00e0\u00ec\u00ff\u00f2\u00e8 \u00c0\u00f3\u00e4\u00e8\u00ee\u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00fc-\u00ef\u00f0\u00ee\u00ec\u00e5\u00ed\u00e0\u00e4 \u0096 \u00f1\u00e2\u00ee\u00e5\u00ee\u00e1\u00f0\u00e0\u00e7\u00ed\u00e0\u00ff \u00ef\u00f0\u00ee\u00e3\u00f3\u00eb\u00ea\u00e0 \u00ef\u00ee \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00f3 \u00ee\u00f2  \u00d0\u00ee\u00e1\u00e5\u00f0\u00f2\u00e0 \u00d0\u00ee\u00e6\u00e4\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00f1\u00ea\u00ee\u00e3\u00ee \u00ea \u00c8\u00f0\u00e8\u00ed\u00e5 \u00d4\u00e5\u00e4\u00ee\u00f1\u00ee\u00e2\u00ee\u00e9. \u00c4\u00ee\u00ea\u00f3\u00ec\u00e5\u00ed\u00f2\u00e0\u00eb\u00fc\u00ed\u00fb\u00e5 \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8, \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00eb\u00ff\u00fe\u00f9\u00e8\u00e5 \u00ef\u00ff\u00f2\u00fc \u00f2\u00e5\u00e0\u00f2\u00f0\u00ee\u00e2 \u00e3\u00ee\u00f0\u00ee\u00e4\u00e0, \u00e7\u00e0\u00ea\u00eb\u00fe\u00f7\u00e5\u00ed\u00fb \u00e2 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00f3\u00fe \u00f0\u00e0\u00ec\u00ea\u00f3 \u00e8\u00ec\u00e5\u00ed\u00e0\u00ec\u00e8, \u00f1\u00e2\u00ff\u00e7\u00e0\u00ed\u00ed\u00fb\u00ec\u00e8 \u00f1\u00ee \u00f1\u00f2\u00ee\u00eb\u00e8\u00f6\u00e5\u00e9 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c2\u00e0\u00ed\u00e5\u00f7\u00ea\u00e0 \u00cf\u00fc\u00e5\u00f1\u00e0 \u00f1 \u00e0\u00f3\u00e4\u00e8\u00ee- \u00e8 \u00e2\u00e8\u00e4\u00e5\u00ee\u00f1\u00ee\u00ef\u00f0\u00ee\u00e2\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00e5\u00ec. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d9\u00f3\u00ea\u00e0 \u00c2\u00e8\u00e4\u00e5\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5, \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed\u00ed\u00ee\u00e5 \u00ce. \u00ca\u00ee\u00e2\u00eb\u00e0\u00ea\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee \u00f1\u00ea\u00e0\u00e7\u00ea\u00e5, \u00ed\u00e0\u00ef\u00e8\u00f1\u00e0\u00ed\u00ed\u00ee\u00e9 \u00e8 \u00e8\u00eb\u00eb\u00fe\u00f1\u00f2\u00f0\u00e8\u00f0\u00ee\u00e2\u00e0\u00ed\u00ed\u00ee\u00e9 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00ee\u00ec \u00d0\u00e0\u00ea\u00ee\u00e2\u00fb\u00ec. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d1\u00e5\u00f0\u00e4\u00ee\u00e1\u00ee\u00eb\u00fc \u00d0\u00e5\u00f0\u00e8\u00f5\u00e0 \u00c0\u00f3\u00e4\u00e8\u00ee\u00f1\u00ef\u00e5\u00ea\u00f2\u00e0\u00ea\u00eb\u00fc-\u00ef\u00f0\u00ee\u00ec\u00e5\u00ed\u00e0\u00e4 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

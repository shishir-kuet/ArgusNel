u062c\u0647\u0632\u0629 \u0627\u0644\u0645\u062d\u0645\u0648\u0644\u0629 \u062a\u0639\u062f\u064a\u0644 \u0645\u0635\u062f\u0631 2017 \u062a\u0639\u062f\u064a\u0644 \u0648\u064a\u0628 \u0645\u062d\u0645\u0648\u0644 \u062a\u0645 \u0627\u0644\u062a\u0639\u062f\u064a\u0644 \u0628\u0648\u0627\u0633\u0637\u0629 \u0645\u0633\u062a\u0648\u0631\u062f \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u062a\u0645\u062a \u0625\u0639\u0627\u062f\u0629 \u0625\u0646\u0634\u0627\u0626\u0647\u0627 \u062d\u0630\u0641 \u0643\u0645\u064a \u0631\u062c\u0648\u0639 \u0631\u062f\u0651 \u063a\u064f\u064a\u064e\u0651\u0631 \u0647\u062f\u0641 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u0629 \u0645\u0633\u062a\u0631\u062c\u0639 \u0645\u0648\u0636\u0648\u0639 \u062c\u062f\u064a\u062f \u0627\u0639\u0643\u0633 \u0627\u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0623\u0638\u0647\u0631 \u0627\u0644\u0646\u0633\u062e \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0641\u0642\u0637 \u0623\u0638\u0647\u0631 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0641\u0642\u0637 \u0623\u062e\u0641 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0637\u0641\u064a\u0641\u0629 \u29fccontribs-date\u29fd \u0645\u0646 \u062a\u0627\u0631\u064a\u062e: \u062d\u062a\u0649 \u062a\u0627\u0631\u064a\u062e: \u0628\u062d\u062b 2 \u0623\u063a\u0633\u0637\u0633 2020 23:58 23:58\u060c 2 \u0623\u063a\u0633\u0637\u0633 2020 \u0641\u0631\u0642 \u062a\u0627\u0631\u064a\u062e +40 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0633\u0644\u0627\u0645/\u0627\u0644\u062f\u0648\u0644\u0629 \u0627\u0644\u0639\u0628\u0627\u0633\u064a\u0629/\u062e\u0635\u0627\u0626\u0635 \u0627\u0644\u062d\u0636\u0627\u0631\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0641\u064a \u0627\u0644\u0639\u0647\u062f \u0627\u0644\u0639\u0628\u0627\u0633\u064a \u0648\u0646\u0641\u0645\u0628\u0632 \u0664\u0645\u0642\u0648\u0629\u0624\u062e \u062d\u0629\u0628 \u0648\u0633\u0645\u0627\u0646 : \u062a\u062d\u0
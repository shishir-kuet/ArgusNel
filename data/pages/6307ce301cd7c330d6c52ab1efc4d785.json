{
  "url": "http://bn.wikivoyage.org/wiki/%E0%A6%86%E0%A6%B2%E0%A6%BE%E0%A6%AA:%E0%A6%AA%E0%A7%8D%E0%A6%B0%E0%A6%A7%E0%A6%BE%E0%A6%A8_%E0%A6%AA%E0%A6%BE%E0%A6%A4%E0%A6%BE",
  "title": "\u0986\u09b2\u09be\u09aa:\u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09be\u09a4\u09be - \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3",
  "text": "\u0986\u09b2\u09be\u09aa:\u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09be\u09a4\u09be - \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1\u09a4\u09c7 \u099a\u09b2\u09c1\u09a8 \u0989\u0987\u0995\u09bf\u09ad\u09cd\u09b0\u09ae\u09a3 \u09a5\u09c7\u0995\u09c7 \u09b8\u09be\u09ae\u09cd\u09aa\u09cd\u09b0\u09a4\u09bf\u0995 \u09ae\u09a8\u09cd\u09a4\u09ac\u09cd\u09af: \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u09b9\u09be\u09b8\u09be\u09a8 \u0995\u09b0\u09cd\u09a4\u09c3\u0995 \u09e9 \u09ac\u099b\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \" \u09b8\u0982\u09b6\u09cb\u09a7\u09a8 \" \u0985\u09a8\u09c1\u099a\u09cd\u099b\u09c7\u09a6\u09c7 \u098f\u0987 \u09aa\u09be\u09a4\u09be\u099f\u09bf \u09b6\u09c1\u09a7\u09c1\u09ae\u09be\u09a4\u09cd\u09b0 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09be\u09a4\u09be\u09b0 \u0986\u09b2\u09cb\u099a\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u0964 \u098f\u099f\u09bf \u0995\u09cb\u09a8\u09cb \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09be\u09b0 \u09b8\u09cd\u09a5\u09be\u09a8 \u09a8\u09af\u09bc\u0964 \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09be \u09b8\u09a4\u09cd\u09af\u09bf\u0987 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09be\u09a4\u09be \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u09a8\u09be \u09b9\u09af\u09bc, \u09a4\u09ac\u09c7 \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u0986\u09b2\u09cb\u099a\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u09ad\u09cd\u09b0\u09ae\u09a3\u09aa\u09bf\u09aa\u09be\u09b8\u09c1\u09b0 \u0986\u09a1\u09cd\u09a1\u09be\u09af\u09bc \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09b8\u0982\u09b6\u09cb\u09a7\u09a8 [ \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be ] \u09b8\u09b0\u09cd\u09ac\u09b6\u09c7\u09b7 \u09ae\u09a8\u09cd\u09a4\u09ac\u09cd\u09af: \u09e9 \u09ac\u099b\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u09ef\u099f\u09bf \u09ae\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u09e9 \u099c\u09a8 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf \u09ae\u09a8\u09cd\u09a4\u09ac\u09cd\u09af \u0995\u09b0\u09c7\u099b\u09c7\u09a8 \u09ae\u09be\u09a8\u099a\u09bf\u09a4\u09cd\u09b0 \u09ac\u09cd\u09af\u09be\u09a8\u09be\u09b0\u099f\u09bf\u09a4\u09c7 \u09a5\u09be\u0995\u09be \u09b2\u09c7\u0996\u09be\u0997\u09c1\u09b2\u09cb mainpage-shadowbox \u0985\u09a8\u09c1\u09af\u09be\u09af\u09bc\u09c0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2\u09c7\u0993 \u09a0\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u0986\u0981\u099f\u099b\u09c7 \u09a8\u09be, \u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0\u09c7\u0993 \u09a8\u09be\u0964 \u09b2\u09c7\u0996\u09be\u0997\u09c1\u09b2\u09cb \u09b8\u0982\u0995\u09cd\u09b7\u09c7\u09aa \u0995\u09b0\u09be \u09b9\u09b2\u09c7 \u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0\u09c7 \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4\u09ad\u09be\u09ac\u09c7 \u098f\u0981\u099f\u09c7 \u09af\u09be\u09ac\u09c7\u0964 \u09b8\u09c7\u099c\u09a8\u09cd\u09af \u0993 \u09b8\u0982\u09b6\u09cb\u09a7\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u099b\u09bf: \u098f\u099f\u09bf \u09ac\u09bf\u09b6\u09cd\u09ac\u09ac\u09cd\u09af\u09be\u09aa\u09c0 \u09ad\u09cd\u09b0\u09ae\u09a3\u09c7\u09b0 \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be \u09af\u09be \u0986\u09aa\u09a8\u09bf \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u09ac\u09bf\u09b6\u09cd\u09ac\u09ad\u09cd\u09b0\u09ae\u09a3\u09c7\u09b0 \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be, \u09af\u09be \u09af\u09c7\u0995\u09c7\u0989 \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964 \u098f\u099f\u09bf \u09ac\u09bf\u09b6\u09cd\u09ac\u099c\u09c1\u09a1\u09bc\u09c7 \u09a6\u09b0\u09cd\u09b6\u09a8\u09c0\u09af\u09bc \u09b8\u09cd\u09a5\u09be\u09a8, \u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0995\u09b2\u09be\u09aa, \u09b0\u09a8\u09cd\u09a7\u09a8\u09aa\u09cd\u09b0\u09a3\u09be\u09b2\u09c0  \u098f\u09ac\u0982 \u0986\u09ac\u09be\u09b8\u09a8\u09c7\u09b0 \u0996\u09be\u09a6\u09cd\u09af\u09be\u09ad\u09cd\u09af\u09be\u09b8 \u0993 \u0986\u09ac\u09be\u09b8\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0989\u0987\u0995\u09bf\u09aa\u09bf\u09a1\u09bf\u09af\u09bc\u09be\u09b0 \u09aa\u09cd\u09b0\u09be\u09a4\u09bf\u09b7\u09cd\u09a0\u09be\u09a8\u09bf\u0995, \u0985-\u09ac\u09be\u09a3\u09bf\u099c\u09cd\u09af\u09bf\u0995 \u09b8\u09b9\u09aa\u09cd\u09b0\u0995\u09b2\u09cd\u09aa\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cb\u09a8\u09cb \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09b0\u09af\u09bc\u09c7\u099b\u09c7? \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09b0\u09cd\u09af\u099f\u09a8 \u09a6\u09aa\u09cd\u09a4\u09b0\u09c7 \u099c\u09bf\u099c\u09cd\u099e\u09c7\u09b8 \u0995\u09b0\u09c1\u09a8\u0964 \u0995\u09cb\u09a8\u09cb \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09b0\u09af\u09bc\u09c7\u099b\u09c7? \u09aa\u09b0\u09cd\u09af\u099f\u09a8 \u09a6\u09aa\u09cd\u09a4\u09b0\u09c7 \u099c\u09bf\u099c\u09cd\u099e\u09c7\u09b8 \u0995\u09b0\u09c1\u09a8\u0964 \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u099c\u09c7\u09a8\u09c7 \u09a8\u09bf\u09a8 \u09ac\u09be \u0986\u09aa\u09a8\u09bf \u0995\u09bf \u099c\u09be\u09a8\u09c7\u09a8? \u09ae\u09a8\u09cd\u09a4\u09ac\u09cd\u09af (\u098f\u099f\u09be \u09af\u09a5\u09be\u09b8\u09ae\u09cd\u09ad\u09ac \u0986\u099c\u09be\u0995\u09bf \u099f\u09be\u0987\u09aa\u09c7\u09b0) \u09b6\u09be\u09ac\u09cd\u09a6\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09a1\u09bf\u09b8\u09cd\u0995\u09ad\u09be\u09b0\u09c7\u09b0 \u0985\u09a8\u09c1\u09ac\u09be\u09a6 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7 \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0\u0964 \u098f\u099f\u09be \u09ad\u09c1\u09b2 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0987 \u09b9\u09af\u09bc\u09c7 \u09a5\u09be\u0995\u09ac\u09c7\u0964 @ Yahya : \u09ad\u09be\u0987, \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09ae\u09a8\u09c7 \u0995\u09b0\u09b2\u09c7 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc \u09ae\u09a8\u09cd\u09a4\u09ac\u09cd\u09af\u09c7\u09b0 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09c7 \u0985\u09a5\u09ac\u09be \u09a8\u09be \u0995\u09b0\u09c7 \u0989\u09a8\u09cd\u09a8\u09af\u09bc\u09a8 \u09b8\u09be\u09a7\u09a8 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0986\u09ae\u09bf \u09a6\u09cd\u09b0\u09c1\u09a4\u0987 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09be\u09a4\u09be\u09b0 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ac\u09bf\u09b7\u09af\u09bc\u0997\u09c1\u09b2\u09cb \u0985\u09a8\u09c1\u09ac\u09be\u09a6 \u0995\u09b0\u09c7 \u098f\u0987 \u0989\u0987\u0995\u09bf\u09a4\u09c7 \u09a8\u09bf\u09af\u09bc\u09c7 \u0986\u09b8\u09ac\u0964 \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u098f\u0995\u099f\u09c1 \u0996\u09c7\u09af\u09bc\u09be\u09b2 \u0995\u09b0\u09c7 \u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c7 \u09a6\u09bf\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 ~ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u0985 , \u0986 , \u0987 ... \u09e7\u09ec:\u09ea\u09ea, \u09e8\u09e6 \u09ab\u09c7\u09ac\u09cd\u09b0\u09c1\u09af\u09bc\u09be\u09b0\u09bf \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 @ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u098f\u0996\u09be\u09a8\u09c7 \u09af\u09c7\u09b9\u09c7\u09a4\u09c1 \u09b8\u09ae\u09cd\u09aa\u09cd\u09b0\u09a6\u09be\u09af\u09bc \u09a8\u09c7\u0987, \u09a4\u09be\u0987 \u0985\u09a8\u09cd\u09af \u0995\u09cb\u09a5\u09be\u0993 \u0986\u09b2\u09cb\u099a\u09a8\u09be\u09af\u09bc \u09a8\u09be \u0997\u09bf\u09af\u09bc\u09c7 \u098f\u0996\u09be\u09a8\u09c7\u0987 \u09a6\u09c1\u09af\u09bc\u09c7\u0995\u09a6\u09bf\u09a8 \u0985\u09aa\u09c7\u0995\u09cd\u09b7\u09be \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc\u0964 \u0986\u09b0 \u098f\u09ae\u09a8\u09bf\u09a4\u09c7\u0993 \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09be\u09a4\u09be \u09b9\u09be\u09b2\u09a8\u09be\u0997\u09be\u09a6 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u0964 \u098f\u099f\u09be \u09a8\u09bf\u09af\u09bc\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09be\u09af\u09bc \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09a7\u09a8\u09cd\u09af\u09ac\u09be\u09a6\u0964 \u2013 \u0987\u09af\u09bc\u09be\u09b9\u09bf\u09af\u09bc\u09be ( \u0986\u09b2\u09be\u09aa \u2022 \u0985\u09ac\u09a6\u09be\u09a8 ) \u09e7\u09ef:\u09e6\u09e9, \u09e8\u09e6 \u09ab\u09c7\u09ac\u09cd\u09b0\u09c1\u09af\u09bc\u09be\u09b0\u09bf \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 \u099c\u09bf \u09a0\u09bf\u0995 \u0986\u099b\u09c7\u0964 --~ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u0985 , \u0986 , \u0987 ... \u09e8\u09e6:\u09e7\u09ea, \u09e8\u09e6 \u09ab\u09c7\u09ac\u09cd\u09b0\u09c1\u09af\u09bc\u09be\u09b0\u09bf \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 \u09a6\u09cd\u09b0: \u09b8\u09ae\u09cd\u09aa\u09be\u09a6\u09a8\u09be \u0995\u09b0\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0 \u098f\u09b0 \u09ac\u09cd\u09af\u09be\u09aa\u09be\u09b0\u099f\u09be \u0986\u09b0\u09c7\u0995\u09ac\u09be\u09b0 \u09ad\u09c7\u09ac\u09c7 \u09a8\u09bf\u09ac\u09c7\u09a8\u0964 \u0986\u09ae\u09be\u09b0 \u09ae\u09be\u09a5\u09be\u09af\u09bc \u09ac\u09bf\u09b7\u09af\u09bc\u099f\u09be \u09a8\u09bf\u09af\u09bc\u09c7 \u09b8\u09a8\u09cd\u09a6\u09c7\u09b9 \u09a2\u09c1\u0995\u09c7\u099b\u09c7\u0964 --\u00a0~ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u0985 , \u0986 , \u0987 ... \u09e6\u09eb:\u09eb\u09e6, \u09e8\u09e8 \u09ab\u09c7\u09ac\u09cd\u09b0\u09c1\u09af\u09bc\u09be\u09b0\u09bf \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 @ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u09b9\u09be\u09b8\u09be\u09a8 \u09ad\u09be\u0987, \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09b6\u099f \u09a6\u09c7\u0996\u09be\u09b2\u09c7 \u0986\u09ae\u09bf \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u099f\u09bf \u09ac\u09c1\u099d\u09a4\u09c7 \u09aa\u09be\u09b0\u09a4\u09be\u09ae\u0964 \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u0986\u09ae\u09be\u09b0 \u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0\u09c7 \u09b2\u09c7\u0996\u09be\u0997\u09c1\u09b2\u09cb \u09a0\u09bf\u0995\u09ae\u09a4 \u098f\u0981\u099f\u09c7 \u09af\u09be\u099a\u09cd\u099b\u09c7\u0964 \u09ae\u09cb\u09ac\u09be\u0987\u09b2\u09c7 \u0995\u09cb\u09a8\u0993 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b9\u099a\u09cd\u099b\u09c7 \u09a8\u09be\u0964 \u0986\u09ab\u09a4\u09be\u09ac ( \u0986\u09b2\u09be\u09aa ) \u09e6\u09e8:\u09e7\u09ed, \u09ea \u0986\u0997\u09b8\u09cd\u099f \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 @ \u0986\u09ab\u09a4\u09be\u09ac \u09ad\u09be\u0987 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09b6\u099f\u099f\u09bf \u09a6\u09c7\u0996\u09c1\u09a8\u0964 (\u09ab\u09be\u0987\u09b2\u099f\u09bf\u09b0 \u09ec\u09ae\u09be\u09b8 \u09ae\u09c7\u09af\u09bc\u09be\u09a6) ~ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u0985 , \u0986 , \u0987 ... \u09e6\u09e8:\u09e8\u09ee, \u09ea \u0986\u0997\u09b8\u09cd\u099f \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 @ Yahya : \"\u09ac\u09bf\u09b6\u09cd\u09ac\u09ad\u09cd\u09b0\u09ae\u09a3\u09c7\u09b0 \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be\" \u09b2\u09c7\u0996\u09be\u09b0 \u09aa\u09c2\u09b0\u09cd\u09ac\u09c7 \"\u098f\u099f\u09bf\" \u09af\u09cb\u0997 \u0995\u09b0\u09cb\u0964 \u09ae\u09be\u09a8\u09c7 \"\u098f\u099f\u09bf \u09ac\u09bf\u09b6\u09cd\u09ac\u09ad\u09cd\u09b0\u09ae\u09a3\u09c7\u09b0 \u0989\u09a8\u09cd\u09ae\u09c1\u0995\u09cd\u09a4 \u09a8\u09bf\u09b0\u09cd\u09a6\u09c7\u09b6\u09bf\u0995\u09be...\"\u0964 \u0986\u09b0 \"\u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cb\u09a8\u09cb \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09b0\u09af\u09bc\u09c7\u099b\u09c7?\" \u09a5\u09c7\u0995\u09c7 \"\u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f\" \u0995\u09c7\u099f\u09c7 \u09b6\u09c1\u09a7\u09c1 \"\u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cb\u09a8\u09cb \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8 \u09b0\u09af\u09bc\u09c7\u099b\u09c7?\" \u09b2\u09c7\u0996\u0964 \u0986\u09b0 \u0986\u09ac\u09bf\u09b7\u09cd\u0995\u09be\u09b0\u0995\u09c7 \u0986\u09aa\u09a8\u09bf \u099c\u09be\u09a8\u09c7\u09a8 \u0995\u09bf? \u09b2\u09c7\u0996\u0964 \u0986\u09ab\u09a4\u09be\u09ac ( \u0986\u09b2\u09be\u09aa ) \u09e7\u09ed:\u09e9\u09ee, \u09ea \u0986\u0997\u09b8\u09cd\u099f \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 @ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u09b9\u09be\u09b8\u09be\u09a8 , \u098f\u0996\u09a8 \u09a0\u09bf\u0995 \u0986\u099b\u09c7? \u0986\u09ab\u09a4\u09be\u09ac ( \u0986\u09b2\u09be\u09aa ) \u09e7\u09ee:\u09e6\u09ea, \u09ea \u0986\u0997\u09b8\u09cd\u099f \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 @ \u0986\u09ab\u09a4\u09be\u09ac\u09c1\u099c\u09cd\u099c\u09be\u09ae\u09be\u09a8 \u099c\u09bf \u09a0\u09bf\u0995 \u0986\u099b\u09c7\u0964 ~ \u0996\u09be\u09a4\u09cd\u09a4\u09be\u09ac \u0985 , \u0986 , \u0987 ... \u09e7\u09ee:\u09e6\u09ef, \u09ea \u0986\u0997\u09b8\u09cd\u099f \u09e8\u09e6\u09e8\u09e8 (\u0987\u0989\u099f\u09bf\u09b8\u09bf) \u0989\u09a4\u09cd\u09a4\u09b0 \u09a6\u09bf\u09a8 ' https://bn.wikivoyage.org/w/index.php?title=\u0986\u09b2\u09be\u09aa:\u09aa\u09cd\u09b0\u09a7\u09be\u09a8_\u09aa\u09be\u09a4\u09be&oldid=75881 ' \u09a5\u09c7\u0995\u09c7 \u0986\u09a8\u09c0\u09a4 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8 \u0986\u09b2\u09be\u09aa : \u09aa\u09cd\u09b0\u09a7\u09be\u09a8 \u09aa\u09be\u09a4\u09be \u0986\u09b2\u09cb\u099a\u09a8\u09be \u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8",

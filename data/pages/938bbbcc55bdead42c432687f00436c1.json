{
  "url": "http://avtor.karelia.ru/about/belova__olga_petrovna_.html",
  "title": "\u00c1\u00e5\u00eb\u00ee\u00e2\u00e0  \u00ce\u00eb\u00fc\u00e3\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e2\u00ed\u00e0  - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00c1\u00e5\u00eb\u00ee\u00e2\u00e0  \u00ce\u00eb\u00fc\u00e3\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e2\u00ed\u00e0  - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00c1\u00e5\u00eb\u00ee\u00e2\u00e0  \u00ce\u00eb\u00fc\u00e3\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e2\u00ed\u00e0 \u00c4\u00e0\u00f2\u00e0 \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: 16.05.1959 \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00c3\u00ee\u00f0\u00ee\u00e4 \u00d2\u00ee\u00eb\u00fc\u00ff\u00f2\u00f2\u00e8 \u00ca\u00f3\u00e9\u00e1\u00fb\u00f8\u00e5\u00e2\u00f1\u00ea\u00ee\u00e9 \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00cc\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4, \u00ef\u00f0\u00e5\u00ef\u00ee\u00e4\u00e0\u00e2\u00e0\u00f2\u00e5\u00eb\u00fc \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee-\u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00f5 \u00e4\u00e8\u00f1\u00f6\u00e8\u00ef\u00eb\u00e8\u00ed, \u00eb\u00e5\u00ea\u00f2\u00ee\u00f0,\u00a0\u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00ed\u00fb\u00e9 \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc, \u00ed\u00e5\u00e7\u00e0\u00e2\u00e8\u00f1\u00e8\u00ec\u00fb\u00e9 \u00e8\u00f1\u00f1\u00eb\u00e5\u00e4\u00ee\u00e2\u00e0\u00f2\u00e5\u00eb\u00fc. \u00c7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00fb\u00e9 \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. \u00ce\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e8\u00e9 \u00f4\u00e8\u00eb\u00e8\u00e0\u00eb \u00cb\u00e5\u00ed\u00e8\u00ed\u00e3\u00f0\u00e0\u00e4\u00f1\u00ea\u00ee\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e9 \u00ea\u00ee\u00ed\u00f1\u00e5\u00f0\u00e2\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 \u00e8\u00ec\u00e5\u00ed\u00e8 \u00cd. \u00c0. \u00d0\u00e8\u00ec\u00f1\u00ea\u00ee\u00e3\u00ee-\u00ca\u00ee\u00f0\u00f1\u00e0\u00ea\u00ee\u00e2\u00e0\u00a0 \u00ef\u00ee \u00f1\u00ef\u00e5\u00f6\u00e8\u00e0\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00e8 \u00ab\u00ec\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e5\u00bb (\u00ea\u00eb\u00e0\u00f1\u00f1 \u00ef\u00f0\u00ee\u00f4\u00e5\u00f1\u00f1\u00ee\u00f0\u00e0 \u00de. \u00c3. \u00ca\u00ee\u00ed\u00e0, 1983). \u00cd\u00e0\u00f7\u00e0\u00eb\u00e0 \u00f1\u00e2\u00ee\u00fe \u00f2\u00f0\u00f3\u00e4\u00ee\u00e2\u00f3\u00fe \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00fc \u00e5\u00f9\u00b8 \u00f1\u00f2\u00f3\u00e4\u00e5\u00ed\u00f2\u00ea\u00ee\u00e9, \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb\u00e0 \u00e2 \u00ea\u00ee\u00ed\u00f1\u00e5\u00f0\u00e2\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 \u00f2\u00e5\u00f5\u00ed\u00e8\u00ea\u00ee\u00ec \u00eb\u00e0\u00e1\u00ee\u00f0\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 \u00e7\u00e2\u00f3\u00ea\u00ee\u00e7\u00e0\u00ef\u00e8\u00f1\u00e8 (1982). \u00cb\u00e5\u00ea\u00f2\u00ee\u00f0-\u00ec\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4 \u00df\u00f0\u00ee\u00f1\u00eb\u00e0\u00e2\u00f1\u00ea\u00ee\u00e9 \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00ed\u00ee\u00e9 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00e8 (1983-1985), \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e9 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00e8 (1985-1989). \u00cf\u00f0\u00e5\u00ef\u00ee\u00e4\u00e0\u00e2\u00e0\u00f2\u00e5\u00eb\u00fc, \u00e7\u00e0\u00f2\u00e5\u00ec \u00f1\u00f2\u00e0\u00f0\u00f8\u00e8\u00e9 \u00ef\u00f0\u00e5\u00ef\u00ee\u00e4\u00e0\u00e2\u00e0\u00f2\u00e5\u00eb\u00fc \u00ea\u00e0\u00f4\u00e5\u00e4\u00f0\u00fb \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e8 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e9 \u00ea\u00ee\u00ed\u00f1\u00e5\u00f0\u00e2\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 (1989-1998), \u00f1\u00e5\u00ea\u00f0\u00e5\u00f2\u00e0\u00f0\u00fc \u00d3\u00f7\u00e5\u00ed\u00ee\u00e3\u00ee \u00f1\u00ee\u00e2\u00e5\u00f2\u00e0 \u00ea\u00ee\u00ed\u00f1\u00e5\u00f0\u00e2\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 (1992-1998). \u00d5\u00f3\u00e4\u00ee\u00e6\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f0\u00f3\u00ea\u00ee\u00e2\u00ee\u00e4\u00e8\u00f2\u00e5\u00eb\u00fc \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e9 \u00e3\u00ee\u00f1\u00f3\u00e4\u00e0\u00f0\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e9 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00e8 (1998-2007). \u00cd\u00e0 \u0412\u00f1\u00e5\u00f0\u00ee\u00f1\u00f1\u00e8\u00e9\u00f1\u00ea\u00ee\u00ec \u00ea\u00ee\u00ed\u00ea\u00f3\u00f0\u00f1\u00e5 \u00ab\u00ce\u00ea\u00ed\u00ee \u00e2 \u00d0\u00ee\u00f1\u00f1\u00e8\u00fe\u00bb\u00a0 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00ff \u00ef\u00ee\u00eb\u00f3\u00f7\u00e8\u00eb\u00e0 \u00f1\u00e5\u00f0\u00e5\u00e1\u00f0\u00ff\u00ed\u00fb\u00e9 \u00e4\u00e8\u00ef\u00eb\u00ee\u00ec, \u00e7\u00e2\u00e0\u00ed\u00e8\u00e5 \u00eb\u00e0\u00f3\u00f0\u00e5\u00e0\u00f2\u00e0 \u00e2 \u00ed\u00ee\u00ec\u00e8\u00ed\u00e0\u00f6\u00e8\u00e8 \u00ab\u00d4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00ff 2001\u00bb \u00e8 \u00e7\u00ee\u00eb\u00ee\u00f2\u00f3\u00fe \u00ec\u00e5\u00e4\u00e0\u00eb\u00fc \u00e8\u00ec\u00e5\u00ed\u00e8 \u00e0\u00ea\u00e0\u00e4\u00e5\u00ec\u00e8\u00ea\u00e0 \u00c4. \u00d1. \u00cb\u00e8\u00f5\u00e0\u00f7\u00e5\u00e2\u00e0. \u00cd\u00e0\u00f7\u00e0\u00eb\u00fc\u00ed\u00e8\u00ea \u00ee\u00f2\u00e4\u00e5\u00eb\u00e0 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00ed\u00ee\u00e9 \u00ef\u00ee\u00eb\u00e8\u00f2\u00e8\u00ea\u00e8 \u00e8 \u00f1\u00f2\u00f0\u00e0\u00f2\u00e5\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e3\u00ee \u00ef\u00eb\u00e0\u00ed\u00e8\u00f0\u00ee\u00e2\u00e0\u00ed\u00e8\u00ff, \u00ee\u00f2\u00e4\u00e5\u00eb\u00e0 \u00f0\u00e0\u00e7\u00e2\u00e8\u00f2\u00e8\u00ff \u00ef\u00f0\u00ee\u00f4\u00e5\u00f1\u00f1\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00e0 \u00e8 \u00f3\u00f7\u00f0\u00e5\u00e6\u00e4\u00e5\u00ed\u00e8\u00e9 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00cc\u00e8\u00ed\u00e8\u00f1\u00f2\u00e5\u00f0\u00f1\u00f2\u00e2\u00e0 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00d0\u00ca (2009-2011). \u00cd\u00e0\u00f7\u00e0\u00eb\u00fc\u00ed\u00e8\u00ea \u00f3\u00f7\u00e5\u00e1\u00ed\u00ee-\u00ec\u00e5\u00f2\u00ee\u00e4\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e3\u00ee \u00ee\u00f2\u00e4\u00e5\u00eb\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e9 \u00ea\u00ee\u00ed\u00f1\u00e5\u00f0\u00e2\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 (2011), \u00e4\u00e8\u00f0\u00e5\u00ea\u00f2\u00ee\u00f0 \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00ed\u00ee\u00e3\u00ee \u00e7\u00e0\u00eb\u00e0 \u00ea\u00ee\u00ed\u00f1\u00e5\u00f0\u00e2\u00e0\u00f2\u00ee\u00f0\u00e8\u00e8 (2012 - 2018). \u00c0\u00e2\u00f2\u00ee\u00f0 \u00e8 \u00e2\u00e5\u00e4\u00f3\u00f9\u00e0\u00ff \u00f6\u00e8\u00ea\u00eb\u00ee\u00e2 \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00ed\u00fb\u00f5 \u00ef\u00f0\u00ee\u00e3\u00f0\u00e0\u00ec\u00ec \u00f1 \u00d1\u00e8\u00ec\u00f4\u00ee\u00ed\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00ec \u00ee\u00f0\u00ea\u00e5\u00f1\u00f2\u00f0\u00ee\u00ec \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e9 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00e8 \u00ab\u00cc\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00fb\u00e5 \u00f3\u00f2\u00f0\u00e5\u00ed\u00ed\u00e8\u00ea\u00e8 \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9 \u00e8 \u00f0\u00ee\u00e4\u00e8\u00f2\u00e5\u00eb\u00e5\u00e9\u00bb, \u00ab\u00c4\u00ed\u00e5\u00e2\u00ed\u00fb\u00e5 \u00f1\u00e8\u00ec\u00f4\u00ee\u00ed\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e5 \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00fb \u00e4\u00eb\u00ff \u00fe\u00ed\u00ee\u00f8\u00e5\u00f1\u00f2\u00e2\u00e0\u00bb (1992 \u00ef\u00ee 2006), \u00f6\u00e8\u00ea\u00eb\u00e0 \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00ed\u00fb\u00f5 \u00ef\u00f0\u00ee\u00e3\u00f0\u00e0\u00ec\u00ec \u00e4\u00eb\u00ff \u00e4\u00e5\u00f2\u00e5\u00e9 \u00e8 \u00f1 \u00f3\u00f7\u00e0\u00f1\u00f2\u00e8\u00e5\u00ec \u00e4\u00e5\u00f2\u00e5\u00e9 \u00ed\u00e0 \u00f1\u00f6\u00e5\u00ed\u00e5 \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e9 \u00f4\u00e8\u00eb\u00e0\u00f0\u00ec\u00ee\u00ed\u00e8\u00e8 \u00ab\u00c8\u00e3\u00f0\u00e0\u00e5\u00ec \u00e2\u00ec\u00e5\u00f1\u00f2\u00e5\u00bb (2006), \u00f6\u00e8\u00ea\u00eb\u00e0 \u00ef\u00f0\u00ee\u00f1\u00e2\u00e5\u00f2\u00e8\u00f2\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00f5 \u00ef\u00f0\u00ee\u00e3\u00f0\u00e0\u00ec\u00ec \u00ee \u00ec\u00f3\u00e7\u00fb\u00ea\u00e5 \u00e4\u00eb\u00ff \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00ea\u00e0\u00e4\u00e5\u00f2\u00f1\u00ea\u00ee\u00e3\u00ee \u00ea\u00ee\u00f0\u00ef\u00f3\u00f1\u00e0 \u00ab\u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00ee\u00f1\u00ee\u00e1\u00ee\u00e3\u00ee \u00ed\u00e0\u00e7\u00ed\u00e0\u00f7\u00e5\u00ed\u00e8\u00ff\u00bb (2006-2007). \u00d0\u00e0\u00e1\u00ee\u00f2\u00e0 \u00e2 \u00e3\u00f0\u00f3\u00ef\u00ef\u00e5 \u00ea\u00ee\u00f0\u00ef\u00ee\u00f0\u00e0\u00f2\u00e8\u00e2\u00ed\u00ee\u00e3\u00ee \u00ef\u00f0\u00ee\u00e5\u00ea\u00f2\u00e0 \u00a0\u00ab\u00ca\u00ee\u00ec\u00e0\u00f0\u00f2 \u2013 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00ed\u00fb\u00e5 \u00ec\u00e0\u00f0\u00f8\u00f0\u00f3\u00f2\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00e2 \u00c8\u00ed\u00f2\u00e5\u00f0\u00ed\u00e5\u00f2\u00bb (2001). \u00d0\u00e0\u00e1\u00ee\u00f2\u00e0 \u00e2\u00a0 \u00ea\u00ee\u00ec\u00e8\u00f1\u00f1\u00e8\u00e8 \u00ef\u00ee \u00ef\u00f0\u00e8\u00f1\u00f3\u00e6\u00e4\u00e5\u00ed\u00e8\u00fe \u00cf\u00f0\u00e5\u00ec\u00e8\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00e2 \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00e8 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e8 \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00e0 (2002-2006), \u00e2 \u00ea\u00e0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e5 \u00ed\u00e5\u00e7\u00e0\u00e2\u00e8\u00f1\u00e8\u00ec\u00ee\u00e3\u00ee \u00fd\u00ea\u00f1\u00ef\u00e5\u00f0\u00f2\u00e0 \u00ef\u00ee \u00ef\u00f0\u00e8\u00f1\u00f3\u00e6\u00e4\u00e5\u00ed\u00e8\u00fe \u00cf\u00f0\u00e5\u00ec\u00e8\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00e2 \u00ee\u00e1\u00eb\u00e0\u00f1\u00f2\u00e8 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb, \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00e0 \u00e8 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb (2012, 2014). \u00ce\u00eb\u00fc\u00e3\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e2\u00ed\u00e0 \u2013 \u00ee\u00f0\u00e3\u00e0\u00ed\u00e8\u00e7\u00e0\u00f2\u00ee\u00f0 \u00ef\u00e5\u00f0\u00e2\u00ee\u00e3\u00ee \u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00f1\u00e5\u00ec\u00e8\u00ed\u00e0\u00f0\u00e0 \u00ef\u00ee \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e8\u00ea\u00e5 \u00ab\u00cf\u00f0\u00ee\u00f4\u00e5\u00f1\u00f1\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e5 \u00ee\u00f1\u00e2\u00e5\u00f9\u00e5\u00ed\u00e8\u00e5 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00e2 \u00d1\u00cc\u00c8. \u00d2\u00e5\u00ee\u00f0\u00e8\u00ff \u00e8 \u00ef\u00f0\u00e0\u00ea\u00f2\u00e8\u00ea\u00e0\u00bb. \u00d1\u00ee\u00f1\u00f2\u00e0\u00e2\u00eb\u00e5\u00ed\u00e8\u00e5 \u00e8 \u00f0\u00e5\u00e4\u00e0\u00ea\u00f6\u00e8\u00ff \u00f1\u00e1\u00ee\u00f0\u00ed\u00e8\u00ea\u00e0 \u00f1\u00f2\u00e0\u00f2\u00e5\u00e9 \u00e8 \u00ec\u00e0\u00f2\u00e5\u00f0\u00e8\u00e0\u00eb\u00ee\u00e2 \u00ab\u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e8\u00ea\u00e0 \u00e8 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00bb, \u00e8\u00e7\u00e4\u00e0\u00ed\u00ed\u00ee\u00e3\u00ee \u00ef\u00ee \u00e8\u00f2\u00ee\u00e3\u00e0\u00ec \u00f1\u00e5\u00ec\u00e8\u00ed\u00e0\u00f0\u00e0 (2005). \u00ca\u00f3\u00f0\u00e0\u00f2\u00ee\u00f0 \u00ea\u00ee\u00ed\u00ea\u00f3\u00f0\u00f1\u00e0 \u00ec\u00ee\u00eb\u00ee\u00e4\u00fb\u00f5 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00ed\u00f2\u00ee\u00e2 \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00e9 musiCasting\u00bb (2006), \u00ea\u00ee\u00ed\u00ea\u00f3\u00f0\u00f1\u00e0 \u00ed\u00ee\u00e2\u00ee\u00e9 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00ab\u00ca\u00ee\u00ec\u00ef\u00ee\u00e7\u00e8\u00f6\u00e8\u00ff XXI\u00bb (2007). \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f1\u00e5\u00f0\u00e8\u00e8 \u00f1\u00f2\u00e0\u00f2\u00e5\u00e9 \u00ee \u00f0\u00ee\u00ec\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00ec \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e5 \u00cf. \u00c8. \u00d7\u00e0\u00e9\u00ea\u00ee\u00e2\u00f1\u00ea\u00ee\u00e3\u00ee \u00e4\u00eb\u00ff \u00ab\u00dd\u00ed\u00f6\u00e8\u00ea\u00eb\u00ee\u00ef\u00e5\u00e4\u00e8\u00e8 \u00d7\u00e0\u00e9\u00ea\u00ee\u00e2\u00f1\u00ea\u00ee\u00e3\u00ee\u00bb . \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f6\u00e8\u00ea\u00eb\u00e0 \u00ef\u00e5\u00f0\u00e5\u00e4\u00e0\u00f7 \u00ee \u00f1\u00e5\u00f0\u00fc\u00e5\u00e7\u00ed\u00ee\u00e9 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e5 \u00ed\u00e0 \u00f0\u00e0\u00e4\u00e8\u00ee \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb \u00ef\u00ee \u00e7\u00e0\u00ea\u00e0\u00e7\u00f3 \u00cc\u00e8\u00ed\u00e8\u00f1\u00f2\u00e5\u00f0\u00f1\u00f2\u00e2\u00e0 \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00d0\u00ca \u00ab\u0412\u00f1\u00e5\u00eb\u00e5\u00ed\u00ed\u00e0\u00ff \u00ef\u00ee \u00e8\u00ec\u00e5\u00ed\u00e8 \u00cc\u00ee\u00f6\u00e0\u00f0\u00f2\u00bb; \u00ab\u00d8\u00ee\u00f1\u00f2\u00e0\u00ea\u00ee\u00e2\u00e8\u00f7 \u2013 \u00e7\u00ed\u00e0\u00ea\u00ee\u00ec\u00fb\u00e9 \u00e8 \u00ed\u00e5\u00e7\u00ed\u00e0\u00ea\u00ee\u00ec\u00fb\u00e9\u00bb; \u00ab\u00ca\u00ee\u00ec\u00ef\u00ee\u00e7\u00e8\u00f2\u00ee\u00f0 \u00d0\u00f3\u00e2\u00e8\u00ec \u00cf\u00e5\u00f0\u00e3\u00e0\u00ec\u00e5\u00ed\u00f2. \u00ca 100-\u00eb\u00e5\u00f2\u00e8\u00fe \u00f1\u00ee \u00e4\u00ed\u00ff \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff\u00bb (2006). \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f1\u00e5\u00f0\u00e8\u00e8 \u00f1\u00f2\u00e0\u00f2\u00e5\u00e9 \u00ee \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00ff\u00f5 \u00ef\u00f0\u00ee\u00f4\u00e5\u00f1\u00f1\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00e0 \u00e4\u00eb\u00ff \u00ab\u00dd\u00ed\u00f6\u00e8\u00ea\u00eb\u00ee\u00ef\u00e5\u00e4\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8\u00bb (2006-2009). \u00d7\u00eb\u00e5\u00ed \u00c1\u00eb\u00e0\u00e3\u00ee\u00f2\u00e2\u00ee\u00f0\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00e3\u00ee \u00d4\u00ee\u00ed\u00e4\u00e0 \u00ab\u00cf\u00ee\u00ef\u00e5\u00f7\u00e8\u00f2\u00e5\u00eb\u00e8 \u00f5\u00f0\u00e0\u00ec\u00e0 \u00d1\u00e2\u00ff\u00f2\u00ee\u00e9 \u00d2\u00f0\u00ee\u00e8\u00f6\u00fb \u00e2 \u00f1\u00e5\u00eb\u00e5 \u00ca\u00ee\u00ed\u00f7\u00e5\u00e7\u00e5\u00f0\u00ee\u00bb \u00e8 \u00e2\u00e5\u00e4\u00f3\u00f9\u00e0\u00ff \u00f6\u00e8\u00ea\u00eb\u00e0 \u00c1\u00eb\u00e0\u00e3\u00ee\u00f2\u00e2\u00ee\u00f0\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00fb\u00f5 \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00ee\u00e2, \u00ee\u00f0\u00e3\u00e0\u00ed\u00e8\u00e7\u00f3\u00e5\u00ec\u00fb\u00f5 \u00d4\u00ee\u00ed\u00e4\u00ee\u00ec \u00e2 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00f3 \u00e2\u00ee\u00e7\u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff \u00f1\u00f2\u00e0\u00f0\u00e8\u00ed\u00ed\u00ee\u00e3\u00ee \u00f5\u00f0\u00e0\u00ec\u00e0 (2007-2018). \u00c0\u00e2\u00f2\u00ee\u00f0 \u00f6\u00e8\u00ea\u00eb\u00ee\u00e2 \u00ee\u00e1\u00f9\u00e5\u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00ed\u00fb\u00f5 \u00eb\u00e5\u00ea\u00f6\u00e8\u00e9 \u00ee \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00eb\u00fc\u00ed\u00ee\u00ec \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2\u00e5 \u00ab\u00cf\u00f0\u00ee\u00e3\u00f3\u00eb\u00ea\u00e8 \u00f1 \u00cc\u00ee\u00f6\u00e0\u00f0\u00f2\u00ee\u00ec\u00bb, \u00ab\u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00e2 \u00e4\u00ee\u00ec\u00e5 \u00d2\u00ee\u00eb\u00f1\u00f2\u00fb\u00f5\u00bb, \u00ab\u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00e2 \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff\u00f5 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb\u00bb \u00e2 \u00ef\u00f0\u00ee\u00e3\u00f0\u00e0\u00ec\u00ec\u00e5 \u00ab\u00ce\u00f2\u00ea\u00f0\u00fb\u00f2\u00ee\u00e3\u00ee \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2\u00e0\u00bb \u00cf\u00e5\u00f2\u00f0\u00c3\u00d3 (2012-2019). \u00c0\u00e2\u00f2\u00ee\u00f0 \u00e4\u00ee\u00ef\u00ee\u00eb\u00ed\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00e9 \u00ef\u00f0\u00ee\u00f4\u00e5\u00f1\u00f1\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00ef\u00f0\u00ee\u00e3\u00f0\u00e0\u00ec\u00ec\u00fb \u00ef\u00ee\u00e2\u00fb\u00f8\u00e5\u00ed\u00e8\u00ff \u00ea\u00e2\u00e0\u00eb\u00e8\u00f4\u00e8\u00ea\u00e0\u00f6\u00e8\u00e8 \u00ab\u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00e2 \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff\u00f5 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb\u00bb (2023). \u00c0\u00e2\u00f2\u00ee\u00f0 \u00e8 \u00e2\u00e5\u00e4\u00f3\u00f9\u00e0\u00ff \u00f6\u00e8\u00ea\u00eb\u00e0 \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00ee\u00e2 \u00e2\u00a0 \u00cc\u00f3\u00e7\u00e5\u00e5-\u00f3\u00f1\u00e0\u00e4\u00fc\u00e1\u00e5 \u00cb.\u00cd. \u00d2\u00ee\u00eb\u00f1\u00f2\u00ee\u00e3\u00ee \u00ab\u00df\u00f1\u00ed\u00e0\u00ff \u00cf\u00ee\u00eb\u00ff\u00ed\u00e0\u00bb \u00ab\u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00e2 \u00e4\u00ee\u00ec\u00e5 \u00d2\u00ee\u00eb\u00f1\u00f2\u00fb\u00f5\u00bb (2014-2023). \u00ce\u00eb\u00fc\u00e3\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e2\u00ed\u00e0 \u00ed\u00e0\u00e3\u00f0\u00e0\u00e6\u00e4\u00e5\u00ed\u00e0 \u00ef\u00ee\u00f7\u00e5\u00f2\u00ed\u00ee\u00e9 \u00e3\u00f0\u00e0\u00ec\u00ee\u00f2\u00ee\u00e9 \u00cc\u00e8\u00ed\u00e8\u00f1\u00f2\u00e5\u00f0\u00f1\u00f2\u00e2\u00e0 \u00ee\u00e1\u00f0\u00e0\u00e7\u00ee\u00e2\u00e0\u00ed\u00e8\u00ff \u00e8 \u00ef\u00ee \u00e4\u00e5\u00eb\u00e0\u00ec \u00ec\u00ee\u00eb\u00ee\u00e4\u00e5\u00e6\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00e7\u00e0 \u00e1\u00ee\u00eb\u00fc\u00f8\u00ee\u00e9 \u00e2\u00ea\u00eb\u00e0\u00e4 \u00e2 \u00e2\u00ee\u00f1\u00ef\u00e8\u00f2\u00e0\u00ed\u00e8\u00e5 \u00e8 \u00e4\u00ee\u00ef\u00ee\u00eb\u00ed\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00e5 \u00ee\u00e1\u00f0\u00e0\u00e7\u00ee\u00e2\u00e0\u00ed\u00e8\u00e5 \u00e4\u00e5\u00f2\u00e5\u00e9 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff (1999). \u00cf\u00e0\u00ec\u00ff\u00f2\u00ed\u00fb\u00e9 \u00ed\u00e0\u00e3\u00f0\u00f3\u00e4\u00ed\u00fb\u00e9 \u00e7\u00ed\u00e0\u00ea \u00ab300 \u00eb\u00e5\u00f2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00f3\u00bb(2003). \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00d1\u00eb\u00ee\u00e2\u00ee \u00ea \u00ea\u00ee\u00ed\u00f6\u00e5\u00f0\u00f2\u00f3 \u00ab\u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00ef\u00ee\u00e2\u00e5\u00f1\u00f2\u00e8 \u00d2\u00ee\u00eb\u00f1\u00f2\u00ee\u00e3\u00ee \u00ab\u00c4\u00e5\u00f2\u00f1\u00f2\u00e2\u00ee\u00bb \u00c2\u00fb\u00f1\u00f2\u00f3\u00ef\u00eb\u00e5\u00ed\u00e8\u00e5 \u00ed\u00e0 \u00f1\u00f6\u00e5\u00ed\u00e5 \u00c4\u00ee\u00ec\u00e0 \u00ca\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00ab\u00df\u00f1\u00ed\u00e0\u00ff \u00cf\u00ee\u00eb\u00ff\u00ed\u00e0\u00bb \u00e2 \u00e4\u00e5\u00ed\u00fc 191-\u00e9 \u00e3\u00ee\u00e4\u00ee\u00e2\u00f9\u00e8\u00ed\u00fb \u00f1\u00ee \u00e4\u00ed\u00ff \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff \u00cb. \u00cd. \u00d2\u00ee\u00eb\u00f1\u00f2\u00ee\u00e3\u00ee \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00e2 \u00e4\u00ee\u00ec\u00e5 \u00d2\u00ee\u00eb\u00f1\u00f2\u00fb\u00f5 \u00d0\u00e0\u00e4\u00e8\u00ee\u00e1\u00e5\u00f1\u00e5\u00e4\u00e0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e0 \u00cc\u00e0\u00f0\u00fc\u00ff\u00ed\u00fb \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00ee\u00e2\u00ee\u00e9 \u00f1 \u00ec\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4\u00ee\u00ec \u00ce\u00eb\u00fc\u00e3\u00ee\u00e9 \u00c1\u00e5\u00eb\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cf\u00b8\u00f2\u00f0 \u00d2\u00ee\u00e4\u00ee\u00f0\u00ee\u00e2\u00f1\u00ea\u00e8\u00e9. \u00cc\u00f3\u00e7\u00fb\u00ea\u00e0 \u00e2 \u00e6\u00e8\u00e7\u00ed\u00e8 \u00e8 \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e5 \u00d0\u00e0\u00e4\u00e8\u00ee\u00e1\u00e5\u00f1\u00e5\u00e4\u00e0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e0 \u00cc\u00e0\u00f0\u00fc\u00ff\u00ed\u00fb \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00ee\u00e2\u00ee\u00e9 \u00f1 \u00ec\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4\u00ee\u00ec \u00ce\u00eb\u00fc\u00e3\u00ee\u00e9 \u00c1\u00e5\u00eb\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c2\u00ee\u00e9\u00ed\u00e0 \u00e8 \u00ec\u00f3\u00e7\u00fb \u00cf\u00e5\u00f2\u00f0\u00e0 \u00d2\u00ee\u00e4\u00ee\u00f0\u00ee\u00e2\u00f1\u00ea\u00ee\u00e3\u00ee \u00ce. \u00c0. \u00c1\u00e5\u00eb\u00ee\u00e2\u00e0, \u00ec\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4, \u00e7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00fb\u00e9 \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc \u00e8\u00f1\u00ea\u00f3\u00f1\u00f1\u00f2\u00e2 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00ab\u00c6\u00e8\u00e7\u00ed\u00fc \u00e8 \u00ec\u00f3\u00e7\u00fb\u00ea\u00e0\u00bb \u00c8\u00ed\u00f2\u00e5\u00f0\u00e2\u00fc\u00fe \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00e0 \u00cc\u00e0\u00f0\u00fc\u00ff\u00ed\u00fb \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00ee\u00e2\u00ee\u00e9 \u00f1 \u00ec\u00f3\u00e7\u00fb\u00ea\u00ee\u00e2\u00e5\u00e4\u00ee\u00ec \u00ce\u00eb\u00fc\u00e3\u00ee\u00e9 \u00c1\u00e5\u00eb\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

  "url": "http://ar.wikiversity.org/wiki/%D8%A7%D9%84%D8%A3%D8%B9%D8%AF%D8%A7%D8%AF_%D8%A7%D9%84%D8%B9%D9%82%D8%AF%D9%8A%D8%A9",
  "title": "\u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u0641\u064a \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a\u060c \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0639\u0642\u062f\u064a \u0623\u0648 \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0645\u0631\u0643\u0628 (\u0628\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629: Nombre complexe\u060c \u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629: Complex number) \u0647\u0648 \u0623\u064a \u0639\u062f\u062f \u064a\u0643\u062a\u0628 \u0639\u0644\u0649 \u0627\u0644\u0635\u0648\u0631\u0629 a + b i {\\displaystyle a+bi\\,} \u062d\u064a\u062b a {\\displaystyle a} \u0648 b {\\displaystyle b} \u0639\u062f\u062f\u0627\u0646 \u062d\u0642\u064a\u0642\u064a\u0627\u0646 \u0648 i {\\displaystyle i} \u0639\u062f\u062f \u062e\u064a\u0627\u0644\u064a \u0645\u0631\u0628\u0639\u0647 \u064a\u0633\u0627\u0648\u064a \u2212 1 {\\displaystyle -1} (\u0623\u064a \u0623\u0646 i 2 = \u2212 1 {\\displaystyle i^{2}=-1} ). \u0639\u062f\u062f \u0645\u0631\u0643\u0628 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0627\u0645\u0629 \u0635\u0646\u0641 \u0641\u0631\u0639\u064a \u0645\u0646 \u0645\u0631\u0628\u0627\u0639 \u0639\u062f\u062f \u0639\u062f\u062f \u0641\u0648\u0642 \u0645\u0631\u0643\u0628 \u0632\u0648\u062c \u0645\u0631\u062a\u0628 \u062c\u0632\u0621 \u0645\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u062c\u0627\u0646\u0628 \u0645\u0646 \u062c\u0648\u0627\u0646\u0628 \u062b\u0646\u0627\u0621 \u0627\u062e\u062a\u0627\u0631 \u0627\u0644\u0627\u0633\u0645 \u0644\u0627\u0632\u0627\u0631 \u0643\u0627\u0631\u0646\u0648 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0635\u064a\u063a\u0629 z = x + i y {\\displaystyle z=x+\\mathrm {i} y} \u0627\u0644\u0631\u0645\u0648\u0632 \u0641\u064a \u0627\u0644\u0635\u064a\u063a\u0629 z {\\displaystyle z} x {\\displaystyle x} y {\\displaystyle y} i {\\displaystyle \\mathrm {i} } \u0644\u0647 \u0645\u064a\u0632\u0629 \u0627\u0644\u0642\u0627\u0626\u0645\u0629 ... \u0642\u064a\u0645\u0629 \u0645\u0637\u0644\u0642\u0629 \u0639\u0645\u062f\u0629 \u0639\u062f\u062f \u0645\u0631\u0643\u0628 \u062c\u0632\u0621 \u062a\u062e\u064a\u0644\u064a \u062c\u0632\u0621 \u062d\u0642\u064a\u0642\u064a \u0645\u0639\u064a\u0627\u0631 \u0639\u062f\u062f \u0645\u0631\u0643\u0628 \u0644\u0647 \u062c\u0632\u0621 \u0623\u0648 \u0623\u062c\u0632\u0627\u0621 \u0648\u062d\u062f\u0629 \u062a\u062e\u064a\u0644\u064a\u0629 \u0639\u062f\u062f \u062d\u0642\u064a\u0642\u064a \u062c\u0632\u0621 \u062d\u0642\u064a\u0642\u064a \u062c\u0632\u0621 \u062a\u062e\u064a\u0644\u064a \u0627\u0644\u0646\u0642\u064a\u0636 \u0639\u062f\u062f \u062d\u0642\u064a\u0642\u064a \u0645\u0631\u0628\u0627\u0639 \u062a\u0639\u062f\u064a\u0644 - \u062a\u0639\u062f\u064a\u0644 \u0645\u0635\u062f\u0631\u064a - \u062a\u0639\u062f\u064a\u0644 \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u062d\u062a\u0648\u0649 [ \u0639\u062f\u0644 ] \u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0642\u0631\u0629 \u0644\u0639\u0631\u0636 \u0645\u062d\u062a\u0648\u0627\u0647\u0627 \u0643\u0627\u0645\u0644\u0627. \u0627\u0644\u0641\u0642\u0631\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u2102 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0627\u0644\u0634\u0643\u0644 \u0627\u0644\u062c\u0628\u0631\u064a \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u062a\u0633\u0627\u0648\u064a \u0639\u062f\u062f\u064a\u0646 \u0639\u0642\u062f\u064a\u064a\u0646 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0641\u064a \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0627\u0644\u0634\u0643\u0644 \u0627\u0644\u062c\u0628\u0631\u064a \u0644\u0645\u062c\u0645\u0648\u0639 \u0648\u062c\u062f\u0627\u0621 \u0639\u062f\u062f\u064a\u0646 \u0639\u0642\u062f\u064a\u064a\u0646 \u0645\u0642\u0627\u0628\u0644 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0645\u0642\u0644\u0648\u0628 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u062e\u0627\u0631\u062c \u0639\u062f\u062f\u064a\u0646 \u0639\u0642\u062f\u064a\u064a\u0646 \u0627\u0644\u062a\u0645\u062b\u064a\u0644 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0644\u062d\u0642 \u0646\u0642\u0637\u0629\u060c \u0644\u062d\u0642 \u0645\u062a\u062c\u0647\u0629 \u0627\u0644\u062a\u0623\u0648\u064a\u0644 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u0644\u0644\u0645\u062c\u0645\u0648\u0639 \u0648\u0627\u0644\u0641\u0631\u0642 \u0648\u0627\u0644\u0636\u0631\u0628 \u0641\u064a \u0639\u062f\u062f \u062d\u0642\u064a\u0642\u064a \u0627\u0644\u062a\u0623\u0648\u064a\u0644 \u0627\u0644\u0639\u0642\u062f\u064a \u0644\u0644\u0627\u0633\u062a\u0642\u0627\u0645\u064a\u0629 \u0648\u0627\u0644\u062a\u0648\u0627\u0632\u064a \u0648\u0627\u0644\u0645\u0631\u062c\u062d \u0645\u0631\u0627\u0641\u0642 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u0648\u0627\u0644\u062a\u0623\u0648\u064a\u0644 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u062e\u0627\u0635\u064a\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0641\u0642 \u0645\u0639\u064a\u0627\u0631 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u0648\u0627\u0644\u062a\u0623\u0648\u064a\u0644 \u0627\u0644\u0647\u0646\u062f\u0633\u064a \u062e\u0627\u0635\u064a\u0627\u062a \u0627\u0644\u0645\u0639\u064a\u0627\u0631 \u0627\u0644\u0623\u0634\u0643\u0627\u0644 \u0627\u0644\u0645\u062b\u0644\u062b\u064a\u0629 \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u0639\u0645\u062f\u0629 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0645\u0639\u064a\u0627\u0631\u0647 \u0627\u0644\u0648\u062d\u062f\u0629 \u0639\u0645\u062f\u0629 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u0634\u0643\u0644 \u0645\u062b\u0644\u062b\u064a \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u062e\u0627\u0635\u064a\u0627\u062a \u0627\u0644\u0639\u0645\u062f\u0629 \u0632\u0627\u0648\u064a\u0629 \u0645\u062a\u062c\u0647\u062a\u064a\u0646 \u0648\u0639\u0645\u062f\u0629 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0627\u0644\u062a\u0631\u0645\u064a\u0632 \u0627\u0644\u0623\u0633\u064a \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0641\u064a \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0645\u062b\u0644\u062b\u064a \u0627\u0644\u062c\u0630\u0648\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u0627\u0644\u062c\u0630\u0648\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0644\u0644\u0648\u062d\u062f\u0629 \u0627\u0644\u062c\u0630\u0648\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u0627\u0644\u0645\u0639\u0627\u062f\u0644\u0627\u062a \u0645\u0646 \u0627\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0628\u0645\u062c\u0647\u0648\u0644 \u0639\u0642\u062f\u064a \u0627\u0644\u062c\u0630\u0631\u0627\u0646 \u0627\u0644\u0645\u0631\u0628\u0639\u0627\u0646 \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u062c\u0644 \u0627\u0644\u0645\u0639\u0627\u062f\u0644\u0629 \u0645\u0646 \u0627\u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629 \u0641\u064a \u2102 \u0627\u0644\u0643\u062a\u0627\u0628\u0627\u062a \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0644\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u0627\u0639\u062a\u064a\u0627\u062f\u064a\u0629 \u0627\u0644\u0625\u0632\u0627\u062d\u0629 \u0627\u0644\u062a\u062d\u0627\u0643\u064a \u0627\u0644\u062f\u0648\u0631\u0627\u0646 \u0645\u0631\u0643\u0628\u0627\u062a \u0628\u0639\u0636 \u0627\u0644\u062a\u062d\u0648\u064a\u0644\u0627\u062a \u0627\u0644\u0627\u0639\u062a\u064a\u0627\u062f\u064a\u0629 \u0627\u0646\u0638\u0631 \u0623\u064a\u0636\u0627 [ \u0639\u062f\u0644 ] \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0647\u0646\u0627\u0643 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 \u062d\u0648\u0644: \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u2102 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u0623\u0639\u062f\u0627\u062f_\u0627\u0644\u0639\u0642\u062f\u064a\u0629&oldid=145425 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u062d\u062f\u0629 \u0628\u0637\u0627\u0642\u0629 \u0645\u0642\u0627\u0644\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0648\u0627\u0644\u0628 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u062e\u0627\u0635\u064a\u0629 P10 \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0631\u0633\u0627\u0644\u0629 \u0646\u0637\u0627\u0642 \u0645\u0639 \u0648\u0633\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 \u062c\u0628\u0631 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0642\u0627\u0644\u0628:Notice \u0628\u0648\u0633\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 5 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

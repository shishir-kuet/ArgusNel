{
  "url": "http://ar.wikibooks.org/wiki/%D8%AE%D8%A7%D8%B5:%D9%85%D8%B3%D8%A7%D8%B9%D8%AF%D8%A9_%D8%A5%D9%8A%D9%87_%D8%A8%D9%8A_%D8%A2%D9%8A/setglobalaccountstatus",
  "title": "\u0645\u0633\u0627\u0639\u062f\u0629 API \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0645\u0633\u0627\u0639\u062f\u0629 API \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0645\u0633\u0627\u0639\u062f\u0629 API \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a \u0647\u0630\u0647 \u0635\u0641\u062d\u0629 \u062a\u0648\u062b\u064a\u0642 \u0645\u064a\u062f\u064a\u0627\u0648\u064a\u0643\u064a API \u0627\u0644\u062a\u064a \u062a\u0645 \u0625\u0646\u0634\u0627\u0624\u0647\u0627 \u062a\u0644\u0642\u0627\u0626\u064a\u0627. \u0648\u062b\u0627\u0626\u0642 \u0648\u0623\u0645\u062b\u0644\u0629: https://www.mediawiki.org/wiki/Special:MyLanguage/API:Main_page action=setglobalaccountstatus ( main | setglobalaccountstatus ) \u0647\u0630\u0647 \u0627\u0644\u0648\u062d\u062f\u0629 \u062a\u062a\u0637\u0644\u0628 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629. \u0647\u0630\u0647 \u0627\u0644\u0648\u062d\u062f\u0629 \u062a\u062a\u0637\u0644\u0628 \u0635\u0644\u0627\u062d\u064a\u0627\u062a \u0627\u0644\u0643\u062a\u0627\u0628\u0629. \u0647\u0630\u0647 \u0627\u0644\u0648\u062d\u062f\u0629 \u062a\u0642\u0628\u0644 \u0637\u0644\u0628\u0627\u062a POST \u0641\u0642\u0637. \u0627\u0644\u0645\u0635\u062f\u0631: CentralAuth \u0627\u0644\u062a\u0631\u062e\u064a\u0635: GPL-2.0-or-later \u0625\u062e\u0641\u0627\u0621 \u0623\u0648 \u0642\u0641\u0644 (\u0623\u0648 \u0625\u0638\u0647\u0627\u0631 \u0623\u0648 \u0625\u0644\u063a\u0627\u0621 \u0642\u0641\u0644) \u062d\u0633\u0627\u0628 \u0645\u0633\u062a\u062e\u062f\u0645 \u0639\u0627\u0644\u0645\u064a. \u0645\u0639\u0644\u0645\u0627\u062a \u0645\u062d\u062f\u062f\u0629: \u0627\u0644\u0645\u0639\u0644\u0645\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0627\u0644\u0623\u062e\u0631\u0649 \u0645\u062a\u0627\u062d\u0629. user \u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u062a\u063a\u064a\u064a\u0631 \u062d\u0627\u0644\u062a\u0647. \u0647\u0630\u0647 \u0627\u0644\u0645\u0639\u0644\u0645\u0629 \u0645\u0637\u0644\u0648\u0628\u0629. locked \u062a\u063a\u064a\u064a\u0631 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u062d\u0645\u064a\u0627 \u0623\u0645 \u0644\u0627. \u0625\u062d\u062f\u0649 \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u062a\u0627\u0644\u064a\u0629: \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0641\u0627\u0631\u063a\u064b\u0627 \u060c \u0623\u0648 lock\u060c unlock hidden \u062a\u063a\u064a\u064a\u0631 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u063a\u064a\u0631 \u0645\u062e\u0641\u064a \u0623\u0648 \u0645\u062e\u0641\u064a \u0645\u0646 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u064a\u0646 \u0623\u0648 \u0645\u0632\u0627\u0644. \u0625\u062d\u062f\u0649 \u0627\u0644\u0642\u064a\u0645 \u0627\u0644\u062a\u0627\u0644\u064a\u0629: \u064a\u0645\u0643\u0646 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0641\u0627\u0631\u063a\u064b\u0627 \u060c \u0623\u0648 lists\u060c suppressed reason \u0633\u0628\u0628 \u062a\u063a\u064a\u064a\u0631 \u0648\u0636\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645. statecheck MD5 \u0627\u062e\u062a\u064a\u0627\u0631\u064a \u0645\u0646 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062d\u0627\u0644\u064a:\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645: \u0645\u062e\u0641\u064a: \u0645\u063a\u0644\u0642. \u064a\u0633\u062a\u062e\u062f\u0645 \u0647\u0630\u0627 \u0644\u0644\u0643\u0634\u0641 \u0639\u0646 \u0635\u0631\u0627\u0639\u0627\u062a \u0627\u0644\u062a\u062d\u0631\u064a\u0631. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0642\u064a\u0645\u0629 \u0645\u062e\u0641\u064a\u0629 \u0633\u0644\u0633\u0644\u0629 \u0641\u0627\u0631\u063a\u0629 \u0625\u0630\u0627 \u0644\u0645 \u062a\u0643\u0646 \u0645\u062e\u0641\u064a\u0629 \u0623\u0648 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0642\u0627\u0626\u0645\u0629 \u0623\u0648 \u0642\u0645\u0639. \u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0642\u064a\u0645\u0629 \u0645\u0642\u0641\u0644 1 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0645\u0642\u0641\u0644\u0629 \u0648 0 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0645\u0641\u062a\u0648\u062d\u0629. \u0623\u0645\u062b\u0644\u0629: 2128506: \u0644\u064a \u0633\u0645\u064a\u062b::0 ; 3839611: \u0641\u0627\u0646\u062f\u0627\u0644 \u063a\u0648\u0628\u0644\u064a\u0646: \u0642\u064f\u0644\u0650\u0628:1. token \u062a\u0645 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0631\u0645\u0632 \u0645\u0645\u064a\u0632 \"setglobalaccountstatus\" \u0645\u0646 action=query&meta=tokens \u0647\u0630\u0647 \u0627\u0644\u0645\u0639\u0644\u0645\u0629 \u0645\u0637\u0644\u0648\u0628\u0629. \u0623\u0645\u062b\u0644\u0629: \u0645\u0646\u0639 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0644\u0640User:Example \u0628\u0633\u0628\u0628 \"\u0633\u062e\u0627\u0645\" api.php?action=setglobalaccountstatus&user=Example&locked=lock&hidden=&reason=Spam [\u0641\u062a\u062d \u0641\u064a \u0645\u0644\u0639\u0628] \u0645\u0646\u0639 \u0648\u0642\u0645\u0639 \u0627\u0644\u062d\u0633\u0627\u0628 \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0644\u0640User:Example \u0628\u0633\u0628\u0628 \"\u0623\u0633\u062a\u0637\u064a\u0639\" api.php?action=setglobalaccountstatus&user=Example&locked=unlock&hidden=suppressed&reason=I%20can [\u0641\u062a\u062d \u0641\u064a \u0645\u0644\u0639\u0628] \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/wiki/\u062e\u0627\u0635:\u0645\u0633\u0627\u0639\u062f\u0629_\u0625\u064a\u0647_\u0628\u064a_\u0622\u064a \u00bb",

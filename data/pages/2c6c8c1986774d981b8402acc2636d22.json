  "url": "http://ar.wikiversity.org/wiki/%D8%AA%D8%B5%D9%86%D9%8A%D9%81:%D8%A7%D9%84%D8%A3%D9%82%D8%B3%D8%A7%D9%85",
  "title": "\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u0623\u0642\u0633\u0627\u0645 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u0623\u0642\u0633\u0627\u0645 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u0647\u0646\u0627\u0643 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 \u062d\u0648\u0644: \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u0646\u064a\u0641 \u064a\u062d\u0648\u064a 97 \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0641\u0631\u0639\u064a\u0629\u060c \u0645\u0646 \u0625\u062c\u0645\u0627\u0644\u064a 97. \u0623 \u0623\u0633\u0627\u0633\u064a\u0627\u062a \u0648\u0645\u0641\u0627\u0647\u064a\u0645 \u0639\u0644\u0648\u0645 \u0627\u0644\u0643\u0645\u0628\u064a\u0648\u062a\u0631 (11 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0625 \u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u063a\u0627\u0628\u0627\u062a (6 \u062a\u0635\u0646\u064a\u0641\u060c 10 \u0635\u0641\u062d\u0629) \u0625\u0646\u0633\u0627\u0646\u064a\u0627\u062a (1 \u062a\u0635\u0646\u064a\u0641) \u0627 \u0627\u0644\u0623\u0634\u0639\u0629 \u0648\u0627\u0644\u062a\u0635\u0648\u064a\u0631 \u0627\u0644\u0637\u0628\u064a (1 \u0635\u0641\u062d\u0629) \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a (2 \u0635\u0641\u062d\u0629) \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0646\u0638\u0631\u064a\u0629 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 (2 \u0635\u0641\u062d\u0629) \u0627\u0644\u062b\u0642\u0627\u0641\u0629 \u0627\u0644\u0627\u0633\u0644\u0627\u0645\u064a\u0629 (11 \u062a\u0635\u0646\u064a\u0641) \u0627\u0644\u062c\u0631\u0627\u062d\u0629 (2 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0627\u0644\u0631\u0633\u0645 (1 \u0635\u0641\u062d\u0629) \u0627\u0644\u0634\u0628\u0643\u0627\u062a (8 \u062a\u0635\u0646\u064a\u0641) \u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u0641\u0648\u062a\u0648\u063a\u0631\u0627\u0641\u064a\u0629 (1 \u0635\u0641\u062d\u0629) \u0627\u0644\u0637\u0628 \u0627\u0644\u0628\u0627\u0637\u0646\u064a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0637\u0628 \u0627\u0644\u0628\u062f\u064a\u0644 (\u0641\u0627\u0631\u063a) \u0627\u0644\u0637\u0628 \u0627\u0644\u0634\u0631\u0639\u064a (1 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0627\u0644\u0637\u0628 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0626\u064a \u0648\u0627\u0644\u0631\u064a\u0627\u0636\u064a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0637\u0628 \u0627\u0644\u0645\u062e\u0628\u0631\u064a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0637\u0628 \u0627\u0644\u0646\u0641\u0633\u064a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0637\u0628 \u0627\u0644\u0646\u0648\u0648\u064a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0621 \u0627\u0644\u0641\u0644\u0643\u064a\u0629 (4 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u062c\u0646\u0627\u0626\u064a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u062f\u0648\u0644\u064a (\u0641\u0627\u0631\u063a) \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0648\u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u062d\u0631\u0648\u0641 \u0641\u064a \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0623\u0645\u0627\u0632\u064a\u063a\u064a\u0629 (2 \u0635\u0641\u062d\u0629) \u0627\u0644\u0643\u064a\u0645\u064a\u0627\u0621 \u0627\u0644\u0639\u0636\u0648\u064a\u0629 (8 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0627\u0644\u0645\u0647\u0627\u0631\u0627\u062a \u0627\u0644\u0633\u0631\u064a\u0631\u064a\u0629 (2 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0627\u0644\u0647\u0646\u062f\u0633\u0629 \u0627\u0644\u0632\u0631\u0627\u0639\u064a\u0629 (4 \u062a\u0635\u0646\u064a\u0641) \u0628 \u0628\u064a\u0648\u0644\u0648\u062c\u064a\u0627 \u0627\u0644\u0641\u0636\u0627\u0621 (4 \u062a\u0635\u0646\u064a\u0641) \u062a \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a (2 \u0635\u0641\u062d\u0629) \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0631\u0628 (1 \u062a\u0635\u0646\u064a\u0641) \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0639\u0635\u0648\u0631 \u0627\u0644\u0648\u0633\u0637\u0649 (1 \u0635\u0641\u062d\u0629) \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0641\u0646 (1 \u0635\u0641\u062d\u0629) \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u0644\u0627\u062d\u0629 \u0627\u0644\u0641\u0636\u0627\u0626\u064a\u0629 (3 \u062a\u0635\u0646\u064a\u0641) \u062a\u0627\u0631\u064a\u062e \u0639\u0644\u0645 \u0627\u0644\u0641\u0644\u0643 (10 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u062a\u0631\u062e\u064a\u0635 \u0627\u0644\u0645\u062c\u0644\u0633 \u0627\u0644\u0637\u0628\u064a \u0627\u0644\u0643\u0646\u062f\u064a (2 \u062a\u0635\u0646\u064a\u0641) \u062a\u0634\u0631\u064a\u062d \u0627\u0644\u0623\u0639\u0636\u0627\u0621 (\u0641\u0627\u0631\u063a) \u062a\u0634\u0631\u064a\u062d \u0627\u0644\u0625\u0646\u0633\u0627\u0646 (\u0641\u0627\u0631\u063a) \u062a\u0634\u0631\u064a\u062d \u0627\u0644\u062f\u0645\u0627\u063a (\u0641\u0627\u0631\u063a) \u062a\u0634\u0631\u064a\u062d \u0627\u0644\u0639\u0636\u0644\u0627\u062a (\u0641\u0627\u0631\u063a) \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u062d\u0627\u0633\u0648\u0628 (22 \u062a\u0635\u0646\u064a\u0641) \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0648\u064a\u0628 (\u0641\u0627\u0631\u063a) \u0635 \u0635\u0648\u062a\u064a\u0627\u062a (1 \u0635\u0641\u062d\u0629) \u0637 \u0637\u0628 \u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0630\u0643\u0648\u0631\u0629 \u0648\u0627\u0644\u0639\u0642\u0645 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0646\u0633\u0627\u0621 \u0648\u0627\u0644\u0648\u0644\u0627\u062f\u0629 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0623\u0630\u0646 \u0648\u0627\u0644\u0623\u0646\u0641 \u0648\u0627\u0644\u062d\u0646\u062c\u0631\u0629 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0623\u0633\u0631\u0629 \u0648 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0623\u0633\u0646\u0627\u0646 (1 \u062a\u0635\u0646\u064a\u0641) \u0637\u0628 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0623\u0648\u0631\u0627\u0645 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u062a\u062e\u062f\u064a\u0631 \u0648\u0627\u0644\u0625\u0646\u0639\u0627\u0634 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u062a\u0634\u0631\u064a\u062d (5 \u062a\u0635\u0646\u064a\u0641\u060c 2 \u0635\u0641\u062d\u0629) \u0637\u0628 \u0627\u0644\u062c\u0644\u062f (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0647\u0636\u0645\u064a (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0631\u0639\u0627\u064a\u0629 \u0627\u0644\u0623\u0648\u0644\u064a\u0629 (2 \u062a\u0635\u0646\u064a\u0641) \u0637\u0628 \u0627\u0644\u0634\u064a\u062e\u0648\u062e\u0629 (1 \u0635\u0641\u062d\u0629) \u0637\u0628 \u0627\u0644\u0639\u0642\u0627\u0642\u064a\u0631 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0639\u064a\u0648\u0646 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u063a\u062f\u062f \u0627\u0644\u0635\u0645\u0627\u0621 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0642\u0644\u0628 \u0648\u0627\u0644\u0623\u0648\u0639\u064a\u0629 \u0627\u0644\u062f\u0645\u0648\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0637\u0628 \u0627\u0644\u0645\u062c\u062a\u0645\u0639 (2 \u062a\u0635\u0646\u064a\u0641) \u0637\u0628 \u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u0623\u0639\u0636\u0627\u0621 (8 \u062a\u0635\u0646\u064a\u0641\u060c 3 \u0635\u0641\u062d\u0629) \u0637\u0631\u0642 \u0648\u0644\u063a\u0627\u062a \u0627\u0644\u0628\u0631\u0645\u062c\u0629 (22 \u062a\u0635\u0646\u064a\u0641) \u0639 \u0639\u0644\u0645 \u0627\u0644\u0622\u062b\u0627\u0631 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a\u0629 (1 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0627\u0644\u0623\u0646\u0633\u062c\u0629 (\u0641\u0627\u0631\u063a) \u0639\u0644\u0645 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 (1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0627\u0644\u062e\u0644\u0627\u064a\u0627 (1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0627\u0644\u0631\u0635\u062f \u0627\u0644\u0641\u0644\u0643\u064a (3 \u062a\u0635\u0646\u064a\u0641) \u0639\u0644\u0645 \u0627\u0644\u0641\u0644\u0643 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u062c\u0631\u0629 (2 \u062a\u0635\u0646\u064a\u0641) \u0639\u0644\u0645 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0621 \u0627\u0644\u0625\u062d\u0635\u0627\u0626\u064a\u0629 (\u0641\u0627\u0631\u063a) \u0639\u0644\u0645 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0621 \u0627\u0644\u0630\u0631\u064a\u0629 (13 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0627\u0644\u0643\u0627\u0626\u0646\u0627\u062a \u0627\u0644\u0623\u062b\u0631\u064a\u0629 (1 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0627\u0644\u0643\u064a\u0645\u064a\u0627\u0621 \u0627\u0644\u062d\u064a\u0648\u064a\u0629 (1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0627\u0644\u0646\u0641\u0633 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a (1 \u062a\u0635\u0646\u064a\u0641) \u0639\u0644\u0645 \u0627\u0644\u0647\u0646\u062f\u0633\u0629 (1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0627\u0644\u0648\u0631\u0627\u062b\u0629 (17 \u062a\u0635\u0646\u064a\u0641) \u0639\u0644\u0645 \u062d\u0631\u0643\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0621 (8 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0641\u0644\u0643 \u0627\u0644\u0645\u062c\u0631\u0629 (5 \u062a\u0635\u0646\u064a\u0641) \u0639\u0644\u0645 \u0641\u064a\u0632\u064a\u0627\u0621 \u0627\u0644\u0645\u0648\u062c\u0627\u062a (23 \u0635\u0641\u062d\u0629) \u0639\u0644\u0645 \u0646\u0638\u0631\u064a\u0627\u062a \u0627\u0644\u0623\u0639\u062f\u0627\u062f (2 \u0635\u0641\u062d\u0629) \u0639\u0644\u0648\u0645 \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 (1 \u062a\u0635\u0646\u064a\u0641) \u0639\u0644\u0648\u0645 \u0627\u0644\u062d\u062f\u064a\u062b (7 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0648\u0645 \u0627\u0644\u0634\u064a\u0639\u0629 (5 \u062a\u0635\u0646\u064a\u0641) \u0639\u0644\u0648\u0645 \u0627\u0644\u0639\u0642\u064a\u062f\u0629 \u0648\u0627\u0644\u0641\u0631\u0642 \u0627\u0644\u0645\u062e\u062a\u0644\u0641\u0629 (4 \u062a\u0635\u0646\u064a\u0641\u060c 1 \u0635\u0641\u062d\u0629) \u0639\u0644\u0648\u0645 \u0627\u0644\u0642\u0631\u0622\u0646 (13 \u062a\u0635\u0646\u064a\u0641\u060c 3 \u0635\u0641\u062d\u0629) \u0639\u0644\u0648\u0645 \u062a\u0637\u0628\u064a\u0642\u064a\u0629 (2 \u062a\u0635\u0646\u064a\u0641) \u0641 \u0641\u062d\u0635 \u0633\u0631\u064a\u0631\u064a \u0645\u0642\u0646\u0646 \u0627\u0644\u0623\u0647\u062f\u0627\u0641 (\u0641\u0627\u0631\u063a) \u0641\u0633\u064a\u0648\u0644\u0648\u062c\u064a\u0627 \u0627\u0644\u062d\u064a\u0648\u0627\u0646 (2 \u0635\u0641\u062d\u0629) \u0641\u0646 \u0627\u0644\u0627\u0641\u0644\u0627\u0645 (1 \u0635\u0641\u062d\u0629) \u0641\u0646 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 (1 \u0635\u0641\u062d\u0629) \u0641\u0646 \u0627\u0644\u0646\u062d\u062a (1 \u0635\u0641\u062d\u0629) \u0642 \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 (18 \u0635\u0641\u062d\u0629) \u0642\u0648\u0627\u0639\u062f \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629 (2 \u0635\u0641\u062d\u0629) \u0644 \u0644\u063a\u0648\u064a\u0627\u062a (139 \u0635\u0641\u062d\u0629) \u0645 \u0645\u0628\u0627\u062f\u0626 \u0627\u0644\u0643\u064a\u0645\u064a\u0627\u0621 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 (5 \u0635\u0641\u062d\u0629) \u0647 \u0647\u0646\u062f\u0633\u0629 \u0628\u064a\u0648\u0643\u064a\u0645\u064a\u0627\u0626\u064a\u0629 (1 \u0635\u0641\u062d\u0629) \u0647\u0646\u062f\u0633\u0629 \u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 (1 \u062a\u0635\u0646\u064a\u0641\u060c 2 \u0635\u0641\u062d\u0629) \u0647\u0646\u062f\u0633\u0629 \u0645\u064a\u0643\u0627\u0646\u064a\u0643\u064a\u0629 (8 \u0635\u0641\u062d\u0629) \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u062a\u0635\u0646\u064a\u0641:\u0627\u0644\u0623\u0642\u0633\u0627\u0645&oldid=143918 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0623\u0642\u0633\u0627\u0645 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u062a\u0635\u0646\u064a\u0641 : \u0627\u0644\u0623\u0642\u0633\u0627\u0645 8 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

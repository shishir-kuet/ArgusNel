  "title": "\u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0645\u064f\u0634\u062a\u064e\u0642\u0651 \u0641\u064a \u0646\u0642\u0637\u0629\u060c \u0639\u0644\u0649 \u0631\u0633\u0645 \u0628\u064a\u0627\u0646\u064a \u0644\u062f\u0627\u0644\u0629 \u0630\u0627\u062a \u0645\u062a\u063a\u064a\u0631\u0627\u062a \u0648\u0642\u064a\u0645 \u062d\u0642\u064a\u0642\u064a\u0629\u060c \u0647\u0648 \u0645\u0639\u0627\u0645\u0644 \u0627\u0644\u0645\u0645\u0627\u0633 \u0627\u0644\u0645\u0648\u062c\u0650\u0651\u0647\u064f. \u0627\u0644\u0645\u062d\u062a\u0648\u0649 [ \u0639\u062f\u0644 ] \u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0642\u0631\u0629 \u0644\u0639\u0631\u0636 \u0645\u062d\u062a\u0648\u0627\u0647\u0627 \u0643\u0627\u0645\u0644\u0627. \u0645\u0634\u062a\u0642 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0627\u0645\u0629 \u0635\u0646\u0641 \u0641\u0631\u0639\u064a \u0645\u0646 \u062f\u0627\u0644\u0629 rate of change (en) \u062c\u0632\u0621 \u0645\u0646 \u062d\u0633\u0627\u0628 \u0627\u0644\u062a\u0641\u0627\u0636\u0644 \u064a\u062f\u0631\u0633\u0647 \u062d\u0633\u0627\u0628 \u0627\u0644\u062a\u0641\u0627\u0636\u0644 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0635\u064a\u063a\u0629 f \u2032 ( x ) = lim h \u2192 0 f ( x + h ) \u2212 f ( x ) h {\\displaystyle f'(x)=\\lim _{h\\to 0}{\\frac {f(x+h)-f(x)}{h}}} \u0627\u0644\u0631\u0645\u0648\u0632 \u0641\u064a \u0627\u0644\u0635\u064a\u063a\u0629 f \u2032 ( x ) {\\displaystyle f'(x)} f ( x ) {\\displaystyle f(x)} lim {\\displaystyle \\lim } \u064a\u0645\u062b\u0644 \u0645\u0639\u062f\u064e\u0651\u0644 \u0645\u0639\u0643\u0648\u0633 \u0631\u064a\u0627\u0636\u064a\u0627\u062a\u064a \u062a\u0643\u0627\u0645\u0644 \u0644\u0647 \u062c\u0632\u0621 \u0623\u0648 \u0623\u062c\u0632\u0627\u0621 differential coefficient (en) \u0627\u0644\u0646\u0642\u064a\u0636 average rate of change (en) \u062a\u0639\u062f\u064a\u0644 - \u062a\u0639\u062f\u064a\u0644 \u0645\u0635\u062f\u0631\u064a - \u062a\u0639\u062f\u064a\u0644 \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0641\u0642\u0631\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0642\u0627\u0628\u0644\u064a\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0634\u062a\u0642\u0627\u0642 \u062f\u0627\u0644\u0629 \u0641\u064a \u0639\u062f\u062f \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0639\u0644\u0649 \u0627\u0644\u064a\u0645\u064a\u0646 - \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0639\u0644\u0649 \u0627\u0644\u064a\u0633\u0627\u0631 \u0642\u0627\u0628\u0644\u064a\u0629 \u0627\u0634\u062a\u0642\u0627\u0642 \u062f\u0627\u0644\u0629 \u0639\u0644\u0649 \u0645\u062c\u0627\u0644 \u0645\u0634\u062a\u0642\u0627\u062a \u0628\u0639\u0636 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0627\u0639\u062a\u064a\u0627\u062f\u064a\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u062a\u0641\u0627\u0636\u0644\u064a\u0629 \u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0645\u0634\u062a\u0642\u0629 \u0645\u0631\u0643\u0628 \u062f\u0627\u0644\u062a\u064a\u0646 \u0645\u0634\u062a\u0642\u0629 \u0627\u0644\u062f\u0627\u0644\u0629 \u0627\u0644\u0639\u0643\u0633\u064a\u0629 \u0645\u0634\u062a\u0642\u0629 \u062f\u0627\u0644\u0629 \u0642\u0648\u0633 \u0627\u0644\u0638\u0644 \u0645\u0634\u062a\u0642\u0629 \u062f\u0627\u0644\u0629 \u0627\u0644\u062c\u0630\u0631 \u0645\u0646 \u0627\u0644\u0631\u062a\u0628\u0629 n \u0645\u0634\u062a\u0642\u0629 \u0627\u0644\u062f\u0627\u0644\u0629 x \u21a6 x n {\\displaystyle x\\mapsto {\\sqrt[{n}]{x}}} \u0645\u0634\u062a\u0642\u0629 \u0627\u0644\u062f\u0627\u0644\u0629 x \u21a6 u ( x ) n {\\displaystyle x\\mapsto {\\sqrt[{n}]{u(x)}}} \u0645\u0634\u062a\u0642\u0627\u062a \u0627\u0644\u062f\u0648\u0627\u0644 x \u21a6 x r {\\displaystyle x\\mapsto x^{r}} \u0648 x \u21a6 ( u ( x ) ) r {\\displaystyle x\\mapsto (u(x))^{r}} \u062d\u064a\u062b r \u2208 Q \u2217 {\\displaystyle r\\in \\mathbb {Q} ^{*}} \u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 - \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0645\u0628\u0631\u0647\u0646\u0629 \u0631\u0648\u0644 \u0645\u0628\u0631\u0647\u0646\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0645\u062a\u0641\u0627\u0648\u062a\u0629 \u0627\u0644\u062a\u0632\u0627\u064a\u062f\u0627\u062a \u0627\u0644\u0645\u0646\u062a\u0647\u064a\u0629 \u0631\u062a\u0627\u0628\u0629 \u062f\u0627\u0644\u0629 \u0639\u062f\u062f\u064a\u0629 \u0627\u0646\u0638\u0631 \u0623\u064a\u0636\u0627 [ \u0639\u062f\u0644 ] \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0646\u0647\u0627\u064a\u0629 \u0645\u062a\u062a\u0627\u0644\u064a\u0629 \u062f\u0631\u0627\u0633\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0639\u062f\u062f\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0644\u0648\u063a\u0627\u0631\u064a\u062a\u0645\u064a\u0629 \u0627\u0644\u062f\u0648\u0627\u0644 \u0627\u0644\u0623\u0633\u064a\u0629 \u0627\u0644\u062a\u0643\u0627\u0645\u0644 \u0627\u0644\u0645\u0639\u0627\u062f\u0644\u0627\u062a \u0627\u0644\u062a\u0641\u0627\u0636\u0644\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0641\u064a \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0627\u0644\u0642\u0627\u0628\u0644\u064a\u0629 \u0644\u0644\u0627\u0634\u062a\u0642\u0627\u0642 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642&oldid=122913 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0642\u0627\u0644\u0628:\u0635\u0646\u062f\u0648\u0642 \u0631\u0633\u0627\u0644\u0629 \u0646\u0637\u0627\u0642 \u0645\u0639 \u0648\u0633\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u062d\u062f\u0629 \u0628\u0637\u0627\u0642\u0629 \u0645\u0642\u0627\u0644\u0627\u062a \u062a\u0633\u062a\u0639\u0645\u0644 \u0642\u0648\u0627\u0644\u0628 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u062e\u0627\u0635\u064a\u0629 P18 \u062a\u062d\u0644\u064a\u0644 \u0631\u064a\u0627\u0636\u064a \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u062a\u0635\u0646\u064a\u0641\u0627\u062a \u0645\u062e\u0641\u064a\u0629: \u0635\u0641\u062d\u0627\u062a \u062a\u0633\u062a\u062e\u062f\u0645 \u0642\u0627\u0644\u0628:Notice \u0628\u0648\u0633\u0627\u0626\u0637 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 \u0635\u0641\u062d\u0627\u062a \u0628\u0647\u0627 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u064a\u0643\u064a \u0628\u064a\u0627\u0646\u0627\u062a \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0627\u0634\u062a\u0642\u0627\u0642 1 \u0644\u063a\u0629 \u0623\u0636\u0641 \u0645\
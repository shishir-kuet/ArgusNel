{
  "url": "http://avtor.karelia.ru/about/ananin_valerii.html",
  "title": "\u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c7\u00ee\u00f1\u00e8\u00ec\u00ee\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c7\u00ee\u00f1\u00e8\u00ec\u00ee\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c7\u00ee\u00f1\u00e8\u00ec\u00ee\u00e2\u00e8\u00f7 ( 20.08.1941 - 14.07.2024 ) \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00cc\u00e5\u00e4\u00e2\u00e5\u00e6\u00fc\u00e5\u00e3\u00ee\u00f0\u00f1\u00ea (\u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff). \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00d4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3, \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2, \u00ef\u00ee\u00fd\u00f2, \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea \u00e0\u00ed\u00e3\u00eb\u00ee\u00ff\u00e7\u00fb\u00f7\u00ed\u00ee\u00e9 \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8. \u00ce\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb \u00f1\u00f0\u00e5\u00e4\u00ed\u00fe\u00fe \u00f8\u00ea\u00ee\u00eb\u00f3 \u00f1 \u00e7\u00ee\u00eb\u00ee\u00f2\u00ee\u00e9 \u00ec\u00e5\u00e4\u00e0\u00eb\u00fc\u00fe. \u0412 1967 \u00e3\u00ee\u00e4\u00f3 \u2013 \u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f4\u00e0\u00ea\u00f3\u00eb\u00fc\u00f2\u00e5\u00f2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e3\u00ee \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2\u00e0. 37 \u00eb\u00e5\u00f2 \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00ed\u00e0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00ec \u00d2\u0412 \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0\u00ee\u00ec, \u00ef\u00ee\u00f2\u00ee\u00ec \u00f0\u00e5\u00e6\u00e8\u00f1\u00f1\u00e5\u00f0\u00ee\u00ec \u00f5\u00f3\u00e4\u00ee\u00e6\u00e5\u00f1\u00f2\u00e2\u00e5\u00ed\u00ed\u00ee\u00e3\u00ee \u00e2\u00e5\u00f9\u00e0\u00ed\u00e8\u00ff. \u00c6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2 \u00f1 35-\u00eb\u00e5\u00f2\u00ed\u00e8\u00ec \u00f1\u00f2\u00e0\u00e6\u00e5\u00ec, \u00f7\u00eb\u00e5\u00ed \u00d1\u00c6. \u00ab\u00ce\u00f2\u00eb\u00e8\u00f7\u00ed\u00e8\u00ea \u00d2\u0412 \u00e8 \u00f0\u00e0\u00e4\u00e8\u00ee \u00d1\u00d1\u00d1\u00d0\u00bb. \u00c7\u00e0\u00f1\u00eb\u00f3\u00e6\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e0\u00e1\u00ee\u00f2\u00ed\u00e8\u00ea \u00ea\u00f3\u00eb\u00fc\u00f2\u00f3\u00f0\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u00cb\u00e0\u00f3\u00f0\u00e5\u00e0\u00f2\u00a0 I \u0412\u00f1\u00e5\u00f1\u00ee\u00fe\u00e7\u00ed\u00ee\u00e3\u00ee \u00f4\u00e5\u00f1\u00f2\u00e8\u00e2\u00e0\u00eb\u00ff \u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00ee\u00e3\u00ee \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e0 \u00e7\u00e0 \u00f2\u00e5\u00e0\u00f2\u00f0\u00e0\u00eb\u00fc\u00ed\u00f3\u00fe \u00f0\u00e5\u00e6\u00e8\u00f1\u00f1\u00f3\u00f0\u00f3 (1977). \u0412 1983-90 \u00e3\u00ee\u00e4\u00e0\u00f5 \u00a0\u2013\u00a0 \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00ea \u0412\u00f1\u00e5\u00f1\u00ee\u00fe\u00e7\u00ed\u00fb\u00f5 \u00d8\u00e5\u00ea\u00f1\u00ef\u00e8\u00f0\u00ee\u00e2\u00f1\u00ea\u00e8\u00f5 \u00ea\u00ee\u00ed\u00f4\u00e5\u00f0\u00e5\u00ed\u00f6\u00e8\u00e9 \u00e2 \u00cc\u00ee\u00f1\u00ea\u00e2\u00e5. \u00a0\u0412 1999 \u00e3. \u00e1\u00fb\u00eb \u00ef\u00f0\u00e8\u00ed\u00ff\u00f2 \u00e2 \u00f7\u00eb\u00e5\u00ed\u00fb \u00d1\u00ee\u00fe\u00e7\u00e0 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8. \u00cf\u00ee\u00fd\u00ec\u00e0 \u00ab\u00ca\u00f0\u00f3\u00e3\u00e8\u00bb (\u00ee \u00ef\u00ee\u00ea\u00ee\u00eb\u00e5\u00ed\u00e8\u00e8 \u00ab\u00f8\u00e5\u00f1\u00f2\u00e8\u00e4\u00e5\u00f1\u00ff\u00f2\u00ed\u00e8\u00ea\u00ee\u00e2\u00bb) \u00ee\u00f2\u00ec\u00e5\u00f7\u00e5\u00ed\u00e0 \u00e2 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00ab\u00c8\u00f1\u00f2\u00ee\u00f0\u00e8\u00e8 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8\u00bb. \u00a0\u00c6\u00e8\u00e2\u00e5\u00f2 \u00e2 \u00e3. \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e5. \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 25-26. \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff . \u00c3\u00e8\u00ed, \u00c8. \u00cf\u00ee\u00e4\u00e2\u00e8\u00e3 \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f7\u00e8\u00ea\u00e0 : \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00e8\u00eb \u00f1\u00e2\u00ee\u00e9 \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4 \u00ab\u00c3\u00e0\u00ec\u00eb\u00e5\u00f2\u00e0\u00bb / \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed // \u00cb\u00e8\u00f6\u00e5\u00e9. - 2010. - \u00b9 11. - \u00d1. 4. - \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0 : https://gazeta-licey.ru/culture/literature/1835-podvig-perevodchika \u00c3\u00e0\u00eb\u00fc\u00f6\u00e8\u00ed, \u00c4. \u00c4. Religio Philologi: \u00ef\u00ee\u00fd\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f0\u00ee\u00ec\u00e0\u00ed \u0412\u00e0\u00eb\u00e5\u00f0\u00e8\u00ff \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed\u00e0 : [\u00f0\u00e5\u00f6\u00e5\u00ed\u00e7\u00e8\u00ff \u00ed\u00e0 \u00ef\u00e5\u00f0\u00e2\u00fb\u00e9 \u00f2\u00ee\u00ec \u00f2\u00f0\u00b8\u00f5\u00f2\u00ee\u00ec\u00ed\u00e8\u00ea\u00e0 \u0412. \u00c7. \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed\u00e0 \u00ab\u00ca\u00ee\u00ec\u00ed\u00e0\u00f2\u00fb \u00fd\u00f5\u00e0\u00bb] / \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e9 \u00c3\u00e0\u00eb\u00fc\u00f6\u00e8\u00ed. - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff, 2021. - (\u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8) (\u00ca\u00f0\u00e8\u00f2\u00e8\u00ea\u00e0). - \u00d0\u00e5\u00e6\u00e8\u00ec \u00e4\u00ee\u00f1\u00f2\u00f3\u00ef\u00e0: URL: http://avtor.karelia.ru/view/religio_philologi__poeticheskii_roman_valeriya_ananina.html - \u00d2\u00e5\u00ea\u00f1\u00f2 : \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9. \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c4\u00e5\u00f0\u00e5\u00e2\u00ee \u00ef\u00e5\u00f1\u00e5\u00ed : \u00e0\u00ed\u00f2\u00ee\u00eb\u00ee\u00e3\u00e8\u00ff \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea . - \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea : \u00ce\u00f1\u00f2\u00f0\u00ee\u00e2\u00e0, 2009. - \u00d1. 26-31. \u00c8\u00ec\u00e5\u00e5\u00f2\u00f1\u00ff \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00ea\u00ee\u00ef\u00e8\u00ff . \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00c8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ec\u00ee\u00e6\u00ed\u00ee \u00ef\u00f0\u00e8\u00ee\u00e1\u00f0\u00e5\u00f1\u00f2\u00e8 \u00e2 \u00ea\u00ed\u00e8\u00e6\u00ed\u00ee\u00ec \u00ea\u00e8\u00ee\u00f1\u00ea\u00e5 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c8\u00e7 \u00c3\u00e5\u00ed\u00f0\u00e8\u00f5\u00e0 \u00c3\u00e5\u00e9\u00ed\u00e5 \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00cf\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4 \u00f1 \u00ed\u00e5\u00ec\u00e5\u00f6\u00ea\u00ee\u00e3\u00ee. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c8\u00e7 \u00e0\u00ed\u00e3\u00eb\u00e8\u00e9\u00f1\u00ea\u00ee\u00e9 \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00c8\u00e7 \u00ef\u00ee\u00fd\u00e7\u00e8\u00e8 \u00d1\u00d8\u00c0 \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00c2\u00f0\u00e5\u00ec\u00ff \u00eb\u00fe\u00e1\u00e8\u00f2\u00fc \u00cf\u00ee\u00fd\u00ec\u00e0. \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00cb\u00fc\u00fe\u00e8\u00f1 \u00ca\u00fd\u00f0\u00f0\u00ee\u00eb\u00eb.  \u00ce\u00f5\u00ee\u00f2\u00e0 \u00ed\u00e0 \u00d1\u00ed\u00e0\u00f0\u00ea\u00e0 \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cf\u00f0\u00e8 \u00f1\u00e2\u00e5\u00f2\u00e5 - \u00ed\u00e5 \u00f3\u00f1\u00ed\u00f3\u00f2\u00fc \u00c2\u00e5\u00ed\u00ee\u00ea \u00e2\u00e5\u00ed\u00ea\u00ee\u00e2 \u00f1\u00ee\u00ed\u00e5\u00f2\u00ee\u00e2. \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00ab\u00c0\u00eb\u00fb\u00e9 \u00ef\u00e0\u00f0\u00f3\u00f1\u00bb \u00e8 \u00e4\u00f0\u00f3\u00e3\u00e8\u00e5 \u00ef\u00e5\u00f1\u00ed\u00e8 \u00cf\u00e5\u00f1\u00ed\u00e8 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00ff \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed\u00e0 \u00e2 \u00e0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00ee\u00ec \u00e8\u00f1\u00ef\u00ee\u00eb\u00ed\u00e5\u00ed\u00e8\u00e8. \u00cf\u00f3\u00e1\u00eb\u00e8\u00ea\u00f3\u00e5\u00f2\u00f1\u00ff \u00e2\u00ef\u00e5\u00f0\u00e2\u00fb\u00e5. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cf\u00ee\u00fd\u00e7\u00e8\u00ff \u00e8 \u00ef\u00f0\u00ee\u00e7\u00e0 \u00c2\u00e8\u00ea\u00f2\u00ee\u00f0\u00e0 \u00d1\u00e5\u00f0\u00e3\u00e8\u00ed\u00e0 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00d4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3 \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e9 \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb\u00e2\u00e0\u00e5\u00f2 \u00ee \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00ec \u00ef\u00ee\u00fd\u00f2\u00e5 \u00c2\u00e8\u00ea\u00f2\u00ee\u00f0\u00e5 \u00d1\u00e5\u00f0\u00e3\u00e8\u00ed\u00e5 \u00e8 \u00f7\u00e8\u00f2\u00e0\u00e5\u00f2 \u00e5\u00e3\u00ee \u00f1\u00f2\u00e8\u00f5\u00e8 \u00e8 \u00ef\u00f0\u00ee\u00e7\u00f3. \u00ab\u00ca\u00ee\u00ec\u00ed\u00e0\u00f2\u00fb \u00fd\u00f5\u00e0\u00bb \u00ea\u00ed\u00e8\u00e3\u00e0-\u00e3\u00e8\u00f0\u00eb\u00ff\u00ed\u00e4\u00e0 I \u00d2\u00ee\u00ec I (\u00e8\u00eb\u00e8 \u00d1\u00f6\u00e5\u00ef I) \u00ab\u00cf\u00f0\u00e8 \u00f1\u00e2\u00e5\u00f2\u00e5 \u0096 \u00ed\u00e5 \u00f3\u00f1\u00ed\u00f3\u00f2\u00fc\u0085\u00bb \u00ed\u00ee\u00f1\u00e8\u00f2 \u00e6\u00e0\u00ed\u00f0\u00ee\u00e2\u00fb\u00e9 \u00ef\u00ee\u00e4\u00e7\u00e0\u00e3\u00ee\u00eb\u00ee\u00e2\u00ee\u00ea: \u00ca\u00ed\u00e8\u00e3\u00e0 \u00ee \u00eb\u00fe\u00e1\u00e2\u00e8 \u00e8\u00eb\u00e8 \u00ca\u00ed\u00e8\u00e3\u00e0 \u00e4\u00eb\u00ff \u00ab\u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3\u00e0\u00bb. \u00dd\u00f2\u00ee \u00ea\u00e0\u00e6\u00f3\u00f9\u00e5\u00e5\u00f1\u00ff \u00f5\u00e0\u00ee\u00f2\u00e8\u00f7\u00ed\u00fb\u00ec \u00f7\u00e5\u00f0\u00e5\u00e4\u00ee\u00e2\u00e0\u00ed\u00e8\u00e5 \u00f1\u00f2\u00e8\u00f5\u00ee\u00e2, \u00ef\u00e5\u00f1\u00e5\u00ed (\u00e4\u00e0\u00e6\u00e5 \u00ef\u00ee\u00fd\u00ec) \u00e8 \u00ef\u00f0\u00ee\u00e7\u00fb\u0085 \u00c3\u00eb\u00e0\u00e2\u00ed\u00fb\u00ec \u00f1\u00f2\u00e5\u00f0\u00e6\u00ed\u00e5\u00ec \u00ea\u00ed\u00e8\u00e3\u00e8 \u00ff\u00e2\u00eb\u00ff\u00e5\u00f2\u00f1\u00ff \u00e2\u00e5\u00ed\u00ee\u00ea \u00e2\u00e5\u00ed\u00ea\u00ee\u00e2 \u00f1\u00ee\u00ed\u00e5\u00f2\u00ee\u00e2 \u00e8 \u00ef\u00e8\u00f1\u00fc\u00ec\u00e0 \u00eb\u00e8\u00f0\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e3\u00ee \u00e3\u00e5\u00f0\u00ee\u00ff \u00ea \u00eb\u00fe\u00e1\u00e8\u00ec\u00ee\u00e9 \u00e6\u00e5\u00ed\u00f9\u00e8\u00ed\u00e5. \u00ab\u00ca\u00ee\u00ec\u00ed\u00e0\u00f2\u00fb \u00fd\u00f5\u00e0\u00bb \u00ea\u00ed\u00e8\u00e3\u00e0-\u00e3\u00e8\u00f0\u00eb\u00ff\u00ed\u00e4\u00e0 II \u00d2\u00ee\u00ec II (\u00d1\u00f6\u00e5\u00ef II) \u00ab\u00ca\u00f0\u00f3\u00e3\u00e8\u00bb \u00e1\u00ee\u00eb\u00e5\u00e5 \u00f2\u00f0\u00e0\u00e4\u00e8\u00f6\u00e8\u00ee\u00ed\u00e5\u00ed \u00ef\u00ee \u00f1\u00f2\u00f0\u00f3\u00ea\u00f2\u00f3\u00f0\u00e5, \u00ea\u00e0\u00ea\u00ee\u00e3\u00ee-\u00eb\u00e8\u00e1\u00ee \u00f1\u00ea\u00e2\u00ee\u00e7\u00ed\u00ee\u00e3\u00ee \u00ab\u00f1\u00f2\u00e5\u00f0\u00e6\u00ed\u00ff\u00bb \u00f2\u00e0\u00ec \u00ed\u00e5\u00f2, \u00ed\u00ee \u00ef\u00f0\u00e8\u00ed\u00f6\u00e8\u00ef \u00ea\u00e0\u00eb\u00e5\u00e9\u00e4\u00ee\u00f1\u00ea\u00ee\u00ef\u00e8\u00f7\u00e5\u00f1\u00ea\u00ee\u00e3\u00ee \u00f7\u00e5\u00f0\u00e5\u00e4\u00ee\u00e2\u00e0\u00ed\u00e8\u00ff \u00f1\u00ee\u00f5\u00f0\u00e0\u00ed\u00e8\u00eb\u00f1\u00ff: \u00fd\u00f1\u00f1\u00e5, \u00ef\u00ee\u00fd\u00ec\u00fb, \u00ef\u00f3\u00e1\u00eb\u00e8\u00f6\u00e8\u00f1\u00f2\u00e8\u00ea\u00e0, \u00ef\u00e5\u00f1\u00ed\u00e8, \u00ab\u00f1\u00f2\u00f0\u00e0\u00ed\u00ed\u00e0\u00ff\u00bb \u00e4\u00f0\u00e0\u00ec\u00e0\u00f2\u00f3\u00f0\u00e3\u00e8\u00ff, \u00f4\u00f0\u00e0\u00e3\u00ec\u00e5\u00ed\u00f2\u00fb \u00ab\u00ec\u00e5\u00ec\u00f3\u00e0\u00f0\u00ee\u00e2\u00bb, \u00f7\u00e8\u00f2\u00e0\u00f2\u00e5\u00eb\u00fc\u00f1\u00ea\u00e8\u00e5 \u00ea\u00ee\u00ec\u00ec\u00e5\u00ed\u00f2\u00e0\u00f0\u00e8\u00e8 \u00ea \u00ed\u00e5\u00ea\u00ee\u00f2\u00ee\u00f0\u00fb\u00ec \u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0\u00f6\u00e8\u00ff\u00ec \u00e2 \u00e8\u00ed\u00f2\u00e5\u00f0\u00ed\u00e5\u00f2-\u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e5 \u00ab\u00cb\u00e8\u00f6\u00e5\u00e9\u00bb, \u00ab\u00cf\u00f0\u00e8\u00eb\u00ee\u00e6\u00e5\u00ed\u00e8\u00ff\u00bb \u00ca\u00f0\u00f3\u00e3\u00e8 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00e2\u00e5\u00f0\u00f1\u00e8\u00ff \u00ef\u00ee\u00fd\u00ec\u00fb. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d3\u00e8\u00eb\u00fc\u00ff\u00ec \u00d8\u00e5\u00ea\u00f1\u00ef\u00e8\u00f0. \u00c8\u00e7 \u00f1\u00ee\u00ed\u00e5\u00f2\u00ee\u00e2 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d1\u00ee\u00ed \u00d4\u00e5\u00f0\u00e4\u00e8\u00ed\u00e0\u00ed\u00e4\u00e0 IX \u00e0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00e2\u00e5\u00f0\u00f1\u00e8\u00ff \u00ef\u00ee\u00fd\u00ec\u00fb \u00c4\u00f3\u00e4\u00ee\u00f7\u00ea\u00e0 \u00d1\u00f3\u00eb\u00e0\u00ec\u00e8\u00f4\u00e8 \u00c0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e0\u00ff \u00e2\u00e5\u00f0\u00f1\u00e8\u00ff \u00ef\u00ee\u00fd\u00ec\u00fb. \u00ab\u00ca\u00ee\u00ec\u00ed\u00e0\u00f2\u00fb \u00fd\u00f5\u00e0\u00bb \u00ea\u00ed\u00e8\u00e3\u00e0-\u00e3\u00e8\u00f0\u00eb\u00ff\u00ed\u00e4\u00e0 III \u00d2\u00ee\u00ec III (\u00d1\u00f6\u00e5\u00ef III) \u00ed\u00e0\u00e7\u00e2\u00e0\u00ed \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00ec \u00ab\u00c1\u00e0\u00e3\u00e0\u00e6\u00ed\u00ee\u00e5\u00bb. \u00c2 \u00fd\u00f2\u00ee\u00ec \u00ab\u00e1\u00e0\u00e3\u00e0\u00e6\u00ed\u00ee\u00ec \u00ee\u00f2\u00e4\u00e5\u00eb\u00e5\u00ed\u00e8\u00e8\u00bb \u00f2\u00f0\u00e5\u00f5\u00f2\u00ee\u00ec\u00ed\u00e8\u00ea\u00e0 \u00ef\u00ee\u00ec\u00e5\u00f1\u00f2\u00e8\u00eb\u00ee\u00f1\u00fc \u00ec\u00ed\u00ee\u00e3\u00ee\u00e5 \u00e8\u00e7 \u00f0\u00e0\u00ed\u00ed\u00e5\u00e3\u00ee \u00e8 \u00e4\u00e0\u00e6\u00e5 \u00ee\u00f7\u00e5\u00ed\u00fc \u00f0\u00e0\u00ed\u00ed\u00e5\u00e3\u00ee. \u00d4\u00e0\u00ed\u00f2\u00e0\u00f1\u00f2\u00e8\u00ea\u00e0, \u00f1\u00f2\u00e8\u00f5\u00e8 \u00f0\u00e0\u00e7\u00ed\u00fb\u00f5 \u00eb\u00e5\u00f2, \u00ee\u00f7\u00e5\u00f0\u00ea\u00e8-\u00ef\u00ee\u00f0\u00f2\u00f0\u00e5\u00f2\u00fb, \u00e4\u00f0\u00f3\u00e6\u00e5\u00f1\u00ea\u00e8\u00e5 \u00ef\u00ee\u00f1\u00eb\u00e0\u00ed\u00e8\u00ff, \u00e2 \u00ab\u00cf\u00f0\u00e8\u00eb\u00ee\u00e6\u00e5\u00ed\u00e8\u00ff\u00f5\u00bb \u0096 \u00fe\u00ed\u00ee\u00f8\u00e5\u00f1\u00ea\u00e8\u00e5 \u00ef\u00ee\u00fd\u00ec\u00fb \u00e8 \u00ef\u00e5\u00f1\u00e5\u00ed\u00ea\u00e8, \u00f8\u00f3\u00f2\u00ee\u00f7\u00ed\u00fb\u00e5 \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00fb\u0085 \u00c3\u00eb\u00e0\u00e2\u00ed\u00ee\u00e9 \u00e6\u00e5 \u00f1\u00e2\u00ff\u00e7\u00f3\u00fe\u00f9\u00e5\u00e9 \u00f1\u00ea\u00f0\u00e5\u00ef\u00ee\u00e9 \u00f1\u00f2\u00e0\u00eb\u00e8 \u00ee\u00e1\u00f8\u00e8\u00f0\u00ed\u00fb\u00e5 \u00ea\u00ee\u00ec\u00ec\u00e5\u00ed\u00f2\u00e0\u00f0\u00e8\u00e8 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ea \u00ec\u00e0\u00f2\u00e5\u00f0\u00e8\u00e0\u00eb\u00e0\u00ec \u00f2\u00ee\u00ec\u00e0. \u00d3\u00e8\u00eb\u00fc\u00ff\u00ec \u00d8\u00e5\u00ea\u00f1\u00ef\u00e8\u00f0. \u00c3\u00e0\u00ec\u00eb\u00e5\u00f2 \u00d4\u00f0\u00e0\u00e3\u00ec\u00e5\u00ed\u00f2\u00fb \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00e0. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c7\u00e0\u00ef\u00e8\u00f1\u00ea\u00e8 \u00ed\u00e0 \u00ef\u00ee\u00eb\u00ff\u00f5 \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00e0 \u00d4\u00f0\u00e0\u00e3\u00ec\u00e5\u00ed\u00f2 \u00ef\u00f0\u00e8\u00ec\u00e5\u00f7\u00e0\u00ed\u00e8\u00e9 \u00e8 \u00ea\u00ee\u00ec\u00ec\u00e5\u00ed\u00f2\u00e0\u00f0\u00e8\u00e5\u00e2 \u00ea \u00ef\u00e5\u00f0\u00e5\u00e2\u00ee\u00e4\u00f3 \u00f2\u00f0\u00e0\u00e3\u00e5\u00e4\u00e8\u00e8 \u00d3.\u00d8\u00e5\u00ea\u00f1\u00ef\u00e8\u00f0\u00e0 \"\u00c3\u00e0\u00ec\u00eb\u00e5\u00f2\" \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

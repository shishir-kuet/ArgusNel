{
  "url": "http://ar.wikibooks.org/wiki/%D8%A7%D9%84%D8%A5%D8%B1%D8%B6%D8%A7%D8%B9",
  "title": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628",
  "text": "\u0627\u0644\u0625\u0631\u0636\u0627\u0639 - \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u0643\u062a\u0628 \u064a\u0631\u062c\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062a\u0646\u0628\u064a\u0647 \u062d\u0648\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0637\u0628\u064a . \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u064a\u0627\u062a [ \u0639\u062f\u0644 ] \u062a\u0648\u0635\u064a\u0627\u062a \u0631\u0626\u064a\u0633\u064a\u0629 \u0644\u0644\u0631\u0636\u0627\u0639\u0629 \u0648\u0627\u0644\u0641\u0637\u0627\u0645 . \u062f\u0639\u0645 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0641\u064a \u0627\u0644\u0645\u0631\u0627\u0643\u0632 \u0627\u0644\u0635\u062d\u064a\u0629 . \u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u0627\u0644\u0637\u0628\u064a\u0639\u064a \u0648\u0627\u0644\u0635\u0646\u0627\u0639\u064a . \u062a\u0644\u0645\u064a\u062d\u0627\u062a \u0645\u0641\u064a\u062f\u0629 \u0644\u0644\u0623\u0645 \u0627\u0644\u0645\u0631\u0636\u0639\u0629 . \u0645\u0646 \u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u0635\u0646\u0627\u0639\u064a . \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0627\u0644\u0628\u062f\u064a\u0644\u0629 . \u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0643\u0644\u0641\u0629 . \u062a\u062d\u0636\u064a\u0631 \u0627\u0644\u0648\u062c\u0628\u0629 \u0628\u0634\u0643\u0644 \u0635\u062d\u064a . \u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0623\u0645 \u0641\u064a \u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u0627\u0644\u0628\u062f\u064a\u0644 . \u0645\u062a\u0649 \u064a\u0645\u0643\u0646\u0646\u064a \u0625\u0639\u0637\u0627\u0621 \u0627\u0644\u0631\u0636\u064a\u0639 \u0627\u0644\u062d\u0644\u064a\u0628 \u0627\u0644\u0643\u0627\u0645\u0644\u061f \u0645\u0643\u0648\u0646\u0627\u062a \u0623\u0633\u0627\u0633\u064a\u0629 \u0641\u064a \u0628\u062f\u0627\u0626\u0644 \u0627\u0644\u062d\u0644\u064a\u0628 . \u062d\u0642\u0627\u0626\u0642 \u0639\u0646 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0646\u0634\u0631\u062a\u0647\u0627 \u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 . \u0645\u0635\u0627\u062f\u0631 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0646 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 [ \u0639\u062f\u0644 ] \u0643\u062a\u0627\u0628 \u0627\u0644\u0631\u0636\u0627\u0639\u0629 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0648\u0623\u062f\u0648\u064a\u0629 \u0627\u0644\u0623\u0645 \u0627\u0644\u0646\u0635 \u0627\u0644\u0643\u0627\u0645\u0644 \u0635\u0641\u062d\u0629 \u0635\u062d\u0629 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0648\u0627\u0644\u0645\u0631\u0627\u0647\u0642\u064a\u0646 \u0648\u0646\u0645\u0627\u0624\u0647\u0645 \u0645\u0646 \u0645\u0646\u0638\u0645\u0629 \u0627\u0644\u0635\u062d\u0629 \u0627\u0644\u0639\u0627\u0644\u0645\u064a\u0629 \u0645\u062c\u0644\u0629 \u0627\u0644\u0639\u0644\u0648\u0645 \u0627\u0644\u0623\u0645\u0631\u064a\u0643\u064a\u0629, \u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0627\u0644\u0623\u0639\u062f\u0627\u062f (5 / 3)\u060c (5 / 8) \u0635\u0641\u062d\u0627\u062a \u0645\u0634\u0627\u0628\u0647\u0629 [ \u0639\u062f\u0644 ] \u062d\u062f\u064a\u062b \u0627\u0644\u0648\u0644\u0627\u062f\u0629 \u0647\u0644 \u064a\u062d\u0635\u0644 \u0639\u0644\u0649 \u062d\u0644\u064a\u0628 \u0643\u0627\u0641 \u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 1 \u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 2 \u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 3 \u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 4 \u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 5 \u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 6 \u0623\u0633\u0628\u0648\u0639 \u0631\u0642\u0645 7 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikibooks.org/w/index.php?title=\u0627\u0644\u0625\u0631\u0636\u0627\u0639&oldid=216010 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0635\u062d\u0629 \u0623\u0633\u0627\u0633\u064a\u0629 \u0637\u0628 \u0623\u0637\u0641\u0627\u0644 \u0631\u0636\u0627\u0639\u0629 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0625\u0631\u0636\u0627\u0639 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

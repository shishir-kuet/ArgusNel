  "url": "http://ar.wikiversity.org/wiki/%D8%A7%D9%84%D8%A3%D8%B9%D8%AF%D8%A7%D8%AF_%D8%A7%D9%84%D8%B9%D9%82%D8%AF%D9%8A%D8%A9/%D9%85%D8%B9%D9%8A%D8%A7%D8%B1_%D8%B9%D8%AF%D8%AF_%D8%B9%D9%82%D8%AF%D9%8A",
  "title": "\u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629/\u0645\u0639\u064a\u0627\u0631 \u0639\u062f\u062f \u0639\u0642\u062f\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629/\u0645\u0639\u064a\u0627\u0631 \u0639\u062f\u062f \u0639\u0642\u062f\u064a - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 < \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0645\u0639\u064a\u0627\u0631 \u0639\u062f\u062f \u0639\u0642\u062f\u064a [ \u0639\u062f\u0644 ] \u0627\u0644\u062a\u0639\u0631\u064a\u0641 \u0648\u0627\u0644\u062a\u0623\u0648\u064a\u0644 \u0627\u0644\u0647\u0646\u062f\u0633\u064a [ \u0639\u062f\u0644 ] \u0633\u0628\u0642 \u0623\u0646 \u0628\u064a\u0646\u0627 \u0623\u0646\u0647 \u0644\u0643\u0644 \u0639\u062f\u062f \u0639\u0642\u062f\u064a z {\\displaystyle z} \u060c \u0644\u062f\u064a\u0646\u0627 z z \u00af \u2208 R + {\\displaystyle z{\\bar {z}}\\in \\mathbb {R} _{+}} \u0648\u0623\u0646 z z \u00af = ( Re \u2061 ( z ) ) 2 + ( Im \u2061 ( z ) ) 2 {\\displaystyle z{\\bar {z}}=(\\operatorname {Re} (z))^{2}+(\\operatorname {Im} (z))^{2}} \u062a\u0639\u0631\u064a\u0641 \u0644\u064a\u0643\u0646 z = x + i y {\\displaystyle z=x+iy} \u060c \u062d\u064a\u062b x {\\displaystyle x} \u0648 y {\\displaystyle y} \u0639\u062f\u062f\u0627\u0646 \u062d\u0642\u064a\u0642\u064a\u0627\u0646\u060c \u0639\u062f\u062f\u0627 \u0639\u0642\u062f\u064a\u0627. \u0645\u0639\u064a\u0627\u0631 \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u0639\u0642\u062f\u064a z {\\displaystyle z} (\u0628\u0627\u0644\u0641\u0631\u0646\u0633\u064a\u0629: Module\u060c \u0628\u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629: Modulus) \u0647\u0648 \u0627\u0644\u0639\u062f\u062f \u0627\u0644\u062d\u0642\u064a\u0642\u064a \u0627\u0644\u0645\u0648\u062c\u0628 \u0627\u0644\u0630\u064a \u0646\u0631\u0645\u0632 \u0644\u0647 \u0628\u0640 | z | {\\displaystyle |z|} \u0648\u0627\u0644\u0645\u064f\u0639\u064e\u0631\u064e\u0651\u0641 \u0628\u0645\u0627 \u064a\u0644\u064a: | z | = z z \u00af = x 2 + y 2 {\\displaystyle |z|={\\sqrt {z{\\bar {z}}}}={\\sqrt {x^{2}+y^{2}}}} \u0645\u062b\u0627\u0644: | 3 + 5 i | = 3 2 + 5 2 = 34 {\\displaystyle |3+5i|={\\sqrt {3^{2}+5^{2}}}={\\sqrt {34}}} \u0641\u064a \u0643\u0644 \u0645\u0627 \u064a\u0644\u064a \u0627\u0644\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0639\u0642\u062f\u064a \u0645\u0646\u0633\u0648\u0628 \u0625\u0644\u0649 \u0645\u0639\u0644\u0645 \u0645\u062a\u0639\u0627\u0645\u062f \u0645\u0645\u0646\u0638\u0645 \u0645\u0628\u0627\u0634\u0631 ( O , I \u2192 , J \u2192 ) {\\displaystyle (O,{\\vec {I}},{\\vec {J}})} . \u062e\u0627\u0635\u064a\u0629 \u0644\u064a\u0643\u0646 z {\\displaystyle z} \u0639\u062f\u062f\u0627 \u0639\u0642\u062f\u064a\u0627 \u0635\u0648\u0631\u062a\u0647 M {\\displaystyle M} \u0648\u0635\u0648\u0631\u062a\u0647 \u0627\u0644\u0645\u062a\u062c\u0647\u064a\u0629 u \u2192 {\\displaystyle {\\vec {u}}} \u0644\u062f\u064a\u0646\u0627\u00a0: | z | = O M {\\displaystyle |z|=OM} \u0648 | z | = \u2016 u \u2192 \u2016 {\\displaystyle |z|=\\|{\\vec {u}}\\|} \u062e\u0627\u0635\u064a\u0629: \u0627\u0644\u0645\u0633\u0627\u0641\u0629 \u0628\u064a\u0646 \u0646\u0642\u0637\u062a\u064a\u0646 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a M 1 {\\displaystyle M_{1}} \u0648 M 2 {\\displaystyle M_{2}} \u0627\u0644\u0646\u0642\u0637\u062a\u064a\u0646 \u0627\u0644\u0644\u062a\u064a\u0646 \u0644\u062d\u0642\u0627\u0647\u0645\u0627 \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0644\u064a z 1 {\\displaystyle z_{1}} \u0648 z 2 {\\displaystyle z_{2}} \u060c \u0641\u0625\u0646\u00a0: M 1 M 2 = \u2016 M 1 M 2 \u2192 \u2016 = | z 2 \u2212 z 1 | {\\displaystyle M_{1}M_{2}=\\|{\\overrightarrow {M_{1}M_{2}}}\\|=|z_{2}-z_{1}|} \u062e\u0627\u0635\u064a\u0627\u062a [ \u0639\u062f\u0644 ] \u062e\u0627\u0635\u064a\u0629 \u0644\u0643\u0644 \u0639\u062f\u062f\u064a\u0646 \u0639\u0642\u062f\u064a\u064a\u0646 z {\\displaystyle z} \u0648 t {\\displaystyle t} \u0644\u062f\u064a\u0646\u0627: | Re \u2061 ( z ) | \u2264 | z | {\\displaystyle |\\operatorname {Re} (z)|\\leq |z|} \u0648 | Im \u2061 ( z ) | \u2264 | z | {\\displaystyle |\\operatorname {Im} (z)|\\leq |z|} | z | = 0 \u27fa z = 0 {\\displaystyle |z|=0\\iff z=0} | z \u00d7 t | = | z | \u00d7 | t | {\\displaystyle |z\\times t|=|z|\\times |t|} | z | = | z \u00af | = | \u2212 z | = | \u2212 z \u00af | {\\displaystyle |z|=|{\\bar {z}}|=|-z|=|-{\\bar {z}}|} \u0625\u0630\u0627 \u0643\u0627\u0646 t \u2260 0 {\\displaystyle t\\neq 0} \u0641\u0625\u0646: | 1 t | = 1 | t | {\\displaystyle \\left|{\\frac {1}{t}}\\right|={\\frac {1}{|t|}}} \u0648 | z t | = | z | | t | {\\displaystyle \\left|{\\frac {z}{t}}\\right|={\\frac {|z|}{|t|}}} \u0625\u0630\u0627 \u0643\u0627\u0646 z \u2260 0 {\\displaystyle z\\neq 0} \u0641\u0625\u0646\u0647 \u0644\u0643\u0644 \u0639\u062f\u062f \u0635\u062d\u064a\u062d \u0646\u0633\u0628\u064a n {\\displaystyle n} : | z n | = | z | n {\\displaystyle |z^{n}|=|z|^{n}} \u062e\u0627\u0635\u064a\u0629: \u0627\u0644\u0645\u062a\u0641\u0627\u0648\u062a\u0629 \u0627\u0644\u0645\u062b\u0644\u062b\u064a\u0629 \u0644\u0643\u0644 \u0639\u062f\u062f\u064a\u0646 \u0639\u0642\u062f\u064a\u064a\u0646 z {\\displaystyle z} \u0648 t {\\displaystyle t} \u0644\u062f\u064a\u0646\u0627: | z + t | \u2264 | z | + | t | {\\displaystyle |z+t|\\leq |z|+|t|} \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629 \u0645\u0631\u0627\u0641\u0642 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0627\u0644\u0623\u0634\u0643\u0627\u0644 \u0627\u0644\u0645\u062b\u0644\u062b\u064a\u0629 \u0644\u0639\u062f\u062f \u0639\u0642\u062f\u064a \u063a\u064a\u0631 \u0645\u0646\u0639\u062f\u0645 \u0647\u0646\u0627\u0643 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0641\u064a \u0648\u064a\u0643\u064a\u0645\u064a\u062f\u064a\u0627 \u0643\u0648\u0645\u0646\u0632 \u062d\u0648\u0644: \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629/\u0645\u0639\u064a\u0627\u0631 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u0623\u0639\u062f\u0627\u062f_\u0627\u0644\u0639\u0642\u062f\u064a\u0629/\u0645\u0639\u064a\u0627\u0631_\u0639\u062f\u062f_\u0639\u0642\u062f\u064a&oldid=102151 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u062c\u0628\u0631 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0631\u064a\u0627\u0636\u064a\u0627\u062a \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0623\u0639\u062f\u0627\u062f \u0627\u0644\u0639\u0642\u062f\u064a\u0629/\u0645\u0639\u064a\u0627\u0631 \u0639\u062f\u062f \u0639\u0642\u062f\u064a \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

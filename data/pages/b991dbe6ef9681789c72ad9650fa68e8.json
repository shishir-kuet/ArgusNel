{
  "url": "http://avtor.karelia.ru/about/gin_iosif_mihailovich.html",
  "title": "\u00c3\u00e8\u00ed \u00c8\u00ee\u00f1\u00e8\u00f4 \u00cc\u00e8\u00f5\u00e0\u00e9\u00eb\u00ee\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00c3\u00e8\u00ed \u00c8\u00ee\u00f1\u00e8\u00f4 \u00cc\u00e8\u00f5\u00e0\u00e9\u00eb\u00ee\u00e2\u00e8\u00f7 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00c3\u00e8\u00ed \u00c8\u00ee\u00f1\u00e8\u00f4 \u00cc\u00e8\u00f5\u00e0\u00e9\u00eb\u00ee\u00e2\u00e8\u00f7 ( 10.12.1931 - 19.01.2026 ) \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00cb\u00f3\u00e3\u00e0\u00ed\u00f1\u00ea \u00ce\u00e1\u00f9\u00e8\u00e5 \u00f1\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00ff: \u00d4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3, \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e9 \u00ea\u00f0\u00e8\u00f2\u00e8\u00ea, \u00f7\u00eb\u00e5\u00ed \u00d1\u00ee\u00fe\u00e7\u00e0 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e8\u00f1\u00f2\u00ee\u00e2 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8. \u0412 1958 \u00e3. \u00ee\u00ea\u00ee\u00ed\u00f7\u00e8\u00eb \u00e8\u00f1\u00f2\u00ee\u00f0\u00e8\u00ea\u00ee-\u00f4\u00e8\u00eb\u00ee\u00eb\u00ee\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f4\u00e0\u00ea\u00f3\u00eb\u00fc\u00f2\u00e5\u00f2 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e3\u00ee \u00f3\u00ed\u00e8\u00e2\u00e5\u00f0\u00f1\u00e8\u00f2\u00e5\u00f2\u00e0. \u00d0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00f3\u00f7\u00e8\u00f2\u00e5\u00eb\u00e5\u00ec \u00f0\u00f3\u00f1\u00f1\u00ea\u00ee\u00e3\u00ee \u00ff\u00e7\u00fb\u00ea\u00e0 \u00e8 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb \u00f8\u00ea\u00ee\u00eb\u00fb \u00b92 \u00ef. \u00cd\u00e0\u00e4\u00e2\u00ee\u00e8\u00f6\u00fb \u00d1\u00e5\u00e3\u00e5\u00e6\u00f1\u00ea\u00ee\u00e3\u00ee \u00f0\u00e0\u00e9\u00ee\u00ed\u00e0, \u00ec\u00e5\u00f2\u00ee\u00e4\u00e8\u00f1\u00f2\u00ee\u00ec \u00ef\u00ee \u00f4\u00ee\u00eb\u00fc\u00ea\u00eb\u00ee\u00f0\u00f3 \u00c4\u00ee\u00ec\u00e0 \u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00ee\u00e3\u00ee \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e0, \u00e1\u00ee\u00eb\u00e5\u00e5 \u00ef\u00ff\u00f2\u00ed\u00e0\u00e4\u00f6\u00e0\u00f2\u00e8 \u00eb\u00e5\u00f2\u00a0 \u2013 \u00ef\u00f0\u00e5\u00ef\u00ee\u00e4\u00e0\u00e2\u00e0\u00f2\u00e5\u00eb\u00e5\u00ec \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb \u00e8 \u00fd\u00f1\u00f2\u00e5\u00f2\u00e8\u00ea\u00e8 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00ee\u00e3\u00ee \u00e6\u00e5\u00eb\u00e5\u00e7\u00ed\u00ee\u00e4\u00ee\u00f0\u00ee\u00e6\u00ed\u00ee\u00e3\u00ee \u00f2\u00e5\u00f5\u00ed\u00e8\u00ea\u00f3\u00ec\u00e0. \u0412 1977 \u00e3\u00ee\u00e4\u00f3 \u00e1\u00fb\u00eb \u00ef\u00f0\u00e8\u00e3\u00eb\u00e0\u00f8\u00e5\u00ed \u00e2 \u00ea\u00e0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e5 \u00f1\u00f2\u00e0\u00f0\u00f8\u00e5\u00e3\u00ee \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00ee\u00e3\u00ee \u00f1\u00ee\u00f2\u00f0\u00f3\u00e4\u00ed\u00e8\u00ea\u00e0 \u00e2 \u00f0\u00e5\u00e4\u00e0\u00ea\u00f6\u00e8\u00fe \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0 \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb, \u00e3\u00e4\u00e5 \u00f0\u00e0\u00e1\u00ee\u00f2\u00e0\u00eb \u00e4\u00ee 1992 \u00e3\u00ee\u00e4\u00e0. \u0412 1970-\u00f5 \u00e3\u00e3. \u2013 \u00f0\u00f3\u00ea\u00ee\u00e2\u00ee\u00e4\u00e8\u00f2\u00e5\u00eb\u00fc \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00ee\u00e3\u00ee \u00ee\u00e1\u00fa\u00e5\u00e4\u00e8\u00ed\u00e5\u00ed\u00e8\u00ff\u00a0 \u00ef\u00f0\u00e8 \u00d1\u00ee\u00fe\u00e7\u00e5 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u00c0\u00e2\u00f2\u00ee\u00f0 \u00e1\u00ee\u00eb\u00e5\u00e5 150\u00a0 \u00f1\u00f2\u00e0\u00f2\u00e5\u00e9, \u00fd\u00f1\u00f1\u00e5, \u00f0\u00e5\u00f6\u00e5\u00ed\u00e7\u00e8\u00e9 \u00e2 \u00e6\u00f3\u00f0\u00ed\u00e0\u00eb\u00e0\u00f5 \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00bb, \u00ab\u00cf\u00f3\u00ed\u00e0\u00eb\u00e8\u00ef\u00ef\u00f3\u00bb, Carelia\u00bb, \u00ab\u00cc\u00e8\u00f0 \u00cf\u00e0\u00f3\u00f1\u00f2\u00ee\u00e2\u00f1\u00ea\u00ee\u00e3\u00ee\u00bb, \u00e3\u00e0\u00e7\u00e5\u00f2\u00e0\u00f5 \u00ab\u00ca\u00ee\u00ec\u00f1\u00ee\u00ec\u00ee\u00eb\u00e5\u00f6\u00bb, \u00ab\u00cb\u00e5\u00ed\u00e8\u00ed\u00f1\u00ea\u00e0\u00ff \u00ef\u00f0\u00e0\u00e2\u00e4\u00e0\u00bb, \u00ab\u00d1\u00e5\u00e2\u00e5\u00f0\u00ed\u00fb\u00e9 \u00ea\u00f3\u00f0\u00fc\u00e5\u00f0\u00bb, \u00ab\u00d2\u0412\u00d0-\u00cf\u00e0\u00ed\u00ee\u00f0\u00e0\u00ec\u00e0\u00bb, \u00ab\u00cb\u00e8\u00f6\u00e5\u00e9\u00bb \u00e8 \u00e4\u00f0\u00f3\u00e3\u00e8\u00f5. \u00cc\u00ed\u00ee\u00e3\u00ee\u00eb\u00e5\u00f2\u00ed\u00e8\u00e9 \u00e8\u00f1\u00f1\u00eb\u00e5\u00e4\u00ee\u00e2\u00e0\u00f2\u00e5\u00eb\u00fc \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e0 \u00ef\u00f0\u00ee\u00e7\u00e0\u00e8\u00ea\u00e0 \u0412\u00e8\u00ea\u00f2\u00ee\u00f0\u00e0 \u00d1\u00ee\u00eb\u00ee\u00e2\u00fc\u00e5\u00e2\u00e0, \u00ea\u00ee\u00f2\u00ee\u00f0\u00ee\u00ec\u00f3 \u00ef\u00ee\u00f1\u00e2\u00ff\u00f9\u00e5\u00ed \u00f6\u00e5\u00eb\u00fb\u00e9 \u00f0\u00ff\u00e4 \u00e5\u00e3\u00ee \u00f1\u00f2\u00e0\u00f2\u00e5\u00e9, \u00e2 \u00f2\u00ee\u00ec \u00f7\u00e8\u00f1\u00eb\u00e5 \u00e2 \u00ed\u00e0\u00f3\u00f7\u00ed\u00fb\u00f5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff\u00f5. \u00ce\u00f1\u00ee\u00e1\u00e0\u00ff \u00f1\u00f2\u00ee\u00f0\u00ee\u00ed\u00e0 \u00e5\u00e3\u00ee \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00ee\u00e9\u00a0 \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00e8 \u2013 \u00f3\u00f1\u00f2\u00ed\u00fb\u00e5 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb. \u00d1 1985 \u00ef\u00ee 2005 \u00e3\u00ee\u00e4 \u00f0\u00e5\u00e3\u00f3\u00eb\u00ff\u00f0\u00ed\u00ee \u00f0\u00e0\u00e7 \u00e2 \u00ec\u00e5\u00f1\u00ff\u00f6 \u00e2\u00fb\u00f1\u00f2\u00f3\u00ef\u00e0\u00eb \u00f1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00f1\u00ea\u00e8\u00ec\u00e8 \u00ef\u00f0\u00ee\u00e3\u00f0\u00e0\u00ec\u00ec\u00e0\u00ec\u00e8 \u00f6\u00e8\u00ea\u00eb\u00e0\u00a0 \u00f1\u00ed\u00e0\u00f7\u00e0\u00eb\u00e0 \u00ab\u00d7\u00e8\u00f2\u00e0\u00ff \u00e8 \u00ef\u00e5\u00f0\u00e5\u00f7\u00e8\u00f2\u00fb\u00e2\u00e0\u00ff\u00bb, \u00e7\u00e0\u00f2\u00e5\u00ec \u00ab\u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e5 \u00ef\u00f0\u00e8\u00f1\u00f2\u00f0\u00e0\u00f1\u00f2\u00e8\u00ff\u00bb, \u00f2\u00e5\u00ec\u00e0\u00ec\u00e8 \u00ea\u00ee\u00f2\u00ee\u00f0\u00fb\u00f5 \u00e1\u00fb\u00eb\u00ee \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00ee \u00c0. \u00d1. \u00cf\u00f3\u00f8\u00ea\u00e8\u00ed\u00e0 (\u00f6\u00e8\u00ea\u00eb \u00e2 \u00f6\u00e8\u00ea\u00eb\u00e5), \u00cb. \u00cd. \u00d2\u00ee\u00eb\u00f1\u00f2\u00ee\u00e3\u00ee, \u00c8. \u00c0. \u00c1\u00f3\u00ed\u00e8\u00ed\u00e0, \u00d1. \u00d2. \u00c0\u00ea\u00f1\u00e0\u00ea\u00ee\u00e2\u00e0, \u00ca. \u00c3. \u00cf\u00e0\u00f3\u00f1\u00f2\u00ee\u00e2\u00f1\u00ea\u00ee\u00e3\u00ee, \u00c0. \u00d2. \u00d2\u00e2\u00e0\u00f0\u00e4\u00ee\u00e2\u00f1\u00ea\u00ee\u00e3\u00ee, \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00e9 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5: \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea, \u00c0. \u00cf\u00ee\u00eb\u00e2\u00e5\u00ea\u00e0 \u00ec\u00e5\u00e6\u00e4\u00f3 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5\u00ec \u00e8 \u00f7\u00e8\u00f2\u00e0\u00f2\u00e5\u00eb\u00e5\u00ec : \u00fe\u00e1\u00e8\u00eb\u00e5\u00e9 [\u00eb\u00e8\u00f2. \u00ea\u00f0\u00e8\u00f2\u00e8\u00ea\u00e0 \u00c8\u00ee\u00f1\u00e8\u00f4\u00e0 \u00cc\u00e8\u00f5\u00e0\u00e9\u00eb\u00ee\u00e2\u00e8\u00f7\u00e0 \u00c3\u00e8\u00ed\u00e0] / \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u0412\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ea // \u00d2\u0412\u00d0-\u00cf\u00e0\u00ed\u00ee\u00f0\u00e0\u00ec\u00e0. \u2013 2006. \u2013 6 \u00e4\u00e5\u00ea. (\u00b949). \u2013 \u00d1.14. \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0, \u00a0\u00c8. \u00d3 \u00e2\u00f0\u00e5\u00ec\u00e5\u00ed\u00e8 \u00e2 \u00ef\u00eb\u00e5\u00ed\u00f3 [\u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e5\u00f1\u00f3\u00f0\u00f1] : [\u00c8\u00ed\u00f2\u00e5\u00f0\u00e2\u00fc\u00fe \u00a0\u00f1 \u00a0\u00c8\u00ee\u00f1\u00e8\u00f4\u00ee\u00ec \u00c3\u00e8\u00ed\u00ee\u00ec / \u00e1\u00e5\u00f1\u00e5\u00e4\u00f3 \u00e2\u00e5\u00eb\u00e0 \u00c8\u00f0\u00e8\u00ed\u00e0 \u00cb\u00e0\u00f0\u00e8\u00ee\u00ed\u00ee\u00e2\u00e0] // \u00c8\u00ed\u00f2\u00e5\u00f0\u00ed\u00e5\u00f2-\u00e6\u00f3\u00f0\u00ed\u00e0\u00eb \u00cb\u00e8\u00f6\u00e5\u00e9. \u2013 URL: http://gazeta-licey.ru/public/lyceumconversation/item/6471-u-vremeni-v-plenu#comment-14033 (21.01.2013) \u00c7\u00e0\u00e0\u00eb\u00ee\u00e2\u00e0, \u00d1. \u00d3 \u00ec\u00e8\u00ea\u00f0\u00ee\u00f4\u00ee\u00ed\u00e0 \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed\u00a0[\u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e9 \u00f0\u00e5\u00f1\u00f3\u00f0\u00f1] : [\u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff]\u00a0// \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8. \u2013 URL: http://avtor.karelia.ru/view/u_mikrofona_iosif_gin.html \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00fb\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00c1\u00e8\u00e1\u00eb\u00e8\u00ee\u00e3\u00f0\u00e0\u00f4\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c3\u00e8\u00ed, \u00c8. \"\u00cc\u00fb-\u00e4\u00e5\u00f2\u00e8 \u00f1\u00f2\u00f0\u00e0\u00f8\u00ed\u00fb\u00f5 \u00eb\u00e5\u00f2 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8\" : 28 \u00ed\u00ee\u00ff\u00e1. \u00e8\u00f1\u00ef\u00ee\u00eb\u00ed. 125 \u00eb\u00e5\u00f2 \u00f1\u00ee \u00e4\u00ed\u00ff \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00e0 \u00c1\u00eb\u00ee\u00ea\u00e0 / \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed // \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. - 2005. - 29 \u00ed\u00ee\u00ff\u00e1. - \u00d1. 10. \u00c3\u00e8\u00ed, \u00c8. \u00d1\u00ee\u00ed \u00ee \u00f0\u00ee\u00e4\u00ed\u00ee\u00e9 \u00f1\u00f2\u00f0\u00e0\u00ed\u00e5 : \u00ef\u00ee\u00fd\u00f2. \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00ee \u0412\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00cd\u00e0\u00e1\u00ee\u00ea\u00ee\u00e2\u00e0 / \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed // \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. - 2005. - 22 \u00f1\u00e5\u00ed\u00f2. - \u00d1. 18. \u00c3\u00e8\u00ed, \u00c8. \"\u0412\u00e5\u00e4\u00fc \u00e3\u00e4\u00e5-\u00f2\u00ee \u00e5\u00f1\u00f2\u00fc \u00ef\u00f0\u00ee\u00f1\u00f2\u00e0\u00ff \u00e6\u00e8\u00e7\u00ed\u00fc ...\" : 5 \u00ec\u00e0\u00f0\u00f2\u00e0 \u00e8\u00f1\u00ef\u00ee\u00eb\u00ed. 40 \u00eb\u00e5\u00f2, \u00ea\u00e0\u00ea \u00ed\u00e5\u00f2 \u00ed\u00e0 \u00e7\u00e5\u00ec\u00eb\u00e5 \u00c0\u00ed\u00ed\u00fb \u00c0\u00f5\u00ec\u00e0\u00f2\u00ee\u00e2\u00ee\u00e9 / \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed // \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff. - 2006. - 6 \u00e0\u00ef\u00f0. - \u00d1. 12. \u00d5\u00f0\u00ee\u00ed\u00ee\u00eb\u00ee\u00e3\u00e8\u00f7\u00e5\u00f1\u00ea\u00e8\u00e9 \u00f1\u00ef\u00e8\u00f1\u00ee\u00ea \u00ee\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00ee\u00e2\u00e0\u00ed\u00ed\u00fb\u00f5 \u00f0\u00e0\u00e1\u00ee\u00f2 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00cc\u00e5\u00e4\u00e8\u00e0\u00e3\u00e0\u00eb\u00e5\u00f0\u00e5\u00ff \u00c7\u00e0\u00ef\u00e8\u00f1\u00fc \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb, \u00e4\u00e5\u00ea\u00e0\u00e1\u00f0\u00fc 2011 \u00e3\u00ee\u00e4\u00e0 \u00c2 \u00f1\u00f2\u00e5\u00ed\u00e0\u00f5 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00e2\u00f1\u00e5\u00e3\u00e4\u00e0 \u00e6\u00e5\u00eb\u00e0\u00ed\u00ed\u00fb\u00e9 \u00e3\u00ee\u00f1\u00f2\u00fc \u00d1. \u00cc. \u00cb\u00ee\u00e9\u00f2\u00e5\u00f0 \u00e8 \u00c8. \u00cc. \u00c3\u00e8\u00ed. \u00c8\u00e7 \u00f1\u00e5\u00ec\u00e5\u00e9\u00ed\u00ee\u00e3\u00ee \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 25 \u00ec\u00e0\u00f0\u00f2\u00e0 1977 \u00c2 \u00ea\u00e0\u00e1\u00e8\u00ed\u00e5\u00f2\u00e5 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb \u00e6\u00e5\u00eb\u00e5\u00e7\u00ed\u00ee\u00e4\u00ee\u00f0\u00ee\u00e6\u00ed\u00ee\u00e3\u00ee \u00f2\u00e5\u00f5\u00ed\u00e8\u00ea\u00f3\u00ec\u00e0 \u00c7\u00e0\u00ed\u00ff\u00f2\u00e8\u00e5 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00ee\u00e3\u00ee \u00ea\u00f0\u00f3\u00e6\u00ea\u00e0 \u00e2 \u00ea\u00e0\u00e1\u00e8\u00ed\u00e5\u00f2\u00e5 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb \u00c2 \u00ea\u00e0\u00e1\u00e8\u00ed\u00e5\u00f2\u00e5 \u00eb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00fb \u00e6\u00e5\u00eb\u00e5\u00e7\u00ed\u00ee\u00e4\u00ee\u00f0\u00ee\u00e6\u00ed\u00ee\u00e3\u00ee \u00f2\u00e5\u00f5\u00ed\u00e8\u00ea\u00f3\u00ec\u00e0 \u00c8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0 \u00ec\u00ee\u00e6\u00ed\u00ee \u00ef\u00f0\u00e8\u00ee\u00e1\u00f0\u00e5\u00f1\u00f2\u00e8 \u00e2 \u00ea\u00ed\u00e8\u00e6\u00ed\u00ee\u00ec \u00ea\u00e8\u00ee\u00f1\u00ea\u00e5 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00ee\u00e9 \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e8 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00d1\u00ea\u00e0\u00e7\u00ea\u00e0 \u00e2\u00e0\u00eb\u00f3\u00ed\u00ee\u00e2 \u00ce \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e5 \u00f5\u00f3\u00e4\u00ee\u00e6\u00ed\u00e8\u00ea\u00e0 \u00d2\u00e0\u00ec\u00e0\u00f0\u00fb \u00de\u00f4\u00e0 \u00ce \u00ef\u00f0\u00ee\u00e7\u00e5 \u00c2\u00e8\u00ea\u00f2\u00ee\u00f0\u00e0 \u00d1\u00ee\u00eb\u00ee\u00e2\u00fc\u00e5\u00e2\u00e0 \u00cf\u00ee\u00e4\u00e1\u00ee\u00f0\u00ea\u00e0 \u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e0\u00f6\u00e8\u00e9 \u00f0\u00e0\u00e7\u00ed\u00fb\u00f5 \u00eb\u00e5\u00f2 \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00fc\u00e5 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2\u00e0 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2\u00e0 \u00d1\u00f2\u00e0\u00f2\u00fc\u00ff \u00e8\u00eb\u00eb\u00fe\u00f1\u00f2\u00f0\u00e8\u00f0\u00ee\u00e2\u00e0\u00ed\u00e0 \u00fd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00ec\u00e8 \u00ea\u00ee\u00ef\u00e8\u00ff\u00ec\u00e8 \u00ea\u00e0\u00f0\u00f2\u00e8\u00ed, \u00ef\u00f0\u00e5\u00e4\u00ee\u00f1\u00f2\u00e0\u00e2\u00eb\u00e5\u00ed\u00ed\u00fb\u00ec\u00e8 \u00cd\u00c1 \u00d0\u00ca \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2\u00ee\u00ec \u00c0\u00eb\u00e5\u00ea\u00f1\u00e5\u00e5\u00e2\u00e8\u00f7\u00e5\u00ec \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2\u00fb\u00ec. \u00c7\u00e0\u00ec\u00e5\u00f2\u00ea\u00e8 \u00ee \u00f2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00e5 \u00c2\u00eb\u00e0\u00e4\u00e8\u00ec\u00e8\u00f0\u00e0 \u00cc\u00ee\u00f0\u00ee\u00e7\u00ee\u00e2\u00e0 \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00ee \u00ef\u00ee\u00fd\u00f2\u00e0\u00f5 \u00f1\u00e5\u00f0\u00e5\u00e1\u00f0\u00ff\u00ed\u00ee\u00e3\u00ee \u00e2\u00e5\u00ea\u00e0 \u00c0\u00ed\u00ed\u00e0 \u00c0\u00f5\u00ec\u00e0\u00f2\u00ee\u00e2\u00e0,\u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u00c1\u00eb\u00ee\u00ea, \u00c1\u00ee\u00f0\u00e8\u00f1 \u00cf\u00e0\u00f1\u00f2\u00e5\u00f0\u00ed\u00e0\u00ea,  \u00ce\u00f1\u00e8\u00ef \u00cc\u00e0\u00ed\u00e4\u00e5\u00eb\u00fc\u00f8\u00f2\u00e0\u00ec. \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00ee \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00ff\u00f5 \u00ef\u00e5\u00f0\u00e2\u00ee\u00e9 \u00ef\u00ee\u00eb\u00ee\u00e2\u00e8\u00ed\u00fb  20 \u00e2\u00e5\u00ea\u00e0 \u00cc\u00e0\u00ea\u00f1\u00e8\u00ec \u00c3\u00ee\u00f0\u00fc\u00ea\u00e8\u00e9, \u00c0\u00ed\u00e4\u00f0\u00e5\u00e9 \u00cf\u00eb\u00e0\u00f2\u00ee\u00ed\u00ee\u00e2, \u00cc\u00e8\u00f5\u00e0\u00e8\u00eb \u00c7\u00ee\u00f9\u00e5\u00ed\u00ea\u00ee, \u00de\u00f0\u00e8\u00e9 \u00ce\u00eb\u00e5\u00f8\u00e0. \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00ee \u00c4\u00ec\u00e8\u00f2\u00f0\u00e8\u00e8 \u00c3\u00f3\u00f1\u00e0\u00f0\u00ee\u00e2\u00e5 \u00c0\u00f3\u00e4\u00e8\u00ee\u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7 \u00c8. \u00cc. \u00c3\u00e8\u00ed\u00e0 \u00ee \u00ed\u00e0\u00f0\u00ee\u00e4\u00ed\u00ee\u00ec \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00e5 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c4. \u00df. \u00c3\u00f3\u00f1\u00e0\u00f0\u00ee\u00e2\u00e5, \u00ee \u00e5\u00e3\u00ee \u00e4\u00e5\u00ff\u00f2\u00e5\u00eb\u00fc\u00ed\u00ee\u00f1\u00f2\u00e8 \u00ea\u00e0\u00ea \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00ff, \u00f0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0\u00e0 \u00e8 \u00f7\u00e8\u00f2\u00e0\u00f2\u00e5\u00eb\u00ff. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00ee\u00e1 \u00c0.\u00d1. \u00cf\u00f3\u00f8\u00ea\u00e8\u00ed\u00e5, \u00cc.\u00de. \u00cb\u00e5\u00f0\u00ec\u00ee\u00ed\u00f2\u00ee\u00e2\u00e5, \u00d1.\u00d2. \u00c0\u00ea\u00f1\u00e0\u00ea\u00ee\u00e2\u00e5 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00ee \u00ef\u00ee\u00fd\u00f2\u00e0\u00f5 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2, \u00ce\u00eb\u00e5\u00e3 \u00cc\u00e8\u00f8\u00e8\u00ed, \u00c2\u00e8\u00ea\u00f2\u00ee\u00f0 \u00d1\u00e5\u00f0\u00e3\u00e8\u00ed. \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e5 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00c8\u00ee\u00f1\u00e8\u00f4\u00e0 \u00c3\u00e8\u00ed\u00e0. \u00d2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00ee  \u00c2. \u00d8\u00f3\u00ea\u00f8\u00e8\u00ed\u00e0 \u00e8 \u00c0. \u00c2\u00ee\u00e7\u00ed\u00e5\u00f1\u00e5\u00ed\u00f1\u00ea\u00ee\u00e3\u00ee \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00d1\u00eb\u00ee\u00e2\u00ee \u00ee \u00c2\u00e0\u00eb\u00e5\u00f0\u00e8\u00e8 \u00c0\u00ed\u00e0\u00ed\u00fc\u00e8\u00ed\u00e5 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00ee\u00e1 \u00c8. \u00c1\u00f3\u00ed\u00e8\u00ed\u00e5, \u00c2. \u00d5\u00ee\u00e4\u00e0\u00f1\u00e5\u00e2\u00e8\u00f7\u00e5 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed  \u00ee  \u00c2\u00e8\u00ea\u00f2\u00ee\u00f0\u00e5 \u00d1\u00ee\u00eb\u00ee\u00e2\u00fc\u00e5\u00e2\u00e5 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00cb\u00e8\u00f2\u00e5\u00f0\u00e0\u00f2\u00f3\u00f0\u00ed\u00fb\u00e5 \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb \u00c8\u00ee\u00f1\u00e8\u00f4\u00e0 \u00c3\u00e8\u00ed\u00e0. \u00d2\u00e2\u00ee\u00f0\u00f7\u00e5\u00f1\u00f2\u00e2\u00ee \u00c0. \u00d0\u00ee\u00e4\u00e8\u00ed\u00e0, \u00c0. \u00d1\u00f3\u00f0\u00e6\u00ea\u00ee, \u00c0. \u00c2\u00e5\u00e4\u00e5\u00ed\u00e5\u00e5\u00e2\u00e0 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00ee \u00f1\u00ee\u00e2\u00e5\u00f2\u00f1\u00ea\u00e8\u00f5 \u00ef\u00e8\u00f1\u00e0\u00f2\u00e5\u00eb\u00ff\u00f5 \u00ca\u00ee\u00ed\u00f1\u00f2\u00e0\u00ed\u00f2\u00e8\u00ed \u00cf\u00e0\u00f3\u00f1\u00f2\u00ee\u00e2\u00f1\u00ea\u00e8\u00e9, \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0 \u00d2\u00e2\u00e0\u00f0\u00e4\u00ee\u00e2\u00f1\u00ea\u00e8\u00e9. \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c7\u00e0\u00ef\u00e8\u00f1\u00e8 \u00e8\u00e7 \u00e0\u00f0\u00f5\u00e8\u00e2\u00e0 \u00c3\u00d2\u00d0\u00ca \u00ab\u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff\u00bb. \u00cb\u00e5\u00e3\u00e5\u00ed\u00e4\u00e0\u00f0\u00ed\u00fb\u00e5 \u00e8\u00ec\u00e5\u00ed\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e7\u00e0\u00e2\u00ee\u00e4\u00f1\u00ea\u00e0 \u00c0\u00f3\u00e4\u00e8\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb\u00e2\u00e0\u00e5\u00f2 \u00ee\u00e1 \u00c8\u00f0\u00e0\u00e8\u00e4\u00e5 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00ee\u00e2\u00ed\u00e5 \u00cc\u00e0\u00eb\u00fc\u00f6\u00e5\u00e2\u00ee\u00e9, \u00cc\u00ee\u00e8\u00f1\u00e5\u00e5 \u00cc\u00e8\u00f5\u00e0\u00e9\u00eb\u00ee\u00e2\u00e8\u00f7\u00e5 \u00c3\u00e8\u00ed\u00e5 \u00e8 \u00cf\u00e5\u00f2\u00f0\u00e5 \u00c0\u00eb\u00e5\u00ea\u00f1\u00e0\u00ed\u00e4\u00f0\u00ee\u00e2\u00e8\u00f7\u00e5 \u00d0\u00f3\u00e4\u00ed\u00e5\u00e2\u00e5. \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed \u00f0\u00e0\u00f1\u00f1\u00ea\u00e0\u00e7\u00fb\u00e2\u00e0\u00e5\u00f2 \u00ee \u00c2\u00ff\u00f7\u00e5\u00f1\u00eb\u00e0\u00e2\u00e5 \u00c0\u00e3\u00e0\u00ef\u00e8\u00f2\u00ee\u00e2\u00e5 \u00c2\u00e8\u00e4\u00e5\u00ee\u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e5. \u00d0\u00e5\u00e4\u00e0\u00ea\u00f2\u00ee\u00f0 \u00f6\u00e8\u00ea\u00eb\u00e0 \u00ef\u00e5\u00f0\u00e5\u00e4\u00e0\u00f7 \u00ca\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00f0\u00e0\u00e4\u00e8\u00ee \u00ab\u00d3 \u00ec\u00e8\u00ea\u00f0\u00ee\u00f4\u00ee\u00ed\u00e0 \u00c8\u00ee\u00f1\u00e8\u00f4 \u00c3\u00e8\u00ed\u00bb (2008 \u0096 2013 \u00e3\u00ee\u00e4\u00fb) \u00d1\u00e2\u00e5\u00f2\u00eb\u00e0\u00ed\u00e0 \u00c7\u00e0\u00e0\u00eb\u00ee\u00e2\u00e0. \u00c0\u00e2\u00f2\u00ee\u00f0\u00fb \u00e2\u00e8\u00e4\u00e5\u00ee\u00f0\u00ff\u00e4\u00e0 \u00ca. \u00cc\u00e0\u00ea\u00f1\u00e8\u00ec\u00ee\u00e2, \u00cd. \u00ca\u00ee\u00f8\u00ea\u00e8\u00ed. \u00cd\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

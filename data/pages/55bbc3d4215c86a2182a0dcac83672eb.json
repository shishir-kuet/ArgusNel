  "title": "\u0645\u0633\u062a\u062e\u062f\u0645:Zaxo - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0645\u0633\u062a\u062e\u062f\u0645:Zaxo - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u064a\u0645\u0643\u0646\u0643 \u0623\u0646 \u062a\u062a\u0635\u0644 \u0628\u064a \u0639\u0646 \u0637\u0631\u064a\u0642 \u0635\u0641\u062d\u062a\u064a \u0641\u064a \u0648\u064a\u0643\u064a\u0628\u064a\u062f\u064a\u0627 \u0627\u0644\u0639\u0631\u0628\u064a\u0629 . \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0645\u0633\u062a\u062e\u062f\u0645:Zaxo&oldid=9481 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0645\u0633\u062a\u062e\u062f\u0645 : Zaxo \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

{
  "url": "http://avtor.karelia.ru/folkloristika.html",
  "title": "\u00d4\u00ee\u00eb\u00fc\u00ea\u00eb\u00ee\u00f0\u00e8\u00f1\u00f2\u00e8\u00ea\u00e0 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8",
  "text": "\u00d4\u00ee\u00eb\u00fc\u00ea\u00eb\u00ee\u00f0\u00e8\u00f1\u00f2\u00e8\u00ea\u00e0 - \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00e0\u00e2\u00f2\u00ee\u00f0\u00ee\u00e2 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00c3\u00eb\u00e0\u00e2\u00ed\u00e0\u00ff \u00c2\u00e8\u00e4\u00e5\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cd\u00ee\u00e2\u00ee\u00f1\u00f2\u00e8 \u00ce\u00e1\u00f0\u00e0\u00f2\u00ed\u00e0\u00ff \u00f1\u00e2\u00ff\u00e7\u00fc \u00d4\u00ee\u00ed\u00ee\u00f2\u00e5\u00ea\u00e0 \u00cf\u00ee\u00e8\u00f1\u00ea \u00ef\u00ee \u00e0\u00e2\u00f2\u00ee\u00f0\u00f3: [\u00c2\u00f1\u00e5] [\u00c0 ] [\u00c1 ] [\u00c2 ] [\u00c3 ] [\u00c4 ] [\u00c5 ] [\u00c6 ] [\u00c7 ] [\u00c8 ] [\u00ca ] [\u00cb ] [\u00cc ] [\u00cd ] [\u00ce ] [\u00cf ] [\u00d0 ] [\u00d1 ] [\u00d2 ] [\u00d3 ] [\u00d4 ] [\u00d5 ] [\u00d6 ] [\u00d7 ] [\u00d8 ] [\u00df ] \u00d4\u00ee\u00eb\u00fc\u00ea\u00eb\u00ee\u00f0\u00e8\u00f1\u00f2\u00e8\u00ea\u00e0 \u00d1\u00f2\u00f0\u00e0\u00ed\u00e8\u00f6\u00fb: 1 2 \u203a\u203a \u00cf\u00e5\u00f1\u00e5\u00ed\u00ed\u00fb\u00e9 \u00f4\u00ee\u00eb\u00fc\u00ea\u00eb\u00ee\u00f0 \u00ea\u00e5\u00f1\u00f2\u00e5\u00ed\u00fc\u00e3\u00f1\u00ea\u00e8\u00f5 \u00ea\u00e0\u00f0\u00e5\u00eb \u00c2 \u00ea\u00ed\u00e8\u00e3\u00e5 \u00ef\u00f0\u00e5\u00e4\u00f1\u00f2\u00e0\u00e2\u00eb\u00e5\u00ed\u00e0 \u00f3\u00f1\u00f2\u00ed\u00ee-\u00ef\u00ee\u00fd\u00f2\u00e8\u00f7\u00e5\u00f1\u00ea\u00e0\u00ff \u00f2\u00f0\u00e0\u00e4\u00e8\u00f6\u00e8\u00ff \u00ea\u00e0\u00f0\u00e5\u00eb\u00fc\u00f1\u00ea\u00ee\u00e3\u00ee \u00ed\u00e0\u00f1\u00e5\u00eb\u00e5\u00ed\u00e8\u00ff \u00cb\u00ee\u00f3\u00f5\u00f1\u00ea\u00ee\u00e3\u00ee \u00f0\u00e0\u00e9\u00ee\u00ed\u00e0 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cd\u00e5\u00ee\u00e1\u00fb\u00f7\u00ed\u00ee\u00e5 \u00ef\u00f3\u00f2\u00e5\u00f8\u00e5\u00f1\u00f2\u00e2\u00e8\u00e5 \u00ee\u00f2 \u00ca\u00ee\u00ed\u00e4\u00ee\u00ef\u00ee\u00e3\u00e8 \u00e4\u00ee \u00d2\u00ee\u00eb\u00e2\u00f3\u00e8 \u00d1\u00ea\u00e0\u00e7\u00ea\u00e8, \u00f1\u00ee\u00e1\u00f0\u00e0\u00ed\u00ed\u00fb\u00e5 \u00c0. \u00c0. \u00d8\u00e0\u00f5\u00ec\u00e0\u00f2\u00ee\u00e2\u00fb\u00ec \u00e2 \u00ce\u00eb\u00ee\u00ed\u00e5\u00f6\u00ea\u00ee\u00e9 \u00e3\u00f3\u00e1\u00e5\u00f0\u00ed\u00e8\u00e8 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c4\u00e2\u00ee\u00f0\u00ee\u00e2\u00fb\u00e9 \u00fd\u00f2\u00e8\u00ea\u00e5\u00f2: \u00ef\u00f0\u00e0\u00e2\u00e8\u00eb\u00e0 \u00ea\u00f0\u00e5\u00f1\u00f2\u00fc\u00ff\u00ed\u00f1\u00ea\u00ee\u00e9 \u00ec\u00ee\u00e4\u00fb \u00cf\u00ee\u00f1\u00ee\u00e1\u00e8\u00e5 \u00ef\u00ee \u00f2\u00f0\u00e0\u00e4\u00e8\u00f6\u00e8\u00ee\u00ed\u00ed\u00ee\u00ec\u00f3 \u00ea\u00ee\u00f1\u00f2\u00fe\u00ec\u00f3 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00e8 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00cb\u00ee\u00e9\u00f2\u00e5\u00f0 \u00d1\u00ee\u00f4\u00fc\u00ff \u00cc\u00e8\u00f5\u00e0\u00e9\u00eb\u00ee\u00e2\u00ed\u00e0 \u00c4\u00e0\u00f2\u00e0 \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: 06.07.1934 \u00cc\u00e5\u00f1\u00f2\u00ee \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff: \u00e3. \u00c6\u00e8\u00f2\u00ee\u00ec\u00e8\u00f0 \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00ab\u00df \u00f1\u00e5\u00eb\u00e5\u00e7\u00ed\u00ff, \u00e4\u00e0 \u00ff \u00e5\u00e3\u00ee \u00eb\u00fe\u00e1\u00e8\u00eb\u00e0\u0085\u00bb \u00ce \u00ed\u00ee\u00e2\u00ee\u00ec \u00e2\u00e0\u00f0\u00e8\u00e0\u00ed\u00f2\u00e5  \u00e1\u00e5\u00f1\u00b8\u00e4\u00ed\u00ee\u00e9 \u00ef\u00e5\u00f1\u00ed\u00e8 \u00dd\u00ea\u00f1\u00ef\u00e5\u00e4\u00e8\u00f6\u00e8\u00ff  \u00e1\u00f0\u00e0\u00f2\u00fc\u00e5\u00e2 \u00c1. \u00cc. \u00e8 \u00de. \u00cc. \u00d1\u00ee\u00ea\u00ee\u00eb\u00ee\u00e2\u00fb\u00f5  \u00ab\u00cf\u00ee \u00f1\u00eb\u00e5\u00e4\u00e0\u00ec  \u00d0\u00fb\u00e1\u00ed\u00e8\u00ea\u00ee\u00e2\u00e0 \u00e8 \u00c3\u00e8\u00eb\u00fc\u00f4\u00e5\u00f0\u00e4\u00e8\u00ed\u00e3\u00e0\u00bb \u00e8 \u00e5\u00e5 \u00f3\u00f7\u00e0\u00f1\u00f2\u00ed\u00e8\u00f6\u00e0 \u00c5. \u00c2. \u00d0\u00e6\u00e0\u00ed\u00ee\u00e2\u00f1\u00ea\u00e0\u00ff \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00c8\u00f0\u00e8\u00ed\u00e0 \u00d4\u00e5\u00e4\u00ee\u00f1\u00ee\u00e2\u00e0 \u00e2 \u00e8\u00f1\u00f1\u00eb\u00e5\u00e4\u00ee\u00e2\u00e0\u00ed\u00e8\u00ff\u00f5 \u00ca. \u00c2. \u00d7\u00e8\u00f1\u00f2\u00ee\u00e2\u00e0. \u00ca 190-\u00eb\u00e5\u00f2\u00e8\u00fe \u00f1\u00ee \u00e4\u00ed\u00ff \u00f0\u00ee\u00e6\u00e4\u00e5\u00ed\u00e8\u00ff \u00c8. \u00c0. \u00d4\u00e5\u00e4\u00ee\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d5\u00f0\u00e0\u00ed\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00e8\u00f6\u00e0 \u00f4\u00ee\u00eb\u00fc\u00ea\u00eb\u00ee\u00f0\u00e0 \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00fc\u00ff \u00d1\u00f2\u00e0\u00f2\u00fc\u00ff \u00ee\u00e1 \u00e8\u00f1\u00ef\u00ee\u00eb\u00ed\u00e8\u00f2\u00e5\u00eb\u00fc\u00ed\u00e8\u00f6\u00e5 \u00f4\u00ee\u00eb\u00fc\u00ea\u00eb\u00ee\u00f0\u00ed\u00fb\u00f5 \u00ef\u00f0\u00ee\u00e8\u00e7\u00e2\u00e5\u00e4\u00e5\u00ed\u00e8\u00e9 \u00c0\u00ed\u00e0\u00f1\u00f2\u00e0\u00f1\u00e8\u00e8 \u00d1\u00f2\u00e5\u00ef\u00e0\u00ed\u00ee\u00e2\u00ed\u00e5 \u00ca\u00ee\u00e9\u00e1\u00e8\u00ed\u00ee\u00e9 \u00e8\u00e7 \u00c7\u00e0\u00ee\u00ed\u00e5\u00e6\u00fc\u00ff. \u00cc\u00e8\u00f0\u00ee\u00ed\u00ee\u00e2\u00e0 \u00c2\u00e0\u00eb\u00e5\u00ed\u00f2\u00e8\u00ed\u00e0 \u00cf\u00e5\u00f2\u00f0\u00ee\u00e2\u00ed\u00e0 \u00cf\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e0\u00e2\u00f2\u00ee\u00f0\u00e5 \u00dd\u00eb\u00e5\u00ea\u00f2\u00f0\u00ee\u00ed\u00ed\u00fb\u00e5 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00ff \u00e0\u00e2\u00f2\u00ee\u00f0\u00e0: \u00c4\u00ee\u00f1\u00e2\u00e0\u00e4\u00e5\u00e1\u00ed\u00e0\u00ff \u00ee\u00e1\u00f0\u00ff\u00e4\u00ed\u00ee\u00f1\u00f2\u00fc \u00e8 \u00f1\u00e2\u00e0\u00e4\u00e5\u00e1\u00ed\u00fb\u00e9 \u00f0\u00e8\u00f2\u00f3\u00e0\u00eb \u00ea\u00e0\u00f0\u00e5\u00eb\u00ee\u00e2 (\u00ea\u00ee\u00ed\u00e5\u00f6 XIX \u0096 \u00ef\u00e5\u00f0\u00e2\u00e0\u00ff \u00ef\u00ee\u00eb\u00ee\u00e2\u00e8\u00ed\u00e0 \u00d5\u00d5 \u00e2.) \u00c8\u00f1\u00f1\u00eb\u00e5\u00e4\u00ee\u00e2\u00e0\u00ed\u00e8\u00ff \u00e8 \u00ec\u00e0\u00f2\u00e5\u00f0\u00e8\u00e0\u00eb\u00fb \u00ef\u00ee\u00e4\u00f0\u00ee\u00e1\u00ed\u00e5\u00e5 \u00ee\u00e1 \u00e8\u00e7\u00e4\u00e0\u00ed\u00e8\u00e8 \u00bb \u00d1\u00f2\u00f0\u00e0\u00ed\u00e8\u00f6\u00fb: 1 2 \u203a\u203a \u00c2\u00e5\u00f0\u00ed\u00f3\u00f2\u00fc\u00f1\u00ff \u00ed\u00e0 \u00e3\u00eb\u00e0\u00e2\u00ed\u00f3\u00fe 2011-2026 \u00a9 \u00cd\u00e0\u00f6\u00e8\u00ee\u00ed\u00e0\u00eb\u00fc\u00ed\u00e0\u00ff \u00e1\u00e8\u00e1\u00eb\u00e8\u00ee\u00f2\u00e5\u00ea\u00e0 \u00d0\u00e5\u00f1\u00ef\u00f3\u00e1\u00eb\u00e8\u00ea\u00e8 \u00ca\u00e0\u00f0\u00e5\u00eb\u00e8\u00ff \u00cf\u00f0\u00ee\u00e5\u00ea\u00f2 \u00f1\u00ee\u00e7\u00e4\u00e0\u00ed \u00ef\u00f0\u00e8 \u00f4\u00e8\u00ed\u00e0\u00ed\u00f1\u00ee\u00e2\u00ee\u00e9 \u00ef\u00ee\u00e4\u00e4\u00e5\u00f0\u00e6\u00ea\u00e5 \u00c8\u00ed\u00f1\u00f2\u00e8\u00f2\u00f3\u00f2\u00e0 \u00d0\u00ee\u00f1\u00f1\u00e8\u00e8 \u00e8 \u00c2\u00ee\u00f1\u00f2\u00ee\u00f7\u00ed\u00ee\u00e9 \u00c5\u00e2\u00f0\u00ee\u00ef\u00fb (\u00e3. \u00d5\u00e5\u00eb\u00fc\u00f1\u00e8\u00ed\u00ea\u00e8, \u00d4\u00e8\u00ed\u00eb\u00ff\u00ed\u00e4\u00e8\u00ff)",

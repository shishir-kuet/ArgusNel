{
  "url": "http://ar.wikiversity.org/wiki/%D8%A7%D9%84%D9%86%D9%88%D9%89%D8%8C_%D8%A7%D9%84%D9%83%D8%AA%D9%84%D8%A9%D8%8C_%D9%88%D8%A7%D9%84%D8%B7%D8%A7%D9%82%D8%A9/%D8%A7%D9%84%D8%AA%D9%83%D8%A7%D9%81%D8%A4_%D9%83%D8%AA%D9%84%D8%A9-%D8%B7%D8%A7%D9%82%D8%A9",
  "title": "\u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0643\u0627\u0641\u0624 \u0643\u062a\u0644\u0629-\u0637\u0627\u0642\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0643\u0627\u0641\u0624 \u0643\u062a\u0644\u0629-\u0637\u0627\u0642\u0629 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 < \u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u0643\u0627\u0641\u0624 \u0643\u062a\u0644\u0629-\u0637\u0627\u0642\u0629 [ \u0639\u062f\u0644 ] \u0639\u0644\u0627\u0642\u0629 \u0623\u064a\u0646\u0634\u062a\u0627\u064a\u0646 [ \u0639\u062f\u0644 ] \u062c\u0627\u0631\u064a \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u062f\u0631\u0633 \u0645\u0627\u0632\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u062f\u0631\u0633 \u0642\u064a\u062f \u0627\u0644\u062a\u0637\u0648\u064a\u0631\u060c \u0641\u0625\u0646 \u0648\u0631\u062f \u0644\u062f\u064a\u0643\u0645 \u0623\u064a \u0633\u0624\u0627\u0644 \u0623\u0648 \u0627\u0633\u062a\u0641\u0633\u0627\u0631\u060c \u064a\u0645\u0643\u0646\u0643\u0645 \u0625\u0636\u0627\u0641\u062a\u0647 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u0646\u0642\u0627\u0634 \u0642\u0628\u0644 \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u0639\u062f\u064a\u0644 \u0623\u0648 \u062a\u0631\u0634\u064a\u062d \u0627\u0644\u0635\u0641\u062d\u0629 \u0644\u0644\u062d\u0630\u0641. \u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0643\u062a\u0644\u0629 \u0648\u0627\u0644\u0637\u0627\u0642\u0629 [ \u0639\u062f\u0644 ] \u062c\u0627\u0631\u064a \u062a\u0637\u0648\u064a\u0631 \u0627\u0644\u062f\u0631\u0633 \u0645\u0627\u0632\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u062f\u0631\u0633 \u0642\u064a\u062f \u0627\u0644\u062a\u0637\u0648\u064a\u0631\u060c \u0641\u0625\u0646 \u0648\u0631\u062f \u0644\u062f\u064a\u0643\u0645 \u0623\u064a \u0633\u0624\u0627\u0644 \u0623\u0648 \u0627\u0633\u062a\u0641\u0633\u0627\u0631\u060c \u064a\u0645\u0643\u0646\u0643\u0645 \u0625\u0636\u0627\u0641\u062a\u0647 \u0625\u0644\u0649 \u0635\u0641\u062d\u0629 \u0627\u0644\u0646\u0642\u0627\u0634 \u0642\u0628\u0644 \u0625\u062c\u0631\u0627\u0621 \u0623\u064a \u062a\u0639\u062f\u064a\u0644 \u0623\u0648 \u062a\u0631\u0634\u064a\u062d \u0627\u0644\u0635\u0641\u062d\u0629 \u0644\u0644\u062d\u0630\u0641. \u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629 \u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629 \u0637\u0627\u0642\u0629 \u0627\u0644\u0631\u0628\u0637 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0627\u0644\u0646\u0648\u0649\u060c_\u0627\u0644\u0643\u062a\u0644\u0629\u060c_\u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0643\u0627\u0641\u0624_\u0643\u062a\u0644\u0629-\u0637\u0627\u0642\u0629&oldid=117135 \u00bb \u062a\u0635\u0646\u064a\u0641\u0627\u062a : \u0639\u0644\u0645 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0621 \u0627\u0644\u0630\u0631\u064a\u0629 \u0643\u0644\u064a\u0629 \u0639\u0644\u0648\u0645 \u0627\u0644\u0641\u064a\u0632\u064a\u0627\u0621 \u0628\u062d\u062b \u0628\u062d\u062b \u0627\u0644\u0646\u0648\u0649\u060c \u0627\u0644\u0643\u062a\u0644\u0629\u060c \u0648\u0627\u0644\u0637\u0627\u0642\u0629/\u0627\u0644\u062a\u0643\u0627\u0641\u0624 \u0643\u062a\u0644\u0629-\u0637\u0627\u0642\u0629 \u0623\u0636\u0641 \u0644\u063a\u0627\u062a \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",

  "title": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0432\u043b\u04d3 \u2014 \u0412\u0438\u043a\u0438\u043f\u0435\u0434\u0438",
  "text": "\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0432\u043b\u04d3 \u2014 \u0412\u0438\u043a\u0438\u043f\u0435\u0434\u0438 \u041f\u0435\u0440\u0435\u0439\u0442\u0438 \u043a \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u043d\u0438\u044e \u0412\u0438\u043a\u0438\u0448\u0442\u04f9 \u0442\u0435\u0445\u0435\u043d\u044c \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438 \u044b\u043b\u0435\u0448 \u0434\u04d3 \u043a\u044b\u0447\u044b\u043b\u0442\u0430\u043b\u0442\u0434\u044b\u043c\u044b \u043b\u0438\u043d \u043a\u0435\u0440\u0434\u04f9\u0442.\n\u0422\u0435\u043d\u0433\u0435\u043e\u043a \u043a\u04f9\u0447\u04d3\u043b\u043c\u04f9 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0432\u043b\u04d3\u043c \u0430\u043d\u0436\u044b. \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0432\u043b\u04d3 \u0410\u043d\u0436\u044b\u043a\u0442\u0430\u0448 \u043a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0432\u043b\u04d3\u043c, \u043a\u044b\u0434\u044b\u0432\u043b\u04d3 \u0442\u04f9\u043d\u0433\u04d3\u043b\u04d3\u043b\u0442\u04f9\u0442: \u0410\u043d\u0436\u044b\u043a\u0442\u0430\u0448 ( \u0438\u043a\u0448\u04f9 | \u043f\u04f9\u0442\u04d3\u0440\u0442\u04f9\u0448 ) ( \u0430\u043d\u0437\u044b\u0446\u0448\u044b \u044b\u043b\u0448\u044b 50 | \u0432\u0435\u0441\u04f9 50 ) ( 20 | 50 | 100 | 250 | 500 ) \u0430\u043d\u0436\u0435\u043d \u043b\u04d3\u043a 1-\u0448\u04f9 \u0430\u0432\u0433\u0443\u0441\u0442\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0430\u0432\u0433\u0443\u0441\u0442\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0430\u043f\u0440\u0435\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0434\u0435\u043a\u0430\u0431\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0434\u0435\u043a\u0430\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0438\u044e\u043b\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0438\u044e\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0438\u044e\u043d\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u043c\u0430\u0440\u0442\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u043c\u0430\u0440\u0442\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u043d\u043e\u044f\u0431\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u043d\u043e\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u043e\u043a\u0442\u044f\u0431\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u043e\u043a\u0442\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0444\u0435\u0432\u0440\u0430\u043b\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u0444\u0435\u0432\u0440\u0430\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 1-\u0448\u04f9 \u044f\u043d\u0432\u0430\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (6 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0430\u043f\u0440\u0435\u043b\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0430\u043f\u0440\u0435\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0434\u0435\u043a\u0430\u0431\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0438\u044e\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0438\u044e\u043d\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (0 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0438\u044e\u043d\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u043c\u0430\u0439\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u043c\u0430\u0440\u0442\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u043d\u043e\u044f\u0431\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u043d\u043e\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u043e\u043a\u0442\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0444\u0435\u0432\u0440\u0430\u043b\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u0444\u0435\u0432\u0440\u0430\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (3 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u044f\u043d\u0432\u0430\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 10-\u0448\u04f9 \u044f\u043d\u0432\u0430\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u0430\u0432\u0433\u0443\u0441\u0442\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (3 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u0430\u0432\u0433\u0443\u0441\u0442\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u0430\u043f\u0440\u0435\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (2 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u043c\u0430\u0439\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (3 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u043c\u0430\u0440\u0442\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u043c\u0430\u0440\u0442\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u043d\u043e\u044f\u0431\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (4 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u043d\u043e\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u0441\u0435\u043d\u0442\u044f\u0431\u0440\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u0444\u0435\u0432\u0440\u0430\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (0 \u0443\u0448\u043d\u044b\u0448\u044b) 11-\u0448\u04f9 \u044f\u043d\u0432\u0430\u0440\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (0 \u0443\u0448\u043d\u044b\u0448\u044b) 1172 \u0438\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 12-\u0448\u04f9 \u0430\u0432\u0433\u0443\u0441\u0442\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 12-\u0448\u04f9 \u0430\u043f\u0440\u0435\u043b\u044c\u044b\u043d \u043a\u043e\u043b\u044b\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) 12-\u0448\u04f9 \u0430\u043f\u0440\u0435\u043b\u044c\u044b\u043d \u0448\u0430\u0447\u0448\u044b\u0432\u043b\u04d3 (1 \u0443\u0448\u043d\u044b\u0448\u044b) ( \u0438\u043a\u0448\u04f9 | \u043f\u04f9\u0442\u04d3\u0440\u0442\u04f9\u0448 ) ( \u0430\u043d\u0437\u044b\u0446\u0448\u044b \u044b\u043b\u0448\u044b 50 | \u0432\u0435\u0441\u04f9 50 ) ( 20 | 50 | 100 | 250 | 500 ) \u0430\u043d\u0436\u0435\u043d \u043b\u04d3\u043a \u00ab https://mrj.wikipedia.org/wiki/\u0421\u043f\u0435\u0446\u04f9\u043b\u04f9\u0448\u0442\u04d3\u0448:\u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0438 \u00bb \u0433\u04f9\u0446 \u043d\u04d3\u043b\u043c\u04f9 \u041a\u04f9\u0447\u04d3\u043b\u043c\u04d3\u0448 \u041a\u04f9\u0447\u04d3\u043b\u043c\u04d3\u0448 \u041a\u0430\u0442\u0435\u0433\u043e\u0440\u0438\u0432\u043b\u04d3 \u0422\u0435\u043c\u044b\u043c \u0443\u0448\u0442\u0430\u0440\u0430\u0448",

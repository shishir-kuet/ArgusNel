{
  "url": "http://ar.wikiversity.org/wiki/%D9%86%D9%82%D8%A7%D8%B4_%D8%A7%D9%84%D9%85%D8%B3%D8%AA%D8%AE%D8%AF%D9%85:%D8%AC%D8%A7%D8%B1_%D8%A7%D9%84%D9%84%D9%87",
  "title": "\u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:\u062c\u0627\u0631 \u0627\u0644\u0644\u0647 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629",
  "text": "\u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:\u062c\u0627\u0631 \u0627\u0644\u0644\u0647 - \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629 \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0645\u0646 \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629, \u0645\u0631\u0643\u0632 \u0627\u0644\u062a\u0639\u0644\u064a\u0645 \u0627\u0644\u062d\u0631 \u0623\u062d\u062f\u062b \u062a\u0639\u0644\u064a\u0642: \u0642\u0628\u0644 7 \u0633\u0646\u0648\u0627\u062a \u0645\u0646 \u0641\u064a\u0635\u0644 \u0641\u064a \u0627\u0644\u0645\u0648\u0636\u0648\u0639 \u0645\u0634\u0627\u0631\u0643\u0629 \u0635\u0641\u062d\u0629 \u062a\u062d\u0648\u064a\u0644 \u062a\u062d\u0648\u064a\u0644 \u0625\u0644\u0649: w:\u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:\u062c\u0627\u0631 \u0627\u0644\u0644\u0647 \u0637\u0644\u0628 \u0628\u0633\u064a\u0637 [ \u0639\u062f\u0644 ] \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0623\u062e\u064a\u0631: \u0642\u0628\u0644 7 \u0633\u0646\u0648\u0627\u062a \u062a\u0639\u0644\u064a\u0642 \u0648\u0627\u062d\u062f \u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u0641\u064a \u0627\u0644\u0646\u0642\u0627\u0634 \u0623\u0647\u0644\u0627\u064b \u062c\u0627\u0631 \u0627\u0644\u0644\u0647\u060c \u0647\u0644 \u0645\u0645\u0643\u0646 \u0623\u0646 \u062a\u0632\u0648\u062f\u0646\u064a \u0628\u062c\u0645\u064a\u0639 \u0635\u0641\u062d\u0627\u062a \u0627\u0644\u0646\u0642\u0627\u0634 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u061f \u0623\u0631\u064a\u062f \u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0642\u0627\u0634\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639. \u0625\u0630\u0627 \u0645\u064f\u0645\u0643\u0646. \u0648\u062a\u0636\u0639\u0647\u0627 \u0647\u064f\u0646\u0627 \u0645\u0633\u062a\u062e\u062f\u0645:\u0641\u064a\u0635\u0644/\u0645\u0644\u0639\u0628 \u061f-- \u0641\u064a\u0635\u0644 (\u0631\u0627\u0633\u0644\u0646\u064a) 07:04\u060c 16 \u0645\u0627\u0631\u0633 2018 (\u062a \u0639 \u0645) \u0631\u062f\u0651 \u0645\u0634\u0627\u0631\u0643\u0629 [ \u0639\u062f\u0644 ] \u0627\u0644\u062a\u0639\u0644\u064a\u0642 \u0627\u0644\u0623\u062e\u064a\u0631: \u0642\u0628\u0644 7 \u0633\u0646\u0648\u0627\u062a \u062a\u0639\u0644\u064a\u0642 \u0648\u0627\u062d\u062f \u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u0641\u064a \u0627\u0644\u0646\u0642\u0627\u0634 \u0645\u0631\u062d\u0628\u064b\u0627\u060c \u0643\u0648\u0646\u0643 \u0645\u0646 \u0627\u0644\u0646\u0634\u064a\u0637\u064a\u0646 \u0641\u064a \u0648\u064a\u0643\u064a \u0627\u0644\u062c\u0627\u0645\u0639\u0629\u060c \u0641\u0645\u0634\u0627\u0631\u0643\u062a\u0643 \u0645\u0637\u0644\u0648\u0628\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0642\u0633\u0645 . \u062a\u062d\u064a\u0627\u062a\u064a-- \u0641\u064a\u0635\u0644 (\u0631\u0627\u0633\u0644\u0646\u064a) 19:27\u060c 14 \u064a\u0648\u0646\u064a\u0648 2018 (\u062a \u0639 \u0645) \u0631\u062f\u0651 \u0645\u062c\u0644\u0648\u0628\u0629 \u0645\u0646 \u00ab https://ar.wikiversity.org/w/index.php?title=\u0646\u0642\u0627\u0634_\u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:\u062c\u0627\u0631_\u0627\u0644\u0644\u0647&oldid=59927 \u00bb \u0628\u062d\u062b \u0628\u062d\u062b \u0646\u0642\u0627\u0634 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 : \u062c\u0627\u0631 \u0627\u0644\u0644\u0647 \u0623\u0636\u0641 \u0645\u0648\u0636\u0648\u0639\u064b\u0627",
